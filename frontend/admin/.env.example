# Backend API base URL (Fastify), e.g. https://servd-api.garibsons.app
NEXT_PUBLIC_API_URL=http://localhost:3001

# socket.io fallback transport — used when GET /auth/realtime-token returns
# driver: 'socketio' instead of 'supabase'. e.g. wss://servd-api.garibsons.app
NEXT_PUBLIC_WS_URL=http://localhost:3001

# Consumer storefront base URL, for cross-links from admin (e.g. "view live" on a brand page)
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000

# Optional: Maps JavaScript API key for the location pin picker. Restrict it
# to the admin origin in Google Cloud. Without it, the picker falls back to
# OpenStreetMap tiles + a paste-a-Maps-link resolver.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
