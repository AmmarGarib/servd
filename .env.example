# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://servd:servd_dev@localhost:5432/servd"

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-in-production-min-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"
PIN_TOKEN_EXPIRY="12h"

# ─── Payment Gateways ─────────────────────────────────────────────────────────
KEENU_API_KEY=""
KEENU_MERCHANT_ID=""
KEENU_WEBHOOK_SECRET=""
KEENU_BASE_URL="https://api.keenu.com.pk/v1"
JAZZCASH_MERCHANT_ID=""
JAZZCASH_PASSWORD=""
JAZZCASH_INTEGRITY_SALT=""
EASYPAISA_STORE_ID=""
EASYPAISA_ACCOUNT_NUM=""
EASYPAISA_HASH_KEY=""

# ─── File Storage (Cloudflare R2 / S3-compatible) ─────────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="servd-media"
R2_PUBLIC_URL="https://media.servd.local"

# ─── Messaging (SMS/WhatsApp receipts) ───────────────────────────────────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
TWILIO_WHATSAPP_FROM=""

# ─── Fiscal filing (FBR + SRB) — through the POS connector ──────────────────
# servd does NOT file with FBR PRAL or SRB itself. The external fiscal POS is
# the only filer; servd sends it each full & final sale through the POS
# connector, configured per company in admin → Dev → API → POS connector
# (driver, base URL, API key, POS ids). There are no FBR_* / SRB_* variables
# any more. See docs/TAX_SETUP.md.

# ─── Secrets at rest ─────────────────────────────────────────────────────────
# AES-256-GCM key for stored integration secrets (POS connector API keys and
# webhook secrets, the WhatsApp gateway key). base64 of 32 random bytes:
#   openssl rand -base64 32
# Set it on the API box only — never commit it. Without it, saving a connector
# or WhatsApp key answers 503 SECRET_KEY_MISSING, a legacy plaintext WhatsApp
# key keeps working, and /health warns. Losing it makes stored secrets
# unreadable (re-enter them in admin), so keep it in the box's secret store.
SERVD_SECRET_KEY=""

# ─── Meta (Facebook Pages + Instagram Business publishing) ──────────────────
# Drives /settings/integrations "Connect Meta" + the Content Calendar's
# Instagram / Facebook publish workers. See docs/META_SETUP.md for the
# step-by-step on getting these values out of developers.facebook.com.
# Without these set, the Connect button surfaces the missing-config error
# instead of redirecting you into Meta's OAuth dialog.
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
# OAuth redirect URI you'll register in the Meta App. The backend builds
# this from API_URL automatically — listed here so you know what to paste
# into Meta's "Valid OAuth Redirect URIs" field:
#   ${API_URL}/api/v1/integrations/social/callback

# ─── Email (Magic links) ──────────────────────────────────────────────────────
SMTP_HOST="smtp.resend.com"
SMTP_PORT="465"
SMTP_USER="resend"
SMTP_PASS=""
EMAIL_FROM="noreply@servd.pk"

# ─── App URLs ────────────────────────────────────────────────────────────────
API_URL="http://localhost:3001"
WEB_URL="http://localhost:3000"
STOREFRONT_URL="http://localhost:3002"

# ─── Tax ─────────────────────────────────────────────────────────────────────
# FBR Sales Tax / GST rate (percentage, e.g. 17 for 17%)
DEFAULT_TAX_RATE=17

# ─── Environment ─────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT="3001"
