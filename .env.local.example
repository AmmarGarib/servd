# Copy to `.env.local` to point the local dev stack (docker-compose.local.yml)
# at the SAME database/cache production uses, instead of the bundled ones.
#
#   cp .env.local.example .env.local   &&   edit in your real values
#
# `.env.local` is git-ignored — never commit real credentials.
#
# ⚠️  These are PRODUCTION services. Any data you change locally is changing
#     live data immediately. The stack disables auto-migrate + auto-seed when
#     it sees a non-bundled DATABASE_URL, but your writes still hit prod.

# Neon (cloud Postgres) — from the Neon dashboard → Connection string.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/servd?sslmode=require

# Upstash (cloud Redis) — from the Upstash console (use the rediss:// TLS URL).
REDIS_URL=rediss://default:PASSWORD@xxxx.upstash.io:6379

# Optional: set these to the real production JWT secrets if you want existing
# production sessions/tokens to validate locally. Otherwise just log in fresh.
# JWT_SECRET=
# JWT_REFRESH_SECRET=

# Optional: set to 1 ONLY if you intend to apply pending migrations to the
# live database from your laptop. Leave unset/0 for normal local work.
# FORCE_MIGRATE=0
