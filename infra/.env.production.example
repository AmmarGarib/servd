# servd backend environment — copy to `.env.production` on the server before
# running `docker compose up -d --build`.
#
# IMPORTANT: REDIS_URL is intentionally NOT set here — docker-compose.yml
# overrides it to point at the in-network redis container. Don't add it back
# unless you're using an external Redis.

# ─── Database (Neon — already provisioned, free tier) ───────────────────────
# Get from console.neon.tech → your project → Connection Details → Connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# ─── Auth (REGENERATE THESE — do not reuse from dev) ────────────────────────
# Generate with:  openssl rand -base64 48
JWT_SECRET="REPLACE_WITH_64_BYTES_OF_RANDOM"
JWT_REFRESH_SECRET="REPLACE_WITH_64_BYTES_OF_RANDOM"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"
PIN_TOKEN_EXPIRY="12h"

# ─── App URLs (substitute YOUR domain) ──────────────────────────────────────
# These drive CORS allow-list AND links emitted in emails/SMS.
# Example for the canonical setup: api.servd.pk / admin.servd.pk / app.servd.pk
API_URL="https://api.servd.pk"
WEB_URL="https://admin.servd.pk"
STOREFRONT_URL="https://app.servd.pk"

# ─── CORS: brand custom domains ─────────────────────────────────────────────
# Comma-separated. The CORS allowlist at backend/src/lib/corsAllowlist.ts
# already includes these defaults; only override if your brand domain set
# differs. Wildcard subdomains *.servd.pk and *.localhost are auto-allowed.
# BRAND_HOSTS="eatstax.com,eatstrata.com,eatflipd.com,bukharirice.com,eatsimmer.com,craveman.pk,garnish.pk"

# ─── Workers (REQUIRED for reminders, no-show sweep, lifecycle triggers) ────
# Disable for cost-saving in dev or if Redis is rate-limited (Upstash 500k/mo
# cap was the historical reason). In production this should be true.
ENABLE_WORKERS=true

# ─── File Storage (Cloudflare R2 — 10GB free, $0 egress) ────────────────────
# Cloudflare Dashboard → R2 → Create bucket "servd-media"
# Credentials: R2 → Manage R2 API Tokens → Create token (Object Read & Write)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="servd-media"
# Public URL — either the r2.dev subdomain (throttled but instant) or a CNAME.
R2_PUBLIC_URL="https://media.servd.pk"

# ─── Email (Resend — free 3k/mo at resend.com) ──────────────────────────────
# Without SMTP_PASS, all email triggers log but don't send.
SMTP_HOST="smtp.resend.com"
SMTP_PORT="465"
SMTP_USER="resend"
SMTP_PASS=""
EMAIL_FROM="noreply@servd.pk"

# ─── Messaging (Twilio for SMS / WhatsApp) ──────────────────────────────────
# Without these, SMS triggers log but don't send.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
TWILIO_WHATSAPP_FROM=""

# ─── Payment Gateways (fill before live transactions) ───────────────────────
KEENU_API_KEY=""
KEENU_MERCHANT_ID=""
KEENU_WEBHOOK_SECRET=""
KEENU_BASE_URL="https://api.keenu.com.pk/v1"
JAZZCASH_MERCHANT_ID=""
JAZZCASH_PASSWORD=""
JAZZCASH_INTEGRITY_SALT=""
EASYPAISA_STORE_ID=""
EASYPAISA_ACCOUNT_NUM=""
EASYPAISA_HASH_KEY=""

# ─── Delivery Platforms (fill when integrating aggregator orders) ───────────
UBEREATS_CLIENT_ID=""
UBEREATS_CLIENT_SECRET=""
UBEREATS_WEBHOOK_SECRET=""
DOORDASH_DEVELOPER_ID=""
DOORDASH_KEY_ID=""
DOORDASH_SIGNING_SECRET=""
DELIVEROO_CLIENT_ID=""
DELIVEROO_CLIENT_SECRET=""
DELIVEROO_WEBHOOK_SECRET=""

# ─── Tax ────────────────────────────────────────────────────────────────────
DEFAULT_TAX_RATE=17

# ─── Environment ────────────────────────────────────────────────────────────
NODE_ENV="production"
PORT="3001"

# ────────────────────────────────────────────────────────────────────────────
# Frontend env vars (Sentry) — these go into the IMAGE BUILD via build args
# in docker-compose.yml, NOT this file. To enable Sentry error capture:
#   1. Sign up at sentry.io, create a project, copy the DSN
#   2. In docker-compose.yml under the `admin` and `storefront` services,
#      add to `build.args`:
#        NEXT_PUBLIC_SENTRY_DSN: "https://...@sentry.io/..."
#   3. Rebuild: docker compose up -d --build admin storefront
# Until then, Sentry init is gated by `enabled: !!NEXT_PUBLIC_SENTRY_DSN` so
# nothing breaks — errors just aren't captured.
# ────────────────────────────────────────────────────────────────────────────
