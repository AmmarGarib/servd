# Compose-level env file. Copy to `.env` (in this same dir) and fill in.
# Read by `docker compose` automatically and substituted into docker-compose.yml
# build args (so the Next.js builds inline these values into the client JS).
#
# This is SEPARATE from .env.production (which is the BACKEND runtime env).
#
# Why two files: NEXT_PUBLIC_* variables must be present at IMAGE BUILD time,
# not container runtime — Next.js inlines them into the static client bundle.
# `env_file:` only affects runtime, so we need build args here.

# Public-facing URLs of your deployment (substitute YOUR domain).
# These get baked into the Next.js bundles so the browser knows where the API
# lives. Must be HTTPS in production.
PUBLIC_API_URL=https://api.servd.pk
PUBLIC_WS_URL=https://api.servd.pk

# Sentry DSNs — leave blank to disable Sentry, fill in to capture errors.
# Each Next.js app needs its own DSN (one Sentry project per app is cleanest).
SENTRY_DSN_ADMIN=
SENTRY_DSN_STOREFRONT=
