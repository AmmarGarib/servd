# servd Docker handoff — fill in the values, save as `.env`, then `docker compose up -d`.

# ─── Docker Hub repo (whose images to pull) ─────────────────────────────────
# Default is ammargarib/servd. The three services use tags :api, :admin, :storefront
# on the SAME repo (Docker Hub free tier = 1 free private repo).
# Override only if the repo moved.
DOCKER_REPO=ammargarib/servd

# ─── Database (Supabase Postgres) ────────────────────────────────────────────
# Get from Supabase Project Settings → Database → Connection string (URI).
DATABASE_URL=

# ─── Redis (Upstash) ─────────────────────────────────────────────────────────
# Get from Upstash Console → your database → REST/redis URLs section.
REDIS_URL=

# ─── Auth secrets (32+ chars each, generate fresh) ──────────────────────────
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
PIN_TOKEN_EXPIRY=12h

# ─── App URLs (the running host — localhost on a single-machine run) ───────
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
STOREFRONT_URL=http://localhost:3002

# ─── Tax defaults ────────────────────────────────────────────────────────────
DEFAULT_TAX_RATE=17

# ─── Optional integrations (leave blank if you don't need them) ─────────────
# Payment gateways
KEENU_API_KEY=
KEENU_MERCHANT_ID=
KEENU_WEBHOOK_SECRET=
KEENU_BASE_URL=https://api.keenu.com.pk/v1
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
EASYPAISA_STORE_ID=
EASYPAISA_ACCOUNT_NUM=
EASYPAISA_HASH_KEY=

# Delivery
FOODPANDA_WEBHOOK_SECRET=

# Storage (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=servd-media
R2_PUBLIC_URL=

# Messaging
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=

# Tax authorities
FBR_USERNAME=
FBR_PASSWORD=
FBR_ENV=sandbox
SRB_USERNAME=
SRB_PASSWORD=
SRB_ENV=sandbox

# Meta (Facebook/Instagram publishing)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Email (magic links)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
EMAIL_FROM=noreply@servd.pk
