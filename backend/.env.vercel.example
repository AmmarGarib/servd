# servd API on Vercel — environment variables for the `backend` project.
# Copy each value into Vercel → Project → Settings → Environment Variables.
# The Docker deployment keeps using its own .env; nothing here changes it.

NODE_ENV=production
# Set by Vercel automatically; switches trustProxy on. Do not set by hand.
# VERCEL=1

# ── Core (same values as the Docker box) ──────────────────────────────────
# Neon: use the POOLED connection string (host contains "-pooler").
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
JWT_SECRET=
JWT_REFRESH_SECRET=
WEB_URL=https://servd-admin.garibsons.app
STOREFRONT_URL=https://servd.pk
API_URL=https://servd-api.garibsons.app
KEENU_WEBHOOK_SECRET=
BRAND_HOSTS=eatstax.com,flipd.pk,stackd.pk

# ── Redis (required) ──────────────────────────────────────────────────────
# Upstash free tier. Used for login rate limiting, token revocation, OTP and
# WhatsApp session state. Must be the TLS URL.
REDIS_URL=rediss://default:PASSWORD@xxx.upstash.io:6379

# ── Background jobs ───────────────────────────────────────────────────────
# db = queued work is stored in Postgres and drained by the scheduler tick.
JOBS_DRIVER=db
# Shared secret the scheduler presents: Authorization: Bearer <CRON_SECRET>.
# Vercel Cron sends it automatically when this variable is set. Generate with
# `openssl rand -hex 32`.
CRON_SECRET=

# ── Realtime (Supabase Realtime, private broadcast channels) ─────────────
REALTIME_DRIVER=supabase
SUPABASE_URL=https://xxxx.supabase.co
# Project Settings → API. The service role key never reaches a browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Project Settings → API → JWT Settings → JWT Secret (legacy HS256 secret).
SUPABASE_JWT_SECRET=

# ── Optional integrations (unchanged) ────────────────────────────────────
# WHATSAPP_API_URL= / WHATSAPP_API_KEY= / SMTP_* / FBR_* / SRB_* / KEENU_* / SENTRY_DSN=
