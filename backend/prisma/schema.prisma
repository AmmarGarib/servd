// servd — Prisma Schema
// Database: PostgreSQL 15+

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum ConceptType {
  restaurant
  digital
  cart
}

enum OrderSource {
  servd
  foodpanda
  careem
  pos
  cart
  manual
}

enum OrderStatus {
  received
  confirmed
  preparing
  ready
  completed
  cancelled
  rejected
  refunded
}

enum ItemStatus {
  pending
  preparing
  ready
  bumped
  held
  recalled
  voided
}

enum UserRole {
  admin
  manager
  cashier
  kitchen
  expediter
  marketing       // outside agency / in-house marketing — scoped to /marketing operations
}

enum PaymentMethod {
  cash
  card
  jazzcash_wallet
  easypaisa_wallet
  keenu_qr
  split
  comp
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

enum PaymentGateway {
  keenu
  jazzcash
  easypaisa
  none
}

enum ShiftStatus {
  open
  closed
}

enum LoyaltyTxType {
  earn
  redeem
  expire
  adjustment
}

enum BroadcastStatus {
  draft
  scheduled
  sent
  failed
}

enum TriggerType {
  birthday
  winback
  loyalty_tier
  custom
}

enum RiderStatus {
  available
  busy
  offline
}

enum VehicleType {
  bike
  car
  bicycle
  foot
}

enum ComplaintStatus {
  open
  in_progress
  resolved
  closed
}

enum ComplaintPriority {
  low
  medium
  high
  urgent
}

enum AccountType {
  asset
  liability
  equity
  revenue
  expense
}

enum JournalEntryType {
  debit
  credit
}

// ─── Concept ──────────────────────────────────────────────────────────────────

model Concept {
  id          String      @id @default(uuid())
  tenantId    String?                                  // tenant — backfilled to "main" on first boot
  name        String
  slug        String      @unique
  type        ConceptType
  description String?
  logoUrl     String?
  primaryColor String?
  isActive    Boolean     @default(true)
  taxRate     Float       @default(17) // FBR GST %

  // Storefront CMS — editable from ops admin
  storefrontVisible  Boolean  @default(true)  // show/hide on customer ordering page
  heroTagline        String?                  // punchy line under concept name
  announcementBanner String?                  // live message customers see (e.g. "Closed today")
  storefrontLayout   Json?                    // ordered array of page blocks (page builder)

  // Reservation availability — per-brand master toggle. When false, public
  // booking endpoints reject (RESERVATIONS_DISABLED) and customer-facing
  // surfaces hide the "Book a table" CTA. Staff can still create reservations
  // via the admin (e.g. take a phone booking) regardless. Useful for:
  // takeaway-only brands, ghost kitchens, brands without floor service.
  reservationsEnabled Boolean @default(true)

  // ── Brand strategy brief ──────────────────────────────────────────────
  // Captured during onboarding, reused in CRM segmentation, marketing copy,
  // and competitive analytics. Free-form fields so operators describe their
  // brand the way they actually pitch it, not a forced taxonomy.
  conceptStatement    String?                 // one-line concept ("Build-your-own smashburger over brioche")
  cuisine             String?                 // 'burgers' | 'desi' | 'asian' | etc.
  heroProduct         String?                 // signature dish — drives daily-special suggestions
  anchoringExperience String?                 // the memorable thing — "27-layer croissant", "open kitchen"
  targetCustomer      String?                 // "22–35 urban DHA, daily indulgence"
  priceTier           String?                 // 'budget' | 'mid' | 'premium' | 'luxury'
  daypartFocus        String[] @default([])   // ['lunch', 'dinner', 'late_night']
  competitors         String[] @default([])   // up to 5 named competitors
  differentiator      String?                 // wedge — "in-house lamination, not bakery buns"
  brandVoice          String?                 // tone notes — "loud, urban, no-precious-paragraphs"

  // Delivery geography — null = no restriction (global / dine-in / pickup)
  latitude          Float?
  longitude         Float?
  deliveryRadiusKm  Float    @default(5)      // how far this brand delivers from its outlet

  // Foodpanda commission rate as a fraction (0.25 = 25%). Negotiated per
  // concept; some brands have promotional discounts. Default mirrors the
  // standard contract.
  foodpandaCommissionRate Float @default(0.25)

  // FBR registration / tax invoice details. Required fields on Pakistani tax
  // invoices: STRN (Sales Tax Registration Number) and NTN (National Tax
  // Number). Province governs which provincial revenue authority's tax also
  // applies to services.
  strn          String?   // FBR sales-tax registration number
  ntn           String?   // National Tax Number
  province      String?   // 'PB' | 'SD' | 'KP' | 'BL' | 'ICT' | 'GB' | 'AJK'
  invoiceLegalName    String?  // legal entity name as registered with FBR
  invoiceAddress      String?  // billing address printed on invoices
  invoicePrefix       String?  // e.g. "STX-" — concept-scoped sequence prefix

  // FBR PRAL Electronic POS — POSID assigned by FBR at POS registration.
  // Required for Tier-1 businesses under SRO 1307(I)/2022. Null = concept
  // is not registered for real-time invoice submission.
  fbrPosId    Int?

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  menus           MenuItem[]
  categories      Category[]
  orders          Order[]
  stations        Station[]
  tables          Table[]
  financialEntries FinancialEntry[]
  customers       Customer[]        @relation("PreferredConcept")
  reviews         OrderReview[]
  complaints      OrderComplaint[]
  promoCodes      PromoCode[]
  sectionDiscounts SectionDiscount[]
  abandonedCarts  AbandonedCart[]
  qrCodes         QrCode[]
  allocationWeights AllocationRuleWeight[]
  floors          Floor[]
  reservations    Reservation[]
  blockouts       ConceptBlockout[]
  serviceHours    ServiceHours[]
  groupOrders     GroupOrder[]
  scheduledShifts ScheduledShift[]
  analyticsEvents    AnalyticsEvent[]   @relation("ConceptAnalytics")
  contentEvents      ContentEvent[]     @relation("ConceptCalendar")
  locations          ConceptLocation[]
  tenant             Tenant?            @relation(fields: [tenantId], references: [id])
  componentUses      ComponentBrandUse[]
  feedbackEntries    FeedbackEntry[]

  @@index([tenantId])
  @@map("concepts")
}

// ─── Station ──────────────────────────────────────────────────────────────────

model Station {
  id           String    @id @default(uuid())
  conceptId    String
  name         String
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  concept    Concept     @relation(fields: [conceptId], references: [id])
  orderItems OrderItem[]

  @@map("stations")
}

// ─── Category ─────────────────────────────────────────────────────────────────

model Category {
  id                    String    @id @default(uuid())
  conceptId             String
  name                  String
  sortOrder             Int       @default(0)
  timeRestrictionStart  String?   // HH:MM (e.g. "08:00")
  timeRestrictionEnd    String?   // HH:MM (e.g. "11:00")
  isActive              Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  concept          Concept          @relation(fields: [conceptId], references: [id])
  items            MenuItem[]
  sectionDiscounts SectionDiscount[]

  @@map("categories")
}

// ─── MenuItem ─────────────────────────────────────────────────────────────────

enum TaxClassification {
  standard       // standard-rate (uses concept.taxRate, default 17% FBR)
  zero_rated     // 0% — exports, certain food staples
  exempt         // outside the GST regime entirely (no input-tax recovery either)
  custom         // use overrideTaxRate
}

model MenuItem {
  id           String    @id @default(uuid())
  conceptId    String
  categoryId   String
  name             String
  nameUrdu         String?   @map("name_urdu")
  description      String?
  instructions     String?   // cooking/assembly steps shown in KDS tap modal
  instructionsUrdu String?   @map("instructions_urdu")
  priceCents   Int
  imageUrl     String?
  isAvailable        Boolean   @default(true)
  portionsAvailable  Int?      // null = unlimited; set per service for live stock tracking
  displayOrder       Int       @default(0)
  stationId          String?   // default routing station

  // FBR tax classification per item. CA can override per-item; default is
  // 'standard' (uses concept.taxRate). 'custom' uses overrideTaxRate.
  taxClassification TaxClassification @default(standard)
  overrideTaxRate   Float?    // only consulted when taxClassification = 'custom'

  // Allergens + dietary tags. Stored as a string array (Postgres TEXT[]) so
  // operators can add custom labels beyond the standard set.
  // Standard set: gluten, dairy, eggs, peanuts, tree_nuts, soy, fish,
  // shellfish, sesame, mustard. Dietary: vegetarian, vegan, halal, gluten_free.
  allergens String[]  @default([])
  dietary   String[]  @default([])
  spiceLevel Int?     // 0–5; null = not applicable

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  concept        Concept         @relation(fields: [conceptId], references: [id])
  category       Category        @relation(fields: [categoryId], references: [id])
  modifierGroups ModifierGroup[]
  orderItems     OrderItem[]
  recipe         Recipe?

  @@map("menu_items")
}

// ─── ModifierGroup ────────────────────────────────────────────────────────────

model ModifierGroup {
  id         String    @id @default(uuid())
  menuItemId String
  name       String
  minSelect  Int       @default(0)
  maxSelect  Int       @default(1)
  isRequired Boolean   @default(false)
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  menuItem  MenuItem   @relation(fields: [menuItemId], references: [id])
  modifiers Modifier[]

  @@map("modifier_groups")
}

// ─── Modifier ─────────────────────────────────────────────────────────────────

model Modifier {
  id             String    @id @default(uuid())
  groupId        String
  name           String
  priceDeltaCents Int      @default(0)
  isDefault      Boolean   @default(false)
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  group          ModifierGroup       @relation(fields: [groupId], references: [id])
  orderItemMods  OrderItemModifier[]

  @@map("modifiers")
}

// ─── Table ────────────────────────────────────────────────────────────────────

enum TableShape {
  rectangle
  square
  round
  banquette   // long sofa-style seating
  counter     // bar / pass counter
  barstool    // single bar seat
}

model Table {
  id           String    @id @default(uuid())
  conceptId    String
  floorId      String?   // groups tables onto a Floor; null = legacy or unassigned
  label        String    // e.g. "T1", "Patio-3"
  capacity     Int       @default(4)
  floorSection String?
  status       String    @default("available") // available|seated|ordered|eating|check|reserved|cleaning|out_of_service
  // Canvas positioning — pixels in floor-plan space (Floor.width × Floor.height).
  // Editor snaps to a 10px grid by default.
  shape        TableShape @default(rectangle)
  x            Int        @default(40)
  y            Int        @default(40)
  width        Int        @default(120)
  height       Int        @default(80)
  rotation     Int        @default(0)    // degrees, 0–359
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  concept      Concept       @relation(fields: [conceptId], references: [id])
  floor        Floor?        @relation(fields: [floorId], references: [id])
  orders       Order[]
  qrCodes      QrCode[]
  reservations Reservation[]

  @@index([conceptId, floorId])
  @@map("tables")
}

model Floor {
  id            String   @id @default(uuid())
  conceptId     String
  name          String   // "Main", "Patio", "Mezzanine", "Bar"
  displayOrder  Int      @default(0)
  width         Int      @default(1200)   // canvas px
  height        Int      @default(800)
  backgroundUrl String?  // optional floorplan image — restaurant blueprint scan
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  concept Concept @relation(fields: [conceptId], references: [id])
  tables  Table[]

  @@index([conceptId, displayOrder])
  @@map("floors")
}

enum ReservationStatus {
  booked
  confirmed
  seated
  completed
  no_show
  cancelled
}

enum ReservationSource {
  staff
  website
  phone
  walkin
}

model Reservation {
  id           String              @id @default(uuid())
  conceptId    String
  customerId   String?             // linked when guest matches a Customer record
  tableId      String?             // null until seated; can change if a guest is reseated
  partySize    Int
  startTime    DateTime
  endTime      DateTime            // start + duration (default 90 min, configurable)
  status       ReservationStatus   @default(booked)
  source       ReservationSource   @default(staff)

  // Guest info — captured even for non-customer (no Customer row) bookings.
  // Synced into a Customer record on first arrival if email/phone provided.
  guestName    String
  guestPhone   String?
  guestEmail   String?

  notes        String?             // allergies, occasion, requests
  isVip        Boolean   @default(false)
  // For walk-ins / waitlist parties without an immediate table assignment
  waitlist     Boolean   @default(false)

  // Optional credit-card hold for premium / large-party bookings. When set,
  // the customer's card is authed (not captured) for this amount; they only
  // pay if they no-show. Operator releases the hold on arrival.
  depositCents Int       @default(0)
  depositRef   String?   // gateway reference (Keenu transaction id)

  // Confirmation token — public link the guest can hit to confirm or cancel
  // without signing in.
  confirmToken String?   @unique
  confirmedAt  DateTime?

  // Reminder flags — flipped by the loyaltyTriggers-style worker so we don't
  // double-send.
  reminder24hSentAt DateTime?
  reminder2hSentAt  DateTime?

  seatedAt     DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  // ── Waitlist promotion ─────────────────────────────────────────────────
  // When another reservation cancels or no-shows, the system can OFFER the
  // freed slot to a matching waitlist row. The original waitlist row stays
  // untouched until the guest claims; these fields hold the offer.
  //   POST /api/v1/reservations/claim/:token  → applies offer to startTime,
  //                                               endTime, tableId and clears
  //                                               the promotion fields.
  // Expired offers (promotionExpiresAt < now) get swept by the reservation
  // reminder worker on its next tick.
  promotionToken              String?   @unique
  promotionExpiresAt          DateTime?
  promotionOfferedStartTime   DateTime?
  promotionOfferedEndTime     DateTime?
  promotionOfferedTableId     String?
  promotedFromWaitlistAt      DateTime?

  createdById  String?             // staff user, null if from public website
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  concept   Concept   @relation(fields: [conceptId], references: [id])
  customer  Customer? @relation(fields: [customerId], references: [id])
  table     Table?    @relation(fields: [tableId], references: [id])

  @@index([conceptId, startTime])
  @@index([tableId, startTime])
  @@index([promotionExpiresAt])
  @@index([status, startTime])
  @@index([reminder24hSentAt])
  @@map("reservations")
}

// ─── Concept blockouts ──────────────────────────────────────────────────────
// Closures, private events, holiday hours. The slot-search API refuses to
// surface time inside a blockout, and the dashboard surfaces them visually.

enum BlockoutKind {
  closure          // restaurant closed entirely
  private_event    // booked out for a private function
  reduced_capacity // only N tables available
  custom
}

model ConceptBlockout {
  id          String       @id @default(uuid())
  conceptId   String
  kind        BlockoutKind @default(closure)
  startTime   DateTime
  endTime     DateTime
  // For reduced_capacity, only this many tables remain available
  capacityCap Int?
  reason      String?      // free-text, surfaced to staff
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  concept Concept @relation(fields: [conceptId], references: [id])

  @@index([conceptId, startTime])
  @@map("concept_blockouts")
}

// ─── Service hours (per concept × per day-of-week) ───────────────────────────
// Defines when a concept accepts reservations. Multiple windows per day allow
// for split lunch/dinner service.

model ServiceHours {
  id          String   @id @default(uuid())
  conceptId   String
  dayOfWeek   Int      // 0 = Sun, 1 = Mon, … 6 = Sat
  // HH:MM 24-hour stored as int minutes since midnight (0–1440)
  openMin     Int
  closeMin    Int
  isReservable Boolean @default(true)  // false = walk-in only
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  concept Concept @relation(fields: [conceptId], references: [id])

  @@unique([conceptId, dayOfWeek, openMin])
  @@map("service_hours")
}

// ─── Customer guest tags (allergies, regular, VIP, etc.) ────────────────────
// Free-form labels operators apply to a customer. Surfaced on reservation rows
// and in the customer 360 view.

// ─── Gift cards ──────────────────────────────────────────────────────────────
//
// Issued with a face value, redeemable across any GS Foods concept (the
// liability sits in 2080). Each redemption decrements balance, posts to the
// journal, and stores a transaction record. Codes are human-readable but
// long enough that brute-forcing is impractical.

enum GiftCardStatus {
  active
  redeemed_full
  expired
  voided
}

model GiftCard {
  id              String          @id @default(uuid())
  code            String          @unique  // human-readable, e.g. "GS-7K2P-X9MD"
  issuedAmountCents Int
  balanceCents    Int
  currency        String          @default("PKR")
  status          GiftCardStatus  @default(active)
  expiresAt       DateTime?

  // Buyer + recipient details (same person if self-purchase)
  buyerCustomerId    String?
  buyerEmail         String?
  recipientName      String?
  recipientEmail     String?
  message            String?

  issuedById      String?         // staff user; null for storefront purchase
  conceptId       String?         // null = redeemable everywhere
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  voidedAt        DateTime?
  voidReason      String?

  redemptions     GiftCardRedemption[]

  @@index([status])
  @@index([buyerEmail])
  @@map("gift_cards")
}

model GiftCardRedemption {
  id             String   @id @default(uuid())
  giftCardId     String
  orderId        String?
  amountCents    Int
  balanceAfter   Int
  redeemedAt     DateTime @default(now())
  redeemedById   String?  // staff user when manual

  giftCard GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  order    Order?   @relation(fields: [orderId], references: [id])

  @@index([giftCardId, redeemedAt(sort: Desc)])
  @@index([orderId])
  @@map("gift_card_redemptions")
}

model GuestTag {
  id         String  @id @default(uuid())
  customerId String
  label      String  // "VIP", "Vegan", "Allergic — peanuts", "Press", "Industry"
  color      String? // optional hex
  createdById String?
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("guest_tags")
}

// ─── User (Staff) ─────────────────────────────────────────────────────────────

model User {
  id        String    @id @default(uuid())
  tenantId  String?                        // tenant — backfilled on first boot
  name      String
  email     String    @unique
  password  String    // bcrypt hash
  pin       String?   // bcrypt hash of PIN
  role      UserRole  @default(kitchen)
  // Concepts this user is allowed to access. Empty array = no concept restriction
  // is applied (intended for admin/manager — role check is the gate). Non-admin
  // roles MUST have explicit concept IDs to access concept-scoped resources.
  conceptIds String[] @default([])
  // Payroll: hourly rate in paisa (PKR cents). Null = unpaid (volunteer/owner).
  hourlyRateCents Int?
  // Wage account this employee's labour posts to: 6030 kitchen / 6031 FOH /
  // 6032 management / 6035 riders. Null = derive from role.
  wageAccountCode String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  shifts                Shift[]
  clockLogs             ClockLog[]
  posOrders             Order[]                @relation("PosStaff")
  poActivityLog         PoActivityLog[]
  receivingDiscrepancies ReceivingDiscrepancy[]
  wasteLogs             WasteLog[]
  payrollLines          PayrollRunLine[]
  tipPoolMemberships    TipPoolMember[]
  scheduledShifts       ScheduledShift[]
  assignedSuppliers     Supplier[]             @relation("SupplierAssignee")
  contentEvents         ContentEvent[]         @relation("EventAssignee")
  createdEvents         ContentEvent[]         @relation("EventCreatedBy")
  supplierConversations SupplierConversation[]
  customerConversations CustomerConversation[] @relation("CustomerConversationStaff")
  tenant                Tenant?                @relation(fields: [tenantId], references: [id])
  // Multi-tenant memberships — a user can own/manage multiple tenants. The
  // `tenantId` above acts as the *active* tenant; this list is the set of
  // tenants they're authorised to switch into.
  tenantMemberships     TenantMember[]

  @@map("users")
}

// ─── Shift ────────────────────────────────────────────────────────────────────

model Shift {
  id                String      @id @default(uuid())
  userId            String
  locationId        String?     // physical place this shift was opened at
  status            ShiftStatus @default(open)
  openedAt          DateTime    @default(now())
  closedAt          DateTime?
  openingFloatCents Int         @default(0)
  closingFloatCents Int?
  notes             String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user     User       @relation(fields: [userId], references: [id])
  location Location?  @relation(fields: [locationId], references: [id])
  payments Payment[]

  @@index([locationId, openedAt(sort: Desc)])
  @@map("shifts")
}

// ─── ClockLog ─────────────────────────────────────────────────────────────────

model ClockLog {
  id         String   @id @default(uuid())
  userId     String
  type       String   // "in" | "out"
  lat        Float?
  lng        Float?
  selfieUrl  String?                                  // captured at clock-in to prevent buddy-punching
  geofenceMatched   Boolean?                          // null = not checked; true = within concept geofence
  geofenceDistanceM Float?                            // metres from concept lat/lng (when checked)
  ipAddress  String?
  recordedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, recordedAt])
  @@map("clock_logs")
}

// ─── Payroll ─────────────────────────────────────────────────────────────────
//
// A payroll run covers a date range (typically a week or month). The
// computation derives hours from ClockLog pairings, multiplies by hourlyRate,
// and posts a single journal entry: Dr Wages (per account code) / Cr Wages
// Payable. Settlement (paying the employee) happens via supplier-payment-style
// entries when the bank transfer goes out.

enum PayrollRunStatus {
  draft       // computed but not posted
  posted      // accrual JE posted; wages payable open
  paid        // payment JE posted; wages payable cleared
}

model PayrollRun {
  id            String           @id @default(uuid())
  periodStart   DateTime
  periodEnd     DateTime
  status        PayrollRunStatus @default(draft)
  totalGrossCents Int            @default(0)
  postedAt      DateTime?
  paidAt        DateTime?
  createdById   String?
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  lines PayrollRunLine[]

  @@index([periodStart(sort: Desc)])
  @@map("payroll_runs")
}

model PayrollRunLine {
  id              String  @id @default(uuid())
  payrollRunId   String
  userId          String
  userName        String
  hoursWorked     Float
  hourlyRateCents Int
  grossCents      Int
  wageAccountCode String      // 6030/6031/6032/6035
  // Optional adjustments (advances, deductions, bonuses) — signed cents
  adjustmentCents Int     @default(0)
  netCents        Int
  notes           String?

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id])

  @@index([payrollRunId])
  @@index([userId])
  @@map("payroll_run_lines")
}

// ─── Customer ─────────────────────────────────────────────────────────────────

model Customer {
  id                String    @id @default(uuid())
  name              String
  email             String?   @unique
  phone             String?   @unique
  marketingOptIn    Boolean   @default(false)
  ntn               String?   // National Tax Number (for FBR invoice BuyerNTN field)
  cnic              String?   // CNIC (for FBR invoice BuyerCNIC field)
  birthdayMmDd      String?   // MM-DD format, e.g. "04-23"
  firstOrderAt      DateTime?
  lastOrderAt       DateTime?
  totalSpentCents   Int       @default(0)
  preferredConceptId String?
  walletBalance     Int       @default(0)

  // ── Referral program ─────────────────────────────────────────────────────
  // Each customer auto-gets a unique 8-char code on registration. New
  // customers can supply someone's code at signup — when their first
  // order completes, BOTH parties get a loyalty bonus (default 200 pts each).
  // referredById and referredAt stay set forever for cohort analytics.
  referralCode              String?   @unique
  referredById              String?
  referredAt                DateTime?
  referralRewardCreditedAt  DateTime?       // null until the dual bonus has fired
  password          String?
  isBlacklisted     Boolean   @default(false)
  blacklistReason   String?

  // ── Cross-module rollups (denormalized on every status change so the host
  //    stand sees the customer's full risk/value picture without joining a
  //    bunch of tables on every render) ─────────────────────────────────
  noShowCount       Int       @default(0)   // lifetime no-show reservations
  complaintCount    Int       @default(0)   // lifetime complaints filed
  reviewCount       Int       @default(0)   // lifetime reviews left (any rating)
  // Naughty list — strikes accumulate from no-show / cash-unpaid / refused-
  // at-door incidents. At 3 active strikes, a CustomerBan row gets created
  // and the customer (plus their email/phone/IP) is locked out of fresh
  // signups + new orders + new reservations.
  strikeCount       Int       @default(0)   // ACTIVE strikes (reversed/expired excluded)
  bannedAt          DateTime?               // null = not banned. Mirror of CustomerBan.bannedAt for fast UI checks.
  avgReviewRating   Float?                  // running average of their ratings
  lastVisitAt       DateTime?               // most recent of (lastOrderAt, last seated reservation)
  lastComplaintAt   DateTime?               // when they last raised an issue (host-relevant context)
  lastReviewedAt    DateTime?               // when they last left a review
  lastNoShowAt      DateTime?               // when they last failed to show
  staffNotes        String?                 // free-form, manager-curated, shown on every host view
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  preferredConcept   Concept?          @relation("PreferredConcept", fields: [preferredConceptId], references: [id])
  orders             Order[]
  loyaltyAccount     LoyaltyAccount?
  magicLinks         MagicLink[]
  triggerLogs        TriggerLog[]
  campaignSends      CampaignSend[]
  walletTransactions WalletTransaction[]
  savedAddresses     CustomerAddress[]
  reservations       Reservation[]
  guestTags          GuestTag[]
  analyticsEvents    AnalyticsEvent[]
  segmentMemberships CustomerSegmentMembership[]
  conversations      CustomerConversation[]
  feedbackEntries    FeedbackEntry[]

  // Referral relation (self-relation: who referred me, who I've referred)
  referredBy   Customer?  @relation("Referrals", fields: [referredById], references: [id])
  referrals    Customer[] @relation("Referrals")

  strikes      CustomerStrike[]
  bans         CustomerBan[]

  @@map("customers")
}

// ─── Naughty list: strikes + bans ───────────────────────────────────────────
//
// Customer accountability layer. Every offense (reservation no-show, COD
// not paid, COD refused at door) records a CustomerStrike. At 3 active
// strikes (not expired, not reversed), the system promotes the customer to
// a CustomerBan that locks out their email + phone + every IP we've seen.
// New signups + reservations + guest orders that match an active ban are
// rejected with a friendly error.
//
// Strikes auto-expire after 365 days (running tab — yesterday's no-show
// shouldn't haunt them forever). A manager can also REVERSE a strike if
// it was on them (kitchen mistake, address bug, etc.) — preserves data
// integrity but doesn't count toward the 3-strike threshold.

model CustomerStrike {
  id          String   @id @default(uuid())
  customerId  String
  // Discriminated kind — extensible. Add new strike types here as patterns emerge.
  kind        String   // 'reservation_no_show' | 'cod_unpaid' | 'cod_refused' | 'chargeback' | 'other'
  // Source row. Order id for COD strikes, Reservation id for no-shows.
  sourceType  String?  // 'reservation' | 'order'
  sourceId    String?
  // Severity defaults to 1; high-value incidents (>PKR 5k refused) can bump to 2 so 2 incidents trigger ban.
  severity    Int      @default(1)
  reason      String?  // operator-supplied note ("driver said customer was very rude, refused to come down")
  // Strikes naturally decay after a year. expiresAt is set at insert time.
  expiresAt   DateTime?
  // Manager can forgive a strike. recordedAt + reversedAt define the audit window.
  reversedAt     DateTime?
  reversedById   String?
  reversalReason String?
  recordedById   String?  // staff user id (or null = system)
  recordedAt     DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, recordedAt])
  @@index([kind, recordedAt])
  @@map("customer_strikes")
}

model CustomerBan {
  id          String   @id @default(uuid())
  customerId  String?            // the original offender. Null only for synthetic bans (e.g. operator-added watchlist entries).

  // Identifier fingerprints captured at offense time. New signups / orders
  // are checked against ALL of these. Phone + email are hard rejects;
  // IP is a soft signal recorded for forensic correlation only (cafe / family
  // shared-IP false-positive risk is too high for a hard block).
  email              String?
  phone              String?
  ipAddresses        String[]  @default([])
  deviceFingerprints String[]  @default([])

  reason       String                       // free-form: "3 strikes — see strikes table"
  bannedById   String?                      // null = auto-promoted by system at 3-strike threshold
  bannedAt     DateTime @default(now())
  // Bans are permanent by default. Operators can lift via /crm/bans/:id/lift.
  liftedAt     DateTime?
  liftedById   String?
  liftReason   String?
  // Optional TTL — null = permanent. Lets operator set "1-year cooldown" if they want.
  expiresAt    DateTime?

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([phone])
  @@index([bannedAt])
  @@index([liftedAt])
  @@map("customer_bans")
}

// ─── CRM outreach: customer chat threads ──────────────────────────────────────
// Mirrors SupplierConversation/SupplierMessage. Used when staff reach out to
// a customer about a complaint, review, or just-because — and any reply
// (email, WhatsApp) lands back in the same thread.
//
// `source` records why the thread exists: "complaint" / "review" / "manual"
// for retroactive linkage in the UI ("This thread is about complaint #1234").
// `sourceRefId` is a loose reference (no FK constraint — keeps schema flat
// and avoids cascade headaches when a complaint gets archived).

model CustomerConversation {
  id          String   @id @default(cuid())
  customerId  String
  staffId     String   // who initiated the outreach
  subject     String?
  source      String   @default("manual")  // "complaint" | "review" | "manual"
  sourceRefId String?  // id of the complaint/review row this thread relates to
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  staff    User              @relation("CustomerConversationStaff", fields: [staffId], references: [id])
  messages CustomerMessage[]

  @@index([customerId, updatedAt])
  @@index([staffId])
  @@index([source, sourceRefId])
  @@map("customer_conversations")
}

model CustomerMessage {
  id             String   @id @default(cuid())
  conversationId String
  fromStaff      Boolean
  senderId       String?
  body           String
  mediaUrl       String?
  seenAt         DateTime?
  createdAt      DateTime @default(now())

  // Channel of origin — same enum-as-string as SupplierMessage.channel.
  channel        String   @default("web_portal")
  externalMessageId  String?  @unique
  inboundFromAddress String?

  conversation CustomerConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("customer_messages")
}

model CustomerAddress {
  id           String   @id @default(uuid())
  customerId   String
  label        String   // e.g. "Home", "Work", "Padel Court"
  address      String
  lat          Float?
  lng          Float?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())

  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_addresses")
}

model TriggerLog {
  id          String   @id @default(uuid())
  customerId  String
  triggerType String   // birthday | winback
  createdAt   DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId, triggerType, createdAt])
  @@map("trigger_logs")
}

// ─── Loyalty tier configuration ────────────────────────────────────────────
//
// One row per tier (bronze / silver / gold). Operator-tunable from admin
// /configuration/tier-perks. Perks are checked at:
//   - Order checkout: free delivery + minimum order
//   - Reservation creation: extended-advance booking window
//   - Birthday trigger: enhanced discount instead of default 25%
//   - Storefront /account: rendered as "perks unlocked" list
//
// Sensible defaults are seeded on first read so the system works
// out-of-the-box without any admin intervention.
model TierConfig {
  id                       String   @id @default(uuid())
  tier                     String   @unique  // 'bronze' | 'silver' | 'gold'

  // Delivery perks
  alwaysFreeDelivery       Boolean  @default(false)
  freeDeliveryAboveCents   Int?              // free delivery for orders >= this

  // Birthday perks (override the default 25% off in the birthday trigger)
  birthdayDiscountPct      Int?              // null = use default

  // Reservation perks
  priorityReservationDays  Int?              // can book N days ahead beyond ReservationPolicy.maxAdvanceDays
  waitlistPriority         Boolean  @default(false)  // promoter loop offers them slots first

  // Monthly comp credit (auto-credited as wallet balance on the 1st)
  monthlyCompCents         Int?

  // Misc flags
  earlyMenuAccess          Boolean  @default(false)
  freeBirthdayItem         Boolean  @default(false)

  description              String?           // operator-facing rationale
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@map("tier_configs")
}

// ─── Customer feedback (NPS / one-question surveys) ────────────────────────
//
// Distinct from OrderReview (rating tied to a specific order) and
// OrderComplaint (formal grievance with a status workflow). FeedbackEntry
// is for one-tap NPS/CSAT signals: "would you recommend us?", "how was your
// most recent experience?". Submitted via a global widget on the storefront.
//
// kind:
//   nps        — "How likely are you to recommend us?" 0..10 score
//   csat       — "How was your most recent experience?" 1..5 score
//   open       — anonymous freeform suggestion box ("got an idea?")
model FeedbackEntry {
  id          String   @id @default(uuid())
  customerId  String?
  conceptId   String?               // null = brand-agnostic / servd-wide feedback
  kind        String                // 'nps' | 'csat' | 'open'
  score       Int?                  // 0..10 for nps, 1..5 for csat, null for open
  comment     String?
  context     Json?                 // { page, orderId, reservationId, etc. } — set by client
  source      String   @default("storefront")
  createdAt   DateTime @default(now())

  customer Customer? @relation(fields: [customerId], references: [id])
  concept  Concept?  @relation(fields: [conceptId], references: [id])

  @@index([conceptId, createdAt])
  @@index([customerId, createdAt])
  @@map("feedback_entries")
}

// ─── MagicLink ────────────────────────────────────────────────────────────────

model MagicLink {
  id         String   @id @default(uuid())
  customerId String
  token      String   @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])

  @@map("magic_links")
}

// ─── LoyaltyAccount ───────────────────────────────────────────────────────────

model LoyaltyAccount {
  id             String   @id @default(uuid())
  customerId     String   @unique
  pointsBalance  Int      @default(0)
  lifetimePoints Int      @default(0)
  tier           String   @default("bronze") // bronze|silver|gold
  stampCounts    Json     @default("{}") // { "simmer": 3, "stax": 7 }
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  customer     Customer           @relation(fields: [customerId], references: [id])
  transactions LoyaltyTransaction[]

  @@map("loyalty_accounts")
}

// ─── LoyaltyTransaction ───────────────────────────────────────────────────────

model LoyaltyTransaction {
  id               String        @id @default(uuid())
  loyaltyAccountId String
  orderId          String?
  type             LoyaltyTxType
  pointsDelta      Int
  description      String?
  createdAt        DateTime      @default(now())

  loyaltyAccount LoyaltyAccount @relation(fields: [loyaltyAccountId], references: [id])
  order          Order?         @relation(fields: [orderId], references: [id])

  @@map("loyalty_transactions")
}

// ─── Order ────────────────────────────────────────────────────────────────────

model Order {
  id              String      @id @default(uuid())
  conceptId       String
  locationId      String?     // physical place; nullable so existing rows still work — auto-set from Shift / cashier session
  source          OrderSource
  externalId      String?     // platform-assigned ID; null for native orders
  status          OrderStatus @default(received)
  tableId         String?
  customerId      String?
  customerName    String?     // raw name for non-direct orders
  posStaffId      String?     // staff who created it (POS)
  shiftId         String?     // associated shift (POS cash orders)
  riderId              String?
  promoCodeId          String?
  totalCents           Int
  discountCents        Int         @default(0)
  promoDiscountCents   Int         @default(0)
  walletAmountCents    Int         @default(0)
  taxCents             Int         @default(0)
  // Service charge: house-imposed % on subtotal, recognised as revenue (4100).
  serviceChargeCents   Int         @default(0)
  // Tips: customer-discretionary, paid through to staff. Liability (2090
  // accrued / 6031 settled at payroll) — not house revenue.
  tipCents             Int         @default(0)
  deliveryNotes        String?
  estimatedPickup      DateTime?
  scheduledFor         DateTime?
  isPreOrder           Boolean     @default(false)
  // Rider hand-off OTP — 4-digit code shown to customer on the storefront.
  // Rider must enter this on dispatch to mark the order delivered. Prevents
  // riders from claiming "delivered" without proof. Set on order placement
  // for delivery orders; verified at dispatch.
  deliveryOtp           String?
  deliveryOtpVerifiedAt DateTime?
  deliveryOtpAttempts   Int         @default(0)
  placedAt             DateTime    @default(now())
  completedAt          DateTime?

  // Post-order review prompt timestamps. Worker sends a "rate your meal"
  // SMS+email 30 min after completion if the guest hasn't already reviewed.
  // The flag prevents double-prompts.
  reviewPromptSentAt   DateTime?

  // ── Curbside / car-hopping fulfilment ────────────────────────────────
  // When the customer chooses curbside at checkout, they're prompted for
  // their vehicle description (and optionally plate). On arrival, they hit
  // POST /storefront/orders/:id/arrived which stamps `curbsideArrivedAt`.
  // The admin /orders/curbside queue lights up — staff runs food out.
  // Presence of `curbsideVehicle` is the canonical "this is a curbside
  // order" signal; nothing here clashes with delivery/pickup/dine-in.
  curbsideVehicle      String?
  curbsidePlate        String?
  curbsideSpot         String?     // optional designated spot ("A3", "Front 2")
  curbsideArrivedAt    DateTime?
  curbsideRunnerOutAt  DateTime?   // when staff hit "running it out"

  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  deletedAt            DateTime?

  // FBR PRAL invoice number returned by PRAL after successful submission.
  // Null until the FBR worker processes the order (fire-and-forget).
  fbrInvoiceNumber String?

  // raw platform payload stored for audit/debug
  rawPayload      Json?

  concept     Concept    @relation(fields: [conceptId], references: [id])
  location    Location?  @relation(fields: [locationId], references: [id])
  table       Table?     @relation(fields: [tableId], references: [id])
  customer    Customer?  @relation(fields: [customerId], references: [id])
  posStaff    User?      @relation("PosStaff", fields: [posStaffId], references: [id])
  rider       Rider?     @relation(fields: [riderId], references: [id])
  promoCode   PromoCode? @relation(fields: [promoCodeId], references: [id])
  items       OrderItem[]
  payments    Payment[]
  loyaltyTxs          LoyaltyTransaction[]
  giftCardRedemptions GiftCardRedemption[]
  financialEntries    FinancialEntry[]
  taxInvoices         TaxInvoice[]
  review              OrderReview?
  complaints          OrderComplaint[]
  promoUsages         PromoCodeUsage[]

  @@unique([source, externalId])
  @@index([conceptId, placedAt(sort: Desc)])
  @@index([locationId, placedAt(sort: Desc)])
  @@index([status, placedAt(sort: Desc)])
  @@index([customerId])
  @@index([shiftId])
  @@index([placedAt(sort: Desc)])
  @@map("orders")
}

// ─── OrderItem ────────────────────────────────────────────────────────────────

model OrderItem {
  id             String     @id @default(uuid())
  orderId        String
  menuItemId     String?    // null if unmapped platform item
  stationId      String?
  externalItemId String?
  name           String     // raw item name (preserved from source)
  quantity       Int        @default(1)
  unitPriceCents Int
  status         ItemStatus @default(pending)
  notes          String?
  course         Int?       // course number for sequencing
  firedAt        DateTime?
  completedAt    DateTime?
  voidedAt       DateTime?
  voidReason     String?
  scheduledFireAt DateTime? // course pacing: when this item should auto-fire
  bumpPhotoUrl    String?   // R2 URL of plating photo captured at bump
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  order     Order               @relation(fields: [orderId], references: [id])
  menuItem  MenuItem?           @relation(fields: [menuItemId], references: [id])
  station   Station?            @relation(fields: [stationId], references: [id])
  modifiers OrderItemModifier[]

  @@index([orderId])
  @@index([stationId, status])
  @@map("order_items")
}

// ─── OrderItemModifier ────────────────────────────────────────────────────────

model OrderItemModifier {
  id             String @id @default(uuid())
  orderItemId    String
  modifierId     String?
  name           String // raw name
  priceDeltaCents Int   @default(0)

  orderItem  OrderItem @relation(fields: [orderItemId], references: [id])
  modifier   Modifier? @relation(fields: [modifierId], references: [id])

  @@map("order_item_modifiers")
}

// ─── Payment ──────────────────────────────────────────────────────────────────

model Payment {
  id           String         @id @default(uuid())
  orderId      String
  shiftId      String?
  method       PaymentMethod
  amountCents  Int
  status       PaymentStatus  @default(pending)
  gateway      PaymentGateway @default(none)
  gatewayRef   String?        // gateway transaction ID
  gatewayMeta  Json?          // raw gateway response
  tenderedCents Int?          // for cash: amount given
  changeCents   Int?          // for cash: change returned
  // Check-splitting: when one bill is split across multiple diners, each
  // diner has their own Payment row pointing at the same orderId. The split
  // group is an integer (1, 2, 3, …) with an optional label; total of all
  // splits must equal order total.
  splitGroup   Int?           // 1-based; null = single payment for whole bill
  splitLabel   String?        // e.g. "Ali", "Sara", or "Half 1"
  processedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  order Order  @relation(fields: [orderId], references: [id])
  shift Shift? @relation(fields: [shiftId], references: [id])

  @@index([orderId])
  @@index([shiftId, status])
  @@index([gatewayRef])
  @@map("payments")
}

// ─── Tip pool ────────────────────────────────────────────────────────────────
//
// A pool covers a date range (typically a shift or a service period). Tips
// collected from orders during the period (Order.tipCents → posted to the
// 2095 Tips Payable liability) are distributed to staff present in the pool
// according to their configured share weight × hours worked.
//
// On payout, the pool posts: Dr 2095 Tips Payable / Cr cash or bank.

enum TipPoolStatus {
  draft
  posted   // distribution committed, lines locked
  paid     // funds disbursed to staff
}

model TipPool {
  id          String        @id @default(uuid())
  conceptId   String?       // null = pool spans all concepts (single operator)
  name        String        // e.g. "Sat dinner shift", "Week of Apr 28"
  periodStart DateTime
  periodEnd   DateTime
  totalTipsCents Int        @default(0)
  status      TipPoolStatus @default(draft)
  postedAt    DateTime?
  paidAt      DateTime?
  createdById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  members TipPoolMember[]

  @@index([periodStart(sort: Desc)])
  @@map("tip_pools")
}

model TipPoolMember {
  id              String  @id @default(uuid())
  poolId          String
  userId          String
  userName        String  // snapshot — survives if user is later deleted
  // Computed: hoursWorked × roleWeight = shareUnits. Operator can override
  // shareUnits manually before posting (e.g. for tipout to BOH).
  hoursWorked     Float
  roleWeight      Float   @default(1.0)
  shareUnits      Float
  shareCents      Int     @default(0)   // computed share — set when pool is posted
  notes           String?

  pool TipPool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  user User   @relation(fields: [userId], references: [id])

  @@unique([poolId, userId])
  @@index([userId])
  @@map("tip_pool_members")
}

// ─── Group orders (shared cart) ──────────────────────────────────────────────
//
// One initiator creates a group order at a brand. Friends join via a share
// link, each adds items as themselves. Initiator (or any member) closes the
// cart and submits as one Order. Each member's contribution is preserved in
// the order's items via an inviteCode label.

enum GroupOrderStatus {
  open
  locked     // closed for new items, awaiting checkout
  submitted  // turned into a real Order
  cancelled
}

model GroupOrder {
  id          String           @id @default(uuid())
  conceptId   String
  initiatorCustomerId String?
  initiatorName String           // free-text in case initiator isn't a customer yet
  shareCode   String           @unique  // 6-char shareable
  status      GroupOrderStatus @default(open)
  closingAt   DateTime?        // soft deadline shown to participants
  orderId     String?          // set when submitted
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  concept Concept            @relation(fields: [conceptId], references: [id])
  members GroupOrderMember[]
  items   GroupOrderItem[]

  @@index([shareCode])
  @@map("group_orders")
}

model GroupOrderMember {
  id           String   @id @default(uuid())
  groupOrderId String
  customerId   String?
  displayName  String
  joinedAt     DateTime @default(now())

  groupOrder GroupOrder @relation(fields: [groupOrderId], references: [id], onDelete: Cascade)
  items      GroupOrderItem[]

  @@unique([groupOrderId, displayName])
  @@map("group_order_members")
}

model GroupOrderItem {
  id           String  @id @default(uuid())
  groupOrderId String
  memberId     String
  menuItemId   String
  name         String  // snapshot
  quantity     Int     @default(1)
  unitPriceCents Int
  notes        String?
  createdAt    DateTime @default(now())

  groupOrder GroupOrder       @relation(fields: [groupOrderId], references: [id], onDelete: Cascade)
  member     GroupOrderMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([groupOrderId])
  @@map("group_order_items")
}

// ─── InventoryItem ────────────────────────────────────────────────────────────

model InventoryItem {
  id              String    @id @default(uuid())
  name            String
  unit            String    // e.g. "kg", "pcs", "litres"
  parLevel        Float     @default(0)
  currentStock    Float     @default(0)
  unitCostCents   Int?      // cost per unit (paisa) — updated on each PO receipt
  supplierId      String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  supplier           Supplier?           @relation(fields: [supplierId], references: [id])
  recipeIngredients  RecipeIngredient[]
  purchaseOrderLines PurchaseOrderLine[]
  priceHistory       ItemPriceHistory[]
  billLines          SupplierBillLine[]
  wasteLogs          WasteLog[]
  components         Component[]
  stockTransfers     StockTransfer[]

  @@map("inventory_items")
}

// ─── WasteLog ─────────────────────────────────────────────────────────────────

model WasteLog {
  id                 String   @id @default(uuid())
  inventoryItemId    String
  quantity           Float
  unit               String
  reason             String   // spoilage | over_prep | expired | damaged | other
  estimatedCostCents Int?
  photoUrl           String?                              // required when waste cost > photoRequiredAboveCents (OperationsConfig)
  approvedById       String?                              // supervisor who approved (PIN-verified)
  notes              String?
  recordedById       String?
  recordedAt         DateTime @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  recordedBy    User?         @relation(fields: [recordedById], references: [id])

  @@index([inventoryItemId, recordedAt(sort: Desc)])
  @@index([recordedAt(sort: Desc)])
  @@map("waste_logs")
}

// ─── Supplier ─────────────────────────────────────────────────────────────────

model Supplier {
  id                  String    @id @default(uuid())
  name                String
  category            String?   // meat, fish, farm, dairy, dry-goods, etc.
  assignedStaffId     String?   // procurement person responsible
  phone               String?
  email               String?
  // Separate from `phone`: many suppliers use a different number for WhatsApp
  // (personal vs. business line). Stored E.164 digits (e.g. "923001234567",
  // no leading + or spaces) so it matches the format Meta sends in the
  // WhatsApp Cloud API webhook `from` field exactly.
  whatsappPhone       String?
  address             String?
  taxId               String?   // NTN / STRN
  notes               String?
  paymentTermsDays    Int       @default(30)
  leadTimeDays        Int?
  openingBalanceCents Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  assignedStaff  User?                  @relation("SupplierAssignee", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  inventoryItems InventoryItem[]
  purchaseOrders PurchaseOrder[]
  bills          SupplierBill[]
  payments       SupplierPayment[]
  priceHistory   ItemPriceHistory[]
  conversations  SupplierConversation[]
  portalTokens   SupplierPortalToken[]

  @@index([whatsappPhone])
  @@index([email])
  @@map("suppliers")
}

// ─── Recipe costing ───────────────────────────────────────────────────────────

model Recipe {
  id            String    @id @default(uuid())
  menuItemId    String    @unique
  servings      Int       @default(1) // portions per batch
  portionSizeG  Float?                // grams per portion (display reference)
  laborMinutes  Int       @default(0)
  notes         String?
  steps         String?   // cooking/assembly steps for kitchen staff (KDS)
  stepsUrdu     String?   @map("steps_urdu")

  // Seasonality. `seasons` is an array of slugs from the curated set:
  // 'spring' | 'summer' | 'monsoon' | 'autumn' | 'winter' | 'ramadan' | 'year-round'
  // Empty array = "year-round" (treated as always available). Use this to
  // filter the recipe library + auto-toggle menu item availability when the
  // current season changes.
  seasons       String[]  @default([])

  // Optional explicit window for menu items that come back at the same time
  // each year (e.g. mango lassi: Apr 1 – Sep 30). Stored as MM-DD strings so
  // the rule applies every year regardless of date.
  seasonStart   String?   // 'MM-DD' inclusive, null = no window
  seasonEnd     String?   // 'MM-DD' inclusive, null = no window

  // Active/featured flags for menu engineering — independent of season
  isActive      Boolean   @default(true)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  menuItem    MenuItem           @relation(fields: [menuItemId], references: [id])
  ingredients RecipeIngredient[]

  @@index([isActive])
  @@map("recipes")
}

model RecipeIngredient {
  id              String  @id @default(uuid())
  recipeId        String
  inventoryItemId String
  quantity        Float   // usable recipe quantity (post-yield) in `unit`
  yieldPct        Float   @default(1.0) // 0.01–1.0, e.g. 0.75 = 75% yield
  unit            String  // unit label for display
  notes           String?

  recipe        Recipe        @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@map("recipe_ingredients")
}

// ─── Purchase Orders ──────────────────────────────────────────────────────────

model PurchaseOrder {
  id              String    @id @default(uuid())
  supplierId      String
  status          String    @default("draft") // draft | pending_approval | sent | received | partial | cancelled
  orderDate       DateTime  @default(now())
  expectedDate    DateTime?
  receivedDate    DateTime?
  reference       String?   // supplier invoice / PO number
  notes           String?
  totalCents      Int       @default(0)

  // Audit / lifecycle
  createdBy       String?
  approvedById    String?
  approvedAt      DateTime?
  rejectedReason  String?
  sentAt          DateTime?
  sentToEmail     String?
  cancelledById   String?
  cancelledAt     DateTime?
  cancelReason    String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  supplier     Supplier              @relation(fields: [supplierId], references: [id])
  lines        PurchaseOrderLine[]
  bills        SupplierBill[]
  activityLog  PoActivityLog[]

  @@index([supplierId, status])
  @@index([status, orderDate(sort: Desc)])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id              String  @id @default(uuid())
  purchaseOrderId String
  inventoryItemId String
  quantityOrdered Float
  quantityReceived Float  @default(0)
  unitCostCents   Int     // agreed cost per unit (paisa)
  notes           String?

  purchaseOrder      PurchaseOrder            @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  inventoryItem      InventoryItem            @relation(fields: [inventoryItemId], references: [id])
  billLines          SupplierBillLine[]
  discrepancies      ReceivingDiscrepancy[]
  priceHistoryEntries ItemPriceHistory[]

  @@index([purchaseOrderId])
  @@index([inventoryItemId])
  @@map("purchase_order_lines")
}

// ─── PO Activity Log (audit trail) ────────────────────────────────────────────

model PoActivityLog {
  id              String   @id @default(uuid())
  purchaseOrderId String
  userId          String?
  action          String   // created | line_added | submitted | approved | rejected | sent | received | cancelled | edited
  details         Json?
  createdAt       DateTime @default(now())

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  user          User?         @relation(fields: [userId], references: [id])

  @@index([purchaseOrderId, createdAt])
  @@map("po_activity_log")
}

// ─── Receiving Discrepancy (variance log) ─────────────────────────────────────

model ReceivingDiscrepancy {
  id           String   @id @default(uuid())
  poLineId     String
  expectedQty  Float
  receivedQty  Float
  reason       String   // short_shipment | over_shipment | damaged | wrong_item | quality_issue
  notes        String?
  recordedById String?
  recordedAt   DateTime @default(now())

  poLine     PurchaseOrderLine @relation(fields: [poLineId], references: [id], onDelete: Cascade)
  recordedBy User?             @relation(fields: [recordedById], references: [id])

  @@index([poLineId])
  @@map("receiving_discrepancies")
}

// ─── Item Price History ───────────────────────────────────────────────────────

model ItemPriceHistory {
  id              String   @id @default(uuid())
  inventoryItemId String
  supplierId      String?
  oldCostCents    Int?
  newCostCents    Int
  source          String   // po_receive | manual_adjust | bill_match
  poLineId        String?
  recordedAt      DateTime @default(now())

  inventoryItem InventoryItem      @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  supplier      Supplier?          @relation(fields: [supplierId], references: [id])
  poLine        PurchaseOrderLine? @relation(fields: [poLineId], references: [id], onDelete: SetNull)

  @@index([inventoryItemId, recordedAt(sort: Desc)])
  @@index([supplierId, recordedAt(sort: Desc)])
  @@map("item_price_history")
}

// ─── Supplier Bills (Accounts Payable) ────────────────────────────────────────

model SupplierBill {
  id            String    @id @default(uuid())
  supplierId    String
  poId          String?   // optional link to a PO for 3-way match
  billNumber    String    // supplier's invoice/bill number
  billDate      DateTime
  dueDate       DateTime
  status        String    @default("open") // draft | open | partially_paid | paid | void
  subtotalCents Int       @default(0)
  taxCents      Int       @default(0)
  totalCents    Int       @default(0)
  paidCents     Int       @default(0)       // running total of payments applied
  notes         String?
  attachmentUrl String?                     // S3/R2 link to scanned bill
  createdBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  voidedAt      DateTime?
  voidReason    String?

  supplier     Supplier                       @relation(fields: [supplierId], references: [id])
  po           PurchaseOrder?                 @relation(fields: [poId], references: [id])
  lines        SupplierBillLine[]
  applications SupplierPaymentApplication[]

  @@unique([supplierId, billNumber])
  @@index([supplierId, status])
  @@index([dueDate, status])
  @@map("supplier_bills")
}

model SupplierBillLine {
  id              String  @id @default(uuid())
  billId          String
  inventoryItemId String?
  poLineId        String? // 3-way match link
  description     String
  quantity        Float
  unitCostCents   Int
  lineTotalCents  Int

  bill          SupplierBill       @relation(fields: [billId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem?     @relation(fields: [inventoryItemId], references: [id])
  poLine        PurchaseOrderLine? @relation(fields: [poLineId], references: [id], onDelete: SetNull)

  @@index([billId])
  @@map("supplier_bill_lines")
}

// ─── Supplier Payments + multi-bill applications ──────────────────────────────

model SupplierPayment {
  id           String   @id @default(uuid())
  supplierId   String
  paymentDate  DateTime @default(now())
  method       String   // cash | bank_transfer | cheque | wallet
  reference    String?  // cheque #, bank ref
  amountCents  Int
  appliedCents Int      @default(0) // sum of applications
  notes        String?
  createdBy    String?
  createdAt    DateTime @default(now())

  supplier     Supplier                     @relation(fields: [supplierId], references: [id])
  applications SupplierPaymentApplication[]

  @@index([supplierId, paymentDate(sort: Desc)])
  @@map("supplier_payments")
}

model SupplierPaymentApplication {
  id                String  @id @default(uuid())
  paymentId         String
  billId            String
  amountAppliedCents Int
  createdAt         DateTime @default(now())

  payment SupplierPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  bill    SupplierBill    @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@unique([paymentId, billId])
  @@index([billId])
  @@map("supplier_payment_applications")
}

// ─── Financial / Accounting ───────────────────────────────────────────────────

model Account {
  id          String      @id @default(uuid())
  code        String      @unique // e.g. "4001"
  name        String      // e.g. "Restaurant Revenue"
  type        AccountType
  description String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  journalLines JournalLine[]

  @@map("accounts")
}

model JournalEntry {
  id          String   @id @default(uuid())
  reference   String?  // e.g. order ID, shift ID
  description String
  entryDate   DateTime @default(now())
  postedBy    String?  // user ID or "system"
  createdAt   DateTime @default(now())

  lines JournalLine[]

  @@map("journal_entries")
}

model JournalLine {
  id             String           @id @default(uuid())
  journalEntryId String
  accountId      String
  type           JournalEntryType
  amountCents    Int
  memo           String?

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id])
  account      Account      @relation(fields: [accountId], references: [id])

  @@map("journal_lines")
}

// ─── Reconciliation ──────────────────────────────────────────────────────────
//
// Imported bank/payment-gateway statements that the operator reconciles
// against the ledger. Each line is either matched to a journal line OR posts
// an adjustment when there's no internal record. Settlement reconciliation
// (Foodpanda payouts vs expected commission) uses the same model.

model BankStatementImport {
  id             String   @id @default(uuid())
  source         String   // "bank:hbl", "foodpanda", "keenu", …
  accountCode    String   // CoA code the statement is reconciling against (e.g. 1020 Bank)
  statementDate  DateTime
  openingBalanceCents Int @default(0)
  closingBalanceCents Int @default(0)
  filename       String?
  importedById   String?
  importedAt     DateTime @default(now())

  lines BankStatementLine[]

  @@index([source, statementDate(sort: Desc)])
  @@map("bank_statement_imports")
}

model BankStatementLine {
  id             String   @id @default(uuid())
  importId       String
  postedDate     DateTime
  description    String
  reference      String?
  amountCents    Int      // signed: + = credit to bank, − = debit
  matchStatus    String   @default("unmatched") // unmatched | matched | adjusted | ignored
  matchedJournalLineId String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  import BankStatementImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId, matchStatus])
  @@index([postedDate(sort: Desc)])
  @@map("bank_statement_lines")
}

// Foodpanda payout reconciliation. One row per settlement received from
// Foodpanda; we compute expected (sum of order net) vs actual (Foodpanda's
// payout) and flag the variance for investigation.
model FoodpandaSettlement {
  id                 String   @id @default(uuid())
  settlementDate     DateTime
  reference          String?  // Foodpanda's settlement ID
  expectedAmountCents Int     // computed: sum of (order total - commission) for orders in period
  actualAmountCents  Int      // what Foodpanda actually paid
  varianceCents      Int      @default(0)
  status             String   @default("open") // open | reconciled | written_off
  notes              String?
  recordedById       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([settlementDate(sort: Desc)])
  @@map("foodpanda_settlements")
}

// ─── Cost allocation ─────────────────────────────────────────────────────────
//
// A shared OpEx account (rent, electricity, etc.) is split across concepts by
// a configurable driver. v1 supports static percentage and revenue-share. The
// allocation runs at period end: it credits the source account and debits a
// per-concept "allocated rent / electricity / …" account that the BS/PL views
// surface inline.

enum AllocationDriver {
  fixed_pct      // weights stored on each rule line
  revenue_share  // computed at run time from per-concept revenue in the period
}

model CostAllocationRule {
  id              String           @id @default(uuid())
  name            String           // operator-friendly label ("Q4 rent split")
  sourceAccountCode String         // 6010, 6020, 6021, …
  driver          AllocationDriver
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  weights AllocationRuleWeight[]
  runs    CostAllocationRun[]

  @@unique([sourceAccountCode])
  @@map("cost_allocation_rules")
}

model AllocationRuleWeight {
  id           String  @id @default(uuid())
  ruleId       String
  conceptId    String
  // For fixed_pct: 0–10000 (basis points, sums to 10000 across rule). For
  // revenue_share: ignored at compute time but the row is required to enumerate
  // which concepts participate (use 0 to opt a concept out).
  weightBps    Int
  // The destination account code for THIS concept (e.g. 6010 may post to per-
  // concept "Rent — Stax", "Rent — Simmer" if you want sub-accounts; or all to
  // 6010 with concept memo). Null = post back to source account with concept
  // tag in memo only.
  targetAccountCode String?

  rule    CostAllocationRule @relation(fields: [ruleId],    references: [id], onDelete: Cascade)
  concept Concept            @relation(fields: [conceptId], references: [id])

  @@unique([ruleId, conceptId])
  @@map("allocation_rule_weights")
}

model CostAllocationRun {
  id            String   @id @default(uuid())
  ruleId        String
  periodStart   DateTime
  periodEnd     DateTime
  totalAmountCents Int
  postedAt      DateTime  @default(now())
  postedById    String?

  rule CostAllocationRule @relation(fields: [ruleId], references: [id])

  @@index([ruleId, periodStart(sort: Desc)])
  @@map("cost_allocation_runs")
}

// ─── Tax invoices (FBR-compliant) ────────────────────────────────────────────
//
// Issued against an Order at fulfilment. Sequential per concept (the prefix
// + zero-padded counter). Once issued, immutable — corrections post a credit
// note (negative invoice).

enum InvoiceType {
  invoice
  credit_note
}

model TaxInvoice {
  id             String      @id @default(uuid())
  invoiceNumber  String      @unique  // e.g. "STX-2026-0001"
  type           InvoiceType @default(invoice)
  orderId        String
  conceptId      String
  issuedAt       DateTime    @default(now())

  // Snapshotted seller details at issue time
  sellerLegalName String
  sellerStrn      String?
  sellerNtn       String?
  sellerAddress   String?

  // Optional buyer details — only populated when known
  buyerName       String?
  buyerStrn       String?
  buyerNtn        String?
  buyerAddress    String?

  // Money fields snapshotted (cents) — these never change after issue
  subtotalCents      Int
  discountCents      Int       @default(0)
  taxableValueCents  Int
  fbrTaxCents        Int       @default(0)   // 17% federal GST on goods
  provincialTaxCents Int       @default(0)   // PRA/SRB/KPRA/BRA on services
  serviceChargeCents Int       @default(0)
  tipCents           Int       @default(0)
  totalCents         Int

  // Reference to the original invoice when this is a credit note
  originalInvoiceId String?

  pdfUrl String?       // optional: where the rendered PDF lives in S3

  order   Order   @relation(fields: [orderId], references: [id])
  lines   TaxInvoiceLine[]
  original TaxInvoice? @relation("InvoiceCorrections", fields: [originalInvoiceId], references: [id])
  corrections TaxInvoice[] @relation("InvoiceCorrections")

  @@index([conceptId, issuedAt(sort: Desc)])
  @@index([orderId])
  @@map("tax_invoices")
}

model TaxInvoiceLine {
  id              String  @id @default(uuid())
  invoiceId       String
  description     String
  quantity        Float
  unitPriceCents  Int
  lineTotalCents  Int

  invoice TaxInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("tax_invoice_lines")
}

// Per-concept invoice counter to guarantee gap-free sequential numbers — FBR
// requires this. Use a transaction with SELECT ... FOR UPDATE to allocate.
model InvoiceCounter {
  conceptId String   @id
  year      Int
  nextValue Int

  @@map("invoice_counters")
}

// ─── SiteLayout — page builder for storefront pages ─────────────────────────
//
// One row per page slug (e.g. "servd:home", "brand:simmer", "brand:stax").
// `blocks` is an ordered array of typed Block records consumed by the
// storefront's PageRenderer. Operator edits via the dashboard /content
// editor; storefront falls back to hard-coded defaults if no row exists.

model SiteLayout {
  id          String   @id @default(uuid())
  slug        String   @unique  // "servd:home" | "brand:<conceptSlug>" | "brand:<slug>:about" etc.
  title       String?  // operator-facing label, e.g. "Simmer — home"
  blocks      Json     // Block[] — array of typed block configs
  updatedById String?
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@map("site_layouts")
}

// ─── Audit log ───────────────────────────────────────────────────────────────
//
// Append-only record of high-stakes mutations: period close, account changes,
// wage-rate updates, allocation rule changes, manual journal entries. The point
// is forensic — when something looks wrong six months later, who did what when.

model AuditLog {
  id        String   @id @default(uuid())
  action    String   // dotted-path verb: "period.close", "account.create", "wage.update", …
  entity    String   // e.g. "User", "Account", "PeriodLock", "PayrollRun"
  entityId  String?  // primary key of the touched row, when applicable
  userId    String?  // who did it; null for system events
  userEmail String?  // denormalised so deleted users still have attribution
  before    Json?    // previous-state snapshot (for updates/deletes)
  after     Json?    // new-state snapshot (for creates/updates)
  metadata  Json?    // extra context (IP, reason, etc.)
  createdAt DateTime @default(now())

  @@index([action, createdAt(sort: Desc)])
  @@index([entity, entityId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

// Books-closed lock. There is at most one active row; new lock dates only move
// FORWARD. Any postJournalEntry with entryDate <= lockedThrough is rejected.
// Reversing entries posted *after* lock date for an event before it ARE allowed
// (they post in the open period with their own date), preserving auditability.
model PeriodLock {
  id             String   @id @default(uuid())
  lockedThrough  DateTime // inclusive — books are closed up to and including this date
  lockedBy       String   // user ID
  lockedAt       DateTime @default(now())
  note           String?

  @@map("period_locks")
}

// Denormalised summary row per completed order (for fast reporting)
model FinancialEntry {
  id              String    @id @default(uuid())
  orderId         String
  conceptId       String
  locationId      String?   // physical place — copied from Order at posting time
  channel         String    // order source as string
  grossCents      Int
  commissionCents Int       @default(0) // delivery platform commission
  discountCents   Int       @default(0)
  taxCents        Int       @default(0)
  netCents        Int       // gross - commission - discount
  entryDate       DateTime  @default(now())
  createdAt       DateTime  @default(now())

  order    Order    @relation(fields: [orderId], references: [id])
  concept  Concept  @relation(fields: [conceptId], references: [id])
  location Location? @relation(fields: [locationId], references: [id])

  @@index([conceptId, entryDate(sort: Desc)])
  @@index([locationId, entryDate(sort: Desc)])
  @@map("financial_entries")
}

// ─── CRM ──────────────────────────────────────────────────────────────────────

model Segment {
  id          String   @id @default(uuid())
  name        String
  description String?
  // filter criteria stored as JSON predicate
  filters     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaigns Campaign[]

  @@map("segments")
}

model Campaign {
  id          String          @id @default(uuid())
  segmentId   String?
  name        String
  channel     String          // email|sms|whatsapp
  subject     String?
  body        String
  status      BroadcastStatus @default(draft)
  scheduledAt DateTime?
  sentAt      DateTime?
  recipientCount Int?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  segment Segment? @relation(fields: [segmentId], references: [id])
  sends   CampaignSend[]

  @@map("campaigns")
}

model CampaignSend {
  id          String    @id @default(uuid())
  campaignId  String
  customerId  String
  sentAt      DateTime?
  status      String    @default("queued") // queued|sent|failed|bounced
  errorMsg    String?

  campaign Campaign @relation(fields: [campaignId], references: [id])
  customer Customer  @relation(fields: [customerId], references: [id])

  @@map("campaign_sends")
}

model AutomationTrigger {
  id          String      @id @default(uuid())
  type        TriggerType
  name        String
  isActive    Boolean     @default(true)
  // config: days inactive, discount %, etc.
  config      Json
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("automation_triggers")
}

// ─── Rider ────────────────────────────────────────────────────────────────────

model Rider {
  id          String      @id @default(uuid())
  name        String
  phone       String      @unique
  vehicleType VehicleType @default(bike)
  status      RiderStatus @default(offline)
  isActive    Boolean     @default(true)
  notes       String?
  totalDeliveries Int     @default(0)
  // Last reported geolocation — also pushed to a per-order WebSocket channel
  // so customers see the live pin move on their tracking page.
  lastLat       Float?
  lastLng       Float?
  lastHeading   Float?    // degrees 0-359
  lastAccuracy  Float?    // metres
  lastReportedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  orders    Order[]
  locations RiderLocation[]

  @@map("riders")
}

// Append-only location stream from rider devices. Keeps a 24h history for
// dispute resolution / time-to-arrive analytics. Older rows pruned by a
// background sweep.
model RiderLocation {
  id         String   @id @default(uuid())
  riderId    String
  orderId    String?  // when on an active delivery
  lat        Float
  lng        Float
  heading    Float?
  accuracy   Float?
  speedMps   Float?
  recordedAt DateTime @default(now())

  rider Rider @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@index([riderId, recordedAt(sort: Desc)])
  @@index([orderId, recordedAt(sort: Desc)])
  @@map("rider_locations")
}

// ─── OrderReview ──────────────────────────────────────────────────────────────

model OrderReview {
  id         String   @id @default(uuid())
  orderId    String   @unique
  customerId String?
  conceptId  String
  rating     Int      // 1–5 overall
  comment    String?
  source     String   @default("storefront")

  // Optional sub-ratings — guests can rate individual aspects without
  // forcing all four. Schema is JSON `{ food?: 1..5, service?: 1..5,
  // value?: 1..5, speed?: 1..5 }` so we can add more facets without a
  // migration.
  categoryRatings Json?

  // Quick-tap chips: "Loved the bread", "Quick service", "Generous
  // portions" etc. Powers segment + recommender training without forcing
  // freeform text. Stored as plain strings; admin can rename/add tags.
  tags     String[] @default([])

  // True if the rating was 4 or 5 — denormalised for fast positive-leaning
  // CRM queries (winback ignores them, NPS report counts them).
  isPositive Boolean @default(false)

  // Loyalty bonus tracking: we award 50 pts for reviewing within 24h. This
  // flag prevents double-credit if the row gets re-saved.
  bonusPointsAwarded Int @default(0)

  // Manager response to a public review (shown on /brand/<slug>). Public
  // accountability — guests see how the venue handles feedback.
  managerResponse     String?
  managerResponseAt   DateTime?
  managerResponseById String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  order   Order   @relation(fields: [orderId], references: [id])
  concept Concept @relation(fields: [conceptId], references: [id])

  @@index([conceptId, createdAt])
  @@index([conceptId, rating])
  @@map("order_reviews")
}

// ─── OrderComplaint ───────────────────────────────────────────────────────────

model OrderComplaint {
  id          String            @id @default(uuid())
  orderId     String?
  customerId  String?
  conceptId   String
  title       String
  description String
  category    String            // wrong_item|missing_item|quality|service|delivery|other
  status      ComplaintStatus   @default(open)
  priority    ComplaintPriority @default(medium)
  resolvedAt  DateTime?
  resolution  String?

  // Lifecycle worker stamp: when we sent the "did we make it right?"
  // follow-up SMS+email after a complaint is marked resolved. Prevents
  // duplicate follow-ups if the resolution is edited.
  followUpSentAt DateTime?

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  concept Concept @relation(fields: [conceptId], references: [id])
  order   Order?  @relation(fields: [orderId], references: [id])

  @@map("order_complaints")
}

