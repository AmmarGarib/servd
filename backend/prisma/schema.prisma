// servd — Prisma Schema
// Database: PostgreSQL 15+

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum ConceptType {
  restaurant
  digital
  cart
}

enum OrderSource {
  servd
  pos
  cart
  manual
}

// How an order leaves the kitchen. Drives plating (dine-in: real plate;
// takeout/delivery: containers + lid + order label), end-of-pipeline handoff
// (server vs counter vs rider), and the CTA copy on the expo "served" button.
// How a till bill was closed (owner, 2026-10-20 — pos/TILL_FLOW.md).
enum SettlementChannel {
  keenu // pushed to the Keenu fiscal POS: it settles and files with FBR / SRB
  servd // closed in servd: filed by hand on the SRB / FBR portal
}

enum FulfilmentType {
  dine_in // plate it nice, server takes to table
  takeout // package for pickup, customer walks up to counter
  delivery // package + label + handoff to rider for the journey out
}

enum OrderStatus {
  received
  confirmed
  preparing
  ready
  completed
  cancelled
  rejected
  refunded
}

enum ItemStatus {
  pending
  preparing
  ready
  bumped
  held
  recalled
  voided
}

// Mirrors the AppRole list in frontend/admin/src/lib/appRoles.ts. When you add
// or remove a value here, run a migration AND update that file so the sidebar
// + the CEO's role-modules editor stay in sync. Adding values is safe and
// additive (Postgres ALTER TYPE ADD VALUE); removing requires a backfill.
enum UserRole {
  admin // CEO / founder — superuser, always full access, FINAL approver
  // owner — co-owner. Sees everything the CEO sees (P&L, payroll, projections)
  // and can approve STAFF submissions, but is deliberately NOT the final
  // authority: anything an owner submits escalates to `admin`, an owner can
  // never approve their own work, and owners cannot touch roles / module
  // access / staff accounts (otherwise they could self-promote to admin and
  // the escalation rule would be cosmetic).
  owner
  manager // legacy "manager" — kept for back-compat; new staff use management
  management // GM / day-to-day operator
  foh_management // floor manager
  boh_management // head chef
  foh // server / host
  boh // line cook / prep (KDS station)
  kitchen // single-station KDS view only
  expediter // pass / quality check
  cashier // POS + curbside
  procurement // supplier chat, POs, inventory receipt
  marketing // CRM, campaigns, reviews, complaints, content
  brand_manager // marketing/brand manager — owns the Brand dashboard (CAC, ROAS, ARPU, LTV…)
  fnb_manager // food & beverage manager — owns BOH + FOH; owns the F&B dashboard
  finance // P&L, payroll, accounting, reconciliation
  hr // staff records, attendance, payroll, scheduling
  it // IT / developer — the Dev workspace: integrations, backups, webhooks, user audit log
  // director — a brand partner (owner, 2026-10-18: Yusuf and Ali, partners in
  // Flipd). READ-ONLY, and only the brands in User.directorConceptIds, through
  // GET /director/* — every other route refuses the role (auth/middleware.ts).
  director
}

// Self-signed-up staff start as `pending` until the CEO approves them. Only
// `active` accounts can complete PIN login. `suspended` is for ex-staff who
// shouldn't be deleted (we want their history) but mustn't be able to log in.
enum AccountStatus {
  pending
  active
  suspended
}

// F-PAY02: jazzcash_wallet + easypaisa_wallet removed in v1 — no live
// adapter ships for either. Strip-script `scripts/strip-wallet-enum.ts`
// backfills any existing rows to `card`. If you ever add the adapters back,
// add the enum values *with* the corresponding adapter + webhook route in
// the same release so the UI can't accept payments the system can't process.
enum PaymentMethod {
  cash
  card
  keenu_qr // RETIRED 2026-10-12 (replaced by raast): read + refund of old sales only, never written by new code
  split
  comp
  raast // Raast QR — instant bank transfer to the company's receiving account (digital tax rate, like card)
  on_account // a named on-account client's bill (owner 2026-10-13): Dr 1110 at the close, billed on a monthly statement; CASH tax class; own route POST /pos/orders/:id/on-account, never POST /pos/payments
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

enum PaymentGateway {
  keenu
  jazzcash
  easypaisa
  none
  card_terminal // till card charged through the POS connector's card machine (TerminalCharge); keenuSettle never touches these
  raast // Raast instant transfer straight to the company's bank — keenuSettle never touches these
}

enum ShiftStatus {
  open
  closed
}

// Shift corrections (owner, 2026-10-21): finance asks, the CEO approves the SET once.
enum ShiftCorrectionStatus {
  submitted
  approved
  rejected
  applied
  failed
}

enum ShiftCorrectionKind {
  void_bill
  cancel_kot
  void_reissue
}

enum LoyaltyTxType {
  earn
  redeem
  expire
  adjustment
  // Points clawed back when the order that earned them is refunded.
  // This value was MISSING while orderPosting.ts wrote `type: 'reversal' as
  // never` — the cast silenced the compiler, Postgres rejected the insert at
  // runtime, and because the insert shared a transaction with the balance
  // decrement, the whole reversal rolled back. Refunds have never clawed a
  // single loyalty point back.
  reversal
}

enum BroadcastStatus {
  draft
  scheduled
  sent
  failed
}

enum TriggerType {
  birthday
  winback
  loyalty_tier
  custom
}

enum RiderStatus {
  available
  busy
  offline
}

enum VehicleType {
  bike
  car
  bicycle
  foot
}

enum ComplaintStatus {
  open
  in_progress
  resolved
  closed
}

enum ComplaintPriority {
  low
  medium
  high
  urgent
}

enum AccountType {
  asset
  liability
  equity
  revenue
  expense
}

enum JournalEntryType {
  debit
  credit
}

// ─── Concept ──────────────────────────────────────────────────────────────────

model Concept {
  id                       String      @id @default(uuid())
  tenantId                 String? // tenant — backfilled to "main" on first boot
  // Kitchen flow (owner, 2026-10-26, K4): the company that OWNS this brand's recipes when it is not the brand's own
  // (Flipd → GS Foods: "Flipd's recipes are OWNED BY GS FOODS and USED by Flipd"). Null = the brand's own company.
  // A CEO field (BRAND_CEO_FIELDS); setting it re-owns the brand's dish and add-on recipes. Stock and sales stay the
  // brand's company's (a Flipd sale deducts Flipd's outlet stock, in Flipd's books).
  recipeOwnerTenantId      String?
  name                     String
  slug                     String      @unique
  type                     ConceptType
  description              String?
  logoUrl                  String?
  primaryColor             String?
  isActive                 Boolean     @default(true)
  // Expected monthly portions at steady state — denominator for the
  // brand's Opex per Portion calc on the Recipe page. Operator-edited
  // when projections are set or revised.
  forecastPortionsPerMonth Int         @default(0)
  taxRate                  Float       @default(17) // FBR GST % — legacy single rate; kept for back-compat. New calc uses the split below.
  // FBR allows a discounted GST rate on card / digital tenders to encourage
  // banked payments. The split is per-brand because some concepts negotiate
  // their own rates with the tax authority. Cash defaults to the higher rate
  // (15% as of 2026), card to the lower (8%).
  taxRateCash              Float       @default(15)
  taxRateCard              Float       @default(8)

  // Storefront CMS — editable from ops admin
  storefrontVisible  Boolean @default(true) // show/hide on customer ordering page
  heroTagline        String? // punchy line under concept name
  announcementBanner String? // live message customers see (e.g. "Closed today")
  storefrontLayout   Json? // ordered array of page blocks (page builder)

  // Brand microsite artwork — the two pieces of supplied art a brand page
  // renders as images rather than as type. Both were hardcoded to files
  // bundled into the storefront build, so replacing a low-resolution export
  // took a code change and a redeploy. Operator-editable now. NULL keeps the
  // bundled fallback, so an unset brand renders exactly as it did before.
  //   wordmarkUrl — the brand's own lettering (a bespoke face we can't set as
  //                 live text), used in the hero and the sign-off.
  //   mascotUrl   — the brand character, shown in its own showcase band.
  // Prefer a transparent PNG at 1000px+ on the long edge, or an SVG.
  wordmarkUrl String?
  mascotUrl   String?

  // Reservation availability — per-brand master toggle. When false, public
  // booking endpoints reject (RESERVATIONS_DISABLED) and customer-facing
  // surfaces hide the "Book a table" CTA. Staff can still create reservations
  // via the admin (e.g. take a phone booking) regardless. Useful for:
  // takeaway-only brands, ghost kitchens, brands without floor service.
  reservationsEnabled Boolean @default(true)

  // ── Brand strategy brief ──────────────────────────────────────────────
  // Captured during onboarding, reused in CRM segmentation, marketing copy,
  // and competitive analytics. Free-form fields so operators describe their
  // brand the way they actually pitch it, not a forced taxonomy.
  conceptStatement    String? // one-line concept ("Build-your-own smashburger over brioche")
  cuisine             String? // 'burgers' | 'desi' | 'asian' | etc.
  heroProduct         String? // signature dish — drives daily-special suggestions
  anchoringExperience String? // the memorable thing — "27-layer croissant", "open kitchen"
  targetCustomer      String? // "22–35 urban DHA, daily indulgence"
  priceTier           String? // 'budget' | 'mid' | 'premium' | 'luxury'
  daypartFocus        String[] @default([]) // ['lunch', 'dinner', 'late_night']
  competitors         String[] @default([]) // up to 5 named competitors
  differentiator      String? // wedge — "in-house lamination, not bakery buns"
  brandVoice          String? // tone notes — "loud, urban, no-precious-paragraphs"

  // Physical presence — phone + address shown on storefront /visit page,
  // /locations geo page, schema.org Restaurant JSON-LD, brand microsite
  // footer + Maps link. Editable from the admin dashboard so the operator
  // doesn't need a code change to fix a wrong number on Google.
  phone           String? // public dial number, E.164 preferred (+923001234567)
  whatsapp        String? // guest-facing WhatsApp number, digits only (923001234567)
  email           String? // guest-facing contact email (owner, 2026-10-07: <brand>@gsfoods.pk)
  address         String? // street address line
  addressLocality String? // neighbourhood / area ("Bukhari Commercial, DHA Phase 6")

  // The brand's public profiles (SEO round 1, owner 2026-10-14) — edited in
  // Marketing → Brands by whoever edits the brand's marketing fields. Read by
  // schema.org Restaurant JSON-LD (sameAs / hasMap) and the brand pages'
  // "Elsewhere" links. https URLs only (zod in modules/concepts/routes.ts).
  sameAs        String[] @default([]) // Instagram, Facebook, TikTok, YouTube, LinkedIn, X — max 12
  googleMapsUrl String? // Google Business Profile / Maps place URL

  // Delivery geography — null = no restriction (global / dine-in / pickup)
  latitude         Float?
  longitude        Float?
  deliveryRadiusKm Float  @default(5) // how far this brand delivers from its outlet

  // FBR registration / tax invoice details. Required fields on Pakistani tax
  // invoices: STRN (Sales Tax Registration Number) and NTN (National Tax
  // Number). Province governs which provincial revenue authority's tax also
  // applies to services.
  strn             String? // FBR sales-tax registration number
  ntn              String? // National Tax Number
  province         String? // 'PB' | 'SD' | 'KP' | 'BL' | 'ICT' | 'GB' | 'AJK'
  invoiceLegalName String? // legal entity name as registered with FBR
  invoiceAddress   String? // billing address printed on invoices
  invoicePrefix    String? // e.g. "STX-" — concept-scoped sequence prefix

  // Brand POS ids for fiscal filing. Since 2026-10-10 FBR/SRB filing goes
  // ONLY through the external fiscal POS (the POS connector, backend/src/
  // connectors); servd no longer files directly. These stay the one store of
  // the brand's registration ids and are edited on Dev -> API -> POS connector.
  // FBR PRAL POSID (Tier-1 businesses, SRO 1307(I)/2022). Null = not registered.
  fbrPosId Int?

  // SRB (Sindh Revenue Board) Electronic Sales Invoicing — POSID assigned
  // by SRB at restaurant registration. Required for restaurants located in
  // Sindh (SRB has its own provincial sales tax regime separate from FBR).
  // Null = concept is not registered with SRB (outside Sindh, or not yet
  // registered). srbPosId ALSO routes Sindh output tax to 2032 in the ledger —
  // never null it.
  srbPosId Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  menus              MenuItem[]
  categories         Category[]
  orders             Order[]
  stations           Station[]
  tables             Table[]
  financialEntries   FinancialEntry[]
  customers          Customer[]             @relation("PreferredConcept")
  reviews            OrderReview[]
  complaints         OrderComplaint[]
  promoCodes         PromoCode[]
  sectionDiscounts   SectionDiscount[]
  abandonedCarts     AbandonedCart[]
  qrCodes            QrCode[]
  allocationWeights  AllocationRuleWeight[]
  floors             Floor[]
  reservations       Reservation[]
  blockouts          ConceptBlockout[]
  serviceHours       ServiceHours[]
  groupOrders        GroupOrder[]
  scheduledShifts    ScheduledShift[]
  analyticsEvents    AnalyticsEvent[]       @relation("ConceptAnalytics")
  contentEvents      ContentEvent[]         @relation("ConceptCalendar")
  locations          ConceptLocation[]
  tenant             Tenant?                @relation(fields: [tenantId], references: [id])
  componentUses      ComponentBrandUse[]
  feedbackEntries    FeedbackEntry[]
  positions          Position[]
  projectionInputs   ProjectionBrandInput[]
  // Raast QR receiving account for this brand (overrides the company default;
  // must be the same company's account — enforced in code).
  raastBankAccountId String?
  raastBankAccount   BankAccount?           @relation("ConceptRaastAccount", fields: [raastBankAccountId], references: [id], onDelete: SetNull)

  // The brand's primary service vessel: 'plate' (dine-in on plates; packaging only for takeaway / delivery / "box given")
  // or 'packaging' (packaging IS the vessel on every order — Stackd). Required when a brand is created; a change applies
  // from then on (snapshotted on OrderItem.serviceVessel at ring-up). CHECK concepts_service_vessel_chk (SQL only).
  // Owner 2026-10-13 (FINAL packaging rule). There is no plateWearPct: Recipe.qFactorPct is the one plate allowance.
  serviceVessel String @default("plate")

  // The brand's own sales account in its company's chart (owner 2026-10-17: "One sales
  // account per brand"). 40xx: the legacy brands keep 4001–4007 (CONCEPT_REVENUE_CODE);
  // every other brand gets "Sales — <brand>" at the first free code in 4010–4089 at
  // create / boot (accounting/brandRevenueAccount.ts). NULL = posts to the 4090 fallback.
  // Read through accounting/journal.ts revenueCodeForConcept, never directly.
  revenueAccountCode      String?
  // The brand's servd SUB-ACCOUNT (owner 2026-10-20, till flow: "two accounts per brand"):
  // "Sales — <brand> (servd)", the first free 40xx code in 4010–4089 of the brand's company,
  // assigned with the main one (brandRevenueAccount.ts). Sales CLOSED IN SERVD
  // (Order.settlementChannel 'servd') credit it; sales pushed to Keenu credit the main one.
  // Read through journal.ts servdRevenueCodeForConcept / saleRevenueCodeFor, never directly.
  servdRevenueAccountCode String?

  // Fixed assets v2 (2026-10-14)
  fixedAssets     FixedAsset[]     @relation("FixedAssetConcept")
  fixedAssetPools FixedAssetPool[] @relation("FixedAssetPoolConcept")
  menuSessions    MenuSession[]

  @@index([tenantId])
  @@index([recipeOwnerTenantId])
  @@map("concepts")
}

// ─── Station ──────────────────────────────────────────────────────────────────

model Station {
  id           String    @id @default(uuid())
  conceptId    String
  name         String
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  // Owner B12 (2026-10-26): how many order cards the station screen shows at
  // once (4–6, default 5; CHECK stations_visible_cards_chk). The rest queue.
  visibleCards Int       @default(4)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  concept     Concept      @relation(fields: [conceptId], references: [id])
  orderItems  OrderItem[]
  recipeSteps RecipeStep[]

  @@map("stations")
}

// Owner C3 (2026-10-26): a kitchen station add / change raised by the F&B
// manager or the chef, applied only when the CEO approves (approval type
// station_change, CEO only). tenantId = the brand's company. SQL-only: one
// pending request per station, kind / status CHECKs, RLS
// (migration 20261026130100_station_change_requests).
model StationChangeRequest {
  id               String    @id @default(uuid())
  tenantId         String
  conceptId        String
  stationId        String?
  kind             String // create | update
  changes          Json // { name?, displayOrder?, isActive?, conceptId? }
  status           String    @default("pending") // pending | approved | rejected | cancelled
  requestedById    String
  requestedAt      DateTime  @default(now())
  decidedById      String?
  decidedAt        DateTime?
  decisionNote     String?
  appliedStationId String?
  updatedAt        DateTime  @updatedAt

  @@index([tenantId, status])
  @@index([stationId])
  @@map("station_change_requests")
}

// A guest-list download (phones / emails) a non-CEO asked for (owner, 2026-10-27: customer exports go to the CEO).
// modules/crm/customerExports.ts is the contract. tenantId = the requester's ACTIVE company (whose guests are
// exported; a 'waitlist' export is the servd-wide new-brand list, filed in that company). Approved = ONE download
// by the requester within 24 hours (expiresAt; downloadedAt claims it). Approval type customer_export (CEO only).
model CustomerExportRequest {
  id            String    @id @default(uuid())
  tenantId      String
  kind          String // customers | waitlist
  filters       Json      @default("{}") // { search?, conceptId? } (customers) | { q?, source?, from?, to? } (waitlist)
  reason        String // why it is needed (≥10)
  status        String    @default("pending") // pending | approved | rejected | cancelled
  requestedById String
  requestedAt   DateTime  @default(now())
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?
  expiresAt     DateTime? // approvedAt + 24 h
  downloadedAt  DateTime? // the one download
  rowCount      Int?
  updatedAt     DateTime  @updatedAt

  @@index([tenantId, status])
  @@index([requestedById])
  @@map("customer_export_requests")
}

// ─── Category ─────────────────────────────────────────────────────────────────

model Category {
  id                   String    @id @default(uuid())
  conceptId            String
  name                 String
  sortOrder            Int       @default(0)
  timeRestrictionStart String? // HH:MM (e.g. "08:00")
  timeRestrictionEnd   String? // HH:MM (e.g. "11:00")
  // Sub-category (owner, 2026-10-22): a category may sit under ONE top-level
  // category of the same brand (one level only). Its items keep their own
  // category; reports read Category = the parent, Sub category = this one.
  parentId             String?
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  concept          Concept           @relation(fields: [conceptId], references: [id])
  parent           Category?         @relation("CategorySub", fields: [parentId], references: [id], onDelete: SetNull)
  children         Category[]        @relation("CategorySub")
  items            MenuItem[]
  sectionDiscounts SectionDiscount[]

  @@index([parentId])
  @@map("categories")
}

// Sales sessions (owner, 2026-10-22: "add sub-categories and sessions"):
// named times of day per brand — Breakfast 08:00–11:00, Dinner 18:00–00:00 —
// that a sale falls into by the Karachi time it was placed (reports only; a
// separate list from the reservation dayparts, owner's choice). A session may
// cross midnight (end ≤ start). Active sessions of a brand never overlap.
// Never deleted — switched off (isActive false), so old reports keep the name.
model MenuSession {
  id        String   @id @default(uuid())
  tenantId  String
  conceptId String
  name      String
  startTime String // HH:MM, Karachi
  endTime   String // HH:MM, Karachi; ≤ startTime = runs past midnight
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  concept Concept @relation(fields: [conceptId], references: [id])

  @@index([tenantId])
  @@index([conceptId])
  @@map("menu_sessions")
}

// ─── MenuItem ─────────────────────────────────────────────────────────────────

enum TaxClassification {
  standard // standard-rate (uses concept.taxRate, default 17% FBR)
  zero_rated // 0% — exports, certain food staples
  exempt // outside the GST regime entirely (no input-tax recovery either)
  custom // use overrideTaxRate
}

model MenuItem {
  id                String  @id @default(uuid())
  conceptId         String
  categoryId        String
  name              String
  // The item code / SKU the till searches by (till flow, 2026-10-20). Unique per brand.
  itemCode          String?
  nameUrdu          String? @map("name_urdu")
  description       String?
  instructions      String? // cooking/assembly steps shown in KDS tap modal
  instructionsUrdu  String? @map("instructions_urdu")
  priceCents        Int
  imageUrl          String?
  // Optional looping video shown in place of the still image on the
  // storefront menu surface. When both are set, the storefront prefers
  // the video and falls back to the image. Operator sets one or the
  // other per item from the admin.
  videoUrl          String?
  isAvailable       Boolean @default(true)
  // The recipe gate (owner 2026-10-24): true only for dishes LIVE at go-live with no approved recipe (set by
  // migration 20261024140000) — they may come back on after an 86; every other dish needs a production recipe.
  liveAtRecipeGate  Boolean @default(false)
  portionsAvailable Int? // null = unlimited; set per service for live stock tracking
  displayOrder      Int     @default(0)
  stationId         String? // default routing station

  // FBR tax classification per item. CA can override per-item; default is
  // 'standard' (uses concept.taxRate). 'custom' uses overrideTaxRate.
  taxClassification TaxClassification @default(standard)
  overrideTaxRate   Float? // only consulted when taxClassification = 'custom'

  // Allergens + dietary tags. Stored as a string array (Postgres TEXT[]) so
  // operators can add custom labels beyond the standard set.
  // Standard set: gluten, dairy, eggs, peanuts, tree_nuts, soy, fish,
  // shellfish, sesame, mustard. Dietary: vegetarian, vegan, halal, gluten_free.
  allergens  String[] @default([])
  dietary    String[] @default([])
  spiceLevel Int? // 0–5; null = not applicable

  // Third-party platform sync — set to null when isAvailable changes so the
  // inventorySync worker picks up the change on its next tick.
  lastSyncedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  concept        Concept         @relation(fields: [conceptId], references: [id])
  category       Category        @relation(fields: [categoryId], references: [id])
  modifierGroups ModifierGroup[]
  orderItems     OrderItem[]
  recipe         Recipe?

  @@unique([conceptId, itemCode])
  @@map("menu_items")
}

// ─── ModifierGroup ────────────────────────────────────────────────────────────

model ModifierGroup {
  id         String    @id @default(uuid())
  menuItemId String
  name       String
  minSelect  Int       @default(0)
  maxSelect  Int       @default(1)
  isRequired Boolean   @default(false)
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  menuItem  MenuItem   @relation(fields: [menuItemId], references: [id])
  modifiers Modifier[]

  @@map("modifier_groups")
}

// ─── Modifier ─────────────────────────────────────────────────────────────────

model Modifier {
  id              String    @id @default(uuid())
  groupId         String
  name            String
  priceDeltaCents Int       @default(0)
  isDefault       Boolean   @default(false)
  sortOrder       Int       @default(0)
  allergens       String[]  @default([]) // e.g. ["nuts", "dairy", "gluten"]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  group         ModifierGroup       @relation(fields: [groupId], references: [id])
  orderItemMods OrderItemModifier[]
  // What ONE unit of this add-on uses (Recipe kind 'modifier'; food cost wave B).
  recipe        Recipe?             @relation("ModifierRecipe")

  @@map("modifiers")
}

// ─── Table ────────────────────────────────────────────────────────────────────

enum TableShape {
  rectangle
  square
  round
  banquette // long sofa-style seating
  counter // bar / pass counter
  barstool // single bar seat
}

model Table {
  id                   String     @id @default(uuid())
  conceptId            String
  floorId              String? // groups tables onto a Floor; null = legacy or unassigned
  label                String // e.g. "T1", "Patio-3"
  capacity             Int        @default(4)
  floorSection         String?
  status               String     @default("available") // available|seated|ordered|eating|check|reserved|cleaning|out_of_service
  // Canvas positioning — pixels in floor-plan space (Floor.width × Floor.height).
  // Editor snaps to a 10px grid by default.
  shape                TableShape @default(rectangle)
  x                    Int        @default(40)
  y                    Int        @default(40)
  width                Int        @default(120)
  height               Int        @default(80)
  rotation             Int        @default(0) // degrees, 0–359
  // Live occupancy — set when a party is seated, cleared on checkout.
  currentPartySize     Int?
  currentOrderId       String?
  estimatedDepartureAt DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  deletedAt            DateTime?

  concept      Concept       @relation(fields: [conceptId], references: [id])
  floor        Floor?        @relation(fields: [floorId], references: [id])
  orders       Order[]
  qrCodes      QrCode[]
  reservations Reservation[]

  @@index([conceptId, floorId])
  @@map("tables")
}

model Floor {
  id            String    @id @default(uuid())
  conceptId     String
  name          String // "Main", "Patio", "Mezzanine", "Bar"
  displayOrder  Int       @default(0)
  width         Int       @default(1200) // canvas px
  height        Int       @default(800)
  backgroundUrl String? // optional floorplan image — restaurant blueprint scan
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  concept Concept @relation(fields: [conceptId], references: [id])
  tables  Table[]

  @@index([conceptId, displayOrder])
  @@map("floors")
}

enum ReservationStatus {
  booked
  confirmed
  seated
  completed
  no_show
  cancelled
  // Owner C10 (2026-10-26): an overbook raised by anyone but the CEO waits here
  // (off the floor plan, capacity and reminders; the guest is told nothing)
  // until the CEO approves (→ booked) or rejects (→ cancelled).
  pending_approval
}

enum ReservationSource {
  staff
  website
  phone
  walkin
}

model Reservation {
  id         String            @id @default(uuid())
  conceptId  String
  customerId String? // linked when guest matches a Customer record
  tableId    String? // null until seated; can change if a guest is reseated
  partySize  Int
  startTime  DateTime
  endTime    DateTime // start + duration (default 90 min, configurable)
  status     ReservationStatus @default(booked)
  source     ReservationSource @default(staff)

  // Guest info — captured even for non-customer (no Customer row) bookings.
  // Synced into a Customer record on first arrival if email/phone provided.
  guestName  String
  guestPhone String?
  guestEmail String?

  notes    String? // allergies, occasion, requests
  isVip    Boolean @default(false)
  // For walk-ins / waitlist parties without an immediate table assignment
  waitlist Boolean @default(false)

  // Optional credit-card hold for premium / large-party bookings. When set,
  // the customer's card is authed (not captured) for this amount; they only
  // pay if they no-show. Operator releases the hold on arrival.
  depositCents Int     @default(0)
  depositRef   String? // gateway reference (Keenu transaction id)

  // Confirmation token — public link the guest can hit to confirm or cancel
  // without signing in.
  confirmToken String?   @unique
  confirmedAt  DateTime?

  // Reminder flags — flipped by the loyaltyTriggers-style worker so we don't
  // double-send.
  reminder24hSentAt DateTime?
  reminder2hSentAt  DateTime?

  seatedAt     DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  // ── Waitlist promotion ─────────────────────────────────────────────────
  // When another reservation cancels or no-shows, the system can OFFER the
  // freed slot to a matching waitlist row. The original waitlist row stays
  // untouched until the guest claims; these fields hold the offer.
  //   POST /api/v1/reservations/claim/:token  → applies offer to startTime,
  //                                               endTime, tableId and clears
  //                                               the promotion fields.
  // Expired offers (promotionExpiresAt < now) get swept by the reservation
  // reminder worker on its next tick.
  promotionToken            String?   @unique
  promotionExpiresAt        DateTime?
  promotionOfferedStartTime DateTime?
  promotionOfferedEndTime   DateTime?
  promotionOfferedTableId   String?
  promotedFromWaitlistAt    DateTime?

  createdById          String? // staff user, null if from public website
  // "Invite your table" (owner, 2026-10-26): sha256 of the booker's invite
  // link token (the token itself is shown once). null = no live link.
  inviteTokenHash      String?   @unique
  inviteTokenCreatedAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  concept  Concept            @relation(fields: [conceptId], references: [id])
  customer Customer?          @relation(fields: [customerId], references: [id])
  table    Table?             @relation(fields: [tableId], references: [id])
  guests   ReservationGuest[]

  @@index([conceptId, startTime])
  @@index([tableId, startTime])
  @@index([promotionExpiresAt])
  @@index([status, startTime])
  @@index([reminder24hSentAt])
  @@map("reservations")
}

// Owner C10 (2026-10-26): "overbooking should auto come to ceo for approval.
// Manager shouldnt be able to do that without approval." A booking (kind
// create — the reservation waits as pending_approval) or a change of one (kind
// edit — the reservation stays as it is, the change waits in `changes`) that
// goes past capacity, raised by anyone but the CEO. Approval type
// reservation_overbook (CEO only, never handed over). tenantId = the brand's
// company (RLS, merge repoint). SQL-only: one pending request per reservation,
// kind / status CHECKs (migration 20261027120000_reservation_overbook_approval).
model ReservationOverbookRequest {
  id                   String    @id @default(uuid())
  tenantId             String
  reservationId        String
  conceptId            String
  kind                 String // create | edit
  changes              Json      @default("{}") // edit: the proposed fields; create: {}
  reason               String
  managerApproverId    String? // the manager (own login or PIN) who raised / allowed it
  viaPin               Boolean   @default(false)
  // edit: the reservation's updatedAt when raised — approval refuses (409 RESERVATION_CHANGED) if it moved.
  reservationUpdatedAt DateTime?
  status               String    @default("pending") // pending | approved | rejected | cancelled
  requestedById        String
  requestedAt          DateTime  @default(now())
  decidedById          String?
  decidedAt            DateTime?
  decisionNote         String?
  updatedAt            DateTime  @updatedAt

  @@index([tenantId, status])
  @@index([reservationId])
  @@map("reservation_overbook_requests")
}

// A servd member who joined a booking through the booker's invite link
// (owner, 2026-10-26). tenantId = the brand's company (RLS, company merge
// repoint). At most partySize − 1 guests (the booker is the first seat).
model ReservationGuest {
  id            String   @id @default(uuid())
  tenantId      String
  reservationId String
  customerId    String
  joinedAt      DateTime @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  customer    Customer    @relation(fields: [customerId], references: [id])

  @@unique([reservationId, customerId])
  @@index([tenantId])
  @@index([customerId])
  @@map("reservation_guests")
}

// ─── Concept blockouts ──────────────────────────────────────────────────────
// Closures, private events, holiday hours. The slot-search API refuses to
// surface time inside a blockout, and the dashboard surfaces them visually.

enum BlockoutKind {
  closure // restaurant closed entirely
  private_event // booked out for a private function
  reduced_capacity // only N tables available
  custom
}

model ConceptBlockout {
  id          String       @id @default(uuid())
  conceptId   String
  kind        BlockoutKind @default(closure)
  startTime   DateTime
  endTime     DateTime
  // For reduced_capacity, only this many tables remain available
  capacityCap Int?
  reason      String? // free-text, surfaced to staff
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  concept Concept @relation(fields: [conceptId], references: [id])

  @@index([conceptId, startTime])
  @@map("concept_blockouts")
}

// ─── Service hours (per concept × per day-of-week) ───────────────────────────
// Defines when a concept accepts reservations. Multiple windows per day allow
// for split lunch/dinner service.

model ServiceHours {
  id           String   @id @default(uuid())
  conceptId    String
  dayOfWeek    Int // 0 = Sun, 1 = Mon, … 6 = Sat
  // HH:MM 24-hour stored as int minutes since midnight (0–1440)
  openMin      Int
  closeMin     Int
  isReservable Boolean  @default(true) // false = walk-in only
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  concept Concept @relation(fields: [conceptId], references: [id])

  @@unique([conceptId, dayOfWeek, openMin])
  @@map("service_hours")
}

// ─── Customer guest tags (allergies, regular, VIP, etc.) ────────────────────
// Free-form labels operators apply to a customer. Surfaced on reservation rows
// and in the customer 360 view.

// ─── Gift cards ──────────────────────────────────────────────────────────────
//
// Issued with a face value, redeemable across any GS Foods concept (the
// liability sits in 2080). Each redemption decrements balance, posts to the
// journal, and stores a transaction record. Codes are human-readable but
// long enough that brute-forcing is impractical.

enum GiftCardStatus {
  active
  redeemed_full
  expired
  voided
}

enum GiftCardKind {
  sold
  promotional
}

model GiftCard {
  id                String         @id @default(uuid())
  // Company that sold the card; a card is spent only at that company's brands (owner decision 14).
  tenantId          String?
  code              String         @unique // human-readable, e.g. "GS-7K2P-X9MD"
  issuedAmountCents Int
  balanceCents      Int
  currency          String         @default("PKR")
  status            GiftCardStatus @default(active)
  expiresAt         DateTime?

  // Buyer + recipient details (same person if self-purchase)
  buyerCustomerId String?
  buyerEmail      String?
  recipientName   String?
  recipientEmail  String?
  message         String?

  issuedById            String? // staff user; null for storefront purchase
  conceptId             String? // null = redeemable everywhere
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  voidedAt              DateTime?
  voidReason            String?
  // Finance gaps (2026-10-13): how the card was paid for, so its issue entry
  // debits the right account and a void can send the value back the same way.
  // 'promotional' cards are given away (Dr 6060 at issue, never cash).
  kind                  GiftCardKind @default(sold)
  paymentMethod         String? // lib/bankAccounts.ts RECEIPT_METHODS (cash | card | bank_transfer | bank_deposit | cheque); null for promotional / storefront
  bankAccountId         String? // the bank a bank-type sale landed in (same company)
  paymentRef            String? // payment reference # (receipt / slip / transfer / cheque no.) — required on every paid sale since 2026-10-14
  expiredAt             DateTime?
  voidDisposition       String? // refund | payment_not_received | forfeit
  // H11 breakage (wave B, INT4: a card is ≤ PKR 100k): value taken to 4200 (sold) / 6060 (promotional) at the card's
  // FIRST expiry, or a CEO forfeit of a sold card. A refund that later puts value back on an expired card waits for a
  // manager (never swept).
  breakageCents         Int          @default(0)
  breakageAt            DateTime?
  // Expired but breakage could not be booked yet (issue entry missing — ISSUE_NOT_BOOKED — or the posting was
  // refused). The sweep and the 'giftcard.expire' reposter retry these; null = nothing pending.
  breakagePendingAt     DateTime?
  breakagePendingReason String?

  redemptions GiftCardRedemption[]

  @@index([status])
  @@index([buyerEmail])
  @@index([tenantId])
  @@index([tenantId, status, expiresAt])
  @@map("gift_cards")
}

model GiftCardRedemption {
  id           String    @id @default(uuid())
  giftCardId   String
  orderId      String?
  amountCents  Int
  balanceAfter Int
  redeemedAt   DateTime  @default(now())
  redeemedById String? // staff user when manual
  // Set when a refund has re-credited this redemption back onto the card.
  // The refund path claimed to be idempotent "on a flag we add
  // (reversedAt)" — the flag was never actually added, so every write of
  // status 'refunded' re-credited the card again, minting balance.
  reversedAt   DateTime?

  giftCard GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  order    Order?   @relation(fields: [orderId], references: [id])

  @@index([giftCardId, redeemedAt(sort: Desc)])
  @@index([orderId])
  @@map("gift_card_redemptions")
}

model GuestTag {
  id          String   @id @default(uuid())
  customerId  String
  label       String // "VIP", "Vegan", "Allergic — peanuts", "Press", "Industry"
  color       String? // optional hex
  createdById String?
  createdAt   DateTime @default(now())
  // B8 (owner, 2026-10-26): the company that put the tag on the guest and the catalogue entry it came from.
  // NULL tenant = a legacy free-form tag (seen by every company that served the guest, as before).
  tenantId    String?
  tagTypeId   String?

  customer Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tagType  GuestTagType? @relation(fields: [tagTypeId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([tenantId])
  @@index([tagTypeId])
  @@map("guest_tags")
}

// The company's own list of guest tags (VIP, allergy, birthday …) that staff pick from on the guest card
// (owner, 2026-10-26, B8). Company data: tenantId from the first commit, unique per company by normalised name,
// switched off (never deleted) so old tags keep their meaning. GuestTag carries the typed tag on a guest.
model GuestTagType {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  nameKey     String // lower-cased, trimmed, spaces collapsed — the per-company unique key
  color       String?
  active      Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tags GuestTag[]

  @@unique([tenantId, nameKey])
  @@index([tenantId])
  @@map("guest_tag_types")
}

// ─── User (Staff) ─────────────────────────────────────────────────────────────

model User {
  id                  String        @id @default(uuid())
  tenantId            String? // tenant — backfilled on first boot
  name                String
  // Email is nullable so the CEO can stub a staff row from the workforce hub
  // (just a name + category) and fill the contact details in later. Postgres
  // permits multiple NULLs on a @unique column, so the uniqueness guarantee
  // still holds for real addresses. Login flows already gate on `email != null`.
  email               String?       @unique
  phone               String? // staff contact + source for the 4-digit PIN
  password            String // bcrypt hash
  pin                 String? // bcrypt hash of PIN
  // Set true for legacy accounts whose PIN was derived from the last 4 digits
  // of their phone number. Login is blocked for these accounts until an admin
  // re-issues a CSPRNG PIN via POST /auth/staff/:id/issue-pin. New signups
  // ship with this false because their PIN is already CSPRNG-generated.
  // Set when an account is created with a generated password, or an admin
  // reissues one. A nudge for the client to prompt a change — NEVER a login
  // block: hard-blocking here is how you strand people on deploy day.
  mustChangePassword  Boolean       @default(false)
  pinMustReset        Boolean       @default(false)
  // Set when a staff member taps "forgot PIN" on the login screen. Surfaces
  // the request to the CEO/owner in the staff directory; cleared when a new
  // PIN is issued. Never reveals anything about the old PIN.
  pinResetRequestedAt DateTime?
  // Owner C1 (2026-10-26): first successful use of a short (4–5 digit) override
  // PIN; it is refused SHORT_PIN_GRACE_HOURS later until a 6-digit PIN is set
  // (auth/managerPin.ts shortPinUsed). Cleared by every PIN set.
  pinChangeRequiredAt DateTime?
  // ─── Two-factor authentication (WhatsApp OTP) ───────────────────────
  // A second factor for the accounts that can move money and read the
  // whole company: a 6-digit code sent to WhatsApp after the password
  // checks out.
  //
  // twoFactorPhone is NOT the `phone` field above. That one is a contact
  // number an admin types in from a form and nobody has proved. This one
  // is only ever written after the staff member has received a code on it
  // and typed it back, so enabling 2FA cannot lock someone out of their
  // own account with a mistyped number.
  //
  // 2FA is on for an account when twoFactorEnabledAt is set — nothing else
  // turns it on. Enforcing it by role alone would have locked out every
  // owner the moment this shipped, which is exactly the mistake the PIN
  // change already made once.
  // RETIRED (owner, 2026-10-26: two-step sign-in removed). Cleared by
  // migration 20261027110000 and read by nothing; columns kept, no data drop.
  twoFactorPhone      String?
  twoFactorEnabledAt  DateTime?
  // A sign-in lasts one shift (owner B1, 2026-10-26). Set when this login's
  // till drawer closes (auth/sessionEnd.ts endSessionsForClosedDrawer): every
  // session ISSUED before it ends SHIFT_CLOSE_GRACE_MS after it (time to see /
  // print the Z-report). Checked on every request and on refresh.
  sessionsEndedAt     DateTime?
  role                UserRole      @default(kitchen)
  // Free-text job title shown next to the role chip in /workforce. The role
  // enum is the *category* (FOH / BOH / Procurement / etc); jobTitle is what
  // the operator actually calls them ("Sous Chef Bukhari", "Floor manager —
  // Clifton", "Pastry CDP"). Optional — falls back to the role label.
  jobTitle            String?
  // Self-signup creates accounts as `pending` — CEO approves from the user
  // dropdown before they can sign in. Existing accounts back-fill to `active`.
  accountStatus       AccountStatus @default(active)
  // Who added this login (a workspace owner adding staff under them, decision 47).
  // The CEO approves it before it can sign in; null = created by the CEO.
  invitedById         String?
  // HR employee the inviter asked to link; applied when the CEO approves.
  inviteEmployeeId    String?
  // Free-text reason kept around for the audit log / approval modal.
  signupReason        String?
  // Concepts this user is allowed to access. Empty array = no concept restriction
  // is applied (intended for admin/manager — role check is the gate). Non-admin
  // roles MUST have explicit concept IDs to access concept-scoped resources.
  conceptIds          String[]      @default([])
  // Stations this user is assigned to work. Drives the /kds dashboard (line
  // cook sees only their stations) and is the route the head chef uses to
  // hand a tablet to a cook without showing them every station's queue.
  // Empty = "not station-restricted" → admin / management / expediter see
  // every station via the existing /kds/stations endpoint.
  stationIds          String[]      @default([])
  // Director logins (owner, 2026-10-18): the brands this director may see,
  // read-only, through GET /director/*. Empty = sees nothing (never "all").
  // Set only by the CEO; each id is a brand of one of the CEO's companies.
  // Deliberately NOT `conceptIds` above (decision 35: no longer read).
  directorConceptIds  String[]      @default([])
  // ─── Per-user permission + module overrides ─────────────────────────
  // The role gives a baseline (set in /configuration/roles for actions and
  // /configuration/role-modules for sidebar visibility). These four arrays
  // let the CEO subjectively tune a single staff member: e.g. give Ahmad
  // (a Cashier) access to /finance/p-and-l without making every other
  // cashier see it.
  //
  //   - permissionAllow: action keys this user has DESPITE role saying no
  //   - permissionDeny:  action keys this user can't do DESPITE role saying yes
  //   - moduleAllow:     sidebar module IDs visible DESPITE role hiding them
  //   - moduleDeny:      sidebar module IDs hidden DESPITE role showing them
  //
  // Effective access = role default ± user overrides. Resolution is in
  // backend/src/lib/permissions.ts (userCan) and the frontend useCan hook.
  permissionAllow     String[]      @default([])
  permissionDeny      String[]      @default([])
  moduleAllow         String[]      @default([])
  moduleDeny          String[]      @default([])
  // Payroll: hourly rate in paisa (PKR cents). Null = unpaid (volunteer/owner).
  hourlyRateCents     Int?
  // Wage account this employee's labour posts to: 6030 kitchen / 6031 FOH /
  // 6032 management / 6035 riders. Null = derive from role.
  wageAccountCode     String?
  isActive            Boolean       @default(true)
  viaHeadOfficeId     String? // D1/A3: the head office it was submitted through (stamped at submit; plain id, no FK)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  deletedAt           DateTime?

  shifts                 Shift[]
  clockLogs              ClockLog[]
  posOrders              Order[]                @relation("PosStaff")
  poActivityLog          PoActivityLog[]
  receivingDiscrepancies ReceivingDiscrepancy[]
  wasteLogs              WasteLog[]
  payrollLines           PayrollRunLine[]
  tipPoolMemberships     TipPoolMember[]
  scheduledShifts        ScheduledShift[]
  assignedSuppliers      Supplier[]             @relation("SupplierAssignee")
  contentEvents          ContentEvent[]         @relation("EventAssignee")
  createdEvents          ContentEvent[]         @relation("EventCreatedBy")
  supplierConversations  SupplierConversation[]
  customerConversations  CustomerConversation[] @relation("CustomerConversationStaff")
  cashMovementsRecorded  CashMovement[]         @relation("CashMovementRecordedBy")
  expoPushTokens         ExpoPushToken[]
  staffNotifications     StaffNotification[]    @relation("StaffNotificationRecipient")
  tenant                 Tenant?                @relation(fields: [tenantId], references: [id])
  // Multi-tenant memberships — a user can own/manage multiple tenants. The
  // `tenantId` above acts as the *active* tenant; this list is the set of
  // tenants they're authorised to switch into.
  tenantMemberships      TenantMember[]
  positionsFilled        Position[]             @relation("PositionFilledBy")
  passwordResets         StaffPasswordReset[]

  @@index([invitedById])
  @@map("users")
}

// ─── Shift ────────────────────────────────────────────────────────────────────

model Shift {
  id                String      @id @default(uuid())
  userId            String
  // Owning company — company master data, never shared across companies.
  tenantId          String?
  locationId        String? // physical place this shift was opened at
  status            ShiftStatus @default(open)
  openedAt          DateTime    @default(now())
  closedAt          DateTime?
  openingFloatCents Int         @default(0)
  closingFloatCents Int?
  notes             String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user          User              @relation(fields: [userId], references: [id])
  location      Location?         @relation(fields: [locationId], references: [id])
  payments      Payment[]
  cashMovements CashMovement[]
  tenant        Tenant?           @relation("TenantShifts", fields: [tenantId], references: [id])
  corrections   ShiftCorrection[]

  @@index([locationId, openedAt(sort: Desc)])
  @@index([tenantId])
  @@map("shifts")
}

// ─── CashMovement ─────────────────────────────────────────────────────────────
//
// Mid-shift cash movements: cash drops (excess removed to safe), cash adds
// (small bills brought in), pay-outs (vendor paid from drawer), pay-ins
// (refund from vendor / employee cash back). All affect the expected cash
// count at close. Stored separately from Payment so they don't pollute
// sales analytics.

enum CashMovementType {
  drop // cashier removes cash to safe — DECREASES expected cash
  add // cashier adds bills to drawer — INCREASES expected cash
  payout // pay a vendor / petty cash — DECREASES expected cash
  payin // money in (refund from vendor, etc) — INCREASES expected cash
}

model CashMovement {
  id                 String           @id @default(uuid())
  shiftId            String
  type               CashMovementType
  amountCents        Int // always positive; sign comes from type
  reason             String
  recordedById       String // the user who logged it
  managerOverridePin String? // captured when above cashier cap
  recordedAt         DateTime         @default(now())

  shift      Shift @relation(fields: [shiftId], references: [id])
  recordedBy User  @relation("CashMovementRecordedBy", fields: [recordedById], references: [id])

  @@index([shiftId, recordedAt])
  @@map("cash_movements")
}

// ─── ExpoPushToken ────────────────────────────────────────────────────────────
//
// One row per device that registers with us. We key by (userId, token) and
// upsert so the same device repeatedly registering doesn't blow up the table.
// `device` distinguishes tablet vs mobile vs web for targeted broadcasts
// ("send to all tablets at this location").

model ExpoPushToken {
  id         String    @id @default(uuid())
  userId     String
  token      String
  platform   String // "ios" | "android" | "web"
  device     String // "tablet" | "mobile" | "kiosk"
  locationId String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  revokedAt  DateTime?

  user     User      @relation(fields: [userId], references: [id])
  location Location? @relation(fields: [locationId], references: [id])

  @@unique([userId, token])
  @@index([userId])
  @@index([device, locationId])
  @@map("expo_push_tokens")
}

// The bell (owner, 2026-10-16). One row per (recipient, event). Advisory only:
// the module's own row (approval item, flag, night-audit day) stays the record.
// The ONE writer is lib/staffNotify.ts. Migration 20261016140000_notifications.
model StaffNotification {
  id         String    @id @default(uuid())
  // The company of the EVENT (approval item's owner, flag's company, the
  // audited company) — never the actor's active company. NULL only for a
  // company-less approval item (shared servd:* page, company-less login /
  // recipe), which is CEO-only by rule: lib/staffNotify.ts keeps a NULL row
  // only for role 'admin' recipients — deliberate.
  tenantId   String?
  userId     String // recipient: a staff login (never a rider / customer)
  kind       String // NotificationKind (lib/staffNotify.ts) — plain string, no enum migration per kind
  severity   String    @default("info") // info | success | warning | critical (CHECK)
  title      String // ≤ 140 chars (CHECK), no secrets, no customer PII
  body       String? // ≤ 500 chars (CHECK)
  link       String? // admin path, must start with one '/' (CHECK)
  entityType String?
  entityId   String?
  actorId    String? // who caused it (never also a recipient)
  dedupeKey  String // same event never notifies the same person twice
  createdAt  DateTime  @default(now())
  readAt     DateTime?

  user   User    @relation("StaffNotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation("TenantStaffNotifications", fields: [tenantId], references: [id])

  // No tenantId in the unique key: dedupe keys embed globally unique ids, so
  // a company merge can repoint tenantId without clashes.
  @@unique([userId, dedupeKey], map: "staff_notifications_user_dedupe_key")
  @@index([userId, createdAt(sort: Desc)])
  @@index([tenantId, createdAt])
  @@map("staff_notifications")
}

// ─── ClockLog ─────────────────────────────────────────────────────────────────

model ClockLog {
  id                String   @id @default(uuid())
  userId            String
  type              String // "in" | "out"
  lat               Float?
  lng               Float?
  selfieUrl         String? // captured at clock-in to prevent buddy-punching
  geofenceMatched   Boolean? // null = not checked; true = within concept geofence
  geofenceDistanceM Float? // metres from concept lat/lng (when checked)
  ipAddress         String?
  recordedAt        DateTime @default(now())
  // Attendance tracking (owner, 2026-10-15): the punch's company, the work location it was measured against (the
  // nearest of the employee's work locations, else of the company's), and whether it was outside the allowed radius
  // or had no location fix. Outside = allowed but flagged for HR (never refused).
  tenantId          String?
  locationId        String?
  outOfArea         Boolean?
  // The employee's custom work pin the punch was measured against (owner, 2026-10-27), and its label then.
  workPinId         String?
  pinLabel          String?

  user User @relation(fields: [userId], references: [id])

  @@index([userId, recordedAt])
  @@index([tenantId, recordedAt])
  @@map("clock_logs")
}

// ─── Payroll ─────────────────────────────────────────────────────────────────
//
// A payroll run covers a date range (typically a week or month). The
// computation derives hours from ClockLog pairings, multiplies by hourlyRate,
// and posts a single journal entry: Dr Wages (per account code) / Cr Wages
// Payable. Settlement (paying the employee) happens via supplier-payment-style
// entries when the bank transfer goes out.

enum PayrollRunStatus {
  draft // computed but not posted
  posted // accrual JE posted; wages payable open
  paid // payment JE posted; wages payable cleared
}

model PayrollRun {
  id              String           @id @default(uuid())
  periodStart     DateTime
  periodEnd       DateTime
  status          PayrollRunStatus @default(draft)
  totalGrossCents Int              @default(0)
  postedAt        DateTime?
  paidAt          DateTime?
  createdById     String?
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  lines PayrollRunLine[]

  @@index([periodStart(sort: Desc)])
  @@map("payroll_runs")
}

model PayrollRunLine {
  id              String  @id @default(uuid())
  payrollRunId    String
  userId          String
  userName        String
  hoursWorked     Float
  hourlyRateCents Int
  grossCents      Int
  wageAccountCode String // 6030/6031/6032/6035
  // Optional adjustments (advances, deductions, bonuses) — signed cents
  adjustmentCents Int     @default(0)
  netCents        Int
  notes           String?

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id])

  @@index([payrollRunId])
  @@index([userId])
  @@map("payroll_run_lines")
}

// ─── Customer ─────────────────────────────────────────────────────────────────

// BOOKS-06: money columns on this model are BIGINT paisa (lib/money.ts returns them as JS numbers).
model Customer {
  id                 String    @id @default(uuid())
  name               String
  email              String?   @unique
  phone              String?   @unique
  // A second number (landline) taken at the till's guest form (till flow, 2026-10-20). Not unique.
  altPhone           String?
  marketingOptIn     Boolean   @default(false)
  // Campaigns are OPT-OUT: everyone we hold contact details for is reachable
  // unless this is set. marketingOptIn above was never set by anything, so
  // under the old opt-in rule every campaign reached nobody. Set by the
  // unsubscribe link carried on every campaign message.
  marketingOptOutAt  DateTime?
  ntn                String? // National Tax Number (for FBR invoice BuyerNTN field)
  cnic               String? // CNIC (for FBR invoice BuyerCNIC field)
  birthdayMmDd       String? // MM-DD format, e.g. "04-23"
  firstOrderAt       DateTime?
  lastOrderAt        DateTime?
  totalSpentCents    BigInt    @default(0)
  preferredConceptId String?
  // RETIRED (ONL-R2-01, migration 20261011160000): the wallet is per company
  // now — CustomerWallet. This column is no longer read or written; the
  // migration moved every non-zero balance to one company's wallet and left
  // the value here untouched as the record of what was moved. Never read it.
  walletBalance      Int       @default(0)

  // ── Referral program ─────────────────────────────────────────────────────
  // Each customer auto-gets a unique 8-char code on registration. New
  // customers can supply someone's code at signup — when their first
  // order completes, BOTH parties get a loyalty bonus (default 200 pts each).
  // referredById and referredAt stay set forever for cohort analytics.
  referralCode             String?   @unique
  referredById             String?
  // ── The servd name and the member code (owner, 2026-10-26) ──────────────
  // nickname = "the servd name": the customer picks it the first time they
  // open servd after signing in; shown in group orders and booking invites.
  // Customers are SERVD-WIDE accounts (no tenantId, deliberately — like
  // referralCode), so the nickname is unique servd-wide, case-insensitive:
  // the unique index is on lower("nickname") in SQL (migration
  // 20261027100000), which Prisma cannot express — never re-declare it here.
  nickname                 String?
  // Internal member barcode (CRM / Marketing only, never shown to the
  // customer). Set by the database DEFAULT customer_member_code() on EVERY
  // insert path (signup, the till's guest form, magic link, WhatsApp,
  // imports): 'SV' + 10 digits, a permuted sequence. The default, sequence and
  // function are SQL-only (migration 20261027100000, applied in
  // tests/setup.ts) — Prisma never writes the column; it is NOT NULL on the
  // database (optional here only because Prisma does not know the default).
  // Separate from the PUBLIC referralCode, which the customer shares.
  memberCode               String?   @unique
  referredAt               DateTime?
  referralRewardCreditedAt DateTime? // null until the dual bonus has fired
  password                 String?
  // F19: signup collects email + password + phone, and verifies phone via a
  // WhatsApp OTP (cheaper than Twilio SMS). phoneVerifiedAt stays null until
  // the customer enters the right 6-digit code.
  phoneVerifiedAt          DateTime?
  // Set when the customer proves control of the email address — a signup code
  // sent to it, the verify-later flow on /account, or a magic link that was
  // emailed to them. WhatsApp is not an official channel and can drop, so
  // every account is verified on BOTH where both can be delivered; either one
  // alone is enough to create the account, and the other can be verified later.
  emailVerifiedAt          DateTime?
  isBlacklisted            Boolean   @default(false)
  blacklistReason          String?

  // ── Cross-module rollups (denormalized on every status change so the host
  //    stand sees the customer's full risk/value picture without joining a
  //    bunch of tables on every render) ─────────────────────────────────
  noShowCount     Int       @default(0) // lifetime no-show reservations
  complaintCount  Int       @default(0) // lifetime complaints filed
  reviewCount     Int       @default(0) // lifetime reviews left (any rating)
  // Naughty list — strikes accumulate from no-show / cash-unpaid / refused-
  // at-door incidents. At 3 active strikes, a CustomerBan row gets created
  // and the customer (plus their email/phone/IP) is locked out of fresh
  // signups + new orders + new reservations.
  strikeCount     Int       @default(0) // ACTIVE strikes (reversed/expired excluded)
  bannedAt        DateTime? // null = not banned. Mirror of CustomerBan.bannedAt for fast UI checks.
  avgReviewRating Float? // running average of their ratings
  lastVisitAt     DateTime? // most recent of (lastOrderAt, last seated reservation)
  lastComplaintAt DateTime? // when they last raised an issue (host-relevant context)
  lastReviewedAt  DateTime? // when they last left a review
  lastNoShowAt    DateTime? // when they last failed to show
  staffNotes      String? // free-form, manager-curated, shown on every host view
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  preferredConcept   Concept?                    @relation("PreferredConcept", fields: [preferredConceptId], references: [id])
  orders             Order[]
  loyaltyAccounts    LoyaltyAccount[] // one per company (ONL-04)
  magicLinks         MagicLink[]
  triggerLogs        TriggerLog[]
  campaignSends      CampaignSend[]
  walletTransactions WalletTransaction[]
  wallets            CustomerWallet[] // one per company (ONL-R2-01)
  savedAddresses     CustomerAddress[]
  reservations       Reservation[]
  guestTags          GuestTag[]
  analyticsEvents    AnalyticsEvent[]
  segmentMemberships CustomerSegmentMembership[]
  conversations      CustomerConversation[]
  feedbackEntries    FeedbackEntry[]

  // Referral relation (self-relation: who referred me, who I've referred)
  referredBy Customer?  @relation("Referrals", fields: [referredById], references: [id])
  referrals  Customer[] @relation("Referrals")

  strikes          CustomerStrike[]
  bans             CustomerBan[]
  waitlistSignups  WaitlistSignup[]
  reservationSeats ReservationGuest[]

  @@map("customers")
}

// ─── Naughty list: strikes + bans ───────────────────────────────────────────
//
// Customer accountability layer. Every offense (reservation no-show, COD
// not paid, COD refused at door) records a CustomerStrike. At 3 active
// strikes (not expired, not reversed), the system promotes the customer to
// a CustomerBan that locks out their email + phone + every IP we've seen.
// New signups + reservations + guest orders that match an active ban are
// rejected with a friendly error.
//
// Strikes auto-expire after 365 days (running tab — yesterday's no-show
// shouldn't haunt them forever). A manager can also REVERSE a strike if
// it was on them (kitchen mistake, address bug, etc.) — preserves data
// integrity but doesn't count toward the 3-strike threshold.

model CustomerStrike {
  id             String    @id @default(uuid())
  customerId     String
  // Discriminated kind — extensible. Add new strike types here as patterns emerge.
  kind           String // 'reservation_no_show' | 'cod_unpaid' | 'cod_refused' | 'chargeback' | 'other'
  // Source row. Order id for COD strikes, Reservation id for no-shows.
  sourceType     String? // 'reservation' | 'order'
  sourceId       String?
  // Severity defaults to 1; high-value incidents (>PKR 5k refused) can bump to 2 so 2 incidents trigger ban.
  severity       Int       @default(1)
  reason         String? // operator-supplied note ("driver said customer was very rude, refused to come down")
  // Strikes naturally decay after a year. expiresAt is set at insert time.
  expiresAt      DateTime?
  // Manager can forgive a strike. recordedAt + reversedAt define the audit window.
  reversedAt     DateTime?
  reversedById   String?
  reversalReason String?
  recordedById   String? // staff user id (or null = system)
  recordedAt     DateTime  @default(now())
  // The company whose incident it is (the order's / reservation's brand's company, or the ACTIVE company for a
  // manual CRM strike). Strikes count and bans apply SERVD-WIDE (owner 2026-10-15); this company decides reversals. NULL only for legacy
  // unattributable rows.
  tenantId       String?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, recordedAt])
  @@index([kind, recordedAt])
  @@index([tenantId, customerId])
  @@map("customer_strikes")
}

model CustomerBan {
  id         String  @id @default(uuid())
  customerId String? // the original offender. Null only for synthetic bans (e.g. operator-added watchlist entries).

  // Identifier fingerprints captured at offense time. New signups / orders
  // are checked against ALL of these. Phone + email are hard rejects;
  // IP is a soft signal recorded for forensic correlation only (cafe / family
  // shared-IP false-positive risk is too high for a hard block).
  email              String?
  phone              String?
  ipAddresses        String[] @default([])
  deviceFingerprints String[] @default([])

  reason     String // free-form: "3 strikes — see strikes table"
  // The company that raised the ban (owner decision 15). Since wave B (2026-10-14) ALWAYS written: the company
  // that raised the ban. A legacy NULL = applies to every company and can be lifted by the CEO (admin) only.
  // Bans are SERVD-WIDE (owner, 2026-10-15): a ban raised in one company blocks the customer everywhere; this
  // column is the company that raised it (it decides lifts and appeals). One active AUTO ban per CUSTOMER — partial
  // unique index customer_bans_one_active_auto_per_customer in SQL (migration 20261015150000; not declared here).
  tenantId   String?
  bannedById String? // null = auto-promoted by system at 3-strike threshold
  bannedAt   DateTime  @default(now())
  // Bans are permanent by default. Operators can lift via /crm/bans/:id/lift.
  liftedAt   DateTime?
  liftedById String?
  liftReason String?
  // Optional TTL — null = permanent. Lets operator set "1-year cooldown" if they want.
  expiresAt  DateTime?

  customer Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  // Help-desk appeals of this ban (OrderComplaint kind 'ban_appeal').
  appeals  OrderComplaint[] @relation("BanAppeals")

  @@index([email])
  @@index([phone])
  @@index([bannedAt])
  @@index([liftedAt])
  @@index([tenantId, customerId])
  @@map("customer_bans")
}

// ─── CRM outreach: customer chat threads ──────────────────────────────────────
// Mirrors SupplierConversation/SupplierMessage. Used when staff reach out to
// a customer about a complaint, review, or just-because — and any reply
// (email, WhatsApp) lands back in the same thread.
//
// `source` records why the thread exists: "complaint" / "review" / "manual"
// for retroactive linkage in the UI ("This thread is about complaint #1234").
// `sourceRefId` is a loose reference (no FK constraint — keeps schema flat
// and avoids cascade headaches when a complaint gets archived).

model CustomerConversation {
  id          String   @id @default(cuid())
  customerId  String
  staffId     String // who initiated the outreach
  subject     String?
  source      String   @default("manual") // "complaint" | "review" | "manual"
  sourceRefId String? // id of the complaint/review row this thread relates to
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  staff    User              @relation("CustomerConversationStaff", fields: [staffId], references: [id])
  messages CustomerMessage[]

  @@index([customerId, updatedAt])
  @@index([staffId])
  @@index([source, sourceRefId])
  @@map("customer_conversations")
}

model CustomerMessage {
  id             String    @id @default(cuid())
  conversationId String
  fromStaff      Boolean
  senderId       String?
  body           String
  mediaUrl       String?
  seenAt         DateTime?
  createdAt      DateTime  @default(now())

  // Channel of origin — same enum-as-string as SupplierMessage.channel.
  channel            String  @default("web_portal")
  externalMessageId  String? @unique
  inboundFromAddress String?

  conversation CustomerConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("customer_messages")
}

model CustomerAddress {
  id         String   @id @default(uuid())
  customerId String
  label      String // e.g. "Home", "Work", "Padel Court"
  address    String
  lat        Float?
  lng        Float?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_addresses")
}

model TriggerLog {
  id          String   @id @default(uuid())
  customerId  String
  triggerType String // birthday | winback
  createdAt   DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId, triggerType, createdAt])
  @@map("trigger_logs")
}

// ─── Loyalty tier configuration ────────────────────────────────────────────
//
// One row per tier (bronze / silver / gold). Operator-tunable from admin
// /configuration/tier-perks. Perks are checked at:
//   - Order checkout: free delivery + minimum order
//   - Reservation creation: extended-advance booking window
//   - Birthday trigger: enhanced discount instead of default 25%
//   - Storefront /account: rendered as "perks unlocked" list
//
// Sensible defaults are seeded on first read so the system works
// out-of-the-box without any admin intervention.
model TierConfig {
  id       String  @id @default(uuid())
  // Each company has its own ladder (owner decision 13).
  tenantId String?
  tier     String // 'bronze' | 'silver' | 'gold' | 'insider' | custom slug

  // Display name shown on the storefront (e.g. "Insider Gold"). The `tier`
  // field above is the immutable slug used by code; `displayName` is the
  // operator-tunable label the customer actually sees.
  displayName String?

  // Ordering — lowest rank first (bronze < silver < gold). Used to sort
  // tiers in the customer-facing perks list and the admin's tier list.
  rank Int @default(0)

  // Paid-tier support. Free tiers (bronze) get assigned automatically
  // by lifetime spend; paid tiers (Insider Gold) are subscription-priced
  // and assigned via /crm or by the customer subscribing.
  isPaid            Boolean @default(false)
  monthlyPriceCents Int? // null when isPaid=false

  // For FREE tiers, auto-upgrade once a customer's lifetime spend
  // reaches this amount (in paisa). Null = no auto-upgrade.
  unlockSpendCents Int?

  // Operator can toggle a tier off without deleting it (cancels new
  // assignments but keeps the row + historical assignments intact).
  isActive Boolean @default(true)

  // Delivery perks
  alwaysFreeDelivery     Boolean @default(false)
  freeDeliveryAboveCents Int? // free delivery for orders >= this

  // Birthday perks (override the default 25% off in the birthday trigger)
  birthdayDiscountPct Int? // null = use default

  // Reservation perks
  priorityReservationDays Int? // can book N days ahead beyond ReservationPolicy.maxAdvanceDays
  waitlistPriority        Boolean @default(false) // promoter loop offers them slots first

  // Monthly comp credit (auto-credited as wallet balance on the 1st)
  monthlyCompCents Int?

  // Misc flags
  earlyMenuAccess  Boolean @default(false)
  freeBirthdayItem Boolean @default(false)

  // Freeform perks — bullet-points the operator wants on this tier that
  // don't fit the structured booleans above. Examples:
  //   "Access to the off-menu Stax sandwiches"
  //   "Priority WhatsApp line for orders"
  //   "Invite-only omakase nights at Simmer"
  // Stored as a string array; rendered as a bulleted list on the
  // storefront /insiders page and inside the perks list on /account.
  customPerks String[] @default([])

  description String? // operator-facing rationale
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, tier])
  @@map("tier_configs")
}

// ─── Customer feedback (NPS / one-question surveys) ────────────────────────
//
// Distinct from OrderReview (rating tied to a specific order) and
// OrderComplaint (formal grievance with a status workflow). FeedbackEntry
// is for one-tap NPS/CSAT signals: "would you recommend us?", "how was your
// most recent experience?". Submitted via a global widget on the storefront.
//
// kind:
//   nps        — "How likely are you to recommend us?" 0..10 score
//   csat       — "How was your most recent experience?" 1..5 score
//   open       — anonymous freeform suggestion box ("got an idea?")
model FeedbackEntry {
  id          String   @id @default(uuid())
  customerId  String?
  conceptId   String? // null = brand-agnostic / servd-wide feedback
  kind        String // 'nps' | 'csat' | 'open' | 'contact'
  score       Int? // 0..10 for nps, 1..5 for csat, null for open / contact
  comment     String?
  context     Json? // { page, orderId, reservationId, etc. } — set by client
  source      String   @default("storefront")
  createdAt   DateTime @default(now())
  // SEO round 1 (WP4): the company that owns the entry — always derived on
  // the server (the chosen brand's company, else the primary company for a
  // contact message), never from the client. Null only on legacy rows with no
  // brand, which no company can read.
  tenantId    String?
  // 'contact' kind only: who wrote, how to reply (never messaged on submit),
  // and the topic (catering | complaint | press | jobs | other).
  contactName String?
  replyPhone  String?
  replyEmail  String?
  topic       String?

  customer Customer? @relation(fields: [customerId], references: [id])
  concept  Concept?  @relation(fields: [conceptId], references: [id])

  @@index([conceptId, createdAt])
  @@index([customerId, createdAt])
  @@index([tenantId, kind, createdAt])
  @@map("feedback_entries")
}

// ─── MagicLink ────────────────────────────────────────────────────────────────

model MagicLink {
  id         String    @id @default(uuid())
  customerId String
  token      String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  // Where the link was sent. Following it proves control of that address, so
  // verify stamps emailVerifiedAt / phoneVerifiedAt accordingly. Null on links
  // issued before this column existed — those verify nothing.
  channel    String? // 'email' | 'phone'
  createdAt  DateTime  @default(now())

  customer Customer @relation(fields: [customerId], references: [id])

  @@map("magic_links")
}

// B14: durable webhook idempotency log. Pre-fix this was Redis-only, which
// meant a Redis blip during a Foodpanda reconnect could replay an old order
// (and re-fire all the side effects). Postgres unique-PK insert is the
// source of truth now; Redis stays as a fast-path.
model WebhookEvent {
  source      String // 'foodpanda' | 'careem' | 'keenu' | 'postmark' …
  eventId     String // gateway's idempotency key
  receivedAt  DateTime @default(now())
  payloadHash String? // optional SHA-256 for forensics

  @@id([source, eventId])
  @@map("webhook_events")
}

// F19: short-lived OTP codes for phone verification, delivered over WhatsApp.
// We avoid Twilio entirely — Meta's Cloud API is free for the first 1k convos
// per month and we already maintain the integration for supplier chat.
//
// Lifecycle: signup creates a row with a 6-digit `code` and 5-minute `expiresAt`.
// On verify, `consumedAt` is set so the same code can't be reused; failed
// attempts increment `attempts` and lock at 5 (caller enforces).
model PhoneOtp {
  id         String    @id @default(uuid())
  phone      String // normalised E.164-ish (digits + leading country code, no +)
  code       String // 6-digit numeric
  purpose    String // 'signup' | 'phone_verify' | 'password_reset'
  customerId String? // null for pre-signup OTPs
  attempts   Int       @default(0)
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([phone, purpose, createdAt])
  @@map("phone_otps")
}

// Email counterpart of PhoneOtp. Same lifetime, attempt limit and cooldown,
// kept as its own table rather than a `channel` column so neither existing
// query on phone_otps changes shape.
model EmailOtp {
  id         String    @id @default(uuid())
  email      String // lowercased
  code       String // 6-digit numeric
  purpose    String // 'signup' | 'email_verify'
  customerId String?
  attempts   Int       @default(0)
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([email, purpose, createdAt])
  @@map("email_otps")
}

// ─── StaffPasswordReset ───────────────────────────────────────────────────────
//
// Self-service "I forgot my password" for staff. Before this existed the only
// remedies were /auth/password/change (which needs the password you forgot) and
// an admin calling /auth/users/:id/reissue-password — so the one person most
// likely to be locked out, the admin, had no way back in without someone else.
//
// Deliberately NOT reusing PhoneOtp: that model is keyed on a phone number and
// stores its code in plaintext, which is tolerable for a 5-minute 6-digit code
// but not for a link token that is a full account takeover in one click. Here
// we store only a SHA-256 of the token, so a database read does not hand
// anyone a working reset link.
model StaffPasswordReset {
  id          String    @id @default(uuid())
  userId      String
  // SHA-256 hex of the token. The token itself only ever exists in the message.
  tokenHash   String    @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  // Who asked, for the audit trail — a burst of these is worth noticing.
  requestedIp String?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("staff_password_resets")
}

// ─── LoyaltyAccount ───────────────────────────────────────────────────────────

// One account per customer PER COMPANY (ONL-04). Points are earned, spent,
// expired and clawed back only at the brands of the company that issued them
// ("loyalty stays inside the company that issued it"), and that company's
// books carry the liability (2060). A single shared account let points earned
// at one company be spent at another, which then carried a liability it never
// raised. Migration 20261010150300 split the old per-customer rows.
model LoyaltyAccount {
  id             String   @id @default(uuid())
  tenantId       String
  customerId     String
  pointsBalance  Int      @default(0)
  lifetimePoints Int      @default(0)
  tier           String   @default("bronze") // the company's tier ladder (TierConfig)
  stampCounts    Json     @default("{}") // { "simmer": 3, "stackd": 7 } — that company's brands
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  customer     Customer             @relation(fields: [customerId], references: [id])
  transactions LoyaltyTransaction[]

  @@unique([tenantId, customerId])
  @@index([customerId])
  @@map("loyalty_accounts")
}

// ─── LoyaltyTransaction ───────────────────────────────────────────────────────

model LoyaltyTransaction {
  id               String        @id @default(uuid())
  loyaltyAccountId String
  orderId          String?
  type             LoyaltyTxType
  pointsDelta      Int
  description      String?
  createdAt        DateTime      @default(now())
  // Set on an `earn` row once a refund has clawed those points back.
  // Reversal used to be idempotent on (orderId, type='reversal') — per ORDER,
  // not per transaction — so an order carrying two earns (the completion earn
  // and the 50-point review bonus both share its orderId) had only the first
  // reversed and the second survived the refund.
  reversedAt       DateTime?

  loyaltyAccount LoyaltyAccount @relation(fields: [loyaltyAccountId], references: [id])
  order          Order?         @relation(fields: [orderId], references: [id])

  @@map("loyalty_transactions")
}

// ─── Order ────────────────────────────────────────────────────────────────────

model Order {
  id                    String         @id @default(uuid())
  conceptId             String
  locationId            String? // physical place; nullable so existing rows still work — auto-set from Shift / cashier session
  source                OrderSource
  // How does this order leave the kitchen? Drives plating (real plate vs.
  // container), end-of-pipeline handoff (server / counter / rider), and the
  // expo "Served" button copy. Inferred from source+tableId at ingestion if
  // the upstream channel didn't tell us:
  //   tableId set + source=pos      → dine_in
  //   source in (foodpanda, careem) → delivery
  //   source in (servd, cart, pos)  → takeout when no table, dine_in when table
  fulfilmentType        FulfilmentType @default(dine_in)
  externalId            String? // platform-assigned ID; null for native orders
  status                OrderStatus    @default(received)
  tableId               String?
  customerId            String?
  customerName          String? // raw name for non-direct orders
  posStaffId            String? // staff who created it (POS)
  shiftId               String? // associated shift (POS cash orders)
  riderId               String?
  promoCodeId           String?
  totalCents            Int
  discountCents         Int            @default(0)
  promoDiscountCents    Int            @default(0)
  walletAmountCents     Int            @default(0)
  taxCents              Int            @default(0)
  // The GST rate the order was priced at (15 cash / 8 card); null on old rows.
  taxRatePct            Float?
  // Service charge: house-imposed % on subtotal, recognised as revenue (4100).
  serviceChargeCents    Int            @default(0)
  // Tips: customer-discretionary, paid through to staff. Liability (2090
  // accrued / 6031 settled at payroll) — not house revenue.
  tipCents              Int            @default(0)
  deliveryNotes         String?
  estimatedPickup       DateTime?
  scheduledFor          DateTime?
  isPreOrder            Boolean        @default(false)
  // Rider hand-off OTP — 4-digit code shown to customer on the storefront.
  // Rider must enter this on dispatch to mark the order delivered. Prevents
  // riders from claiming "delivered" without proof. Set on order placement
  // for delivery orders; verified at dispatch.
  deliveryOtp           String?
  deliveryOtpVerifiedAt DateTime?
  deliveryOtpAttempts   Int            @default(0)
  // Completed with the customer's code (rider app or staff Enter code); staff Delivered only while the company's
  // code-only switch is off (lib/deliveryRules.ts codeOnlyDelivery). The claim that counts a delivery exactly once.
  deliveredAt           DateTime?
  // The CURRENT rider's job stages (rider app v1, docs/rider-app.md). Set by
  // dispatch/service.ts and the rider routes; reset when the rider is taken
  // off. The full history (offers, declines, time-outs) is RiderJobEvent.
  riderAssignedAt       DateTime? // offered to the rider (manual assign or auto-dispatch)
  riderAcceptedAt       DateTime? // the rider accepted the offer
  pickedUpAt            DateTime? // the rider has the bag
  arrivedAt             DateTime? // the rider is at the customer's door
  placedAt              DateTime       @default(now())
  completedAt           DateTime?

  // Post-order review prompt timestamps. Worker sends a "rate your meal"
  // SMS+email 30 min after completion if the guest hasn't already reviewed.
  // The flag prevents double-prompts.
  reviewPromptSentAt DateTime?

  // ── Curbside / car-hopping fulfilment ────────────────────────────────
  // When the customer chooses curbside at checkout, they're prompted for
  // their vehicle description (and optionally plate). On arrival, they hit
  // POST /storefront/orders/:id/arrived which stamps `curbsideArrivedAt`.
  // The admin /orders/curbside queue lights up — staff runs food out.
  // Presence of `curbsideVehicle` is the canonical "this is a curbside
  // order" signal; nothing here clashes with delivery/pickup/dine-in.
  curbsideVehicle     String?
  curbsidePlate       String?
  curbsideSpot        String? // optional designated spot ("A3", "Front 2")
  curbsideArrivedAt   DateTime?
  curbsideRunnerOutAt DateTime? // when staff hit "running it out"

  // Auto-cancellation: set by the orderAutoCancel worker when an order times
  // out in 'received' (>30 min) or 'confirmed' (>2 h) without progressing.
  cancelledAt        DateTime?
  cancellationReason String?

  // Delivery fee (owner 2026-10-13 + H9; wave B, per-ticket INT4): the zone fee BEFORE GST, and the GST charged on
  // it at the order's tender rate (round(fee × rate / 100)). taxCents = food GST + deliveryFeeTaxCents. Written by
  // ingestOrder from priceOrder; 0 on legacy orders (no backfill — their fee stays in brand revenue).
  deliveryFeeCents        Int       @default(0)
  deliveryFeeTaxCents     Int       @default(0)
  // Emergency override (a): the hand-over code was sent to the RIDER (once per order; conditional claim on null).
  handoverReroutedAt      DateTime?
  handoverRerouteRiderId  String? // assignRider / unassign refuse another rider while set and undelivered
  handoverRerouteAttempts Int? // deliveryOtpAttempts at the reroute (then reset to 0; riderScoring reads this)
  // Emergency override (b): the food came back and was booked as waste.
  returnedAt              DateTime?
  returnCause             String? // 'refused' | 'unreachable' | 'other' — CHECK orders_return_cause_chk (SQL only)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // READ-ONLY HISTORY since 2026-10-10: numbers from servd's old direct
  // FBR/SRB filing. Nothing writes these after the POS-connector cutover; the
  // fiscal number now lives on FiscalDocument. They drive the prefiled_direct
  // skip and the receipt fallback for orders filed before the cutover.
  // FBR PRAL invoice number (old direct filing).
  fbrInvoiceNumber String?

  // SRB invoice number returned after successful submission to the Sindh
  // Revenue Board e-invoicing API. Null = order's concept isn't SRB-registered
  // (outside Sindh) OR the SRB worker hasn't processed the order yet.
  srbInvoiceNumber String?

  // SRB invoice-verification QR link returned alongside srbInvoiceNumber. Per
  // the SRB POS spec this link MUST be rendered as a QR code on the receipt.
  srbQrCodeLink String?

  // ── Till flow (owner, 2026-10-20; backend/src/modules/pos/TILL_FLOW.md) ──
  // How the bill was closed: 'keenu' = pushed to the Keenu fiscal POS (it settles and
  // files; revenue → the brand's main sales account), 'servd' = closed in servd (cash /
  // card / Raast / on account; revenue → the brand's servd sub-account; its fiscal
  // document waits for a MANUAL filing on the SRB / FBR portal). Null = legacy / non-till.
  settlementChannel   SettlementChannel?
  // Keenu push state (pos/keenuPush.ts): { keenu: { pushId, state, method, tipCents, shiftId, providerRef, at } }.
  settlementMeta      Json?
  // Waiter on the ticket: an HR employee of the ORDER's company (login or not — the
  // tip-pool member rule); typed at the till as their employee code.
  waiterEmployeeId    String?
  // Pax: the number of guests at the table.
  partySize           Int?
  // The guest's registration number with this company, as typed at the till (free text).
  guestRegistrationNo String?

  // raw platform payload stored for audit/debug
  rawPayload Json?

  concept             Concept              @relation(fields: [conceptId], references: [id])
  location            Location?            @relation(fields: [locationId], references: [id])
  table               Table?               @relation(fields: [tableId], references: [id])
  customer            Customer?            @relation(fields: [customerId], references: [id])
  posStaff            User?                @relation("PosStaff", fields: [posStaffId], references: [id])
  rider               Rider?               @relation(fields: [riderId], references: [id])
  promoCode           PromoCode?           @relation(fields: [promoCodeId], references: [id])
  waiter              HrEmployee?          @relation("OrderWaiter", fields: [waiterEmployeeId], references: [id], onDelete: SetNull)
  items               OrderItem[]
  payments            Payment[]
  loyaltyTxs          LoyaltyTransaction[]
  giftCardRedemptions GiftCardRedemption[]
  financialEntries    FinancialEntry[]
  taxInvoices         TaxInvoice[]
  review              OrderReview?
  complaints          OrderComplaint[]
  promoUsages         PromoCodeUsage[]
  riderJobEvents      RiderJobEvent[]

  // POS connector (fiscal outbox + card machine) and pre-bills (2026-10-10)
  fiscalDocuments FiscalDocument[]
  terminalCharges TerminalCharge[]
  preBills        PreBill[]
  raastReceipts   RaastReceipt[]

  @@unique([source, externalId])
  @@index([conceptId, placedAt(sort: Desc)])
  @@index([locationId, placedAt(sort: Desc)])
  @@index([status, placedAt(sort: Desc)])
  @@index([customerId])
  @@index([shiftId])
  @@index([placedAt(sort: Desc)])
  // The rider app reads "orders on this rider's hands" on every request, every
  // location fix and every hand-back (dispatch/service riderOpenOrderWhere).
  @@index([riderId, deliveredAt])
  @@index([waiterEmployeeId])
  @@index([settlementChannel])
  @@map("orders")
}

// ─── OrderItem ────────────────────────────────────────────────────────────────

model OrderItem {
  id              String     @id @default(uuid())
  orderId         String
  menuItemId      String? // null if unmapped platform item
  stationId       String?
  externalItemId  String?
  name            String // raw item name (preserved from source)
  quantity        Int        @default(1)
  unitPriceCents  Int
  status          ItemStatus @default(pending)
  notes           String?
  course          Int? // course number for sequencing
  firedAt         DateTime?
  // Owner B12 (2026-10-26): a line with no recipe steps — when the cook
  // tapped Start, and when the card first showed in the station's visible
  // window (the expo's 60-second unstarted alert reads both).
  startedAt       DateTime?
  kdsShownAt      DateTime?
  completedAt     DateTime?
  voidedAt        DateTime?
  voidReason      String?
  scheduledFireAt DateTime? // course pacing: when this item should auto-fire
  bumpPhotoUrl    String? // R2 URL of plating photo captured at bump
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  // Packaging (wave B, owner's FINAL packaging rule 2026-10-13): the brand's service vessel at ring-up, and "Box given"
  // for a dine-in line whose leftovers were boxed. The line's packaging is consumed (FIFO, Dr 5030 / Cr 1230) when
  // packagingApplies(order, line): takeaway/delivery → yes; serviceVessel 'packaging' → yes; dine-in plate → only if
  // boxGiven. CHECK order_items_service_vessel_chk (SQL only).
  serviceVessel String? // 'plate' | 'packaging' (null on legacy rows = read the brand's current vessel)
  boxGiven      Boolean   @default(false)
  boxGivenAt    DateTime?
  boxGivenById  String?

  // Removals (owner, 2026-10-27: "any item that is being deducted from stock will be adjusted if customer asks to
  // remove"): the ingredients of the dish's approved plate recipe the customer asked to leave out — a JSON array of
  // { masterIngredientId | inventoryItemId | prepRecipeId, name } (lib/lineRemovals.ts). The sale draws none of them
  // (lib/recipeCost.ts consumptionPerLine); tickets / KDS / receipts print "No <name>". Price unchanged. Null = none.
  removedIngredients Json?

  order     Order               @relation(fields: [orderId], references: [id])
  menuItem  MenuItem?           @relation(fields: [menuItemId], references: [id])
  station   Station?            @relation(fields: [stationId], references: [id])
  modifiers OrderItemModifier[]
  steps     OrderItemStep[]

  @@index([orderId])
  @@index([stationId, status])
  @@map("order_items")
}

// ─── OrderItemModifier ────────────────────────────────────────────────────────

model OrderItemModifier {
  id              String  @id @default(uuid())
  orderItemId     String
  modifierId      String?
  name            String // raw name
  priceDeltaCents Int     @default(0)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id])
  modifier  Modifier? @relation(fields: [modifierId], references: [id])

  @@map("order_item_modifiers")
}

// ─── Payment ──────────────────────────────────────────────────────────────────

model Payment {
  id            String         @id @default(uuid())
  orderId       String
  shiftId       String?
  method        PaymentMethod
  amountCents   Int
  status        PaymentStatus  @default(pending)
  gateway       PaymentGateway @default(none)
  gatewayRef    String? // gateway transaction ID
  gatewayMeta   Json? // raw gateway response
  tenderedCents Int? // for cash: amount given
  changeCents   Int? // for cash: change returned
  // Check-splitting: when one bill is split across multiple diners, each
  // diner has their own Payment row pointing at the same orderId. The split
  // group is an integer (1, 2, 3, …) with an optional label; total of all
  // splits must equal order total.
  splitGroup    Int? // 1-based; null = single payment for whole bill
  splitLabel    String? // e.g. "Ali", "Sara", or "Half 1"
  processedAt   DateTime?
  // Retry tracking for failed gateway payments. Worker increments retryCount
  // up to 3 attempts; after that status flips to 'failed' permanently.
  retryCount    Int            @default(0)
  lastRetryAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // H5 'rider' (wave B): delivered COD booked by finance as owed by the rider. Own rider: Dr 1351 / Cr 1010
  // ('cod.rider_debt:<paymentId>', codRiderDebtEntryId). Fleet rider of another company: an IntercompanyTransfer
  // (source 'cod', codRiderDebtTransferId). Reversed in settlePayment when the rider hands the cash in.
  codRiderDebtAt         DateTime?
  codRiderDebtById       String?
  codRiderDebtEntryId    String?
  codRiderDebtTransferId String?

  order        Order         @relation(fields: [orderId], references: [id])
  shift        Shift?        @relation(fields: [shiftId], references: [id])
  raastReceipt RaastReceipt?

  @@index([orderId])
  @@index([shiftId, status])
  @@index([gatewayRef])
  @@map("payments")
}

// ─── Tip pool ────────────────────────────────────────────────────────────────
//
// A pool covers a date range (typically a shift or a service period). Tips
// collected from orders during the period (Order.tipCents → posted to the
// 2095 Tips Payable liability) are distributed to staff present in the pool
// according to their configured share weight × hours worked.
//
// On payout, the pool posts: Dr 2095 Tips Payable / Cr cash or bank.

enum TipPoolStatus {
  draft
  posted // distribution committed, lines locked
  paid // funds disbursed to staff
}

model TipPool {
  id             String        @id @default(uuid())
  // The company the pool belongs to (HR-R7, migration 20261012120000). It
  // decides everything company-shaped about the pool: who may see and edit
  // it, which chart its payout posts to, and which inbox its flags reach.
  // Set from the ACTIVE company on create (the brand must be that company's).
  tenantId       String
  conceptId      String? // the brand whose tips these are; null only on legacy rows
  name           String // e.g. "Sat dinner shift", "Week of Apr 28"
  periodStart    DateTime
  periodEnd      DateTime
  totalTipsCents Int           @default(0)
  status         TipPoolStatus @default(draft)
  postedAt       DateTime?
  // Who posted (approved) the pool — set in the same write that flips it to
  // 'posted' (migration 20261017150000). Finance may pay a pool only when the
  // CEO (role admin) posted it (owner, 2026-10-17). Null on pools posted
  // before the column existed: finance is refused, the approvers pay.
  postedById     String?
  paidAt         DateTime?
  createdById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant  Tenant          @relation("TenantTipPools", fields: [tenantId], references: [id], onDelete: Restrict)
  members TipPoolMember[]

  @@index([periodStart(sort: Desc)])
  @@index([tenantId, periodStart])
  @@map("tip_pools")
}

// A pool member is a login holder (userId) OR an HR employee with no servd
// login — kiosk / time-clock staff (employeeId). Exactly one of the two is
// set: a CHECK constraint in migration 20261012120000 enforces it.
//
// One row per person per pool: two PARTIAL unique indexes in that migration's
// SQL — "tip_pool_members_poolId_userId_key" (poolId, userId) WHERE userId IS
// NOT NULL and "tip_pool_members_poolId_employeeId_key" (poolId, employeeId)
// WHERE employeeId IS NOT NULL. Prisma cannot express a partial unique (and
// its migrate diff does not see one), so they are deliberately NOT declared
// here — declaring them would make the next generated migration try to
// create them again. tests/setup.ts adds them (and the CHECK) after db push.
model TipPoolMember {
  id          String  @id @default(uuid())
  poolId      String
  userId      String?
  employeeId  String?
  userName    String // name snapshot — survives if the login or HR record is later deleted
  // Computed: hoursWorked × roleWeight = shareUnits. Operator can override
  // shareUnits manually before posting (e.g. for tipout to BOH).
  hoursWorked Float
  roleWeight  Float   @default(1.0)
  shareUnits  Float
  shareCents  Int     @default(0) // computed share — set when pool is posted
  notes       String?

  pool     TipPool     @relation(fields: [poolId], references: [id], onDelete: Cascade)
  user     User?       @relation(fields: [userId], references: [id], onDelete: Restrict)
  employee HrEmployee? @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([poolId])
  @@index([userId])
  @@index([employeeId])
  @@map("tip_pool_members")
}

// ─── Group orders (shared cart) ──────────────────────────────────────────────
//
// One initiator creates a group order at a brand. Friends join via a share
// link, each adds items as themselves. Initiator (or any member) closes the
// cart and submits as one Order. Each member's contribution is preserved in
// the order's items via an inviteCode label.

enum GroupOrderStatus {
  open
  locked // closed for new items, awaiting checkout
  submitted // turned into a real Order
  cancelled
}

model GroupOrder {
  id                  String           @id @default(uuid())
  conceptId           String
  initiatorCustomerId String?
  initiatorName       String // free-text in case initiator isn't a customer yet
  shareCode           String           @unique // 6-char shareable
  status              GroupOrderStatus @default(open)
  closingAt           DateTime? // soft deadline shown to participants
  orderId             String? // set when submitted
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  concept Concept            @relation(fields: [conceptId], references: [id])
  members GroupOrderMember[]
  items   GroupOrderItem[]

  @@index([shareCode])
  @@map("group_orders")
}

model GroupOrderMember {
  id           String   @id @default(uuid())
  groupOrderId String
  customerId   String?
  displayName  String
  joinedAt     DateTime @default(now())

  groupOrder GroupOrder       @relation(fields: [groupOrderId], references: [id], onDelete: Cascade)
  items      GroupOrderItem[]

  @@unique([groupOrderId, displayName])
  @@map("group_order_members")
}

model GroupOrderItem {
  id             String   @id @default(uuid())
  groupOrderId   String
  memberId       String
  menuItemId     String
  name           String // snapshot
  quantity       Int      @default(1)
  unitPriceCents Int
  notes          String?
  createdAt      DateTime @default(now())

  groupOrder GroupOrder       @relation(fields: [groupOrderId], references: [id], onDelete: Cascade)
  member     GroupOrderMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([groupOrderId])
  @@map("group_order_items")
}

// ─── InventoryItem ────────────────────────────────────────────────────────────

model InventoryItem {
  id                 String    @id @default(uuid())
  // Tenant the ingredient stock belongs to. Critical: inventory is per-
  // company — GS Foods Bukhari's chicken doesn't show up in GS x Viva
  // Clifton's par sheet. Backfilled to the supplier's tenant where one
  // exists; legacy rows with no supplier remain nullable until the CEO
  // assigns them via the inventory edit drawer.
  tenantId           String?
  name               String
  unit               String // e.g. "kg", "pcs", "litres"
  parLevel           Float     @default(0)
  currentStock       Float     @default(0)
  // Cost per purchase unit (paisa). Since wave B (food cost on FIFO lots) = the FIFO HEAD cost: the oldest open lot,
  // else the latest lot, else the typed estimate. Every recipe/pricing/menu-engineering screen reads it. Editable only
  // while the item has no lots (422 COST_FROM_DELIVERIES — existing error name kept).
  unitCostCents      Int?
  // The negotiated price on the sourcing sheet. A reference only; never the cost.
  listPriceCents     Int?
  // Edible portion after trim/peel/loss. The Recipe page uses this as the
  // default yield when adding this ingredient to a recipe; per-recipe rows
  // can still override on RecipeIngredient.yieldPct.
  yieldPct           Float     @default(100)
  // Dietary tags surfaced on Recipe / Menu pages — e.g. ['dairy','gluten'].
  allergens          String[]  @default([])
  // Classification: protein | produce | dairy | dry_goods | sauce | spices | sweetener | oil_fat | flour_grain | bakery | frozen | beverage | packaging | other — z.enum in the
  // route (lib/inventoryClass.ts INVENTORY_CATEGORIES; legacy values normalised by migration 20261014090000).
  // Cost class: beverage → 1220/5020, packaging → 1230/5030, everything else food (1210/5010).
  category           String?
  supplierId         String?
  notes              String?
  // Unmeasured consumables (oil, salt, items on no recipe): each receipt is issued straight to cost of sales
  // ('issue_on_receipt', an explained bucket of the food-cost report) instead of waiting for a count.
  issueOnReceipt     Boolean   @default(false)
  // Stock by site, prep as stock (owner, 2026-10-24). kind 'stock' = bought; 'prep' = a prep (sub-recipe) item made in
  // house by a prep batch (prepRecipeId = its recipe, one item per recipe PER COMPANY — kitchen flow 2026-10-26).
  // CHECK inventory_items_kind_chk (SQL only).
  kind               String    @default("stock")
  prepRecipeId       String?
  // Units: the unit it is BOUGHT in (e.g. "case of 24") and how many stock units (`unit`) one purchase unit holds.
  // PO / receipt / bill lines may be typed in the purchase unit; the dock converts (qty × factor, cost ÷ factor).
  purchaseUnit       String?
  purchaseUnitFactor Float     @default(1)
  // Count schedule: 'daily' | 'weekly' (GET /physical-counts/due). CHECK inventory_items_count_frequency_chk.
  countFrequency     String    @default("weekly")
  // Kitchen flow (owner, 2026-10-26, K1): the servd-wide IngredientMaster row this company's stock item is. The master
  // owns the DEFINITION (unit, category, allergens, yield %, buying unit + factor, spec); the company keeps its price,
  // supplier, par and stock. One live stock item per master per company — partial unique index
  // inventory_items_tenant_master_live_key (SQL only, migration 20261026120000_ingredient_master). Prep items have none.
  masterIngredientId String?
  // Use-by dates (owner B6, 2026-10-26). A MIRROR of the master's definition for a linked item (MASTER_FIELDS, kept
  // in step by the master PATCH, locked on the item); an unlinked item (a prep item, a legacy row) keeps its own.
  // perishable = a delivery line must carry a use-by date (422 USE_BY_REQUIRED at the dock) unless shelfLifeDays
  // gives the default (received day + shelfLifeDays). CHECK inventory_items_shelf_life_chk (1–3650, SQL only).
  perishable         Boolean   @default(false)
  shelfLifeDays      Int?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  supplier           Supplier?           @relation(fields: [supplierId], references: [id])
  tenant             Tenant?             @relation("TenantInventoryItems", fields: [tenantId], references: [id], onDelete: SetNull)
  recipeIngredients  RecipeIngredient[]
  purchaseOrderLines PurchaseOrderLine[]
  priceHistory       ItemPriceHistory[]
  billLines          SupplierBillLine[]
  wasteLogs          WasteLog[]
  components         Component[]
  stockTransfers     StockTransfer[]
  lots               StockLot[]
  stockBalances      StockBalance[]
  prepRecipe         Recipe?             @relation("PrepRecipeItem", fields: [prepRecipeId], references: [id])
  masterIngredient   IngredientMaster?   @relation(fields: [masterIngredientId], references: [id])

  @@unique([tenantId, prepRecipeId])
  @@index([tenantId])
  @@index([masterIngredientId])
  @@map("inventory_items")
}

// ─── Daily par per outlet (kitchen flow, owner 2026-10-26, K5) ───────────────
// "Par = one count shown in PORTIONS." The portions of a prep (sub-recipe, kind 'component') an outlet wants on hand
// at the start of a weekday (0 = Sunday … 6 = Saturday, Karachi). Company data: tenantId = the OUTLET's company;
// RLS; in the company-merge repoint list. Set by kitchen managers (PUT /kitchen/par-targets), suggested from the
// forecast; read by the par board and the prep list (target = max(par, forecast need)).
model ParTarget {
  id          String   @id @default(uuid())
  tenantId    String
  locationId  String
  recipeId    String
  weekday     Int
  portions    Float
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([tenantId, locationId, recipeId, weekday])
  @@index([tenantId])
  @@index([locationId])
  @@map("par_targets")
}

// ─── Ingredient master (owner, 2026-10-26, K1–K3, K6) ────────────────────────
// SERVD-WIDE BY DESIGN — deliberately NO tenantId (platform data, like the servd:* storefront pages): the owner
// decided one ingredient definition for every company ("Ingredient master is SERVD-WIDE (not per company)"). It holds
// only the DEFINITION — never a price, a supplier, a par or stock: each company's InventoryItem (masterIngredientId)
// keeps those, company-scoped as before. A chef may add a new one while writing a recipe (status 'needs_review', K2);
// a reviewer (CEO / fnb_manager) fixes or MERGES duplicates (mergedIntoId → the row it was merged into; never deleted).
// `spec` / `specFields` = the spec list (K6): what we BUY (e.g. burger meat = 80/20, coarse ground) — printed on POs and
// the shopping list. Unique on (normalizedName, lower(stockUnit)) among live (not merged) rows — partial unique index
// ingredient_masters_name_unit_live_key (SQL only). CHECK ingredient_masters_status_chk.
model IngredientMaster {
  id                 String   @id @default(uuid())
  name               String
  normalizedName     String
  stockUnit          String
  category           String?
  allergens          String[] @default([])
  yieldPct           Float    @default(100)
  purchaseUnit       String?
  purchaseUnitFactor Float    @default(1)
  spec               String?
  specFields         Json?
  // Use-by dates (owner B6, 2026-10-26): the DEFINITION of perishable + its shelf life in days (optional). Linked
  // company items mirror both (lib/ingredientMaster.ts MASTER_FIELDS). CHECK ingredient_masters_shelf_life_chk.
  perishable         Boolean  @default(false)
  shelfLifeDays      Int?
  status             String   @default("approved")
  createdByUserId    String?
  createdInTenantId  String?
  mergedIntoId       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  inventoryItems InventoryItem[]
  prices         IngredientMasterPrice[]

  @@index([normalizedName])
  @@index([status])
  @@map("ingredient_masters")
}

// A price typed on the Ingredients sheet (owner, 2026-10-29: "just make this editable within the table"). servd-wide
// like its ingredient — DELIBERATELY no tenantId (platform data: the one servd price, lib/ingredientPrices.ts). Rows
// are never edited or deleted: each edit is a new row, so the history keeps every typed price. Paisa per BASE unit
// (g / ml / pcs) — fractional, as a kg price is typed.
model IngredientMasterPrice {
  id                 String           @id @default(uuid())
  masterIngredientId String
  master             IngredientMaster @relation(fields: [masterIngredientId], references: [id])
  perBaseCents       Float
  setById            String?
  setAt              DateTime         @default(now())

  @@index([masterIngredientId, setAt])
  @@map("ingredient_master_prices")
}

// Stock by site (owner, 2026-10-24): the per-site on-hand cache — Σ remainingQty of the item's lots at that location.
// Kept by lib/stockLedger.ts with every lot change (InventoryItem.currentStock stays the company total). Lots with no
// site (a company with no location) have no row.
model StockBalance {
  id              String   @id @default(uuid())
  tenantId        String
  inventoryItemId String
  locationId      String
  qty             Float    @default(0)
  updatedAt       DateTime @updatedAt

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@unique([inventoryItemId, locationId])
  @@index([tenantId])
  @@index([tenantId, locationId])
  @@map("stock_balances")
}

// ─── WasteLog ─────────────────────────────────────────────────────────────────

model WasteLog {
  id                 String   @id @default(uuid())
  inventoryItemId    String
  quantity           Float
  unit               String
  // spoilage | over_prep | expired | damaged | other | void_after_fire | cancelled_after_fire | returned_food |
  // transit_loss | remake
  reason             String
  estimatedCostCents Int? // since wave B = the FIFO value taken from the lots
  photoUrl           String? // required when waste cost > photoRequiredAboveCents (OperationsConfig)
  approvedById       String? // supervisor who approved (PIN-verified)
  notes              String?
  recordedById       String?
  recordedAt         DateTime @default(now())
  // Food cost wave B (2026-10-14)
  tenantId           String? // the item's company (backfilled); every new row sets it
  conceptId          String? // brand charged (else the usage split, H20)
  locationId         String? // outlet tag (per-outlet stock is the NEXT build)
  orderItemId        String? // a sold line wasted (void_after_fire | cancelled_after_fire | returned_food); key pos.void_waste:<orderItemId>

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  recordedBy    User?         @relation(fields: [recordedById], references: [id])

  @@index([inventoryItemId, recordedAt(sort: Desc)])
  @@index([recordedAt(sort: Desc)])
  @@index([tenantId, recordedAt])
  @@index([orderItemId])
  @@map("waste_logs")
}

// ─── Supplier ─────────────────────────────────────────────────────────────────

// BOOKS-06: money columns on this model are BIGINT paisa (lib/money.ts returns them as JS numbers).
model Supplier {
  id                  String    @id @default(uuid())
  // Tenant the supplier belongs to. Procurement is multi-tenant — GS Foods
  // Bukhari's chicken vendor isn't visible to GS x Viva Clifton. PurchaseOrder
  // / SupplierBill / SupplierPayment all scope through this relation, so we
  // only need the column on the root entity. Nullable for legacy rows; the
  // workforce-style "no company" badge surfaces orphans in the UI.
  tenantId            String?
  name                String
  category            String? // meat, fish, farm, dairy, dry-goods, etc.
  assignedStaffId     String? // procurement person responsible
  phone               String?
  email               String?
  // Separate from `phone`: many suppliers use a different number for WhatsApp
  // (personal vs. business line). Stored E.164 digits (e.g. "923001234567",
  // no leading + or spaces) so it matches the format Meta sends in the
  // WhatsApp Cloud API webhook `from` field exactly.
  whatsappPhone       String?
  address             String?
  taxId               String? // NTN / STRN
  notes               String?
  paymentTermsDays    Int       @default(30)
  leadTimeDays        Int?
  openingBalanceCents BigInt    @default(0)
  // The day the opening balance is brought forward at (the company's go-live
  // for this supplier). Its ledger postings are dated at it; null = createdAt.
  openingBalanceDate  DateTime? @db.Date
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?
  // Withholding (H8/H28, wave B) — the ONE vendor master (OpEx/CapEx vendors are Suppliers).
  filerStatus         String    @default("unknown") // filer | non_filer | exempt | unknown (unknown = filer rate + 'Check ATL' warning)
  whtExemptCertNo     String? // s.153 exemption certificate (belongs to the supplier, never per payment)
  whtExemptUntil      DateTime?
  defaultTaxAuthority String? // fbr | srb | pra | kpra | bra — who usually charges us sales tax
  defaultWhtSection   String? // 153_1_a | 153_1_b | 153_1_c | 155 | none
  // System supplier rows (never offered in pickers, never billed): 'cash_purchases' = the supplier of every
  // receipt settled by a petty-cash spend / cash request (wave B decision P6). One per company (unique below).
  systemKind          String?

  assignedStaff  User?                  @relation("SupplierAssignee", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  tenant         Tenant?                @relation("TenantSuppliers", fields: [tenantId], references: [id], onDelete: SetNull)
  inventoryItems InventoryItem[]
  purchaseOrders PurchaseOrder[]
  bills          SupplierBill[]
  payments       SupplierPayment[]
  priceHistory   ItemPriceHistory[]
  conversations  SupplierConversation[]
  portalTokens   SupplierPortalToken[]
  opexLines      OpexLine[]
  fixedAssets    FixedAsset[]           @relation("FixedAssetSupplier")
  capexLines     CapexLine[]            @relation("CapexLineSupplier")

  @@unique([tenantId, systemKind])
  @@index([tenantId])
  @@index([whatsappPhone])
  @@index([email])
  @@map("suppliers")
}

// ─── Recipe costing ───────────────────────────────────────────────────────────

// Recipe kind drives the costing model + which fields are meaningful.
//   plate     — finished menu item. 1:1 with a MenuItem; costed as plate cost
//               (total of all inputs ÷ servings) for margin analysis.
//   component — sub-recipe / batch prep used inside other recipes (sauces,
//               marinades, doughs — e.g. "Burger Sauce" shared by Stax Classic
//               and Stax Spicy). No MenuItem; costed as cost-per-gram so it can
//               be consumed as an ingredient inside a plate recipe (quantity in
//               grams × cost-per-gram). Components feed their cost into the
//               plates that use them and never carry an opex/portion allocation.
//   modifier  — what ONE unit of a menu modifier (add-on) uses (wave B). Recipe.modifierId set, no menuItemId,
//               no packaging section.
enum RecipeKind {
  plate
  component
  modifier // what ONE unit of a menu modifier (add-on) uses; Recipe.modifierId set, no menuItemId, no packaging section
}

// Recipe lifecycle — independent of `kind`. A recipe starts in `iteration`
// (under testing), is submitted for sign-off (`pending_approval`), and goes
// live once a CEO/owner approves (`production`). Rejection drops it back to
// `iteration`. Existing recipes were backfilled to `production` by the
// migration that introduced this column.
enum RecipeStatus {
  iteration
  pending_approval
  production
}

model Recipe {
  id                      String       @id @default(uuid())
  kind                    RecipeKind   @default(plate)
  // Lifecycle status (see RecipeStatus). New recipes start as `iteration`.
  status                  RecipeStatus @default(iteration)
  // Promotion audit. Plain staff-user IDs (no FK relation — mirrors the
  // `createdBy` convention on PurchaseOrder). `submitted*` is set when a
  // manager requests promotion; `approved*` when a CEO/owner signs off;
  // `rejectionReason` is the note left on a rejection back to `iteration`.
  submittedById           String?
  submittedAt             DateTime?
  approvedById            String?
  approvedAt              DateTime?
  rejectionReason         String?
  // PLATE recipes are 1:1 with a MenuItem. COMPONENT recipes have menuItemId=null
  // and are named via the `name` field below. A plate created while in
  // `iteration` has NO MenuItem yet — testing recipes must not appear on the
  // menu. The intended menu item is stashed in `pendingMenuItem` and created
  // only when the recipe is approved to production.
  menuItemId              String?      @unique
  // Deferred new-menu-item payload for testing plates:
  // { conceptId, categoryId, name, description }. Null once the item is
  // created (on approval) or when the plate was attached to an existing item.
  pendingMenuItem         Json?
  // Display name for component recipes (plate recipes inherit name from menuItem).
  // Required when kind=component; null when kind=plate (validated at the route layer).
  name                    String?
  // Batch yield in grams — relevant only for component recipes. Drives the
  // cost-per-gram calculation: batchCost ÷ yieldGrams = costPerGram. Required
  // when kind=component; null when kind=plate (which uses portionSizeG instead).
  yieldGrams              Float?
  // The unit yieldGrams counts in for a prep (component) recipe — 'g' (default), 'ml' or 'pcs' (e.g. a bun batch makes
  // 24 pcs) — and the unit of its prep stock item (owner 2026-10-24, D3). CHECK recipes_yield_unit_chk (SQL only).
  yieldUnit               String       @default("g")
  servings                Int          @default(1) // portions per batch (plate recipes)
  portionSizeG            Float? // grams per portion (display reference, plate recipes)
  laborMinutes            Int          @default(0)
  notes                   String?
  steps                   String? // cooking/assembly steps for kitchen staff (KDS) — also the free-text MOP for sub-recipes (components)
  stepsUrdu               String?      @map("steps_urdu")
  // Finished-plate method as an ordered, station-tagged step list:
  //   [{ station: "Grill", instruction: "Sear patty 90s/side" }, …]
  // Sub-recipes use the free-text `steps` (MOP) instead; plates use this.
  methodSteps             Json?
  // ── Pricing inputs (per spec — sections 3 & 4) ──────────────────────────
  // Q factor = waste buffer. Default 10% pre-fills on every new recipe;
  // operator can override per-recipe (e.g. tighter for hard-to-waste prep,
  // looser for protein-heavy plates).
  qFactorPct              Float        @default(10)
  // Target net profit % the recipe should generate after opex + packaging.
  // Default 25%. Drives the suggested Target Price calculation.
  targetProfitPct         Float        @default(25)
  // The food-cost % the operator wants this item to run at (Menu Engineering
  // "price to hit target" suggestion = plateCost ÷ target%). Default 30.
  targetFoodCostPct       Float        @default(30)
  // RETIRED 2026-10-14 (wave B): no longer read or written — packaging is the recipe's Packaging section
  // (RecipeIngredient.section 'packaging'). Column kept (no data dropped).
  packagingPct            Float        @default(8)
  // What the operator actually charges on the menu. Null = defaults to
  // the computed Target Price. Stored as cents (paisa) per servd convention.
  actualSellingPriceCents Int?
  // Recipe category for menu organisation. 'main' | 'side' | 'sauce' |
  // 'sub_recipe'. Plate recipes usually inherit category from MenuItem;
  // component recipes own this field directly since they have no
  // MenuItem.
  category                String?
  // Optional hero photo URL. Operator-uploaded via the media upload helper.
  photoUrl                String?

  // Seasonality. `seasons` is an array of slugs from the curated set:
  // 'spring' | 'summer' | 'monsoon' | 'autumn' | 'winter' | 'ramadan' | 'year-round'
  // Empty array = "year-round" (treated as always available). Use this to
  // filter the recipe library + auto-toggle menu item availability when the
  // current season changes.
  seasons String[] @default([])

  // Optional explicit window for menu items that come back at the same time
  // each year (e.g. mango lassi: Apr 1 – Sep 30). Stored as MM-DD strings so
  // the rule applies every year regardless of date.
  seasonStart String? // 'MM-DD' inclusive, null = no window
  seasonEnd   String? // 'MM-DD' inclusive, null = no window

  // Active/featured flags for menu engineering — independent of season
  isActive Boolean @default(true)

  // kind 'modifier' (wave B): what ONE unit of a menu modifier uses. Company via modifier → group → menu item → brand.
  // @unique on a uuid FK (one recipe per modifier) — globally unique by construction, like menuItemId @unique above;
  // a deliberate exception to "unique keys are per company" (the route still resolves the modifier's company first).
  modifierId String? @unique

  // D1/A6: who created it and everyone who edited it (an approver may be none of them).
  createdById     String?
  editedByIds     String[] @default([])
  viaHeadOfficeId String? // D1/A3: the head office it was submitted through (stamped at submit; plain id, no FK)

  // Kitchen flow (owner, 2026-10-26, K4): "Recipes belong to a COMPANY, not a brand." The OWNER company — its recipe
  // editors create, edit, approve and delete it. A company whose brand USES it (a brand with
  // Concept.recipeOwnerTenantId = this company, e.g. Flipd → GS Foods) reads it at its own prices and never edits it
  // (403 RECIPE_OWNED_BY_OTHER_COMPANY). Set on every new recipe; backfilled by migration 20261026120100 (NULL only
  // when truly ambiguous — flagged recipe_company_unknown, the old derived rule applies to those).
  tenantId         String?
  // Kitchen flow (C, K5; owner amendment 2026-10-26): "Portions per recipe" — how many portions ONE batch of a
  // sub-recipe makes. Portion size = batch yield (yieldGrams, in yieldUnit) ÷ portionsPerBatch (lib/portions.ts — never
  // stored). The par and the prep log are counted in portions; portionLabel names one ("bun"). Null = not set (old rows).
  // CHECK recipes_portion_chk (≥ 1).
  portionsPerBatch Int?
  portionLabel     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  menuItem     MenuItem?           @relation(fields: [menuItemId], references: [id])
  modifier     Modifier?           @relation("ModifierRecipe", fields: [modifierId], references: [id], onDelete: SetNull)
  ingredients  RecipeIngredient[]
  // Back-relation: rows where this recipe appears as a prep component on
  // another recipe (only meaningful for prep recipes). Used to detect when
  // editing/deleting a prep would affect plate recipes.
  usedInPlates RecipeIngredient[]  @relation("RecipeAsIngredient")
  // The stock item a prep (component) recipe makes (InventoryItem.prepRecipeId; owner 2026-10-24, D3).
  // One per (company, recipe) since the kitchen flow (2026-10-26): a shared sub-recipe is stock in each company.
  prepItems    InventoryItem[]     @relation("PrepRecipeItem")
  tenant       Tenant?             @relation("TenantRecipes", fields: [tenantId], references: [id])
  parTargets   ParTarget[]
  recipeSteps  RecipeStep[]
  testAttempts RecipeTestAttempt[]

  @@index([isActive])
  @@index([status])
  @@index([tenantId])
  @@map("recipes")
}

// Outcome of a single recipe test cook — optional structured signal alongside
// the free-text notes on a RecipeTestAttempt.
enum RecipeTestOutcome {
  promising
  needs_work
  rejected
}

// One dated test cook of an iteration recipe. Attempts are versioned per
// recipe (v1, v2, …) so the kitchen can track how a recipe evolved before it
// was promoted to production. Tester name is denormalised for easy display.
model RecipeTestAttempt {
  id           String             @id @default(uuid())
  recipeId     String
  version      Int // sequential within a recipe: 1, 2, 3…
  notes        String
  outcome      RecipeTestOutcome?
  rating       Int? // optional 1–5 quality score
  testedById   String // staff user id who logged the cook
  testedByName String? // denormalised name for display
  createdAt    DateTime           @default(now())

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([recipeId, version])
  @@index([recipeId])
  @@map("recipe_test_attempts")
}

model RecipeIngredient {
  id                 String  @id @default(uuid())
  recipeId           String
  // Exactly ONE of (inventoryItemId, prepRecipeId) is set on each row.
  //   inventoryItemId → raw ingredient straight from inventory.
  //   prepRecipeId    → a prep recipe used as a component (unit is typically
  //                     'g' and quantity is grams consumed). Cost flows in
  //                     at prepRecipe.costPerGram × quantity.
  // A CHECK constraint in the migration enforces the mutual-exclusion;
  // application code constructs one or the other based on the picker.
  inventoryItemId    String?
  prepRecipeId       String?
  quantity           Float // usable recipe quantity (post-yield) in `unit`
  yieldPct           Float   @default(1.0) // 0.01–1.0, e.g. 0.75 = 75% yield. N/A for prep components (already yielded by the prep batch); kept at 1.0.
  unit               String // unit label for display
  notes              String?
  // 'ingredients' | 'packaging' (wave B; CHECK recipe_ingredients_section_chk, SQL only). Packaging lines:
  // packaging-class items only, plate recipes only. A sale uses the dish's packaging when packagingApplies(order,
  // line) (owner's FINAL rule: takeaway/delivery, a packaging-vessel brand, or "box given" on a dine-in line). A
  // recipe may have no packaging (warning PACKAGING_MISSING only for a packaging-vessel brand).
  section            String  @default("ingredients")
  // Kitchen flow (owner, 2026-10-26, K4): the servd master a raw line is. A shared recipe's line resolves to the
  // SELLING / VIEWING company's own stock item for this master (lib/recipeCost.ts localiseGraph); inventoryItemId
  // stays for back-compat (the owner company's item). Backfilled from the item's master. Null on sub-recipe lines.
  masterIngredientId String?

  recipe        Recipe         @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  prepRecipe    Recipe?        @relation("RecipeAsIngredient", fields: [prepRecipeId], references: [id])

  @@index([masterIngredientId])
  @@map("recipe_ingredients")
}

// Phase tags for RecipeStep — see the four CEO-named phases below.
enum RecipePhase {
  prep_mep // mise en place: dice, portion, pre-make sauces (pre-service)
  prep_mop // method of procedure: par-bake, marinate, sous-vide (pre-service)
  service_cook // hot-line cook step during service
  service_assemble // final plating / wrap / box during service
}

// Runtime status of one step on one order item. Mirrors the ItemStatus enum
// but lives at step granularity so the cascade engine can fire each station
// independently as upstream deps clear.
enum StepRunStatus {
  pending // recipe step exists, expo hasn't fired this item yet
  waiting // expo fired; deps not yet met
  preparing // station is actively cooking this step
  done // bumped — frees dependents
  voided
}

// One ordered step in a recipe. The kitchen pipeline reads these to figure
// out which station gets the ticket and when. `dependsOnIds` carries
// step-IDs that must be completed first; an empty list means "fire on
// expo-confirm". Parallel-then-converge flows naturally fall out of the
// graph — `service_assemble` would list every preceding cook-step in
// dependsOnIds so it only fires when all the proteins/sides are ready.
model RecipeStep {
  id               String      @id @default(uuid())
  recipeId         String
  phase            RecipePhase
  // Display ordinal within phase — purely for the editor UI; the runtime
  // pipeline uses `dependsOnIds` to decide what fires next.
  ordinal          Int         @default(0)
  // Which station picks up this step. Null = anyone (e.g. a prep note with no
  // particular station). At service time we route the ticket to this station.
  stationId        String?
  // Free-text instruction the line cook sees on their KDS.
  instruction      String
  instructionUrdu  String?
  // Estimated time-to-completion. Drives ETAs + the prep-time forecast.
  estimatedSeconds Int         @default(60)
  // Either an array of step-IDs (from this recipe) that must all be `done`
  // before this step can fire, OR an empty array meaning "fire immediately
  // on expo-confirm". Postgres `text[]` is fine — we never query into it.
  dependsOnIds     String[]    @default([])
  createdAt        DateTime    @default(now())

  recipe  Recipe          @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  station Station?        @relation(fields: [stationId], references: [id])
  runs    OrderItemStep[]

  @@index([recipeId, phase, ordinal])
  @@map("recipe_steps")
}

// Instantiated step on a specific order item. Created when expo fires the
// order — one row per (orderItem × recipeStep). Cascade engine walks these:
// when a step flips to `done`, anything whose `dependsOnIds` is now fully
// satisfied flips from `waiting` → `preparing` and broadcasts to its station.
model OrderItemStep {
  id               String        @id @default(uuid())
  orderItemId      String
  recipeStepId     String
  stationId        String? // copied from recipeStep at creation — survives recipe edits
  status           StepRunStatus @default(pending)
  // Snapshot of the recipe step's dependency list at fire-time. Recipe edits
  // mid-service don't disrupt in-flight orders.
  dependsOnStepIds String[]      @default([])
  // Same shape as OrderItem timing fields so the KDS card UI can reuse logic.
  firedAt          DateTime?
  startedAt        DateTime? // the cook tapped Start (owner B12, 2026-10-26)
  kdsShownAt       DateTime? // first shown in the station's visible window (owner B12)
  completedAt      DateTime?
  bumpedById       String? // KitchenStaff or User who confirmed
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  orderItem  OrderItem  @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  recipeStep RecipeStep @relation(fields: [recipeStepId], references: [id])

  @@index([stationId, status])
  @@index([orderItemId])
  @@map("order_item_steps")
}

// Owner B12 (2026-10-26): a cook's countdown on a dish / step at a station.
// Server-side (started at + duration) so a refresh or another tablet shows it;
// when it ends the card blinks red — no sound. tenantId = the order's company
// (RLS, merge repoint). Stopped = dismissed / done.
model KitchenTimer {
  id              String    @id @default(uuid())
  tenantId        String
  orderId         String
  orderItemId     String
  orderItemStepId String?
  stationId       String
  label           String
  durationSeconds Int
  startedAt       DateTime  @default(now())
  endsAt          DateTime
  stoppedAt       DateTime?
  startedById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([tenantId])
  @@index([stationId, stoppedAt])
  @@index([orderId])
  @@map("kitchen_timers")
}

// ─── Purchase Orders ──────────────────────────────────────────────────────────

// BOOKS-06: money columns on this model are BIGINT paisa (lib/money.ts returns them as JS numbers).
model PurchaseOrder {
  id           String    @id @default(uuid())
  supplierId   String
  status       String    @default("draft") // draft | pending_approval | sent | received | partial | cancelled
  orderDate    DateTime  @default(now())
  expectedDate DateTime?
  receivedDate DateTime?
  reference    String? // supplier invoice / PO number
  notes        String?
  totalCents   BigInt    @default(0)

  // Audit / lifecycle
  createdBy      String?
  approvedById   String?
  approvedAt     DateTime?
  rejectedReason String?
  sentAt         DateTime?
  sentToEmail    String?
  cancelledById  String?
  cancelledAt    DateTime?
  cancelReason   String?

  viaHeadOfficeId String? // D1/A3: the head office it was submitted through (stamped at submit; plain id, no FK)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conceptId String? // the brand that ordered (owner B13 (a)); its receipt's lots are that brand's. Plain id.

  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  lines       PurchaseOrderLine[]
  bills       SupplierBill[]
  activityLog PoActivityLog[]

  @@index([supplierId, status])
  @@index([status, orderDate(sort: Desc)])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id               String  @id @default(uuid())
  purchaseOrderId  String
  inventoryItemId  String
  quantityOrdered  Float
  quantityReceived Float   @default(0)
  unitCostCents    Int // agreed cost per unit (paisa)
  notes            String?

  purchaseOrder       PurchaseOrder          @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  inventoryItem       InventoryItem          @relation(fields: [inventoryItemId], references: [id])
  billLines           SupplierBillLine[]
  discrepancies       ReceivingDiscrepancy[]
  priceHistoryEntries ItemPriceHistory[]
  receiptLines        GoodsReceiptLine[]

  @@index([purchaseOrderId])
  @@index([inventoryItemId])
  @@map("purchase_order_lines")
}

// ─── PO Activity Log (audit trail) ────────────────────────────────────────────

model PoActivityLog {
  id              String   @id @default(uuid())
  purchaseOrderId String
  userId          String?
  action          String // created | line_added | submitted | approved | rejected | sent | received | cancelled | edited
  details         Json?
  createdAt       DateTime @default(now())

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  user          User?         @relation(fields: [userId], references: [id])

  @@index([purchaseOrderId, createdAt])
  @@map("po_activity_log")
}

// ─── Receiving Discrepancy (variance log) ─────────────────────────────────────

model ReceivingDiscrepancy {
  id           String   @id @default(uuid())
  poLineId     String
  expectedQty  Float
  receivedQty  Float
  reason       String // short_shipment | over_shipment | damaged | wrong_item | quality_issue
  notes        String?
  recordedById String?
  recordedAt   DateTime @default(now())

  poLine     PurchaseOrderLine @relation(fields: [poLineId], references: [id], onDelete: Cascade)
  recordedBy User?             @relation(fields: [recordedById], references: [id])

  @@index([poLineId])
  @@map("receiving_discrepancies")
}

// ─── Item Price History ───────────────────────────────────────────────────────

model ItemPriceHistory {
  id              String   @id @default(uuid())
  inventoryItemId String
  supplierId      String?
  oldCostCents    Int?
  newCostCents    Int
  source          String // po_receive | manual_adjust | bill_match
  poLineId        String?
  recordedAt      DateTime @default(now())

  inventoryItem InventoryItem      @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  supplier      Supplier?          @relation(fields: [supplierId], references: [id])
  poLine        PurchaseOrderLine? @relation(fields: [poLineId], references: [id], onDelete: SetNull)

  @@index([inventoryItemId, recordedAt(sort: Desc)])
  @@index([supplierId, recordedAt(sort: Desc)])
  @@map("item_price_history")
}

// ─── Supplier Bills (Accounts Payable) ────────────────────────────────────────

// BOOKS-06: money columns on this model are BIGINT paisa (lib/money.ts returns them as JS numbers).
model SupplierBill {
  id             String    @id @default(uuid())
  supplierId     String
  poId           String? // optional link to a PO for 3-way match
  billNumber     String // supplier's invoice/bill number
  billDate       DateTime
  dueDate        DateTime
  status         String    @default("open") // draft | open | partially_paid | paid | void
  subtotalCents  BigInt    @default(0)
  taxCents       BigInt    @default(0)
  totalCents     BigInt    @default(0)
  // Income-tax withheld at source (s.153), fixed when the bill is recorded
  // and booked by postSupplierBill: the supplier is owed totalCents − whtCents
  // (credited to AP 2010) and the rest is owed to FBR (2040). Every "still
  // due" figure — payments, status, AP aging, the supplier statement — is net
  // of it, so a bill paid net of withholding clears, as it does in the ledger.
  whtCents       BigInt    @default(0)
  paidCents      BigInt    @default(0) // running total of payments applied
  notes          String?
  attachmentUrl  String? // S3/R2 link to scanned bill
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  voidedAt       DateTime?
  voidReason     String?
  // A supplier credit note / return is a SupplierBill of kind 'credit_note'
  // against its original bill (one AP subledger, never a second table).
  // creditedCents on a bill = credit notes applied to it; still due =
  // total − wht − paid − credited.
  kind           String    @default("bill") // bill | credit_note
  originalBillId String?
  creditedCents  BigInt    @default(0)
  // H8 (wave B): the authority that charged the bill's sales tax → its input account (fbr 1320, pra 1321, srb 1322,
  // kpra 1323, bra 1324). Default 'fbr' = today's 1320. Credit notes credit the bill's own code.
  taxAuthority   String    @default("fbr")
  // Snapshot of how whtCents was worked out (lib/withholding.ts computeWithholding).
  whtSection     String?
  whtRateBps     Int?

  supplier        Supplier                     @relation(fields: [supplierId], references: [id])
  po              PurchaseOrder?               @relation(fields: [poId], references: [id])
  lines           SupplierBillLine[]
  applications    SupplierPaymentApplication[]
  creditsGiven    SupplierCreditApplication[]  @relation("CreditNoteApplications")
  creditsReceived SupplierCreditApplication[]  @relation("BillCreditApplications")
  grniMatches     GrniMatch[]

  @@unique([supplierId, billNumber])
  @@index([supplierId, status])
  @@index([dueDate, status])
  @@index([originalBillId])
  @@map("supplier_bills")
}

// A supplier credit note applied to a bill. tenantId = the supplier's company.
// BOOKS-06: money columns are BIGINT paisa (lib/money.ts returns them as JS numbers).
model SupplierCreditApplication {
  id           String   @id @default(uuid())
  tenantId     String
  creditNoteId String
  billId       String
  amountCents  BigInt
  createdBy    String?
  createdAt    DateTime @default(now())

  creditNote SupplierBill @relation("CreditNoteApplications", fields: [creditNoteId], references: [id], onDelete: Cascade)
  bill       SupplierBill @relation("BillCreditApplications", fields: [billId], references: [id], onDelete: Cascade)

  @@unique([creditNoteId, billId])
  @@index([tenantId])
  @@index([billId])
  @@map("supplier_credit_applications")
}

// BOOKS-06: money columns on this model are BIGINT paisa (lib/money.ts returns them as JS numbers).
model SupplierBillLine {
  id                 String  @id @default(uuid())
  billId             String
  inventoryItemId    String?
  poLineId           String? // 3-way match link
  description        String
  quantity           Float
  unitCostCents      BigInt
  lineTotalCents     BigInt
  returnQty          Float? // credit note lines: stock sent back to the supplier
  // Food cost wave B (GRNI, H17)
  receiptLineId      String? // a stock line matched to a receipt line (else poLineId); one of them is required for a stock line
  expenseAccountCode String? // a line that is NOT stock names its 6xxx account (assertExpenseCode); equipment refused (USE_CAPEX)

  bill          SupplierBill       @relation(fields: [billId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem?     @relation(fields: [inventoryItemId], references: [id])
  poLine        PurchaseOrderLine? @relation(fields: [poLineId], references: [id], onDelete: SetNull)
  receiptLine   GoodsReceiptLine?  @relation("BillLineReceiptLine", fields: [receiptLineId], references: [id], onDelete: SetNull)
  matches       GrniMatch[]

  @@index([billId])
  @@index([receiptLineId])
  @@map("supplier_bill_lines")
}

// ─── Supplier Payments + multi-bill applications ──────────────────────────────

// BOOKS-06: money columns on this model are BIGINT paisa (lib/money.ts returns them as JS numbers).
model SupplierPayment {
  id            String    @id @default(uuid())
  supplierId    String
  paymentDate   DateTime  @default(now())
  method        String // cash | bank_transfer | cheque | wallet
  reference     String? // cheque #, bank ref
  amountCents   BigInt
  appliedCents  BigInt    @default(0) // sum of applications
  notes         String?
  createdBy     String?
  createdAt     DateTime  @default(now())
  // The company bank account the money left (lib/bankAccounts.ts moneyAccountCode).
  bankAccountId String?
  voidedAt      DateTime?
  voidReason    String?

  supplier     Supplier                     @relation(fields: [supplierId], references: [id])
  applications SupplierPaymentApplication[]

  @@index([supplierId, paymentDate(sort: Desc)])
  @@index([bankAccountId])
  @@map("supplier_payments")
}

// BOOKS-06: money columns on this model are BIGINT paisa (lib/money.ts returns them as JS numbers).
model SupplierPaymentApplication {
  id                 String   @id @default(uuid())
  paymentId          String
  billId             String
  amountAppliedCents BigInt
  createdAt          DateTime @default(now())

  payment SupplierPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  bill    SupplierBill    @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@unique([paymentId, billId])
  @@index([billId])
  @@map("supplier_payment_applications")
}

// ─── Financial / Accounting ───────────────────────────────────────────────────

model Account {
  id                 String      @id @default(uuid())
  // Owning company. Each company keeps its own chart of accounts — GS Foods'
  // "4001 Simmer Revenue" and GSX Viva's chart are separate ledgers, so the
  // code is unique PER COMPANY, not globally.
  tenantId           String?
  code               String // e.g. "4001"
  name               String // e.g. "Restaurant Revenue"
  type               AccountType
  description        String?
  isActive           Boolean     @default(true)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  /// Sub-accounts switched on for this account (owner, 2026-10-23: "limited to Wages Expense (HO) account only,
  /// and add an option to switch on sub accounts for other head accounts … only in those for which I open
  /// subaccount"). Off = payroll never tags it, the journal picker and statements show no sub-accounts and no new
  /// tag is accepted; existing tags stay as history. Opening a sub-account switches it on. lib/subAccounts.ts.
  subAccountsEnabled Boolean     @default(false)

  /// Who controls postings to this account (journal.ts postJournalEntry) — ONE controlled-account mechanism (wave B):
  ///   'intercompany' — "Due from/to <company>" of ONE company pair: only sourceType 'ic.*'
  ///   'head_office'  — D1 head-office links (reserved): only sourceType 'ho.*'
  ///   'fixed_asset'  — the register-controlled codes 1500-1599 + 2012: system postings 'fixed_asset.*' /
  ///                    'capex.*' pass; any other source needs input.controlledOverride {reason} (manual JE,
  ///                    bank-line adjust) and the caller raises fixed_asset_gl_mismatch.
  /// NULL = an ordinary account. CHECKs accounts_controlled_by_chk / accounts_controlled_company_chk /
  /// accounts_ic_counterparty_chk and the partial unique accounts_ic_pair_side (one Due-from and one Due-to per
  /// company pair) are SQL only (migration 20261014090000; not declared here).
  controlledBy         String?
  counterpartyTenantId String?

  tenant       Tenant?       @relation("TenantAccounts", fields: [tenantId], references: [id])
  counterparty Tenant?       @relation("AccountCounterparty", fields: [counterpartyTenantId], references: [id], onDelete: Restrict)
  journalLines JournalLine[]
  subAccounts  SubAccount[]

  // Head office (D1): the company-chart "Head office charges" account of a link, and the HO-chart recharge account.
  headOfficeLinkCharges HeadOfficeLink[]  @relation("HoLinkCharges")
  rechargeAccountFor    HeadOfficeBooks[] @relation("HoRechargeAccount")

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, controlledBy])
  @@map("accounts")
}

model JournalEntry {
  id          String   @id @default(uuid())
  // Company this entry belongs to. Stamped by the posting engine from the
  // source document (the order's brand, the shift's company, the supplier's
  // company…) so every ledger report can scope without walking the lines.
  tenantId    String?
  reference   String? // e.g. order ID, shift ID
  description String
  entryDate   DateTime @default(now())
  postedBy    String? // user ID or "system"
  createdAt   DateTime @default(now())

  tenant                Tenant?                @relation("TenantJournalEntries", fields: [tenantId], references: [id])
  lines                 JournalLine[]
  // Internal payment classification (owner, 2026-10-20) — a reporting label
  // only; never read by any posting, ledger report or tax return.
  paymentClassification PaymentClassification?
  // Automatic voucher number (owner, 2026-10-20; accounting/voucherNumbers.ts): JV- manual / reversal, PV- payment,
  // RV- receipt — per company, ascending, stamped by postJournalEntry. null = sales / till / non-cash entries.
  voucherKind           String?
  voucherSeq            Int?
  voucherNo             String?

  @@unique([tenantId, voucherNo])
  @@unique([tenantId, voucherKind, voucherSeq])
  @@index([tenantId, entryDate])
  @@map("journal_entries")
}

// Internal payment classification (owner, 2026-10-20; migration
// 20261020100000). A REPORTING DIMENSION on a payment journal entry: Official
// / Unofficial / Unclassified (no row = Unclassified), plus the tax-deduction
// status and the reason a tax was not deducted. A label only — no posting,
// account, trial balance, tax return or statutory report ever reads it.
// Written only by accounting/paymentsRegister.ts classifyPaymentTx, stamped
// with the ENTRY's company. CHECKs live in the migration's SQL-only section.
model PaymentClassification {
  id                 String   @id @default(cuid())
  tenantId           String
  journalEntryId     String   @unique
  classification     String // 'official' | 'unofficial' | 'unclassified'
  taxStatus          String? // 'deducted' | 'not_deducted' | 'not_applicable'
  nonDeductionReason String?
  setById            String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)

  @@index([tenantId, classification])
  @@map("payment_classifications")
}

// BOOKS-06: money columns on this model are BIGINT paisa (lib/money.ts returns them as JS numbers).
model JournalLine {
  id             String           @id @default(uuid())
  journalEntryId String
  accountId      String
  // Brand attribution for per-brand P&L. Set on lines posted from an order /
  // shift (revenue, COGS, discounts) so per-brand cost is MEASURED, not
  // estimated. NULL = genuinely shared / overhead / manual entries, which the
  // per-brand report allocates across brands by revenue share.
  conceptId      String?
  type           JournalEntryType
  amountCents    BigInt
  memo           String?

  journalEntry          JournalEntry            @relation(fields: [journalEntryId], references: [id])
  account               Account                 @relation(fields: [accountId], references: [id])
  subAccountAllocations JournalLineSubAccount[]

  @@index([conceptId])
  @@map("journal_lines")
}

// Sub-accounts (owner, 2026-10-23: "option to create sub account in chart of accounts, e.g in Wages … in name of
// employees … report/account statement with balance of subgroups"). A SUB-LEDGER, never a child account: entries
// keep posting to the main account, so the trial balance, P&L, tax returns and every reader of a code are
// unchanged. A sub-account is a named bucket under ONE account of ONE company (tenantId = the account's company);
// kind 'employee' is payroll's per-employee wages bucket (one per account and employee). Never deleted once
// used — switched off (isActive). lib/subAccounts.ts is the one writer. Migration 20261023110000.
model SubAccount {
  id          String   @id @default(uuid())
  tenantId    String
  accountId   String
  name        String
  code        String?
  kind        String   @default("manual") // manual | employee (CHECK sub_accounts_kind_chk)
  employeeId  String?
  isActive    Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  account     Account                 @relation(fields: [accountId], references: [id])
  allocations JournalLineSubAccount[]

  @@unique([tenantId, accountId, name])
  @@unique([accountId, employeeId])
  @@index([tenantId])
  @@map("sub_accounts")
}

// A sub-account tag on a journal line — the line itself is never changed. The tags of one line sum to ≤ the line's
// amount (the rest is "Unassigned"); the sub-account's account is the line's account, same company. A reversal
// mirrors its original's tags (journal.ts reverseJournalEntry). BIGINT paisa.
model JournalLineSubAccount {
  id            String   @id @default(uuid())
  tenantId      String
  journalLineId String
  subAccountId  String
  amountCents   BigInt
  createdById   String?
  createdAt     DateTime @default(now())

  line       JournalLine @relation(fields: [journalLineId], references: [id])
  subAccount SubAccount  @relation(fields: [subAccountId], references: [id])

  @@unique([journalLineId, subAccountId])
  @@index([tenantId])
  @@index([subAccountId])
  @@map("journal_line_sub_accounts")
}

// ─── Reconciliation ──────────────────────────────────────────────────────────
//
// Imported bank/payment-gateway statements that the operator reconciles
// against the ledger. Each line is either matched to a journal line OR posts
// an adjustment when there's no internal record. Settlement reconciliation
// (Foodpanda payouts vs expected commission) uses the same model.

model BankStatementImport {
  id                  String   @id @default(uuid())
  // Owning company — the ledger the statement reconciles against.
  tenantId            String?
  // The bank account the statement is for; source and accountCode derive
  // from it. Null only for a non-bank ledger (e.g. 1030 card receivable).
  bankAccountId       String?
  source              String // "bank:hbl", "keenu", …
  accountCode         String // CoA code the statement is reconciling against (e.g. 1020 Bank)
  statementDate       DateTime
  // BigInt: an operating account holds more than PKR 21.47M (2^31 paisa) —
  // INT4 made those imports 500 (BOOKS-06). They come back as JS numbers
  // through the one boundary in lib/money.ts (moneyAsNumbers).
  openingBalanceCents BigInt   @default(0)
  closingBalanceCents BigInt   @default(0)
  filename            String?
  importedById        String?
  importedAt          DateTime @default(now())

  lines  BankStatementLine[]
  tenant Tenant?             @relation("TenantBankStatementImports", fields: [tenantId], references: [id])

  @@index([source, statementDate(sort: Desc)])
  @@index([tenantId, statementDate(sort: Desc)])
  @@map("bank_statement_imports")
}

// BOOKS-06: money columns on this model are BIGINT paisa (lib/money.ts returns them as JS numbers).
model BankStatementLine {
  id                   String   @id @default(uuid())
  importId             String
  postedDate           DateTime
  description          String
  reference            String?
  amountCents          BigInt // signed: + = credit to bank, − = debit
  matchStatus          String   @default("unmatched") // unmatched | matched | adjusted | ignored
  matchedJournalLineId String?
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  import       BankStatementImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  raastReceipt RaastReceipt?

  @@index([importId, matchStatus])
  @@index([postedDate(sort: Desc)])
  @@map("bank_statement_lines")
}

// ─── Cost allocation ─────────────────────────────────────────────────────────
//
// A shared OpEx account (rent, electricity, etc.) is split across concepts by
// a configurable driver. v1 supports static percentage and revenue-share. The
// allocation runs at period end: it credits the source account and debits a
// per-concept "allocated rent / electricity / …" account that the BS/PL views
// surface inline.

enum AllocationDriver {
  fixed_pct // weights stored on each rule line
  revenue_share // computed at run time from per-concept revenue in the period
}

model CostAllocationRule {
  id                String           @id @default(uuid())
  tenantId          String?
  name              String // operator-friendly label ("Q4 rent split")
  sourceAccountCode String // 6010, 6020, 6021, …
  driver            AllocationDriver
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  // Trash bin (2026-10-15): a rule with runs is referenced by the ledger's
  // allocation runs, so it is soft-deleted (never erased). Who deleted it is in
  // trash_entries — never a second column here.
  deletedAt         DateTime?

  weights AllocationRuleWeight[]
  runs    CostAllocationRun[]

  // One LIVE rule per (company, source account): partial unique index
  // cost_allocation_rules_tenant_source_live_key WHERE "deletedAt" IS NULL —
  // SQL only (Prisma cannot express it); do not re-declare @@unique here.
  @@index([tenantId, deletedAt])
  @@map("cost_allocation_rules")
}

model AllocationRuleWeight {
  id                String  @id @default(uuid())
  ruleId            String
  conceptId         String
  // For fixed_pct: 0–10000 (basis points, sums to 10000 across rule). For
  // revenue_share: ignored at compute time but the row is required to enumerate
  // which concepts participate (use 0 to opt a concept out).
  weightBps         Int
  // The destination account code for THIS concept (e.g. 6010 may post to per-
  // concept "Rent — Stax", "Rent — Simmer" if you want sub-accounts; or all to
  // 6010 with concept memo). Null = post back to source account with concept
  // tag in memo only.
  targetAccountCode String?

  rule    CostAllocationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  concept Concept            @relation(fields: [conceptId], references: [id])

  @@unique([ruleId, conceptId])
  @@map("allocation_rule_weights")
}

// BOOKS-06: money columns on this model are BIGINT paisa (lib/money.ts returns them as JS numbers).
model CostAllocationRun {
  id               String   @id @default(uuid())
  tenantId         String?
  ruleId           String
  periodStart      DateTime
  periodEnd        DateTime
  totalAmountCents BigInt
  postedAt         DateTime @default(now())
  postedById       String?

  rule CostAllocationRule @relation(fields: [ruleId], references: [id])

  @@index([ruleId, periodStart(sort: Desc)])
  @@index([tenantId])
  @@map("cost_allocation_runs")
}

// ─── Tax invoices (FBR-compliant) ────────────────────────────────────────────
//
// Issued against an Order at fulfilment. Sequential per concept (the prefix
// + zero-padded counter). Once issued, immutable — corrections post a credit
// note (negative invoice).

enum InvoiceType {
  invoice
  credit_note
}

model TaxInvoice {
  id            String      @id @default(uuid())
  // The company that issued it — the order's brand's company; a credit note
  // carries its original's (migration 20261012120100). Numbers are unique
  // per company, numbered per (company, prefix, year, invoice/credit note).
  tenantId      String
  invoiceNumber String // e.g. "STX-2026-00001", "STX-2026-CN-00001"
  type          InvoiceType @default(invoice)
  orderId       String
  conceptId     String
  issuedAt      DateTime    @default(now())

  // Snapshotted seller details at issue time
  sellerLegalName String
  sellerStrn      String?
  sellerNtn       String?
  sellerAddress   String?

  // Optional buyer details — only populated when known
  buyerName    String?
  buyerStrn    String?
  buyerNtn     String?
  buyerAddress String?

  // Money fields snapshotted (cents) — these never change after issue
  subtotalCents      Int
  discountCents      Int @default(0)
  taxableValueCents  Int
  fbrTaxCents        Int @default(0) // 17% federal GST on goods
  provincialTaxCents Int @default(0) // PRA/SRB/KPRA/BRA on services
  serviceChargeCents Int @default(0)
  tipCents           Int @default(0)
  totalCents         Int
  // Delivery charge before GST (wave B, H9): inside taxableValueCents and totalCents, plus its own TaxInvoiceLine.
  // totalCents = max(0, subtotal + deliveryFee + tax + serviceCharge + tip − discount) — equals the bill.
  deliveryFeeCents   Int @default(0)

  // Reference to the original invoice when this is a credit note
  originalInvoiceId String?

  pdfUrl String? // optional: where the rendered PDF lives in S3

  tenant      Tenant           @relation("TenantTaxInvoices", fields: [tenantId], references: [id], onDelete: Restrict)
  order       Order            @relation(fields: [orderId], references: [id])
  lines       TaxInvoiceLine[]
  original    TaxInvoice?      @relation("InvoiceCorrections", fields: [originalInvoiceId], references: [id])
  corrections TaxInvoice[]     @relation("InvoiceCorrections")

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, issuedAt(sort: Desc)])
  @@index([conceptId, issuedAt(sort: Desc)])
  @@index([orderId])
  @@map("tax_invoices")
}

// The next number of each tax-invoice series (D-RV-3, migration
// 20261012120100). A series is one company's numbers that start with `head` —
// "<prefix>-<YYYY>-" for invoices, "<prefix>-<YYYY>-CN-" for credit notes.
// invoices/service.ts allocates with one upsert (INSERT … ON CONFLICT DO
// UPDATE … RETURNING) inside the issuing transaction: the row lock makes it
// race-safe, and a rolled-back issue rolls its number back, so the series
// stays gap-free — in O(1), however many invoices the company has issued.
model TaxInvoiceSeries {
  tenantId  String
  head      String // "GSF-2026-" or "GSF-2026-CN-"
  lastValue Int // the last number issued in the series (0 = none yet)
  updatedAt DateTime @updatedAt

  tenant Tenant @relation("TenantTaxInvoiceSeries", fields: [tenantId], references: [id], onDelete: Restrict)

  @@id([tenantId, head])
  @@map("tax_invoice_series")
}

model TaxInvoiceLine {
  id             String @id @default(uuid())
  invoiceId      String
  description    String
  quantity       Float
  unitPriceCents Int
  lineTotalCents Int

  invoice TaxInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("tax_invoice_lines")
}

// Per-concept invoice counter to guarantee gap-free sequential numbers — FBR
// requires this. Use a transaction with SELECT ... FOR UPDATE to allocate.
model InvoiceCounter {
  conceptId String @id
  year      Int
  nextValue Int

  @@map("invoice_counters")
}

// ─── SiteLayout — page builder for storefront pages ─────────────────────────
//
// One row per page slug (e.g. "servd:home", "brand:simmer", "brand:stax").
// `blocks` is an ordered array of typed Block records consumed by the
// storefront's PageRenderer. Operator edits via the dashboard /content
// editor; storefront falls back to hard-coded defaults if no row exists.

model SiteLayout {
  id               String    @id @default(uuid())
  slug             String    @unique // "servd:home" | "servd:hero" | "brand:<slug>" | "brand:<slug>:footer" | "page:<slug>" | "popup:<key>"
  title            String? // operator-facing label, e.g. "Simmer — home"
  // Storefront content module (decision 41). One row per page / pop-up.
  // blocks + settings are the LIVE copy the storefront reads; draft* is the
  // working copy. Nothing reaches the live copy without CEO approval.
  kind             String    @default("page") // page | header | footer | widget (servd:feedback) | popup
  tenantId         String? // null = the shared servd pages; else the owning company
  blocks           Json // Block[] — live
  settings         Json? // live PageSettings: fonts, A/B variant, pop-up rules
  draftBlocks      Json?
  draftSettings    Json?
  draftStatus      String    @default("none") // none | draft | pending | scheduled
  draftUpdatedById String?
  draftUpdatedAt   DateTime?
  submittedById    String?
  submittedAt      DateTime?
  reviewNote       String?
  reviewedById     String?
  reviewedAt       DateTime?
  publishAt        DateTime? // approved + scheduled: goes live at this time
  liveVersion      Int       @default(0)
  updatedById      String?
  publishedAt      DateTime?
  viaHeadOfficeId  String? // D1/A3: the head office it was submitted through (stamped at submit; plain id, no FK)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  versions SiteLayoutVersion[]
  stats    SiteLayoutStat[]

  @@index([slug])
  @@index([tenantId, kind])
  @@index([draftStatus, publishAt])
  @@map("site_layouts")
}

// Every publish of a SiteLayout, for one-click rollback and the audit trail.
model SiteLayoutVersion {
  id            String   @id @default(uuid())
  layoutId      String
  version       Int
  blocks        Json
  settings      Json?
  publishedById String?
  approvedById  String?
  note          String?
  publishedAt   DateTime @default(now())

  layout SiteLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)

  @@unique([layoutId, version])
  @@map("site_layout_versions")
}

// A/B counters per published version and variant ("a" | "b").
model SiteLayoutStat {
  id          String   @id @default(uuid())
  layoutId    String
  version     Int
  variant     String
  views       Int      @default(0)
  conversions Int      @default(0)
  updatedAt   DateTime @updatedAt

  layout SiteLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)

  @@unique([layoutId, version, variant])
  @@map("site_layout_stats")
}

// ─── Audit log ───────────────────────────────────────────────────────────────
//
// Append-only record of high-stakes mutations: period close, account changes,
// wage-rate updates, allocation rule changes, manual journal entries. The point
// is forensic — when something looks wrong six months later, who did what when.

model AuditLog {
  id        String   @id @default(uuid())
  // Which trail this belongs to. Two audiences with different rights:
  //   identity   — who exists, what access they hold, and what they did on
  //                shift (refunds, voids, comps, gift cards, stock moves).
  //                Read by managers.
  //   accounting — what hit the BOOKS: period closes, manual journals, wage
  //                rates, tip-pool postings, cost allocations. Read by the CEO
  //                and exec only, behind its own module.
  // A String rather than an enum on purpose: this table already types action
  // and entity that way, and a missing enum value has silently rolled back a
  // whole transaction in this codebase before.
  category  String   @default("identity")
  // Company the actor was working in AT THE TIME. Nullable because rows written
  // before this column existed cannot be attributed — the actor's CURRENT
  // company is not necessarily the one they were acting in, and operators here
  // belong to both and switch. Those legacy rows are shown to the CEO only.
  tenantId  String?
  action    String // dotted-path verb: "period.close", "user.role_change", "wage.update", …
  entity    String // e.g. "User", "Account", "PeriodLock", "PayrollRun"
  entityId  String? // primary key of the touched row, when applicable
  userId    String? // who did it; null for system events
  userEmail String? // denormalised so deleted users still have attribution
  before    Json? // previous-state snapshot (for updates/deletes)
  after     Json? // new-state snapshot (for creates/updates)
  metadata  Json? // extra context (IP, reason, etc.)
  createdAt DateTime @default(now())

  @@index([action, createdAt(sort: Desc)])
  @@index([entity, entityId])
  @@index([userId, createdAt(sort: Desc)])
  // The shape every read uses: one trail, one company, newest first.
  @@index([category, tenantId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

// Books-closed lock. There is at most one active row; new lock dates only move
// FORWARD. Any postJournalEntry with entryDate <= lockedThrough is rejected.
// Reversing entries posted *after* lock date for an event before it ARE allowed
// (they post in the open period with their own date), preserving auditability.
model PeriodLock {
  id             String   @id @default(uuid())
  // Company whose books are closed. Closing GS Foods' August must not freeze
  // GSX Viva's ledger, so the lock — and the posting check — is per company.
  tenantId       String?
  lockedThrough  DateTime // inclusive — books are closed up to and including this date
  lockedBy       String // user ID
  lockedAt       DateTime @default(now())
  note           String?
  /// Blocking close checks the CEO closed over (wave B close checklist): [{key, count, cents, months}]; null = none.
  overrides      Json?
  overrideReason String?

  tenant Tenant? @relation("TenantPeriodLocks", fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("period_locks")
}

// Denormalised summary row per completed order (for fast reporting)
model FinancialEntry {
  id              String   @id @default(uuid())
  // B03: one financial entry per order, full stop. The race between two
  // parallel bumps on the last items of an order used to create duplicate
  // rows (and duplicate loyalty earns). The unique constraint forces the
  // second writer to hit P2002 and bail, which the service layer ignores.
  orderId         String   @unique
  conceptId       String
  locationId      String? // physical place — copied from Order at posting time
  channel         String // order source as string
  grossCents      Int
  commissionCents Int      @default(0) // delivery platform commission
  discountCents   Int      @default(0)
  taxCents        Int      @default(0)
  netCents        Int // gross - commission - discount
  entryDate       DateTime @default(now())
  createdAt       DateTime @default(now())

  order    Order     @relation(fields: [orderId], references: [id])
  concept  Concept   @relation(fields: [conceptId], references: [id])
  location Location? @relation(fields: [locationId], references: [id])

  @@index([conceptId, entryDate(sort: Desc)])
  @@index([locationId, entryDate(sort: Desc)])
  @@map("financial_entries")
}

// ─── CRM ──────────────────────────────────────────────────────────────────────

model Segment {
  id          String   @id @default(uuid())
  tenantId    String?
  name        String
  description String?
  // filter criteria stored as JSON predicate
  filters     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaigns Campaign[]

  @@index([tenantId])
  @@map("segments")
}

model Campaign {
  id             String          @id @default(uuid())
  tenantId       String?
  segmentId      String?
  // Brand audience. Empty = every customer we can reach, across all brands.
  // Otherwise customers who ordered from, or prefer, any of these brands.
  conceptIds     String[]        @default([])
  name           String
  channel        String // email|sms|whatsapp
  subject        String?
  body           String
  status         BroadcastStatus @default(draft)
  scheduledAt    DateTime?
  sentAt         DateTime?
  recipientCount Int?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  segment Segment?       @relation(fields: [segmentId], references: [id])
  sends   CampaignSend[]

  @@index([tenantId])
  @@map("campaigns")
}

model CampaignSend {
  id         String    @id @default(uuid())
  campaignId String
  customerId String
  sentAt     DateTime?
  status     String    @default("queued") // queued|sent|failed|bounced
  errorMsg   String?

  // Engagement tracking — incremented by the public /t/c/:id (click) and
  // /t/o/:id (open pixel) endpoints. firstClickedAt/firstOpenedAt give unique
  // click/open rates; the counts give raw totals.
  clickCount     Int       @default(0)
  openCount      Int       @default(0)
  firstClickedAt DateTime?
  firstOpenedAt  DateTime?

  campaign Campaign @relation(fields: [campaignId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@map("campaign_sends")
}

model AutomationTrigger {
  id        String      @id @default(uuid())
  type      TriggerType
  name      String
  isActive  Boolean     @default(true)
  // config: days inactive, discount %, etc.
  config    Json
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@map("automation_triggers")
}

// ─── Rider ────────────────────────────────────────────────────────────────────

model Rider {
  id              String      @id @default(uuid())
  // Tenant scope. Was nullable historically (Rider predates multi-tenant);
  // backfilled from each rider's first delivery's concept.tenantId in the
  // migration. New riders must specify a tenant. Dispatch routes filter by
  // this so a cashier in tenant A can't see tenant B's fleet GPS / orders.
  tenantId        String?
  tenant          Tenant?     @relation(fields: [tenantId], references: [id])
  name            String
  // The rider's sign-in identity for the rider app (a WhatsApp code to this
  // number), so it stays unique across companies: one person, one login. Stored
  // normalised (auth/otp.ts normalisePhone, 92… digits) from 2026-10-10 —
  // migration 20261010120000_rider_app normalised the existing rows.
  phone           String      @unique
  // Riders sign in like staff (owner, 2026-10-28: "Riders same as staff — Gsfoods email + password"): an
  // @gsfoods.pk email (stored lower-case, unique; never a staff login's email) + a password a manager issues on
  // Riders (POST /riders/:id/new-password, shown once). No WhatsApp code. bcrypt hash; null = none issued yet.
  email           String?     @unique
  passwordHash    String?
  passwordSetAt   DateTime?
  vehicleType     VehicleType @default(bike)
  status          RiderStatus @default(offline)
  isActive        Boolean     @default(true)
  notes           String?
  totalDeliveries Int         @default(0)
  avgRating       Float? // recomputed after each new RiderRating
  // Last reported geolocation — also pushed to a per-order WebSocket channel
  // so customers see the live pin move on their tracking page.
  lastLat         Float?
  lastLng         Float?
  lastHeading     Float? // degrees 0-359
  lastAccuracy    Float? // metres
  lastReportedAt  DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  orders    Order[]
  locations RiderLocation[]
  ratings   RiderRating[]
  jobEvents RiderJobEvent[]

  @@index([tenantId])
  @@map("riders")
}

// ─── Rider app: job events + fleet agreements (docs/rider-app.md) ─────────────

enum RiderJobEventType {
  offered
  accepted
  declined
  timed_out
  picked_up
  arrived
  delivered
  otp_failed
  unassigned
  code_rerouted // Emergency override: the hand-over code was sent to the rider (actorId = the manager)
  door_problem // the rider reported a problem at the door (no code / refused / unreachable) — never an outcome
  returned // Emergency override: the food came back and was booked as waste (actorId = the manager)
}

// Append-only trail of every step of every rider job. Stamped with BOTH
// companies: `tenantId` is the ORDER's company (the client — whose staff see
// it, and who a later cost split charges) and `riderTenantId` the rider's
// employer (the provider fleet). They differ only under a FleetAgreement.
model RiderJobEvent {
  id            String            @id @default(uuid())
  riderId       String
  orderId       String
  tenantId      String // the order's company (client)
  riderTenantId String // the rider's company (provider)
  type          RiderJobEventType
  lat           Float?
  lng           Float?
  note          String?
  createdAt     DateTime          @default(now())
  actorId       String? // the staff user behind an override event (code_rerouted, returned); null for rider / system steps

  rider Rider @relation(fields: [riderId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([riderId, createdAt])
  @@index([tenantId, createdAt])
  @@map("rider_job_events")
}

// The ONE deliberate crossing of company separation (owner, 2026-10-10): GS
// Foods runs a shared fleet, so a provider company's riders may carry a client
// company's orders — only while an active agreement exists. Created / ended
// only by an operator who belongs to BOTH companies. Nothing else crosses.
model FleetAgreement {
  id               String   @id @default(cuid())
  providerTenantId String // whose riders
  clientTenantId   String // whose orders they may carry
  isActive         Boolean  @default(true)
  createdById      String // the staff user who first set it up
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  provider Tenant      @relation("FleetProvider", fields: [providerTenantId], references: [id])
  client   Tenant      @relation("FleetClient", fields: [clientTenantId], references: [id])
  rates    FleetRate[]

  @@unique([providerTenantId, clientTenantId])
  @@index([clientTenantId])
  @@map("fleet_agreements")
}

// What a provider's fleet charges a client per trip (H30, wave B). History: a new row from a month on; never edited.
// The row's (tenantId, clientTenantId) must be the agreement's (providerTenantId, clientTenantId): composite FK
// fleet_rates_agreement_pair_fkey in SQL (migration 20261014090000; not declared here). `prisma migrate diff` against
// a live database proposes DROPPING it — delete that line from any generated migration. CHECKs
// fleet_rates_rate_chk / fleet_rates_period_chk / fleet_rates_parties_chk are SQL only too. RLS lets either company
// read the row.
model FleetRate {
  id               String   @id @default(uuid())
  tenantId         String // provider (the riders' company), owner of the row
  clientTenantId   String
  agreementId      String
  fromPeriod       String // 'YYYY-MM'
  ratePerTripCents Int // INT4 per trip; 0 = not charged from this month
  setById          String
  note             String?
  createdAt        DateTime @default(now())

  agreement FleetAgreement @relation(fields: [agreementId], references: [id], onDelete: Restrict)
  provider  Tenant         @relation("FleetRateProvider", fields: [tenantId], references: [id], onDelete: Restrict)
  client    Tenant         @relation("FleetRateClient", fields: [clientTenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, agreementId, fromPeriod])
  @@index([tenantId])
  @@index([clientTenantId])
  @@map("fleet_rates")
}

// One movement between TWO companies' books, posted in both or neither (H30, wave B). DEBTOR (tenantId) owes/pays:
// its "Due to <creditor>" moves; CREDITOR (counterpartyTenantId): its "Due from <debtor>" moves. Same reference
// 'ic.transfer:<id>' in both books. Sources: manual (finance prepares, CEO approves), fleet (system, monthly),
// cod (a fleet rider's unpaid COD, booked by finance in both companies), ho_recharge (reserved for D1).
// debtorEntryId / creditorEntryId @unique are journal-entry uuids — globally unique by construction; a deliberate
// exception to "unique keys are per company". CHECKs ic_amount_chk, ic_parties_chk, ic_kind_chk, ic_status_chk,
// ic_source_chk, ic_sourceref_chk and ic_method_chk are SQL only (migration 20261014090000). RLS lets either company
// read the row.
// BOOKS-06: money columns on this model are BIGINT paisa (lib/money.ts returns them as JS numbers).
model IntercompanyTransfer {
  id                    String    @id @default(uuid())
  tenantId              String // debtor
  counterpartyTenantId  String // creditor
  kind                  String // charge | settlement | netting
  source                String    @default("manual") // manual | fleet | cod | ho_recharge | asset_transfer
  sourceRef             String? // fleet: 'fleet:<agreementId>:<YYYY-MM>'; cod: 'cod:<paymentId>'; null for manual
  period                String? // 'YYYY-MM' a charge is for
  amountCents           BigInt
  entryDate             DateTime // the date in BOTH books
  debtorAccountCode     String? // charge: debtor's Dr account (fleet: 6035; cod: 1351)
  creditorAccountCode   String? // charge: creditor's Cr account (fleet: 6990 recharges recovered; cod: 1010)
  conceptSplit          Json? // charge: [{conceptId, cents}] on the debtor's Dr lines
  method                String? // settlement: bank_transfer | bank_deposit | cheque | cash (old rows may say bank = bank_transfer)
  debtorBankAccountId   String?
  creditorBankAccountId String?
  bankReference         String?
  memo                  String
  status                String    @default("submitted") // submitted | posted | rejected | reversed
  preparedById          String
  preparedAt            DateTime  @default(now())
  decidedById           String?
  decidedAt             DateTime?
  decisionNote          String?
  selfApproved          Boolean   @default(false)
  debtorEntryId         String?   @unique
  creditorEntryId       String?   @unique
  reversedById          String?
  reversedAt            DateTime?
  reversalReason        String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  debtor   Tenant @relation("IcTransferDebtor", fields: [tenantId], references: [id], onDelete: Restrict)
  creditor Tenant @relation("IcTransferCreditor", fields: [counterpartyTenantId], references: [id], onDelete: Restrict)

  // D1: the head-office recharge line this 'ho_recharge' charge books (one transfer per run line).
  rechargeRunLine RechargeRunLine? @relation("RunLineTransfer")

  @@unique([tenantId, counterpartyTenantId, sourceRef])
  @@index([tenantId, status, entryDate])
  @@index([counterpartyTenantId, status, entryDate])
  @@map("intercompany_transfers")
}

// ─── RiderRating ──────────────────────────────────────────────────────────────
//
// One rating per delivered order. Staff rates on behalf of the customer at
// the counter; future versions will accept direct customer auth. avgRating
// on the Rider row is recomputed as a running average after each insert.

model RiderRating {
  id        String   @id @default(uuid())
  riderId   String
  orderId   String   @unique
  rating    Int // 1–5
  comment   String?
  createdAt DateTime @default(now())

  rider Rider @relation(fields: [riderId], references: [id])

  @@index([riderId, createdAt(sort: Desc)])
  @@map("rider_ratings")
}

// Append-only location stream from rider devices. Keeps a 24h history for
// dispute resolution / time-to-arrive analytics. Older rows are pruned hourly
// by the rider-dispatch worker (workers/riderDispatch.ts pruneRiderLocations).
model RiderLocation {
  id         String   @id @default(uuid())
  riderId    String
  orderId    String? // when on an active delivery
  lat        Float
  lng        Float
  heading    Float?
  accuracy   Float?
  speedMps   Float?
  recordedAt DateTime @default(now())

  rider Rider @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@index([riderId, recordedAt(sort: Desc)])
  @@index([orderId, recordedAt(sort: Desc)])
  @@map("rider_locations")
}

// ─── OrderReview ──────────────────────────────────────────────────────────────

model OrderReview {
  id         String  @id @default(uuid())
  orderId    String  @unique
  customerId String?
  conceptId  String
  rating     Int // 1–5 overall
  comment    String?
  source     String  @default("storefront")

  // Optional sub-ratings — guests can rate individual aspects without
  // forcing all four. Schema is JSON `{ food?: 1..5, service?: 1..5,
  // value?: 1..5, speed?: 1..5 }` so we can add more facets without a
  // migration.
  categoryRatings Json?

  // Quick-tap chips: "Loved the bread", "Quick service", "Generous
  // portions" etc. Powers segment + recommender training without forcing
  // freeform text. Stored as plain strings; admin can rename/add tags.
  tags String[] @default([])

  // True if the rating was 4 or 5 — denormalised for fast positive-leaning
  // CRM queries (winback ignores them, NPS report counts them).
  isPositive Boolean @default(false)

  // Loyalty bonus tracking: we award 50 pts for reviewing within 24h. This
  // flag prevents double-credit if the row gets re-saved.
  bonusPointsAwarded Int @default(0)

  // Manager response to a public review (shown on /brand/<slug>). Public
  // accountability — guests see how the venue handles feedback.
  managerResponse     String?
  managerResponseAt   DateTime?
  managerResponseById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   Order   @relation(fields: [orderId], references: [id])
  concept Concept @relation(fields: [conceptId], references: [id])

  @@index([conceptId, createdAt])
  @@index([conceptId, rating])
  @@map("order_reviews")
}

// ─── OrderComplaint ───────────────────────────────────────────────────────────

model OrderComplaint {
  id          String            @id @default(uuid())
  orderId     String?
  customerId  String?
  conceptId   String
  title       String
  description String
  category    String // wrong_item|missing_item|quality|service|delivery|other
  status      ComplaintStatus   @default(open)
  priority    ComplaintPriority @default(medium)
  resolvedAt  DateTime?
  resolution  String?

  // Lifecycle worker stamp: when we sent the "did we make it right?"
  // follow-up SMS+email after a complaint is marked resolved. Prevents
  // duplicate follow-ups if the resolution is edited.
  followUpSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Ban appeals via the help desk (wave B, owner 2026-10-13: people change numbers). Every complaint reader
  // filters kind='complaint'. CHECK order_complaints_kind_chk and the partial unique
  // order_complaints_one_open_appeal_per_ban (one OPEN appeal per ban) are SQL only (migration 20261014090000).
  kind         String  @default("complaint") // 'complaint' | 'ban_appeal' | 'compensation'
  banId        String? // ban_appeal: the CustomerBan appealed (a brand of the ban's company is conceptId)
  contactPhone String? // from the customer session / WhatsApp sender — never client-supplied

  // Compensation tickets (owner, 2026-10-27: "extend Complaints"): kind 'compensation' = one customer
  // compensation done at the till (void, comp / No Charge, refund, discount above the limit, price
  // override), made from its audit row / review flag by complaints/compensation.ts — never by a route.
  // The company is the order's brand's (conceptId). CHECKs are SQL only (migration 20261027170000).
  compType            String? // 'void' | 'comp' | 'refund' | 'discount' | 'price_override'
  compValueCents      Int? // per-ticket money (INT4, like the order)
  compApproverId      String? // the manager who approved (null = approved by a PIN not recorded)
  compActorId         String? // who did it at the till
  compSourceRef       String?   @unique // 'audit:<auditLogId>' | 'flag:<exceptionFlagId>' — a ticket is made once
  compFlaggedAt       DateTime? // the CEO flagged it (an ExceptionFlag 'compensation_flagged' was raised)
  compFlaggedById     String?
  compFlagNote        String?
  compFlagExceptionId String?

  concept Concept      @relation(fields: [conceptId], references: [id])
  order   Order?       @relation(fields: [orderId], references: [id])
  ban     CustomerBan? @relation("BanAppeals", fields: [banId], references: [id], onDelete: SetNull)

  @@index([banId])
  @@index([kind, status])
  @@index([kind, compType, createdAt])
  @@map("order_complaints")
}

// ─── Settings ────────────────────────────────────────────────────────────────

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ─── StorefrontPromo ──────────────────────────────────────────────────────────

model StorefrontPromo {
  id        String   @id @default(uuid())
  tenantId  String?
  emoji     String   @default("🔥")
  badge     String
  headline  String
  sub       String
  bg        String   @default("#c0392b")
  shadow    String   @default("#922b21")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("storefront_promos")
}

// ─── WalletTransaction ────────────────────────────────────────────────────────

// ─── CustomerWallet ───────────────────────────────────────────────────────────
//
// A customer's stored value AT ONE COMPANY (ONL-R2-01). The wallet used to be
// one servd-wide number (Customer.walletBalance), so value company A granted
// was spent at company B, and B's 2050 Wallet Liability went to a debit
// balance for money it never received. CLAUDE.md: customer-facing money stays
// inside the company that issued it. Every top-up credits the top-up's company
// (and posts Cr 2050 there), every spend debits the ORDER's company, every
// restore credits the order's company. Paisa. Debited only under
// SELECT … FOR UPDATE on this row (order row first when an order is involved)
// — modules/wallet/service.ts is the one place that moves it.
model CustomerWallet {
  id           String   @id @default(uuid())
  tenantId     String
  customerId   String
  balanceCents Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])

  @@unique([tenantId, customerId])
  @@index([tenantId])
  @@index([customerId])
  @@map("customer_wallets")
}

model WalletTransaction {
  id            String   @id @default(uuid())
  // The company whose wallet moved (ONL-R2-01). Every write sets it; null only
  // on a row the 20261011160000 backfill could not attribute (none expected).
  tenantId      String?
  customerId    String
  type          String // topup | spend | refund | bonus | expire
  amountCents   Int // positive = credit, negative = debit
  balanceAfter  Int // the balance of THIS company's wallet after the move
  description   String?
  orderId       String?
  createdAt     DateTime @default(now())
  bankAccountId String? // a top-up received into a company bank account
  method        String? // a paid top-up's method (lib/bankAccounts.ts RECEIPT_METHODS); null for goodwill / spends / older rows
  paymentRef    String? // a paid top-up's payment reference # (2026-10-14)

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId, createdAt])
  @@index([tenantId, customerId])
  @@map("wallet_transactions")
}

// ─── PromoCode ────────────────────────────────────────────────────────────────

model PromoCode {
  id               String    @id @default(uuid())
  tenantId         String?
  conceptId        String?
  code             String
  description      String?
  discountType     String    @default("percentage") // percentage | fixed
  discountValue    Float
  minOrderCents    Int?
  maxDiscountCents Int?
  maxUsageCount    Int?
  perCustomerLimit Int       @default(1)
  usedCount        Int       @default(0)
  channel          String    @default("both") // app | web | both
  startAt          DateTime
  endAt            DateTime
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  // Trash bin (2026-10-15): orders and usages point at a code, so a deleted
  // code is soft-deleted. EVERY redemption read (lib/promoEval.ts) filters
  // deletedAt: null — a trashed code is never redeemable.
  deletedAt        DateTime?

  concept Concept?         @relation(fields: [conceptId], references: [id])
  usages  PromoCodeUsage[]
  orders  Order[]

  // A LIVE code is unique within its company, never across companies (ONL-12):
  // partial unique index promo_codes_tenant_code_live_key on (tenantId, code)
  // WHERE "deletedAt" IS NULL — SQL only; do not re-declare @@unique here.
  @@index([tenantId])
  @@index([tenantId, code])
  @@map("promo_codes")
}

model PromoCodeUsage {
  id            String   @id @default(uuid())
  promoCodeId   String
  customerId    String?
  orderId       String
  discountCents Int
  usedAt        DateTime @default(now())

  promoCode PromoCode @relation(fields: [promoCodeId], references: [id])
  order     Order     @relation(fields: [orderId], references: [id])

  @@map("promo_code_usages")
}

