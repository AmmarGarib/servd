model SupplierConversation {
  id         String   @id @default(cuid())
  supplierId String
  staffId    String
  subject    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  supplier Supplier          @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  staff    User              @relation(fields: [staffId], references: [id])
  messages SupplierMessage[]

  @@index([supplierId])
  @@index([staffId])
  @@map("supplier_conversations")
}

model SupplierMessage {
  id             String   @id @default(cuid())
  conversationId String
  fromStaff      Boolean
  senderId       String?
  body           String
  mediaUrl       String?
  seenAt         DateTime?
  createdAt      DateTime @default(now())

  // Where this message was *originated* — for outbound (fromStaff=true) it's
  // typically "web_portal" because staff types in the admin UI; the same
  // logical message may also fan out via email/whatsapp but that's tracked as
  // delivery, not channel. For inbound (fromStaff=false) it's the channel the
  // supplier replied through: "web_portal", "email", or "whatsapp".
  channel        String   @default("web_portal")

  // For inbound messages: vendor's message id (Postmark MessageID, Meta wamid).
  // Used for de-duplication on webhook retries — same provider id = same
  // logical message, ignore the second delivery.
  externalMessageId  String?  @unique
  // For inbound: the from address (email like "ali@gsfoods.pk" or wa-style
  // E.164 phone "923001234567"). Lets us reconstruct routing decisions
  // and shows in the UI as "from <ali@gsfoods.pk> via email".
  inboundFromAddress String?

  conversation SupplierConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("supplier_messages")
}

model SupplierPortalToken {
  id         String    @id @default(cuid())
  supplierId String
  token      String    @unique @default(cuid())
  label      String?
  expiresAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("supplier_portal_tokens")
}

