}

// Facebook / Instagram page connection PER BRAND (owner C18, 2026-10-26:
// "Approval goes thru me, marketing can connect"). Marketing connects a brand's
// page → `pending`; the CEO approves it in the approvals inbox (type
// social_connection) → `approved` (the previous approved row of the brand →
// `superseded`). Only an `approved` row is ever used to post. The page token is
// sealed with lib/secretBox.ts (plain only while SERVD_SECRET_KEY is unset,
// encrypted on the next read). `legacy` = the old global connection, kept for
// nobody (tenantId / conceptId null, deliberately). modules/socialConnections.
model SocialConnection {
  id            String    @id @default(uuid())
  tenantId      String? // the brand's company; null only for the legacy row
  conceptId     String?
  status        String // pending | approved | rejected | superseded | legacy
  pageId        String
  pageName      String?
  igUserId      String?
  token         String // secretBox value (enc:v1:…) or plain while no key is set
  tokenHint     String?
  requestedById String?
  requestedAt   DateTime  @default(now())
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId])
  @@index([conceptId, status])
  @@map("social_connections")
}

// ─── Supplier Chat ────────────────────────────────────────────────────────────

model SupplierConversation {
  id         String   @id @default(cuid())
  supplierId String
  staffId    String
  subject    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  supplier Supplier          @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  staff    User              @relation(fields: [staffId], references: [id])
  messages SupplierMessage[]

  @@index([supplierId])
  @@index([staffId])
  @@map("supplier_conversations")
}

model SupplierMessage {
  id             String    @id @default(cuid())
  conversationId String
  fromStaff      Boolean
  senderId       String?
  body           String
  mediaUrl       String?
  seenAt         DateTime?
  createdAt      DateTime  @default(now())

  // Where this message was *originated* — for outbound (fromStaff=true) it's
  // typically "web_portal" because staff types in the admin UI; the same
  // logical message may also fan out via email/whatsapp but that's tracked as
  // delivery, not channel. For inbound (fromStaff=false) it's the channel the
  // supplier replied through: "web_portal", "email", or "whatsapp".
  channel String @default("web_portal")

  // For inbound messages: vendor's message id (Postmark MessageID, Meta wamid).
  // Used for de-duplication on webhook retries — same provider id = same
  // logical message, ignore the second delivery.
  externalMessageId  String? @unique
  // For inbound: the from address (email like "ali@gsfoods.pk" or wa-style
  // E.164 phone "923001234567"). Lets us reconstruct routing decisions
  // and shows in the UI as "from <ali@gsfoods.pk> via email".
  inboundFromAddress String?

  conversation SupplierConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("supplier_messages")
}

model SupplierPortalToken {
  id         String    @id @default(cuid())
  supplierId String
  token      String    @unique @default(cuid())
  label      String?
  expiresAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("supplier_portal_tokens")
}

// ─── Configuration models — 18 setup gaps shipped in one batch ───────────────

// Reusable modifier template — instead of creating "Sauces (Choose 1)" inline
// per menu item, operators define once and reference from many items.
model ModifierTemplate {
  id          String    @id @default(cuid())
  // Owning company — this is company master data, never shared across companies.
  tenantId    String?
  name        String // 'Sauces', 'Sizes', 'Sides', 'Spice Level'
  description String?
  isRequired  Boolean   @default(false)
  minSelect   Int       @default(0)
  maxSelect   Int       @default(1)
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  options ModifierTemplateOption[]

  tenant Tenant? @relation("TenantModifierTemplates", fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("modifier_templates")
}

model ModifierTemplateOption {
  id              String  @id @default(cuid())
  templateId      String
  name            String
  priceDeltaCents Int     @default(0)
  isDefault       Boolean @default(false)
  isAvailable     Boolean @default(true)
  sortOrder       Int     @default(0)

  template ModifierTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("modifier_template_options")
}

// Delivery zones — radius-based or polygon-based, with fee + minimum order
model DeliveryZone {
  id               String   @id @default(cuid())
  // Owning company — company master data, never shared across companies.
  tenantId         String?
  conceptId        String? // null = all concepts
  name             String // "Inner DHA", "Phase 5", "Outside city"
  // Distance-based mode
  radiusKmMin      Float? // 0 for first zone
  radiusKmMax      Float?
  // Polygon mode (GeoJSON-style coords)
  polygon          Json?
  feeCents         Int      @default(0)
  freeAboveCents   Int? // free delivery if order >= this
  minOrderCents    Int      @default(0)
  estimatedMinutes Int? // delivery time estimate shown to customers
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  tenant           Tenant?  @relation("TenantDeliveryZones", fields: [tenantId], references: [id])

  @@index([conceptId])
  @@index([tenantId])
  @@map("delivery_zones")
}

// Notification templates — order events, system events, marketing
model NotificationTemplate {
  id        String   @id @default(cuid())
  // Owning company — company master data, never shared across companies.
  tenantId  String?
  conceptId String? // null = global default
  channel   String // 'email' | 'sms' | 'whatsapp' | 'push'
  event     String // 'order.confirmed' | 'order.ready' | 'order.refunded' | 'shift.opened' | 'reservation.reminder' | etc.
  subject   String? // email subject; null for SMS
  body      String // template string with {{variables}}
  variables String[] @default([]) // declared variables for editor hint
  isActive  Boolean  @default(true)
  language  String   @default("en") // 'en' | 'ur'
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant?  @relation("TenantNotificationTemplates", fields: [tenantId], references: [id])

  @@unique([tenantId, conceptId, channel, event, language], map: "notification_templates_tenant_scope_key")
  @@index([conceptId, channel])
  @@index([tenantId])
  @@map("notification_templates")
}

// Bank accounts — used in reconciliation against Foodpanda/Careem settlements + card payouts
model BankAccount {
  id                  String    @id @default(cuid())
  // Owning company — this is company master data, never shared across companies.
  tenantId            String?
  name                String // "HBL Operations Account"
  bankName            String? // "HBL", "Meezan"
  accountTitle        String?
  accountNumber       String?
  iban                String?
  branchCode          String?
  swiftCode           String?
  currency            String    @default("PKR")
  // Bank details only. The BALANCE lives in the ledger: accountCode is the
  // chart-of-accounts code (in this company's chart) the money sits in —
  // 1020 for the operating account, a 102x child for each further bank.
  // Deposits post to it, bank-statement imports reconcile against it.
  accountCode         String?
  // Recorded at setup; not read by any report (the ledger balance of
  // accountCode is the balance). Shown read-only.
  openingBalanceCents Int       @default(0)
  isActive            Boolean   @default(true)
  notes               String?
  // Raast QR: the Raast ID / alias shown at the till, and whether this is the
  // company's default receiving account (at most one per company — a partial
  // unique index in SQL, migration 20261013090100). A brand may override it
  // (Concept.raastBankAccountId).
  raastId             String?
  raastDefault        Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  tenant        Tenant?        @relation("TenantBankAccounts", fields: [tenantId], references: [id])
  raastConcepts Concept[]      @relation("ConceptRaastAccount")
  raastReceipts RaastReceipt[]

  @@index([tenantId])
  @@map("bank_accounts")
}

// KDS device registry — physical screens distinct from logical Stations
model KdsDevice {
  id                String    @id @default(cuid())
  // B15: every device registration is owned by exactly one tenant so two
  // operators on different companies can never see each other's stations.
  tenantId          String? // nullable for legacy rows; new rows always set it
  name              String // "Grill Tablet 1"
  stationId         String? // logical station this device displays
  conceptId         String? // optional concept restriction
  deviceFingerprint String?   @unique // browser fingerprint or set on first connect
  lastSeenAt        DateTime?
  ipAddress         String?
  isActive          Boolean   @default(true)
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([stationId])
  @@index([tenantId])
  @@map("kds_devices")
}

// Outbound webhooks — let third-party software subscribe to servd events
model WebhookSubscription {
  id           String    @id @default(cuid())
  // Owning company — this is company master data, never shared across companies.
  tenantId     String?
  url          String // https://accountant.example.com/webhooks/servd
  events       String[]  @default([]) // ['order.completed', 'order.refunded', 'shift.closed']
  secret       String // HMAC SHA-256 signing secret
  isActive     Boolean   @default(true)
  lastSentAt   DateTime?
  lastStatus   String? // 'success' | 'failed_4xx' | 'failed_5xx' | 'timeout'
  failureCount Int       @default(0)
  notes        String?
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  deliveries WebhookDelivery[]

  tenant Tenant? @relation("TenantWebhookSubscriptions", fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("webhook_subscriptions")
}

// Per-attempt delivery log — written by the webhookDelivery worker.
// Gives operators a scrollable timeline of "what fired, when, did it succeed".
// Pruned to last 90 days by a background sweep (future cron job).
model WebhookDelivery {
  id             String   @id @default(cuid())
  subscriptionId String
  event          String // 'order.placed', 'ping', etc.
  url            String // snapshot of URL at time of delivery
  requestBody    String // JSON payload sent
  responseCode   Int? // HTTP status from subscriber
  responseBody   String? // first 1000 chars of response
  status         String // 'success' | 'failed_4xx' | 'failed_5xx' | 'timeout' | 'error'
  durationMs     Int? // round-trip latency
  attemptNumber  Int      @default(1) // BullMQ attempt (1 = first try)
  attemptedAt    DateTime @default(now())

  subscription WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, attemptedAt(sort: Desc)])
  @@index([event, attemptedAt(sort: Desc)])
  @@map("webhook_deliveries")
}

// Custom fields — operator-defined extensions to core entities
model CustomFieldDefinition {
  id         String   @id @default(cuid())
  // Owning company — company master data, never shared across companies.
  tenantId   String?
  scope      String // 'customer' | 'order' | 'menu_item' | 'supplier'
  key        String // 'gift_recipient', 'table_preference', 'allergy_severity'
  label      String // operator-facing label
  type       String // 'text' | 'number' | 'date' | 'select' | 'boolean'
  options    String[] @default([]) // for select type
  helpText   String?
  isRequired Boolean  @default(false)
  showInList Boolean  @default(false) // include in list view columns
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  values CustomFieldValue[]
  tenant Tenant?            @relation("TenantCustomFieldDefinitions", fields: [tenantId], references: [id])

  @@unique([tenantId, scope, key])
  @@index([scope])
  @@index([tenantId])
  @@map("custom_field_definitions")
}

model CustomFieldValue {
  id         String   @id @default(cuid())
  fieldId    String
  entityType String // matches field.scope
  entityId   String // FK by string — flexible across entity types
  value      String // serialised; parsed by field.type
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  field CustomFieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([fieldId, entityType, entityId])
  @@index([entityType, entityId])
  @@map("custom_field_values")
}

// Scheduled reports — owner gets daily/weekly digests by email
model ScheduledReport {
  id          String    @id @default(cuid())
  // Owning company — company master data, never shared across companies.
  tenantId    String?
  name        String // "Daily P&L"
  reportType  String // 'sales_daily' | 'shift_summary' | 'low_stock' | 'food_cost' | 'ap_aging' | 'menu_engineering'
  cron        String // standard cron syntax
  recipients  String[]  @default([]) // email addresses
  conceptId   String? // null = all concepts
  isActive    Boolean   @default(true)
  lastRunAt   DateTime?
  lastStatus  String?
  notes       String?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant Tenant? @relation("TenantScheduledReports", fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("scheduled_reports")
}

// Refund / void / comp policy — single record per scope
model RefundPolicy {
  id       String  @id @default(cuid())
  scope    String  @default("global") // 'global' | 'concept'
  scopeId  String? // concept id when scope='concept'
  // Owning company — this is company master data, never shared across companies.
  tenantId String?

  // Per-role caps (cents). 0 = role can't perform without manager override.
  cashierVoidLimitCents   Int @default(0)
  cashierCompLimitCents   Int @default(50000) // PKR 500
  cashierRefundLimitCents Int @default(0)

  managerVoidLimitCents   Int @default(500000) // PKR 5,000
  managerCompLimitCents   Int @default(500000)
  managerRefundLimitCents Int @default(500000)

  requireReason         Boolean  @default(true)
  requirePhotoEvidence  Boolean  @default(false)
  notifyOwnerAboveCents Int? // alert owner above threshold
  approverEmail         String?
  notes                 String?
  updatedAt             DateTime @updatedAt
  updatedById           String?
  tenant                Tenant?  @relation("TenantRefundPolicies", fields: [tenantId], references: [id])

  @@unique([tenantId, scope, scopeId])
  @@index([tenantId])
  @@map("refund_policies")
}

// Reservation policy — single record per scope
model ReservationPolicy {
  id       String  @id @default(cuid())
  scope    String  @default("global")
  scopeId  String?
  // Owning company — this is company master data, never shared across companies.
  tenantId String?

  depositRequiredAboveParty Int? // require deposit for parties larger than this
  depositCents              Int     @default(0)
  noShowGraceMinutes        Int     @default(15)
  cancellationWindowHours   Int     @default(24)
  maxAdvanceDays            Int     @default(60)
  minAdvanceHours           Int     @default(2)
  maxPartySize              Int     @default(20)
  walkInsAllowed            Boolean @default(true)
  remindersEnabled          Boolean @default(true)
  reminderHoursBefore       Int     @default(24)

  // Slot generation — drives the public availability widget. The restaurant
  // controls these from /configuration/reservation-policy. slotIntervalMin
  // sets the granularity (15 / 30 / 60). defaultDurationMin is the booked
  // window per slot (90 = standard dinner sitting).
  slotIntervalMin    Int @default(30)
  defaultDurationMin Int @default(90)

  // Daypart grouping — how the public widget buckets the slot grid into
  // labelled sections (Lunch / Dinner / etc). JSON array of
  //   { label: string, startHour: 0..23, endHour: 1..24 }
  // Default mirrors the original hardcoded grouping so existing rows behave
  // the same after migration.
  dayparts Json @default("[{\"label\":\"Lunch\",\"startHour\":0,\"endHour\":12},{\"label\":\"Afternoon\",\"startHour\":12,\"endHour\":16},{\"label\":\"Dinner\",\"startHour\":16,\"endHour\":22},{\"label\":\"Late night\",\"startHour\":22,\"endHour\":24}]")

  notes       String?
  updatedAt   DateTime @updatedAt
  updatedById String?
  tenant      Tenant?  @relation("TenantReservationPolicies", fields: [tenantId], references: [id])

  @@unique([tenantId, scope, scopeId])
  @@index([tenantId])
  @@map("reservation_policies")
}

// Receipt customization — logo/footer/legal/format
model ReceiptConfig {
  id                     String   @id @default(cuid())
  scope                  String   @default("global")
  scopeId                String?
  // Owning company — this is company master data, never shared across companies.
  tenantId               String?
  paperWidthMm           Int      @default(80) // 80 or 58
  showLogo               Boolean  @default(true)
  logoUrl                String?
  headerText             String? // e.g. "Mubarak Biryani Co. — DHA Phase 5"
  footerText             String? // "Thank you, see you again!"
  legalDisclaimer        String? // "Goods sold are not returnable"
  showTaxBreakdown       Boolean  @default(true)
  showFbrInvoice         Boolean  @default(true)
  printerIp              String? // ESC/POS network printer
  printerPort            Int      @default(9100)
  autoPrintOnOrder       Boolean  @default(false)
  autoPrintOnPay         Boolean  @default(true)
  drawerKickEnabled      Boolean  @default(true)
  cashVarianceLimitCents Int      @default(20000) // PKR 200 default
  updatedAt              DateTime @updatedAt
  updatedById            String?
  tenant                 Tenant?  @relation("TenantReceiptConfigs", fields: [tenantId], references: [id])

  @@unique([tenantId, scope, scopeId])
  @@index([tenantId])
  @@map("receipt_configs")
}

// Operations config — service charge, tip pool rules, invoice numbering, withholding tax,
// brand assets, period locks, COA — settings the platform reads but no dedicated full
// model. Stored as a single typed record per scope.
model OperationsConfig {
  id       String  @id @default(cuid())
  scope    String  @default("global")
  scopeId  String?
  // Owning company — this is company master data, never shared across companies.
  tenantId String?

  // Service charge
  serviceChargePct               Float    @default(0) // 0–1, e.g. 0.05 = 5%
  serviceChargeAppliesToChannels String[] @default([]) // ['pos', 'storefront'] — if empty, applies to all

  // Tip pool
  tipPoolEnabled      Boolean @default(false)
  tipPoolDistribution String  @default("equal") // 'equal' | 'by_hours' | 'by_role_weight'
  tipPoolRoleWeights  Json? // { kitchen: 1.0, cashier: 1.5, ... }

  // Tax invoice numbering
  invoiceSequenceReset    String  @default("yearly") // 'yearly' | 'monthly' | 'never'
  invoiceCreditNotePrefix String? // 'CN-'

  // Withholding tax
  withholdingTaxEnabled     Boolean @default(false)
  withholdingTaxPct         Float   @default(0)
  withholdingTaxRecoverable Boolean @default(true)

  // Brand assets (extended palette)
  secondaryColors       String[] @default([]) // hex colors
  fontHeading           String? // 'Playfair Display'
  fontBody              String? // 'Inter'
  brandVoiceNotes       String? // tone-of-voice guidance for marketing copy
  socialInstagramHandle String?
  socialTiktokHandle    String?
  socialFacebookUrl     String?

  // Anti-theft enforcement thresholds (added 2026-05-06)
  cashierDiscountPctCap    Float   @default(0.10) // 10% — above requires manager PIN
  managerDiscountPctCap    Float   @default(0.50) // 50% — admin override above
  cashierPriceOverrideCap  Int     @default(0) // PKR cents — 0 = no override allowed for cashiers
  photoRequiredAboveCents  Int     @default(50000) // waste/receipt photo required above this
  geofenceRadiusMetres     Int     @default(150) // clock-in must be within N metres of concept lat/lng
  geofenceEnforced         Boolean @default(false) // soft-launch flag; flips to true after staff training
  selfieRequiredAtClockIn  Boolean @default(false) // selfie photo at clock-in
  pii_export_row_threshold Int     @default(100) // bulk customer/recipe export above this auto-flags
  shrinkage_trend_weeks    Int     @default(4) // window for chronic shrinkage detection

  // Fixed assets v2 policy (wave B; edited only via PATCH /accounting/fixed-assets/policy). Depreciation is ALWAYS
  // automatic (owner) — there is deliberately no on/off switch.
  capexUncapitalisedAlertDays Int    @default(30)
  capexAdvanceOverdueDays     Int    @default(45)
  deferredTaxRateBp           Int    @default(2900) // H24: report only, 29%
  assetTagPrefix              String @default("FA-")
  // Withholding (H8/H28): { '153_1_a': {filerBps, nonFilerBps}, '153_1_b': …, '153_1_c': …, '155': … }.
  // null = defaults in lib/withholding.ts, with withholdingTaxPct as the 153_1_a filer rate. ONE writer:
  // PUT /accounting/withholding/rates (PATCH /setup/operations-config no longer accepts withholdingTaxPct).
  withholdingRates            Json?
  // Card payouts (H12): { enabled, payoutBankAccountId, unitMode ('company'|'brand'|'terminal'), mdrBps, feeTaxBps,
  // lagDays, toleranceBps, maxBatchDays, maxFeeBps, startDay }. null = card payout matching off.
  cardSettlement              Json?
  // Cash requests (H3): receipts due within N days of payment; the daily worker then converts the rest.
  cashAdvanceSettleDays       Int    @default(30)

  updatedAt   DateTime @updatedAt
  updatedById String?
  tenant      Tenant?  @relation("TenantOperationsConfigs", fields: [tenantId], references: [id])

  @@unique([tenantId, scope, scopeId])
  @@index([tenantId])
  @@map("operations_configs")
}

// ─── Component library ────────────────────────────────────────────────────────
// Master file of every prep / sauce / sub-recipe built FROM raw ingredients and
// used IN menu items. Sits between InventoryItem (raw) and MenuItem (finished).
// One ingredient can yield many components — operators capture hero forms,
// supporting forms, and trim/waste utilizations all hanging off the same
// parent ingredient. Plug-and-play seasonal additions over time.
//
// Examples from the GS Foods component matrix:
//   Dates → hero: "Stuffed Dates"
//         → supporting: "Date Syrup", "Date Ketchup"
//         → trim/waste: "Date Coffee"
//   Lemon → hero: "Lemon Curd / Fluid Gel"
//         → supporting: "Preserved Lemons"
//         → trim/waste: "Candied Lemon Julienne"

enum ComponentType {
  hero
  supporting
  trim_waste
}

model Component {
  id               String        @id @default(cuid())
  baseIngredientId String?
  name             String
  type             ComponentType
  description      String?
  preparation      String?

  seasons String[] @default([])

  yieldGrams     Float?
  shelfLifeHours Int?
  laborMinutes   Int?

  isActive  Boolean   @default(true)
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  baseIngredient InventoryItem?      @relation(fields: [baseIngredientId], references: [id])
  brands         ComponentBrandUse[]
  parLevels      ComponentParLevel[]

  @@index([baseIngredientId])
  @@index([type])
  @@index([isActive])
  @@map("components")
}

// Daily prep tracking. Each (component × tenant × date) gets one row created
// in the morning by expo/prep — `targetCount` is what the team aims to make,
// `actualCount` ticks up as prep cooks update it, and it ticks down as orders
// fire the component on the line. The Expo screen highlights low-actual rows
// in red so the floor manager can shift labor before service starts.
model ComponentParLevel {
  id          String   @id @default(uuid())
  tenantId    String
  componentId String
  date        DateTime // midnight UTC of the service day
  // Target prep — what we're aiming to have on hand at service start.
  targetCount Float    @default(0)
  // What's currently in the walk-in. Updated by prep staff as they work;
  // decremented by the runtime as orders consume the component.
  actualCount Float    @default(0)
  // Unit label for readability ("portions", "trays", "ltr"). Falls back to
  // the component's natural unit when blank.
  unit        String?
  notes       String?
  // Who last touched the row — useful for the audit trail at par disputes.
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  component Component @relation(fields: [componentId], references: [id])

  @@unique([tenantId, componentId, date])
  @@index([tenantId, date])
  @@map("component_par_levels")
}

model ComponentBrandUse {
  componentId String
  conceptId   String
  usageNote   String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())

  component Component @relation(fields: [componentId], references: [id], onDelete: Cascade)
  concept   Concept   @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@id([componentId, conceptId])
  @@index([conceptId])
  @@map("component_brand_uses")
}

// ─── Capital ledger ───────────────────────────────────────────────────────────
// Tracks every PKR out against the project's total capital ask. Mirrors the
// "Date / Amount / For / Paid Out To" tab most operators run in Excel.

model CapitalLedgerEntry {
  id          String    @id @default(cuid())
  tenantId    String?
  conceptId   String?
  projectId   String?
  date        DateTime
  amountCents Int
  description String
  paidTo      String?
  invoiceUrl  String?
  category    String? // 'rent' | 'broker' | 'capex' | 'license' | 'equipment' | 'consulting' | 'other'
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([tenantId, date(sort: Desc)])
  @@index([conceptId, date(sort: Desc)])
  @@index([projectId])
  @@map("capital_ledger_entries")
}

// ─── CapEx project ────────────────────────────────────────────────────────────
// One project per location/concept buildout. Line items grouped into scopes
// (BOH = back of house, FOH = front of house, AG = above ground / finishing).

// BOOKS-06: money columns on this model are BIGINT paisa (lib/money.ts returns them as JS numbers).
model CapexProject {
  id                  String    @id @default(cuid())
  tenantId            String?
  conceptId           String?
  locationId          String? // physical location being built/refurbed
  name                String
  projectType         String    @default("kitchen_buildout") // kitchen_buildout | refurb | expansion | new_brand | equipment_only
  phase               String    @default("planning") // planning | quoting | executing | snagging | live
  // Budget envelope — owner-set cap. Lines + fees + tax + contingency = totalAsk;
  // we flag when totalAsk exceeds this.
  budgetEnvelopeCents BigInt    @default(0)
  contingencyPct      Float     @default(0.10) // 10% default
  totalAskCents       BigInt    @default(0) // legacy; recomputed from lines + fees
  consultantFeesCents BigInt    @default(0)
  taxCents            BigInt    @default(0)
  // Project schedule
  targetOpeningDate   DateTime?
  actualOpeningDate   DateTime?
  // Project metadata
  ownerId             String? // project manager / owner
  address             String?
  floorAreaSqft       Int?
  // Per-project scope sections — JSON array of { key, label, emoji, hint }.
  // null = use platform default (BOH/FOH/AG/etc). Operators rename/add/reorder.
  scopeConfig         Json?
  // Project-level JV (independent of tenant-level JV). Useful when a single
  // build is co-funded by a partner even though the tenant isn't a JV
  // overall. Same shape as Tenant.jvPartners. UI renders partner-share
  // chips next to every cost line on the project's CapEx + OpEx tabs.
  isJointVenture      Boolean   @default(false)
  jvPartners          Json? // [{label, pct}, ...]
  status              String    @default("planning") // legacy alias for phase
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?
  // The per-outlet 'Equipment & smallwares' project used by Quick buy (projectType 'equipment_only'; wave B).
  // One live standing project per (company, outlet): partial unique capex_projects_standing in SQL (migration
  // 20261014090000; not declared here).
  isStanding          Boolean   @default(false)

  lines CapexLine[]

  @@index([tenantId])
  @@index([conceptId])
  @@index([locationId])
  @@map("capex_projects")
}

// BOOKS-06: money columns on this model are BIGINT paisa (lib/money.ts returns them as JS numbers).
model CapexLine {
  id                   String    @id @default(cuid())
  projectId            String
  scope                String // 'BOH' | 'FOH' | 'AG' | 'Equipment' | 'MEP' | 'Civil' | 'Tech' | 'Branding' | 'Permits' | 'SoftCosts' | 'Other'
  category             String? // sub-grouping for the operator's mental model
  item                 String
  quantity             Int       @default(1)
  unitCostCents        BigInt // budgeted/estimated cost — what you planned
  // Vendor + quoting
  vendor               String? // selected vendor
  vendorContact        String?
  quotedCents          BigInt? // initial quote total
  negotiatedCents      BigInt? // final negotiated total — what you actually committed to
  paidCents            BigInt    @default(0) // running total paid
  // Status pipeline
  status               String    @default("not_quoted") // not_quoted | quoted | ordered | partial_paid | delivered | installed | commissioned | snag | done
  priority             String    @default("must_have") // must_have | nice_to_have | future
  // Schedule
  leadTimeDays         Int?
  expectedDeliveryDate DateTime?
  actualDeliveryDate   DateTime?
  installedDate        DateTime?
  // Documents + photos as JSON arrays of {label, url}
  documentUrls         Json?
  photoUrls            Json?
  // Operational
  warrantyMonths       Int?
  assignedToId         String?
  notes                String?
  sortOrder            Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  // Wave B — the ONE treatment override (the per-payment body field is removed) + vendor tax
  supplierId           String?
  // capital | prepaid | deposit | expense; null = automatic (capexTreatmentOf); locked once a payment posts.
  // CHECK capex_lines_treatment_chk (SQL only).
  treatment            String?
  inputTaxCents        BigInt    @default(0)
  inputTaxAuthority    String? // fbr | srb | pra | kpra | bra → taxAuthorities.inputTaxCodeFor (never a free code)
  whtSection           String? // 153_1_a | 153_1_b | 153_1_c | 155 | none; null = supplier.defaultWhtSection ?? by treatment

  project        CapexProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  quotes         CapexQuote[]
  payments       CapexPayment[]
  supplierRecord Supplier?      @relation("CapexLineSupplier", fields: [supplierId], references: [id], onDelete: SetNull)
  fixedAssets    FixedAsset[]

  @@index([projectId])
  @@index([status])
  @@index([supplierId])
  @@map("capex_lines")
}

// Multiple quotes per line — vendor comparison shopping. Operator marks one
// as the winner; that one populates CapexLine.vendor + negotiatedCents.
// BOOKS-06: money columns on this model are BIGINT paisa (lib/money.ts returns them as JS numbers).
model CapexQuote {
  id           String    @id @default(cuid())
  lineId       String
  vendor       String
  contactName  String?
  contactPhone String?
  totalCents   BigInt
  leadTimeDays Int?
  validUntil   DateTime?
  fileUrl      String? // PDF / image of the quote document
  notes        String?
  isWinner     Boolean   @default(false)
  createdAt    DateTime  @default(now())

  line CapexLine @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@index([lineId])
  @@map("capex_quotes")
}

// ─── OpEx tracker — recurring operational expenses ───────────────────────────
// Different shape from CapEx: these are recurring cash-outflows (rent, payroll,
// utilities, software). The model is "category → line → period payments" with
// expected vs actual per period so trend + variance jump out.

// BOOKS-06: money columns on this model are BIGINT paisa (lib/money.ts returns them as JS numbers).
model OpexCategory {
  id                 String    @id @default(cuid())
  tenantId           String?
  conceptId          String? // null = company-wide
  name               String // 'Rent' | 'Utilities' | 'Payroll' | 'Software' | etc.
  // The 6xxx account this category's payments post to (in its company's
  // chart). Null = not mapped yet: the payment names one and it is remembered.
  expenseAccountCode String?
  emoji              String? // surfaced in UI
  budgetMonthlyCents BigInt    @default(0) // monthly cap; variance vs actual flagged
  notes              String?
  isActive           Boolean   @default(true)
  sortOrder          Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  lines OpexLine[]

  @@index([tenantId])
  @@index([conceptId])
  @@map("opex_categories")
}

// BOOKS-06: money columns on this model are BIGINT paisa (lib/money.ts returns them as JS numbers).
model OpexLine {
  id                String    @id @default(cuid())
  categoryId        String
  conceptId         String?
  projectId         String? // optional link to a CapexProject (build-out + run together = full TCO)
  name              String // 'Office rent — Lahore', 'KE bill — Karachi kitchen'
  vendor            String?
  vendorContact     String?
  amountCents       BigInt // expected per-period amount
  cadence           String    @default("monthly") // 'monthly' | 'quarterly' | 'annual' | 'per_use'
  nextDueDate       DateTime?
  paymentMethod     String? // 'bank_transfer' | 'card' | 'cash' | 'auto_debit'
  bankAccountId     String?
  // Source: 'manual' for hand-entered; 'payroll'/'license'/'subscription' link to internal data.
  source            String    @default("manual")
  isActive          Boolean   @default(true)
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  // Wave B — supplierId wins over the free-text vendor (kept for legacy lines; filled from the supplier name)
  supplierId        String?
  whtSection        String? // 153_1_a | 153_1_b | 153_1_c | 155 | null = none
  inputTaxAuthority String? // fbr | srb | pra | kpra | bra (usual)

  category OpexCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  payments OpexPayment[]
  supplier Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([categoryId])
  @@index([projectId])
  @@index([nextDueDate])
  @@index([supplierId])
  @@map("opex_lines")
}

// BOOKS-06: money columns on this model are BIGINT paisa (lib/money.ts returns them as JS numbers).
model OpexPayment {
  id                String    @id @default(cuid())
  lineId            String
  periodStart       DateTime
  periodEnd         DateTime
  expectedCents     BigInt // forecast for this period
  actualCents       BigInt? // what hit the bank (null until paid)
  paidAt            DateTime?
  paymentRef        String?
  receiptUrl        String?
  notes             String?
  createdAt         DateTime  @default(now())
  // Wave B — actualCents stays the CASH that left the bank; invoice = actualCents + whtCents;
  // expense = invoice − inputTaxCents (budget/variance compare the EXPENSE).
  inputTaxCents     BigInt    @default(0)
  inputTaxAuthority String?
  whtCents          BigInt    @default(0)
  whtSection        String?
  whtRateBps        Int?
  filerStatus       String? // snapshot at payment
  whtOverrideReason String?
  // expense | prepaid (H25: Dr 1310, released monthly by PrepaidRelease). CHECK opex_payments_treatment_chk (SQL only).
  treatment         String    @default("expense")
  coversFrom        String? // 'YYYY-MM' (prepaid)
  coversMonths      Int?

  line OpexLine @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@index([lineId, periodStart])
  @@index([paidAt])
  @@map("opex_payments")
}

// Payment schedule per line — deposit / midpoint / balance / extras.
// Cash-flow page sums these by dueDate to show outflow timeline.
// BOOKS-06: money columns on this model are BIGINT paisa (lib/money.ts returns them as JS numbers).
model CapexPayment {
  id                         String    @id @default(cuid())
  lineId                     String
  label                      String // 'deposit' | 'midpoint' | 'balance' | 'extra'
  amountCents                BigInt
  dueDate                    DateTime?
  paidAt                     DateTime?
  paidAmountCents            BigInt? // null until paid; supports partial
  paymentRef                 String? // bank ref, cheque #, transaction ID
  notes                      String?
  createdAt                  DateTime  @default(now())
  bankAccountId              String? // the company bank account it was paid from
  // Wave B — withholding snapshot (lib/withholding.ts computeWithholding), prepaid term, deposits
  whtCents                   BigInt    @default(0) // fixed when first marked paid
  whtSection                 String?
  whtRateBps                 Int?
  filerStatus                String? // snapshot at payment
  whtOverrideReason          String?
  coversFrom                 String? // 'YYYY-MM' — required for treatment 'prepaid' (422 PREPAID_TERM_REQUIRED on new rows)
  coversMonths               Int?
  depositReturnedCents       BigInt    @default(0)
  depositForfeitedCents      BigInt    @default(0)
  depositReturnedAt          DateTime?
  depositReturnMethod        String?
  depositReturnRef           String? // payment reference # of the money the landlord returned (2026-10-14)
  depositReturnBankAccountId String?
  // 'finance' = entered in CapEx; 'cash' = created from a petty-cash spend line / cash-request settlement line of
  // kind 'capex' (that line's capexPaymentId is the one-time guard, per company).
  source                     String    @default("finance")

  line CapexLine @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@index([lineId])
  @@index([dueDate])
  @@map("capex_payments")
}

// ─── Pro-forma / financial projection ─────────────────────────────────────────
// Persisted version of the operator's Excel "Annual Projection" tab. One
// ProForma = one scenario; channels + fixed costs + monthly ramp curves
// produce the per-month P&L.

model ProForma {
  id                       String    @id @default(cuid())
  tenantId                 String?
  conceptId                String?
  name                     String
  scenario                 String    @default("base")
  totalAskCents            Int       @default(0)
  capexCents               Int       @default(0)
  workingCapitalCents      Int       @default(0)
  brokerFeeCents           Int       @default(0)
  rentAdvanceSecurityCents Int       @default(0)
  monthlyFixedCostsCents   Int       @default(0)
  variableCostPct          Float     @default(0.40)
  tradingDaysPerMonth      Int       @default(26)
  notes                    String?
  createdById              String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  deletedAt                DateTime?

  channels   ProFormaChannel[]
  fixedCosts ProFormaFixedCost[]
  months     ProFormaMonth[]

  @@index([tenantId])
  @@index([conceptId])
  @@map("pro_formas")
}

model ProFormaChannel {
  id            String @id @default(cuid())
  proFormaId    String
  name          String
  checkAvgCents Int
  ordersTue     Int    @default(0)
  ordersWed     Int    @default(0)
  ordersThu     Int    @default(0)
  ordersFri     Int    @default(0)
  ordersSat     Int    @default(0)
  ordersSun     Int    @default(0)
  ordersMon     Int    @default(0)
  sortOrder     Int    @default(0)

  proForma ProForma @relation(fields: [proFormaId], references: [id], onDelete: Cascade)

  @@index([proFormaId])
  @@map("pro_forma_channels")
}

model ProFormaFixedCost {
  id           String  @id @default(cuid())
  proFormaId   String
  category     String
  monthlyCents Int
  notes        String?
  sortOrder    Int     @default(0)

  proForma ProForma @relation(fields: [proFormaId], references: [id], onDelete: Cascade)

  @@index([proFormaId])
  @@map("pro_forma_fixed_costs")
}

model ProFormaMonth {
  id               String  @id @default(cuid())
  proFormaId       String
  monthIndex       Int
  rampPct          Float
  channelOverrides Json?
  notes            String?

  proForma ProForma @relation(fields: [proFormaId], references: [id], onDelete: Cascade)

  @@unique([proFormaId, monthIndex])
  @@index([proFormaId])
  @@map("pro_forma_months")
}

// ─── Projections (per-brand 12-month P&L) ────────────────────────────────────
// Replaces the legacy ProForma model. Inputs are stored per-brand; the rest
// (staff costs, opex, capex working-capital buffer) is derived live from
// Positions, OpexLine, and CapexProject so the projection always reflects
// the current state of the business.
//
// Calculation:
//   per brand per month:
//     liveThisMonth = monthNumber >= launchMonth
//     rampFactor    = rampCurve[ min(monthNumber - launchMonth + 1, rampCurve.length) ]
//     orders        = tradingDaysPerMonth * dailyCoversAtSS * rampFactor
//     revenue       = orders * checkAverageCents
//     variableCost  = revenue * (foodCostPct + packagingCostPct) / 100
//     staffCost     = SUM(positions.tenantCostShareCents * headcount) WHERE conceptId = brand
//     opexCost      = SUM(opex_lines.amountCents) WHERE conceptId = brand AND cadence = monthly
//     totalCost     = variableCost + staffCost + opexCost
//     profit        = revenue - totalCost
//   combined = sum across brands.
//   capitalAsk = sum(capex_projects.totalCents) + (3 * steadyStateMonthlyCost)
//   payback (months) = capitalAsk / max(1, steadyStateMonthlyProfit)

model Projection {
  id          String                 @id @default(cuid())
  tenantId    String?
  name        String                 @default("Default scenario")
  isActive    Boolean                @default(true)
  // 12-month ramp curve (multipliers on steady-state daily covers, applied
  // from each brand's launch month onward). Default = PDF spec.
  rampCurve   Float[]                @default([0.30, 0.45, 0.60, 0.75, 0.90, 1.00, 1.00, 1.00, 1.00, 1.00, 1.00, 1.00])
  // Calendar month the scenario's Month 1 is (YYYY-MM). Trading days are
  // counted on the real calendar from here (owner, 2026-10-16). Null = the
  // month after today (Karachi) at read time.
  startPeriod String?
  brands      ProjectionBrandInput[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@map("projections")
}

model ProjectionBrandInput {
  id                  String @id @default(cuid())
  projectionId        String
  conceptId           String
  launchMonth         Int    @default(1) // 1..12
  checkAverageCents   Int    @default(0)
  // Legacy flat figure — no longer read: trading days are the calendar days
  // of each month minus the brand's closed weekdays (owner, 2026-10-16).
  tradingDaysPerMonth Int    @default(26)
  // Weekdays the brand is closed (0 = Sunday … 6 = Saturday). Default Monday.
  closedWeekdays      Int[]  @default([1])
  foodCostPct         Float  @default(32)
  packagingCostPct    Float  @default(8)
  // Manual fallback for daily covers. When the timing block below is filled
  // (seats > 0 and turn time > 0), daily covers are CALCULATED from it instead:
  //   covers = seats × utilization% × (total operating hours ÷ turn hours)
  dailyCoversAtSS     Int    @default(0)
  // ── Timing & capacity block (per the ops model sheet) ──────────────────
  seats               Int    @default(0) // max seated capacity
  tableTurnHours      Float  @default(1.5) // avg table turn time (hrs)
  seatUtilizationPct  Float  @default(70) // % of seats filled per turn
  breakfastHours      Float  @default(4) // 8–12
  lunchHours          Float  @default(4) // 12–4
  dinnerHours         Float  @default(10) // 4–2 (next day)
  // Per-brand tax rate on profit (Flip'd vs Stax sole-prop differ). Applied to
  // profitable months only — losses carry through untaxed.
  taxRatePct          Float  @default(0)

  projection Projection @relation(fields: [projectionId], references: [id], onDelete: Cascade)
  concept    Concept    @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([projectionId, conceptId])
  @@index([projectionId])
  @@map("projection_brand_inputs")
}

// ─── Custom domains ───────────────────────────────────────────────────────────
// Maps a hostname (`order.mubarakbiryani.pk`) to a concept. Storefront-side
// middleware reads the Host header and serves that concept's microsite / order
// flow. SSL is provisioned at the edge (Cloudflare / Caddy / Vercel) — servd
// just tracks status here so the operator can see what's wired up.
//
// Verification flow:
//   1. User adds domain. We generate a 16-char `verificationToken`.
//   2. UI tells them to add a DNS TXT record:
//        _servd-verify.<their-domain> = <verificationToken>
//   3. Plus a CNAME for traffic:
//        <their-domain> → <servd-storefront-host>
//   4. They click "Verify". We DNS-resolve the TXT and flip status: verified.
//   5. Operator (or auto-job) provisions SSL at the edge → flips status: active.

enum DomainStatus {
  pending // added, awaiting DNS records
  verified // TXT record found, ready for SSL
  active // SSL issued + serving traffic
  failed // verification failed; user fix DNS and retry
  disabled // operator paused this domain
}

model Domain {
  id                String       @id @default(cuid())
  tenantId          String?
  conceptId         String? // null = generic tenant landing; set = specific brand microsite / order page
  hostname          String       @unique // 'order.mubarakbiryani.pk', no scheme
  purpose           String       @default("order") // 'order' | 'brand_microsite' | 'admin' (rare)
  status            DomainStatus @default(pending)
  verificationToken String // random 16-char string included in TXT record
  verifiedAt        DateTime?
  sslIssuedAt       DateTime?
  lastCheckedAt     DateTime?
  notes             String?
  createdById       String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?

  @@index([tenantId])
  @@index([conceptId])
  @@index([status])
  @@map("domains")
}

// ─── Tenant ───────────────────────────────────────────────────────────────────
// Lightweight multi-tenancy. Each restaurant company is one Tenant; concepts
// (brands) and users belong to a tenant. We attach tenantId nullably so existing
// single-tenant data keeps working — the seed function promotes existing rows
// into a default "main" tenant on first boot.
//
// (Named Tenant rather than Account because `Account` is already the chart-of-
// accounts model in the accounting module.)
//
// What this gets you today:
//   - A signup flow that creates a fresh tenant + admin + first concept
//   - Templates apply per-tenant so prospects can try with sample data
//   - Top-level list endpoints will filter by tenantId once we wire the JWT
//
// What's NOT here yet:
//   - Row-level isolation across every model (deferred — risky refactor;
//     concepts already filter most queries by conceptId so tenant scoping
//     flows naturally for now)
//   - Per-tenant billing customer ID, plan tier (next iteration)

model Tenant {
  id                 String    @id @default(cuid())
  slug               String    @unique
  name               String
  industry           String? // 'qsr' | 'cafe' | 'fine_dining' | 'cloud_kitchen' | 'biryani' | 'multi_brand'
  countryCode        String    @default("PK") // ISO 3166-1 alpha-2 — drives currency, tax regime
  currency           String    @default("PKR")
  timezone           String    @default("Asia/Karachi")
  isActive           Boolean   @default(true)
  // Joint-venture metadata. When isJointVenture=true, every cost line viewed
  // under this tenant (OpEx, positions, contributions) renders with partner-
  // split chips so the operator can see at a glance "who pays what". Stored
  // as JSON array: [{ label: 'Viva', pct: 60 }, { label: 'Garibsons', pct: 40 }].
  // Percentages should sum to 100 but we don't enforce — the chips display
  // whatever was entered, the operator can correct.
  isJointVenture     Boolean   @default(false)
  jvPartners         Json? // [{label, pct}, ...]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?
  /// Financial year end month 1-12 (H29: 30 June = 6; wave B). Reports split earnings into "retained b/f" and
  /// "profit for the year to date" (virtual roll-forward, no closing journal). CEO-only, audited.
  /// CHECK tenants_fy_end_month_chk (SQL only).
  fiscalYearEndMonth Int       @default(6)
  /// Test company (owner, 2026-10-14): CEO-only, for trying things out. Fiscal reporting is OFF, it is left out of
  /// "All companies" totals, it never messages customers or outside parties, and its brands are never advertised.
  /// Its own books work normally. ONE predicate: lib/testCompany.ts (isTestTenant / testTenantIds).
  isTest             Boolean   @default(false)
  /// Night audit (owner, 2026-10-16; sales only): 'YYYY-MM-DD' PKT — the first sales day the month close requires to be
  /// night-audited and closed; null = not started (the first run sets it). CHECK tenants_night_audit_start_chk (SQL only).
  nightAuditStartDay String?

  concepts               Concept[]
  nightAuditDays         NightAuditDay[]         @relation("TenantNightAuditDays")
  staffNotifications     StaffNotification[]     @relation("TenantStaffNotifications")
  users                  User[]
  members                TenantMember[]
  riders                 Rider[]
  suppliers              Supplier[]              @relation("TenantSuppliers")
  inventoryItems         InventoryItem[]         @relation("TenantInventoryItems")
  recipes                Recipe[]                @relation("TenantRecipes")
  locations              Location[]              @relation("TenantLocations")
  hrWorkLocations        HrWorkLocation[]        @relation("TenantHrWorkLocations")
  bankAccounts           BankAccount[]           @relation("TenantBankAccounts")
  depositDrops           DepositDrop[]           @relation("TenantDepositDrops")
  bankStatementImports   BankStatementImport[]   @relation("TenantBankStatementImports")
  modifierTemplates      ModifierTemplate[]      @relation("TenantModifierTemplates")
  webhookSubscriptions   WebhookSubscription[]   @relation("TenantWebhookSubscriptions")
  refundPolicies         RefundPolicy[]          @relation("TenantRefundPolicies")
  reservationPolicies    ReservationPolicy[]     @relation("TenantReservationPolicies")
  receiptConfigs         ReceiptConfig[]         @relation("TenantReceiptConfigs")
  operationsConfigs      OperationsConfig[]      @relation("TenantOperationsConfigs")
  deliveryZones          DeliveryZone[]          @relation("TenantDeliveryZones")
  notificationTemplates  NotificationTemplate[]  @relation("TenantNotificationTemplates")
  scheduledReports       ScheduledReport[]       @relation("TenantScheduledReports")
  customFieldDefinitions CustomFieldDefinition[] @relation("TenantCustomFieldDefinitions")
  shifts                 Shift[]                 @relation("TenantShifts")
  accounts               Account[]               @relation("TenantAccounts")
  periodLocks            PeriodLock[]            @relation("TenantPeriodLocks")
  journalEntries         JournalEntry[]          @relation("TenantJournalEntries")
  departments            Department[]
  shiftBands             ShiftBand[]
  positions              Position[]
  contributionsOut       TenantContribution[]    @relation("ContributionsFromTenant")
  contributionsIn        TenantContribution[]    @relation("ContributionsToTenant")
  fleetProvided          FleetAgreement[]        @relation("FleetProvider")
  fleetReceived          FleetAgreement[]        @relation("FleetClient")

  // POS connector + pre-bills (2026-10-10)
  posConnectors   PosConnector[]   @relation("TenantPosConnectors")
  fiscalDocuments FiscalDocument[] @relation("TenantFiscalDocuments")
  terminalCharges TerminalCharge[] @relation("TenantTerminalCharges")
  preBills        PreBill[]        @relation("TenantPreBills")

  // Company data (2026-10-12): tip pools and tax invoices carry their company
  tipPools         TipPool[]          @relation("TenantTipPools")
  taxInvoices      TaxInvoice[]       @relation("TenantTaxInvoices")
  taxInvoiceSeries TaxInvoiceSeries[] @relation("TenantTaxInvoiceSeries")

  // Cash vouchers (2026-10-13)
  cashVouchers           CashVoucher[]           @relation("TenantCashVouchers")
  cashVoucherAttachments CashVoucherAttachment[] @relation("TenantCashVoucherAttachments")

  // Raast QR (2026-10-12)
  raastReceipts  RaastReceipt[]  @relation("TenantRaastReceipts")
  bankSmsDevices BankSmsDevice[] @relation("TenantBankSmsDevices")
  bankSmsAlerts  BankSmsAlert[]  @relation("TenantBankSmsAlerts")

  // Inter-company (wave B, H30)
  counterpartyAccounts  Account[]              @relation("AccountCounterparty")
  icTransfersAsDebtor   IntercompanyTransfer[] @relation("IcTransferDebtor")
  icTransfersAsCreditor IntercompanyTransfer[] @relation("IcTransferCreditor")
  fleetRatesProvided    FleetRate[]            @relation("FleetRateProvider")
  fleetRatesCharged     FleetRate[]            @relation("FleetRateClient")

  // Cash requests + petty cash in the ledger (wave B, 2026-10-14)
  cashVoucherSettlements CashVoucherSettlement[] @relation("TenantCashVoucherSettlements")
  pettyCashSpendLines    PettyCashSpendLine[]    @relation("TenantPettyCashSpendLines")

  // Head office (D1, owner 2026-10-11; migration 20261015120000). A head office is a Tenant of kind 'head_office':
  // its own HR, payroll and books, serving companies through HeadOfficeLink and recharging them monthly. It never
  // has brands (lib/headOffice.ts assertTradingCompany).
  kind                  TenantKind           @default(company)
  headOfficeLinks       HeadOfficeLink[]     @relation("HoLinkHeadOffice")
  servedByLinks         HeadOfficeLink[]     @relation("HoLinkCompany")
  headOfficeBooks       HeadOfficeBooks?     @relation("HoBooks")
  rechargeSplits        RechargeSplit[]      @relation("HoRechargeSplits")
  splitLines            RechargeSplitLine[]  @relation("SplitLineCompany")
  rechargeRuns          RechargeRun[]        @relation("HoRechargeRuns")
  rechargeRunLines      RechargeRunLine[]    @relation("RunLineCompany")
  hoSplitLines          RechargeSplitLine[]  @relation("SplitLineHeadOffice")
  hoRunLines            RechargeRunLine[]    @relation("RunLineHeadOffice")
  delegationsAsHo       ApprovalDelegation[] @relation("DelegationHeadOffice")
  delegationsForCompany ApprovalDelegation[] @relation("DelegationCompany")
  journalRequests       JournalRequest[]     @relation("TenantJournalRequests")
  posConnectorChanges   PosConnectorChange[] @relation("TenantPosConnectorChanges")

  @@index([kind])
  @@map("tenants")
}

// ─── TenantMember ─────────────────────────────────────────────────────────────
// Many-to-many between User and Tenant. A user can own / be a member of multiple
// tenants (each billed separately). The User.tenantId column above continues to
// represent the *active* tenant in the current session. Switching active tenant
// = update User.tenantId to another tenant the user is a member of.

model TenantMember {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  role      String   @default("owner") // 'owner' | 'admin' | 'manager'
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([userId])
  @@index([tenantId])
  @@map("tenant_members")
}

// ─── Payment gateway configuration ────────────────────────────────────────────
// Per-provider toggle + non-secret config. Secrets (merchant keys, hash keys)
// live in env vars — referenced by name here so the UI can show the user
// which env var to populate.

model PaymentGatewayConfig {
  id          String   @id @default(uuid())
  provider    String // 'keenu' | 'jazzcash' | 'easypaisa' | 'cash'
  conceptId   String? // null = global; otherwise per-concept override
  isEnabled   Boolean  @default(false)
  isLive      Boolean  @default(false) // false = sandbox / test mode
  merchantId  String? // public, safe to store (NOT the secret)
  callbackUrl String?
  successUrl  String?
  failureUrl  String?
  notes       String?
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@unique([provider, conceptId])
  @@map("payment_gateway_configs")
}

// ─── Locations ────────────────────────────────────────────────────────────────
// A physical place. A location can host one or many Concepts (multi-concept
// kitchens, ghost kitchens, food courts). A concept can theoretically also run
// at multiple locations (chain expansion), so the relationship is many-to-many.
//
// Why a separate model: Concept = brand (logical, has its own menu, branding,
// loyalty); Location = physical venue (has an address, a cash drawer, a kitchen,
// a printer). Accounting and ops need to filter by both axes independently.

model Location {
  id                   String    @id @default(uuid())
  slug                 String    @unique
  name                 String // "Gulberg Branch", "DHA Kitchen"
  address              String?
  city                 String?
  latitude             Float?
  longitude            Float?
  phone                String?
  isActive             Boolean   @default(true)
  // Time-clock radius for this place (metres); null = the company's OperationsConfig.geofenceRadiusMetres.
  geofenceRadiusMetres Int?
  // The time-clock fence the CEO APPROVED (owner, 2026-10-22: "each location gets a map pin and a radius, approved by
  // the CEO"). Punches are measured from these, never from latitude / longitude directly: an edited pin waits for the
  // CEO (approval type location_pin) and the old approved one stays in force meanwhile. fenceRadiusMetres null = the
  // company's radius. fencePinRejected = the pin the CEO turned down ({lat, lng, radius, at, byId, note}), so it
  // leaves the queue until the pin is changed again.
  fenceLatitude        Float?
  fenceLongitude       Float?
  fenceRadiusMetres    Int?
  fencePinApprovedAt   DateTime?
  fencePinApprovedById String?
  fencePinRejected     Json?
  // Company that owns this physical location. Locations are company master
  // data: GS Foods' Bukhari kitchen must never appear in GSX Viva's Locations
  // page, and a location may only link brands of its own company. Nullable
  // only for the column-add; the migration backfills every row from its
  // linked brands and the API never creates a row without one.
  tenantId             String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  tenant           Tenant?           @relation("TenantLocations", fields: [tenantId], references: [id])
  concepts         ConceptLocation[]
  orders           Order[]
  shifts           Shift[]
  financialEntries FinancialEntry[]
  transfersFrom    StockTransfer[]   @relation("TransferFrom")
  hrWorkLocations  HrWorkLocation[]
  transfersTo      StockTransfer[]   @relation("TransferTo")
  expoPushTokens   ExpoPushToken[]
  // Fixed assets v2 (2026-10-14)
  fixedAssets      FixedAsset[]      @relation("FixedAssetLocation")
  fixedAssetPools  FixedAssetPool[]  @relation("FixedAssetPoolLocation")

  @@index([tenantId])
  @@map("locations")
}

// ─── StockTransfer ───────────────────────────────────────────────────────────
// Inter-location inventory movement. Records the request → approval →
// in-transit → received workflow. Stock-level mutations live separately
// (today inventory is one tenant-wide pool; per-location stock is queued
// for a future migration). Until then, this model is the authoritative
// audit trail of "who sent what to whom on what day."
model StockTransfer {
  id              String  @id @default(uuid())
  inventoryItemId String
  fromLocationId  String
  toLocationId    String
  // Brand stock (owner B13 (a), 2026-10-26): whose lots ship (fromConceptId; NULL = shared lots) and who owns them on
  // arrival (toConceptId; NULL = shared). brandMove false = a plain outlet transfer (any lot; arrived lots keep their
  // brand). A BRAND MOVE (brandMove true) names both sides; from = to location is allowed only for it. Plain ids.
  fromConceptId   String?
  toConceptId     String?
  brandMove       Boolean @default(false)
  quantity        Float
  unit            String
  // requested → approved → in_transit → received       (happy path)
  //              ↓                       ↓
  //          cancelled               (any time before received)
  status          String  @default("requested")
  reason          String? // e.g. "low stock at DHA, surplus at Gulberg"
  notes           String? // free-form

  // Audit trail of WHO did what
  requestedById String
  approvedById  String?
  shippedById   String?
  receivedById  String?
  cancelledById String?

  requestedAt  DateTime  @default(now())
  approvedAt   DateTime?
  shippedAt    DateTime?
  receivedAt   DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  // Once per-location stock lands, this is where receivedQuantity might
  // diverge from quantity (driver lost some, breakage, etc.).
  receivedQuantity Float?

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
  fromLocation  Location      @relation("TransferFrom", fields: [fromLocationId], references: [id])
  toLocation    Location      @relation("TransferTo", fields: [toLocationId], references: [id])

  @@index([status, requestedAt])
  @@index([inventoryItemId])
  @@index([fromLocationId, status])
  @@index([toLocationId, status])
  @@map("stock_transfers")
}

// Many-to-many link between Concept (brand) and Location (place).
// A row in this table means "concept X is operated at location Y".
model ConceptLocation {
  conceptId  String
  locationId String
  isPrimary  Boolean  @default(false) // primary location for a concept (used when an order doesn't specify one)
  createdAt  DateTime @default(now())

  concept  Concept  @relation(fields: [conceptId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  @@id([conceptId, locationId])
  @@index([locationId])
  @@map("concept_locations")
}

// ─── Role-based permissions ──────────────────────────────────────────────────
// Editable permission matrix. The catalogue of permission keys lives in code
// (see lib/permissions.ts); this table tracks which role currently has each
// one enabled. Admins can flip any cell from the Roles & Permissions admin UI.

model RolePermission {
  id         String   @id @default(cuid())
  role       UserRole
  permission String
  enabled    Boolean  @default(true)
  updatedAt  DateTime @updatedAt

  @@unique([role, permission])
  @@index([role])
  @@map("role_permissions")
}

// Role → sidebar-module allow-list. A row here is the CEO's FULL override for
// that role (from /configuration/role-modules); roles without a row fall back
// to the in-code defaults (lib/moduleAccess.ts). Enforced server-side by the
// auth middleware on the finance/reports/management surfaces — previously this
// config lived only in the admin browser's localStorage and gated nothing.
model RoleModuleAccess {
  id        String   @id @default(cuid())
  role      UserRole @unique
  modules   String[] @default([])
  updatedAt DateTime @updatedAt

  @@map("role_module_access")
}

// ─── API access tokens ───────────────────────────────────────────────────────
// Long-lived bearer tokens for partner integrations + the customer mobile app.
// Tokens are hashed with sha256 before storage; the plaintext is shown only
// once (at creation time). Revoke by setting revokedAt — never delete the row,
// so audit lookups stay intact.

// B07: ApiToken model removed — see FIXES.md. The table is dropped by the
// schema sync; if you ever want partner integrations back, prefer scoped
// OAuth2 (per-app credentials, refresh + revocation primitives) over the
// long-lived bearer-token pattern that lived here.

// ─── Media Library ────────────────────────────────────────────────────────────

model MediaAsset {
  id           String   @id @default(cuid())
  tenantId     String?
  key          String
  url          String
  filename     String
  contentType  String
  category     String   @default("general") // menu, marketing, shoot, kds, general
  // Storefront content library (decision 41): images, videos, fonts and copy
  // snippets. Copy snippets have no file (key/url ''), the words live in text.
  kind         String   @default("image") // image | video | font | copy
  name         String?
  tags         String[] @default([])
  conceptId    String? // brand the asset is for; null = any brand of the company
  text         String?
  fontFamily   String? // kind=font: the CSS family name pages refer to
  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([tenantId, kind])
  @@index([category, createdAt])
  @@index([tenantId, createdAt])
  @@map("media_assets")
}

// ─── Cross-checks: closed-loop inventory + fraud detection ───────────────────
//
// The platform's anti-fraud spine. Each model captures one checkpoint in the
// "buy → receive → use → sell" loop. Variance between adjacent checkpoints is
// the signal — `ExceptionFlag` records that signal so the owner only sees
// what's broken, not what's working.

// Goods receipt — what physically arrived at the dock. Independent of the
// supplier's bill so we can detect price manipulation or short-shipments
// before the bill is paid (3-way match: PO qty / GRN qty / Bill qty).
model GoodsReceipt {
  id                 String   @id @default(cuid())
  poId               String? // matched PO if scanned at dock
  supplierId         String
  receivedById       String // user who accepted delivery
  receivedAt         DateTime @default(now())
  photoUrl           String? // dock-door photo (required if config)
  notes              String?
  status             String   @default("pending") // pending | accepted | disputed | partial
  varianceFlag       Boolean  @default(false) // true if any line variance > threshold
  // Food cost wave B (2026-10-14)
  tenantId           String? // the supplier's company (backfilled); every new row sets it
  locationId         String?
  conceptId          String? // the brand whose stock this is (owner B13 (a)); NULL = shared. Its lots carry it.
  // Decision P6: a no-PO receipt created for food bought with cash. Its lines are born billed (billedQty =
  // receivedQty), it posts NOTHING itself (no 2015): the cash document's own entry carries Dr 12x0 / Cr 1011|1355.
  // One receipt per cash document (unique below), so the same food can't come in twice. CHECK
  // goods_receipts_settled_chk (both or neither, known types) is SQL only.
  settledByType      String? // 'petty_cash_movement' | 'cash_voucher_settlement'
  settledById        String?
  settledAccountCode String? // the credit side the cash document books (1011 box / 1355 advance)

  lines GoodsReceiptLine[]

  @@unique([tenantId, settledByType, settledById])
  @@index([supplierId, receivedAt])
  @@index([status])
  @@index([tenantId, receivedAt])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id                    String    @id @default(cuid())
  receiptId             String
  inventoryItemId       String? // null when receiving non-inventoried items
  description           String // human-readable; mirrors PO line
  poQty                 Float? // ordered qty (when matched)
  receivedQty           Float // what actually arrived
  poUnitCostCents       Int? // expected unit cost
  unit                  String    @default("kg")
  variancePct           Float? // (receivedQty - poQty) / poQty
  notes                 String?
  // The PO line this receipt line was matched to, so a receipt can be traced
  // back to what was ordered.
  poLineId              String?
  // Food cost wave B — lots + GRNI (H16/H17)
  lotUnitCostCents      Int? // the unit cost the receipt's lot(s) opened at (pending-bill price, else PO, else dock)
  billedQty             Float     @default(0) // quantity a bill has matched (GRNI open = receivedQty − billedQty)
  // GRNI write-off (supplier will never bill): finance/procurement REQUESTS, the CEO approves (approvals inbox type
  // 'grni_writeoff'); a CEO-raised request applies at once (decision 27). Posts 'procurement.grni_writeoff:<id>'.
  // The claim is a conditional update (writeOffRequestedAt IS NULL); the partial unique
  // goods_receipt_lines_one_open_writeoff is SQL-only documentation (migration 20261014090000).
  writeOffRequestedAt   DateTime?
  writeOffRequestedById String?
  writeOffReason        String?
  writtenOffAt          DateTime?
  writtenOffById        String?
  writeOffEntryId       String?

  receipt   GoodsReceipt       @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  poLine    PurchaseOrderLine? @relation(fields: [poLineId], references: [id], onDelete: SetNull)
  lots      StockLot[]
  matches   GrniMatch[]
  billLines SupplierBillLine[] @relation("BillLineReceiptLine")

  @@index([receiptId])
  @@index([poLineId])
  @@map("goods_receipt_lines")
}

// Prep batch — kitchen records what they made + what they used to make it.
// Yield variance (actualYield / expectedYield) is the leak signal between
// "received into inventory" and "available to sell". A chef walking out with
// product shows up here as low yield % over time.
model PrepBatch {
  id               String   @id @default(cuid())
  tenantId         String? // company whose stock the inputs came from
  recipeId         String? // null for ad-hoc preps
  itemName         String // e.g. "Confit garlic"
  inputs           Json // [{inventoryItemId, qtyDrawn, unit}]
  expectedYieldQty Float?
  actualYieldQty   Float
  unit             String   @default("g")
  yieldVariancePct Float? // actualYield / expectedYield
  staffId          String // chef who logged it
  photoUrl         String? // photo of finished prep
  notes            String?
  createdAt        DateTime @default(now())
  // Food cost wave B
  locationId       String?
  conceptId        String? // the brand the batch is for (owner B13 (a)): draws its lots then shared; its prep lot is its
  drawValueCents   BigInt? // FIFO value drawn by an ad-hoc batch ('inventory.prep_draw:<id>')

  @@index([staffId, createdAt])
  @@index([recipeId])
  @@index([tenantId, createdAt])
  @@map("prep_batches")
}

// Physical count — periodic spot-counts. Variance vs system stock shows
// shrinkage between checkpoints (received→used or used→sold). Cumulative
// per-item shrinkage trends drive the strongest theft signal.
model PhysicalCount {
  id          String   @id @default(cuid())
  // Company the count belongs to (the items counted are that company's).
  tenantId    String?
  countedById String
  countedAt   DateTime @default(now())
  status      String   @default("pending") // pending | completed | reviewed
  notes       String?
  // Food cost wave B: spot | opening (opening → 3010 owner's capital, H19; finance/CEO/management only). CHECK
  // physical_counts_kind_chk (SQL only).
  kind        String   @default("spot")
  locationId  String?
  conceptId   String? // a count of ONE brand's stock (owner B13 (a)); NULL = the site's whole stock

  lines PhysicalCountLine[]

  @@index([countedAt])
  @@index([tenantId, countedAt])
  @@index([tenantId, kind, countedAt])
  @@map("physical_counts")
}

model PhysicalCountLine {
  id              String  @id @default(cuid())
  countId         String
  inventoryItemId String
  systemQty       Float // what the DB thinks
  physicalQty     Float // what was physically counted
  variancePct     Float? // (physical - system) / system
  reason          String? // free-text justification
  // Food cost wave B
  unitCostCents   Int? // opening counts: the unit cost entered (default the latest purchase price)
  valueCents      BigInt? // signed value posted (count_loss FIFO value / count_gain or opening lot value)

  count PhysicalCount @relation(fields: [countId], references: [id], onDelete: Cascade)

  @@index([countId])
  @@index([inventoryItemId])
  @@map("physical_count_lines")
}

// ─── Food cost on FIFO lots (wave B, 2026-10-14; H16/H17) ────────────────────
// Owner: costing is REAL-TIME at the PO price of the ingredients actually being
// cooked (FIFO lots). lib/stockLedger.ts is the ONLY writer of these tables.

// One lot of stock at one cost. tenantId = the item's company (never null; company-less items are refused on every
// stock write). FIFO order = receivedAt, then id. The open-lot index stock_lots_open_fifo (partial, remainingQty > 0)
// and CHECKs stock_lots_class_chk / stock_lots_remaining_chk / stock_lots_source_chk are SQL only (migration
// 20261014090000; not declared here).
// BOOKS-06: money columns on this model are BIGINT paisa (lib/money.ts returns them as JS numbers); the per-unit cost
// stays INT4.
model StockLot {
  id                  String    @id @default(uuid())
  tenantId            String
  inventoryItemId     String
  // The site (outlet) holding the lot (owner, 2026-10-24: per-site stock). Every new lot names one (lib/stockSite.ts);
  // NULL only for a company with no location (its one pool) and pre-cut-over history.
  locationId          String?
  // The OWNING BRAND (owner B13 (a), 2026-10-26: "Each brand keeps its own stock even when it shares a kitchen").
  // NULL = shared (legacy, or an outlet with several brands until a count / brand move assigns it). A sale draws its
  // brand's lots, then shared ones — never another brand's (lib/stockLedger.ts). Plain id (a Concept of tenantId).
  conceptId           String?
  sourceType          String // goods_receipt_line | count_gain | opening | fifo_cutover | legacy_return | transfer_in | prep_batch
  // goods_receipt_line: '<receiptLineId>:<grniMatchId|po|dock>' (a receipt line may open SEVERAL lots: a pending-bill
  // quantity at the billed price + the rest at the PO price); legacy_return: '<orderItemId>:<event>';
  // count_gain/opening: '<countLineId>'; fifo_cutover: '<tenantId>'.
  sourceId            String
  receiptLineId       String?
  costClass           String // food | beverage | packaging
  receivedAt          DateTime
  qtyIn               Float // purchase units
  remainingQty        Float
  unitCostCents       Int // per purchase unit (INT4 per-unit stock cost)
  valueInCents        BigInt
  remainingValueCents BigInt // exact: the last draw takes the remainder, so lots and 12x0 never drift by rounding
  // Use-by (owner B6, 2026-10-26): the Karachi day the lot must be used by — typed at the dock for a perishable item
  // (or received day + shelf life), the earliest of the lots a prep batch drew, carried over by a transfer. Record +
  // report only: FIFO order and costing are unchanged. The bell markers (workers/stockExpiry.ts, written only through
  // lib/stockLedger.ts markUseByNotifiedTx) make each lot notified once per stage. Partial index stock_lots_use_by_open
  // (SQL only).
  useBy               DateTime? @db.Date
  useByWarnedAt       DateTime?
  expiredWarnedAt     DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  inventoryItem InventoryItem     @relation(fields: [inventoryItemId], references: [id])
  receiptLine   GoodsReceiptLine? @relation(fields: [receiptLineId], references: [id], onDelete: SetNull)
  movements     StockMovement[]

  @@unique([tenantId, sourceType, sourceId, inventoryItemId])
  @@index([tenantId, inventoryItemId, receivedAt])
  @@index([receiptLineId])
  @@index([inventoryItemId, locationId])
  @@index([inventoryItemId, locationId, conceptId])
  @@map("stock_lots")
}

// THE lot ledger, append-only. Every stock change writes these rows in the document's own transaction.
// CHECKs stock_movements_kind_chk / stock_movements_class_chk are SQL only (migration 20261014090000).
// BOOKS-06: money columns on this model are BIGINT paisa (lib/money.ts returns them as JS numbers).
model StockMovement {
  id                  String   @id @default(uuid())
  tenantId            String
  inventoryItemId     String
  lotId               String?
  lotKey              String   @default("") // lotId or '' (part of the idempotency key)
  // receipt | opening | fifo_cutover | count_gain | count_loss | sale | sale_return | sale_void | waste | prep_draw |
  // supplier_return | cost_adjust | class_reclass | legacy_return | issue_on_receipt | shortfall_settle |
  // transfer_out | transfer_in (a stock transfer between two sites of one company; owner 2026-10-24)
  kind                String
  qty                 Float // signed, purchase units
  valueCents          BigInt // signed lot value moved
  unitCostCents       Int
  costClass           String
  theoreticalQty      Float? // sale rows: the recipe quantity
  shortfallQty        Float? // sale rows: needed but not on the books (clamped)
  shortfallValueCents BigInt? // memo at the latest purchase price; settled from the next lot within 7 days ('shortfall_settle')
  settlesMovementId   String? // shortfall_settle rows: the sale row whose shortfall this settles
  conceptId           String?
  brandShares         Json? // brand-less waste/count/prep/5060/issue: [{conceptId, share}] as posted (H20)
  locationId          String?
  orderId             String?
  orderItemId         String?
  sourceType          String
  sourceId            String
  occurredAt          DateTime
  createdById         String?
  createdAt           DateTime @default(now())

  lot StockLot? @relation(fields: [lotId], references: [id])

  @@unique([tenantId, sourceType, sourceId, inventoryItemId, kind, lotKey])
  @@index([tenantId, occurredAt])
  @@index([tenantId, inventoryItemId, occurredAt])
  @@index([tenantId, locationId, occurredAt])
  @@index([orderId])
  @@index([orderItemId])
  @@index([lotId])
  @@index([settlesMovementId])
  @@map("stock_movements")
}

// What a bill line matched against received stock (GRNI, H17). CHECK grni_matches_status_chk is SQL only.
// BOOKS-06: money columns on this model are BIGINT paisa (lib/money.ts returns them as JS numbers); per-unit costs
// stay INT4.
model GrniMatch {
  id                   String    @id @default(uuid())
  tenantId             String
  billId               String
  billLineId           String
  receiptLineId        String? // null while billed but not yet received (pending)
  poLineId             String?
  qty                  Float
  receiptUnitCostCents Int?
  billedUnitCostCents  Int
  grniCents            BigInt // debited to 2015 by the bill
  priceDiffCents       BigInt    @default(0)
  absorbedCents        BigInt    @default(0) // to stock still on hand (12x0)
  usedCents            BigInt    @default(0) // to 5060 (stock already used)
  status               String    @default("live") // live | pending | void
  settledAt            DateTime?
  createdAt            DateTime  @default(now())

  bill        SupplierBill      @relation(fields: [billId], references: [id])
  billLine    SupplierBillLine  @relation(fields: [billLineId], references: [id])
  receiptLine GoodsReceiptLine? @relation(fields: [receiptLineId], references: [id])

  @@index([tenantId, status])
  @@index([billId])
  @@index([billLineId])
  @@index([receiptLineId])
  @@index([poLineId, status])
  @@map("grni_matches")
}

// ExceptionFlag — universal anomaly signal. Anywhere in the codebase fires
// `flagException(...)` when a control trigger fires; the owner inbox reads
// open flags and shows only what needs attention. Resolution + acknowledgement
// are tracked so audit trail is complete.
enum ExceptionSeverity {
  low
  medium
  high
  critical
}

enum ExceptionStatus {
  open
  acknowledged
  resolved
  dismissed
}

// BOOKS-06: money columns on this model are BIGINT paisa (lib/money.ts returns them as JS numbers).
model ExceptionFlag {
  id          String            @id @default(cuid())
  // Company this row belongs to (company separation sweep, 2026-09-27).
  tenantId    String?
  kind        String // 'receiving_variance' | 'shrinkage' | 'consecutive_voids' | 'cash_variance' | 'route_variance' | 'pii_export' | 'self_approval' | 'price_drift' | 'yield_low' | 'ghost_employee'
  severity    ExceptionSeverity @default(medium)
  title       String
  description String
  entityType  String? // 'GoodsReceipt' | 'Order' | 'Shift' | 'PrepBatch' | etc.
  entityId    String?
  metadata    Json? // arbitrary context (variance %, names, amounts)
  conceptId   String? // when scoped to a brand
  actorId     String? // user who triggered it (if applicable)
  amountCents BigInt? // monetary impact, if any

  status           ExceptionStatus @default(open)
  acknowledgedById String?
  acknowledgedAt   DateTime?
  resolvedById     String?
  resolvedAt       DateTime?
  resolution       String?

  // The bell's claim (workers/staffNotifications.ts): NULL = not yet
  // announced. Migration 20261016140000 stamps existing rows (no flood).
  notifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, severity, createdAt])
  @@index([kind, status])
  @@index([entityType, entityId])
  @@index([tenantId, status, createdAt])
  @@map("exception_flags")
}

// ─── Petty cash ──────────────────────────────────────────────────────────────
// Float box(es) the operator stocks for small spend (water bottles, last-minute
// herbs, courier tips). Without this, PKR leaks through "miscellaneous" with no
// trail. Every spend requires a receipt photo above threshold; reconcile
// monthly against actual count.

model PettyCashBox {
  id              String    @id @default(cuid())
  tenantId        String?
  name            String // "Front-of-house till", "Manager pocket"
  conceptId       String?
  custodianId     String // user responsible for the box
  floatCents      Int       @default(0) // current balance (system view)
  topUpLimitCents Int       @default(2000000) // reject top-up above this without admin
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  movements    PettyCashMovement[]
  // Cash requests paid from this box (optional on the request side since wave B: picked at pay).
  cashVouchers CashVoucher[]

  @@index([conceptId])
  @@index([tenantId])
  @@map("petty_cash_boxes")
}

// Wave B (petty cash in the ledger): tenantId stamped on every new write (backfilled from the box); RLS policy
// petty_cash_movements_rls is the tenant policy with legacy NULL rows visible to staff (migration 20261014090000).
// CHECK petty_cash_movements_source_chk is SQL only.
model PettyCashMovement {
  id                String   @id @default(cuid())
  boxId             String
  type              String // 'topup' | 'spend' | 'reconcile' | 'transfer' | 'return' (wave B: change handed back)
  amountCents       Int // signed: + topup, - spend
  category          String? // expense category (drives JE account)
  reason            String // free-text description
  receiptUrl        String? // photo of vendor receipt (required above threshold)
  vendorName        String?
  approvedById      String? // for spend > role cap
  // Set when the spend paid a supplier's open bill: it was recorded as that
  // SupplierPayment (method 'cash', Dr 2010 AP / Cr 1010), the one
  // ledger-backed way to pay a vendor in cash — never expense it again.
  supplierPaymentId String?
  createdById       String
  createdAt         DateTime @default(now())
  // Petty cash in the ledger (wave B, 2026-10-14)
  tenantId          String? // stamped on every new write; backfilled from the box
  source            String? // garibsons | safe | bank | till | cash_request | opening | box
  accountCode       String? // the counter account of the posting (2210 / 1010 / bank code / 1015 / 1355 / 8010 …)
  bankAccountId     String?
  shiftId           String?
  cashMovementId    String? // the drawer 'payout' CashMovement a 'till' top-up wrote (entry key 'pettycash.till_topup:<cashMovementId>')
  transferRef       String? // TRF-xxxxxxxx (was only inside reason)
  cashVoucherId     String? // the request it paid, or whose change it took back
  conceptId         String?
  journalEntryId    String? // set when booked (UI 'Booked'); re-stamped after a syncSourcePosting repost

  box         PettyCashBox            @relation(fields: [boxId], references: [id])
  lines       PettyCashSpendLine[]
  attachments CashVoucherAttachment[]

  @@unique([tenantId, cashMovementId])
  @@index([boxId, createdAt])
  @@index([tenantId, createdAt])
  @@index([cashVoucherId])
  @@index([transferRef])
  @@map("petty_cash_movements")
}

// ─── Bank deposit drops ──────────────────────────────────────────────────────
// End-of-day cash to bank. Closes the cash loop: shift cash sales should equal
// the deposit drop. Variance flags theft between till and bank teller.

model DepositDrop {
  id            String   @id @default(cuid())
  // Owning company — stamped from the operator's active company at create.
  tenantId      String?
  shiftId       String? // when scoped per-shift
  conceptId     String?
  bankAccountId String?
  amountCents   Int // counted at drop
  expectedCents Int // cash sales total
  varianceCents Int // amount - expected
  bagSerial     String? // tamper-evident bag serial
  slipNumber    String? // the bank's deposit slip number (owner, 2026-10-14)
  receiptUrl    String? // photo of teller deposit slip
  droppedById   String // who delivered to bank
  witnessedById String? // dual-signoff (optional)
  droppedAt     DateTime @default(now())
  notes         String?

  tenant      Tenant?                 @relation("TenantDepositDrops", fields: [tenantId], references: [id])
  // Deposit slips / bank receipts uploaded as files (owner, 2026-10-16: "it
  // should ask for attachment instead of URL") — kind 'deposit_slip'.
  attachments CashVoucherAttachment[]
  // One bag split across several tills (owner, 2026-10-16: "One deposit can
  // be split across several shifts"). Σ amountCents = the drop's amount.
  allocations DepositDropShift[]

  @@index([conceptId, droppedAt])
  @@index([shiftId])
  @@index([tenantId, droppedAt])
  @@map("deposit_drops")
}

// How much of a deposit drop came from each till shift (owner decision
// 2026-10-16, bank bags: "Split one bag"). The drop's company owns every row;
// each shift must be that company's. A legacy drop with `shiftId` and no rows
// counts as one allocation of its whole amount (accounting/depositPosting.ts
// dropAllocations is the ONE reader).
model DepositDropShift {
  id            String   @id @default(cuid())
  tenantId      String
  depositDropId String
  shiftId       String
  amountCents   Int
  createdAt     DateTime @default(now())

  depositDrop DepositDrop @relation(fields: [depositDropId], references: [id], onDelete: Restrict)

  @@unique([depositDropId, shiftId])
  @@index([tenantId, shiftId])
  @@index([shiftId])
  @@map("deposit_drop_shifts")
}

// ─── Staff meals ─────────────────────────────────────────────────────────────
// Free / staff-rate meals consumed by employees. Without logging, "I'll take a
// burger off the line" runs untracked and inventory shrinks without a paper
// trail. Approver PIN required + caps; above cap auto-flags.

model StaffMeal {
  id                 String   @id @default(cuid())
  // Company the meal was served by (company separation sweep, 2026-09-27).
  tenantId           String?
  staffId            String // who ate
  approvedById       String // manager who approved (PIN-verified)
  shiftId            String?
  conceptId          String?
  description        String // "Stax Classic + fries"
  estimatedCostCents Int      @default(0) // recipe-cost approximation
  reason             String   @default("shift_meal") // 'shift_meal' | 'training' | 'tasting' | 'comp'
  consumedAt         DateTime @default(now())

  @@index([staffId, consumedAt])
  @@index([conceptId, consumedAt])
  @@index([tenantId, consumedAt])
  @@map("staff_meals")
}

// ─── Kitchen Staff Management ─────────────────────────────────────────────────

enum KitchenStaffRole {
  head_chef
  sous_chef
  cdp
  demi_chef
  commis
  kitchen_helper
  dishwasher
  baker
  tandoor_grill_cook
}

enum SkillLevel {
  unskilled
  semi_skilled
  skilled
  highly_skilled
}

enum EmploymentType {
  permanent
  probationary
  temporary
  contract
}

enum KitchenStaffStatus {
  active
  on_leave
  terminated
}

model KitchenStaff {
  id                    String             @id @default(uuid())
  tenantId              String
  fullName              String
  cnic                  String // XXXXX-XXXXXXX-X
  phone                 String
  kitchenRole           KitchenStaffRole
  skillLevel            SkillLevel
  employmentType        EmploymentType
  dateJoined            DateTime
  dateLeft              DateTime?
  monthlySalaryCash     Int // PKR
  mealsProvided         Boolean            @default(false)
  accommodationProvided Boolean            @default(false)
  accommodationValue    Int                @default(0)
  eobiRegistered        Boolean            @default(false)
  sessiRegistered       Boolean            @default(false)
  bankAccount           String?
  emergencyContact      String
  status                KitchenStaffStatus @default(active)
  // Each cook is assigned to one or more stations. The KDS station view
  // filters live tickets by the cook's station set; the par sheet shows
  // them only the components their station preps. Empty = "all stations"
  // (head chef, expediter, etc.).
  stationIds            String[]           @default([])
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  kitchenShifts        KitchenShift[]
  payrollRuns          KitchenPayrollRun[]
  complianceViolations ComplianceViolation[]

  @@unique([tenantId, cnic])
  @@index([tenantId, status])
  @@map("kitchen_staff")
}

model KitchenShift {
  id                String   @id @default(uuid())
  staffId           String
  date              DateTime // date portion only; time ignored
  scheduledStart    String // "HH:MM"
  scheduledEnd      String // "HH:MM"
  actualStart       String?
  actualEnd         String?
  breakMinutes      Int      @default(60)
  isWeeklyOff       Boolean  @default(false)
  isFestivalHoliday Boolean  @default(false)
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  staff KitchenStaff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, date])
  @@index([date])
  @@map("kitchen_shifts")
}

model WageSettings {
  id                   String   @id @default(uuid())
  tenantId             String   @unique
  minWageUnskilled     Int      @default(40000)
  minWageSemiSkilled   Int      @default(41280)
  minWageSkilled       Int      @default(48910)
  minWageHighlySkilled Int      @default(50868)
  workingDaysPerMonth  Int      @default(26)
  paidHoursPerDay      Int      @default(8)
  otMultiplierRegular  Float    @default(2.0)
  otMultiplierFestival Float    @default(3.0)
  maxOtHoursPerWeek    Int      @default(12)
  maxOtHoursPerYear    Int      @default(624)
  eobiEmployerPct      Float    @default(0.01)
  sessiEmployerPct     Float    @default(0.06)
  updatedAt            DateTime @updatedAt

  @@map("wage_settings")
}

model KitchenPayrollRun {
  id                 String   @id @default(uuid())
  staffId            String
  tenantId           String
  month              Int
  year               Int
  baseSalary         Int
  regularHoursWorked Float    @default(0)
  otHoursRegular     Float    @default(0)
  otHoursFestival    Float    @default(0)
  hourlyRate         Float
  otPayRegular       Float    @default(0)
  otPayFestival      Float    @default(0)
  mealValue          Int      @default(0)
  accommodationValue Int      @default(0)
  grossPay           Float
  eobiEmployee       Float    @default(0)
  eobiEmployer       Float    @default(0)
  sessiEmployer      Float    @default(0)
  incomeTaxWithheld  Float    @default(0)
  netPay             Float
  trueCostToCompany  Float
  status             String   @default("draft")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  staff KitchenStaff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, month, year])
  @@index([tenantId, year, month])
  @@map("kitchen_payroll_runs")
}

model ComplianceViolation {
  id          String    @id @default(uuid())
  staffId     String
  tenantId    String
  type        String // 'below_min_wage'|'ot_week_exceeded'|'ot_ytd_exceeded'|'no_weekly_off'|'shift_too_long'|'insufficient_breaks'|'consecutive_days'
  description String
  detectedAt  DateTime  @default(now())
  resolvedAt  DateTime?
  resolvedBy  String?

  staff KitchenStaff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([tenantId, detectedAt(sort: Desc)])
  @@index([staffId])
  @@map("compliance_violations")
}

// ─── Workforce: budgeted positions ────────────────────────────────────────────
// "Workforce" used to be a directory of People (User rows). That's still true
// but bottom-up — a User shows up when you onboard a real human. The CEO needs
// the inverse: a top-down BUDGET of every seat the org has decided to pay for,
// whether it's filled yet or not. Position = one budgeted seat.
//
// Positions roll up into:
//   - /opex/payroll-snapshot  → "Budgeted payroll" line per tenant
//   - /financePlanning/*       → labour line on the pro-forma is computed
//                                 live from active positions, not entered
//                                 manually as a fixed cost
// so editing a salary here updates OpEx + projections on next read.
//
// Cost-share model: monthlySalaryCents is gross (what the person actually
// earns). tenantCostShareCents is what THIS tenant's P&L bears. They're
// equal for normal positions. For shared head-office roles (e.g. a brand
// manager serving multiple tenants) and JV positions (GS x Viva, 60/40),
// tenantCostShareCents < monthlySalaryCents. Storing both as cents (not %)
// keeps the math un-ambiguous in reports.

model Department {
  id           String    @id @default(uuid())
  tenantId     String? // null = global / template
  name         String // "Procurement", "Main Kitchen", "FOH Service"
  emoji        String?
  isHeadOffice Boolean   @default(false) // surfaces head-office split UI
  order        Int       @default(0)
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())

  tenant    Tenant?    @relation(fields: [tenantId], references: [id])
  positions Position[]

  @@unique([tenantId, name])
  @@index([tenantId, archivedAt])
  @@map("departments")
}

model ShiftBand {
  id         String    @id @default(uuid())
  tenantId   String? // null = global
  name       String // "10am-6pm", "6pm-2am"
  startTime  String // "10:00"
  endTime    String // "18:00"
  order      Int       @default(0)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  tenant    Tenant?    @relation(fields: [tenantId], references: [id])
  positions Position[]

  @@unique([tenantId, name])
  @@map("shift_bands")
}

enum PositionStatus {
  open // budgeted, not yet hired
  filled // someone in this seat (filledByUserId set)
  frozen // intentionally not hiring; still counted in budget? see countInBudget
  archived // no longer a position; excluded from rollups
}

// ─── TenantContribution ──────────────────────────────────────────────────────
// Inter-tenant monthly transfer for JV / shared-service arrangements.
//
// Use case: GS Foods carries 100% of the head office payroll (800k/month) on
// its books. The JV (GS x Viva) contributes 500k/month back to GS Foods as a
// lump sum for shared HO services. That 500k internally splits into:
//   - 200k = Garibsons' 40% share of the JV
//   - 300k = Viva's    60% share of the JV
// The split is recorded in `internalSplit` purely for AG's reporting; from a
// cash-flow standpoint the JV tenant pays the JV tenant pays the full 500k.
//
// /opex/payroll-snapshot reads contributions in two directions:
//   - destination tenant sees `incomingMonthlyCents` (reduces net HO cost)
//   - source tenant      sees `outgoingMonthlyCents` (adds to its OpEx)
// Projections do the same on the labour line.

enum ContributionCategory {
  head_office // shared HO salaries (procurement / finance / marketing)
  commissary // shared kitchen prep (e.g. Viva uses GS Foods' 42C)
  shared_services // other (legal, IT, brand assets)
  other
}

model TenantContribution {
  id                  String               @id @default(uuid())
  sourceTenantId      String // who pays
  destinationTenantId String // who receives
  category            ContributionCategory @default(other) // D1: no longer defaults to head_office
  monthlyCents        Int // gross amount transferred per month
  label               String // short name: "Viva HO contribution"
  description         String? // longer context if needed
  // JSON array of { label: string; cents: int } — purely informational, lets
  // operators document the internal split (e.g. "Garibsons 40% / Viva 60%").
  // Sum doesn't have to match monthlyCents — that's the AGREED transfer.
  internalSplit       Json?
  isActive            Boolean              @default(true)
  startedAt           DateTime             @default(now())
  endedAt             DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  sourceTenant      Tenant @relation("ContributionsFromTenant", fields: [sourceTenantId], references: [id])
  destinationTenant Tenant @relation("ContributionsToTenant", fields: [destinationTenantId], references: [id])

  @@index([destinationTenantId, isActive])
  @@index([sourceTenantId, isActive])
  @@map("tenant_contributions")
}

model Position {
  id                   String         @id @default(uuid())
  tenantId             String // which tenant owns this seat
  conceptId            String? // null = tenant-level (e.g. head office, commissary)
  departmentId         String?
  shiftBandId          String?
  title                String // "Chef de Partie", "Procurement Manager"
  monthlySalaryCents   Int // gross monthly salary
  // Portion of monthlySalary this tenant's P&L bears. Equal to
  // monthlySalaryCents in the normal case. Lower when a position is shared
  // (head office allocated across tenants) or a JV (GS x Viva split).
  tenantCostShareCents Int
  // costShareNote: free-text explanation of why share < gross, e.g.
  // "Head office: GS Foods bears 37.5% of 800k total" or
  // "JV: combined GS 40% + Viva 60% under this tenant".
  costShareNote        String?
  headcount            Int            @default(1) // a single Position row can represent N seats
  filledByUserId       String?
  status               PositionStatus @default(open)
  notes                String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  concept    Concept?    @relation(fields: [conceptId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  shiftBand  ShiftBand?  @relation(fields: [shiftBandId], references: [id])
  filledBy   User?       @relation("PositionFilledBy", fields: [filledByUserId], references: [id])

  @@index([tenantId, status])
  @@index([conceptId])
  @@index([departmentId])
  @@map("positions")
}

// ════════════════════════════════════════════════════════════════════════════
// Fixed assets — base layer (2026-09-23)
//
// A register of owned equipment and fit-out, with straight-line depreciation
// posted monthly to the ledger. Before this existed the fixed-asset accounts
// (1510–1590, 6150) sat at zero forever: no asset base on the balance sheet and
// no depreciation in the P&L.
// ════════════════════════════════════════════════════════════════════════════

// BOOKS-06: money columns on this model are BIGINT paisa (lib/money.ts returns them as JS numbers).
model FixedAsset {
  id                    String    @id @default(uuid())
  tenantId              String
  conceptId             String? // brand it serves; null = shared across brands
  locationId            String?
  name                  String
  // Since v2 (wave B) holds a FixedAssetClass.key: kitchen_equipment | furniture_fixtures | it_equipment | vehicles |
  // leasehold | buildings | power_equipment | office_equipment | smallwares | land
  category              String
  assetTag              String? // unique per company (backfill de-duplicated and filled blanks with FA-NNNNN)
  serialNumber          String?
  supplier              String? // free-text vendor name (legacy); supplierId below is the vendor master link
  acquiredAt            DateTime
  costCents             BigInt // cost still on the books (originalCostCents = when capitalised)
  salvageCents          BigInt    @default(0)
  usefulLifeMonths      Int
  // Credit side of the acquisition entry: 1020 bank, 1010 cash, 2010 payable.
  // Always set: every asset is capitalised (3010 for equipment already owned).
  acquisitionCreditCode String?
  // active | disposed | voided — CHECK fixed_assets_status_chk (SQL only)
  status                String    @default("active")
  disposedAt            DateTime?
  disposalProceedsCents BigInt?
  notes                 String?
  createdById           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // ── Fixed assets v2 (wave B, 2026-10-14; owner: depreciation automatic, no threshold, smallwares pooled) ──
  // CHECKs fixed_assets_quantity_chk / fixed_assets_kind_chk and the partial unique fixed_assets_capex_unit_live
  // (one live asset per CapEx line unit) are SQL only (migration 20261014090000; not declared here).
  kind                     String    @default("individual") // individual | pool_layer
  poolId                   String?
  quantity                 Int       @default(1) // units still on the books (pool layer: units left)
  originalQuantity         Int       @default(1)
  originalCostCents        BigInt    @default(0) // cost when capitalised; costCents = cost still on the books
  inServiceAt              DateTime? // depreciation starts this PKT month (legacy null = acquiredAt)
  method                   String    @default("straight_line") // straight_line | none (land)
  capexLineId              String? // THE link to CapEx (the 'capex-line:' notes prefix is never read again)
  capexLineUnit            Int       @default(0) // 0 = a single-unit line or a pool layer; 1..N = unit n of a line split into N ≥ 2 assets
  supplierId               String?
  warrantyUntil            DateTime?
  documentUrls             Json?
  photoUrls                Json?
  leaseEndsAt              DateTime?
  inputTaxCents            BigInt    @default(0)
  inputTaxCode             String? // snapshot of the 132x code debited (from taxAuthorities.inputTaxCodeFor)
  carriedAccumulatedCents  BigInt    @default(0) // accumulated brought in by a pool-unit transfer
  splitFromAssetId         String?
  disposalKind             String? // sale | scrap | lost | stolen
  disposalReason           String?
  voidedAt                 DateTime?
  voidReason               String?
  // H42 (Hasnain, 2026-10-16): finance ticks "eligible for the 25% initial allowance" per asset (tax view only —
  // never the books). Set at capitalisation by the class rule (kitchen + power true, every other class false);
  // existing rows backfilled the same way (migration 20261017090000). NULL (a row inserted without it) = that rule.
  initialAllowanceEligible Boolean?

  depreciation   FixedAssetDepreciation[]
  concept        Concept?                 @relation("FixedAssetConcept", fields: [conceptId], references: [id], onDelete: SetNull)
  location       Location?                @relation("FixedAssetLocation", fields: [locationId], references: [id], onDelete: SetNull)
  supplierRecord Supplier?                @relation("FixedAssetSupplier", fields: [supplierId], references: [id], onDelete: SetNull)
  pool           FixedAssetPool?          @relation(fields: [poolId], references: [id], onDelete: Restrict)
  capexLine      CapexLine?               @relation(fields: [capexLineId], references: [id], onDelete: Restrict)
  events         FixedAssetEvent[]
  taxYears       FixedAssetTaxYear[]

  @@unique([tenantId, assetTag])
  @@index([tenantId, status])
  @@index([tenantId, category])
  @@index([tenantId, conceptId])
  @@index([tenantId, locationId])
  @@index([poolId])
  @@index([capexLineId])
  @@map("fixed_assets")
}

// BOOKS-06: money columns on this model are BIGINT paisa (lib/money.ts returns them as JS numbers).
model FixedAssetDepreciation {
  id           String    @id @default(uuid())
  tenantId     String
  assetId      String
  period       String // 'YYYY-MM'
  amountCents  BigInt
  postedAt     DateTime  @default(now())
  // Fixed assets v2 (wave B)
  accumCode    String    @default("1590") // accumulated account the charge credited (legacy 1590; 1591-1599 from v2)
  conceptId    String? // brand charged (snapshot)
  locationId   String?
  postedPeriod String? // month the entry actually landed in when posted late; null = its own month
  revision     Int       @default(1)
  reversedAt   DateTime?

  asset FixedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  // One charge per asset per month, whatever happens — reruns are no-ops.
  @@unique([assetId, period])
  @@index([tenantId, period])
  @@map("fixed_asset_depreciation")
}

// ONE asset class list per company (wave B), seeded from fixedAssets/classes.ts ASSET_CLASS_DEFAULTS
// (ensureAssetClasses adds missing keys only, so operator edits survive).
model FixedAssetClass {
  id                    String   @id @default(uuid())
  tenantId              String
  key                   String // kitchen_equipment|furniture_fixtures|it_equipment|vehicles|leasehold|buildings|power_equipment|office_equipment|smallwares|land
  label                 String
  costAccountCode       String
  accumAccountCode      String? // null = not depreciated (land)
  depreciable           Boolean  @default(true)
  pooled                Boolean  @default(false) // smallwares true
  defaultLifeMonths     Int?
  taxRateBp             Int      @default(0)
  taxInitialAllowanceBp Int      @default(0)
  isActive              Boolean  @default(true)
  sortOrder             Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("fixed_asset_classes")
}

// Smallwares pool per outlet × brand × type (H21; owner: smallwares grouped and tracked). Uniqueness (with COALESCE
// on the brand) is the SQL expression index fixed_asset_pools_key (migration 20261014090000; not declared here).
model FixedAssetPool {
  id          String   @id @default(uuid())
  tenantId    String
  locationId  String
  conceptId   String?
  classKey    String // smallwares (or any class marked pooled)
  typeKey     String // knives | ladles_utensils | bowls | plates | trays | cutlery | glassware | pots_pans | bar_tools | storage | other
  label       String
  isActive    Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  location Location          @relation("FixedAssetPoolLocation", fields: [locationId], references: [id], onDelete: Restrict)
  concept  Concept?          @relation("FixedAssetPoolConcept", fields: [conceptId], references: [id], onDelete: SetNull)
  layers   FixedAsset[]
  events   FixedAssetEvent[]

  @@index([tenantId, locationId])
  @@map("fixed_asset_pools")
}

// The register's own request queue + history (read by the approvals inbox provider 'fixed_asset_request'). Owner:
// disposals / scraps / write-downs — finance requests, the CEO approves. CHECK fixed_asset_events_status_chk and the
// partial uniques fixed_asset_events_pending_capitalise (one pending capitalisation per CapEx line) and
// fixed_asset_events_one_pending_per_asset (one pending request of a kind per asset) are SQL only.
// BOOKS-06: money columns on this model are BIGINT paisa (lib/money.ts returns them as JS numbers).
model FixedAssetEvent {
  id             String    @id @default(uuid())
  tenantId       String
  assetId        String?
  poolId         String?
  capexLineId    String?
  parentEventId  String? // per-layer allocation rows of a pool write-off / pool transfer
  kind           String // capitalise|disposal|pool_write_off|pool_write_off_alloc|impairment|change_estimate|transfer|pool_transfer|pool_transfer_alloc|void|undispose|count
  status         String    @default("pending") // pending | posted | rejected | cancelled
  effectiveDate  DateTime
  payload        Json // zod-validated per kind
  amountCents    BigInt? // headline amount for the inbox (cost, proceeds, impairment, NBV out)
  costOutCents   BigInt?
  accumOutCents  BigInt?
  reason         String
  requestedById  String
  requestedAt    DateTime  @default(now())
  decidedById    String?
  decidedAt      DateTime?
  decisionNote   String?
  postedAt       DateTime?
  journalEntryId String?
  errorMessage   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  asset FixedAsset?     @relation(fields: [assetId], references: [id], onDelete: Restrict)
  pool  FixedAssetPool? @relation(fields: [poolId], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
  @@index([assetId, effectiveDate])
  @@index([poolId])
  @@index([capexLineId])
  @@index([parentEventId])
  @@map("fixed_asset_events")
}

// ITO Third-Schedule tax depreciation per asset per tax year (Jul-Jun, ending year), frozen by the CEO (H23).
// BOOKS-06: money columns on this model are BIGINT paisa (lib/money.ts returns them as JS numbers).
model FixedAssetTaxYear {
  id                    String   @id @default(uuid())
  tenantId              String
  assetId               String
  taxYear               Int
  rateBp                Int
  openingWdvCents       BigInt
  additionsCents        BigInt
  initialAllowanceCents BigInt
  depreciationCents     BigInt
  disposalProceedsCents BigInt
  closingWdvCents       BigInt
  frozenAt              DateTime @default(now())
  frozenById            String

  asset FixedAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([tenantId, assetId, taxYear])
  @@index([tenantId, taxYear])
  @@map("fixed_asset_tax_years")
}

// One row per automatic run (depreciation, prepaid releases, register checks) per company — the audit trail of the
// worker. BOOKS-06: chargedCents is BIGINT paisa.
model FixedAssetRun {
  id            String    @id @default(uuid())
  tenantId      String
  kind          String // depreciation | prepaid_release | checks
  throughPeriod String
  triggeredBy   String // 'worker' | userId
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  chargedCount  Int       @default(0)
  chargedCents  BigInt    @default(0)
  lateCount     Int       @default(0)
  failedCount   Int       @default(0)
  error         String?

  @@index([tenantId, startedAt])
  @@map("fixed_asset_runs")
}

// Monthly release of a prepayment to expense (H25, wave B): CapEx rent advances (Dr 6010 / Cr 1310) and OpEx payments
// of treatment 'prepaid' (Dr the category's expense code / Cr 1310). ONE engine: accounting/prepaidReleases.ts.
// Polymorphic source (no FK). 'prepaid.release:<sourceType>:<sourceId>:<YYYY-MM>' is the journal key.
// CHECK prepaid_releases_source_chk is SQL only. BOOKS-06: amountCents is BIGINT paisa.
model PrepaidRelease {
  id           String    @id @default(uuid())
  tenantId     String
  sourceType   String // capex_payment | opex_payment
  sourceId     String
  period       String // 'YYYY-MM'
  amountCents  BigInt
  postedPeriod String? // month it landed in when posted late
  revision     Int       @default(1)
  reversedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@unique([tenantId, sourceType, sourceId, period])
  @@index([tenantId, period])
  @@map("prepaid_releases")
}

// ════════════════════════════════════════════════════════════════════════════
// Receivables — base layer (2026-09-23)
//
// Invoices raised to a customer who pays later (corporate catering, events,
// accounts). Before this nothing receivable was tracked at all and account
// 1110 was never posted to. Till sales settle immediately and never come here.
// ════════════════════════════════════════════════════════════════════════════

// BOOKS-06: money columns on this model are BIGINT paisa (lib/money.ts returns them as JS numbers).
model ReceivableInvoice {
  id                 String    @id @default(uuid())
  tenantId           String
  conceptId          String?
  number             String
  customerName       String
  customerEmail      String?
  customerPhone      String?
  customerNtn        String?
  customerId         String? // linked servd customer, when there is one
  issueDate          DateTime
  dueDate            DateTime
  description        String
  amountCents        BigInt // before tax
  taxCents           BigInt    @default(0)
  paidCents          BigInt    @default(0)
  status             String    @default("open") // open | partial | paid | void
  revenueAccountCode String    @default("4090")
  notes              String?
  createdById        String?
  voidedAt           DateTime?
  voidReason         String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  // Credit notes are ReceivableInvoice rows of kind 'credit_note' against
  // their original invoice (numbered AR-CN-YYYY-NNNN). creditedCents on an
  // invoice = credit notes against it; still due = total − paid − credited.
  kind               String    @default("invoice") // invoice | credit_note
  originalInvoiceId  String?
  creditedCents      BigInt    @default(0)
  // Income tax the customer withheld at source (s.153) and paid to FBR for
  // us: Dr 1330 — it settles that part of the invoice.
  whtCents           BigInt    @default(0)
  // Wave B — kind adds 'statement' (an on-account client's monthly statement: AR-ST-YYYY-NNNN, no issue entry, never
  // a tax invoice); status adds 'written_off'. Still due = total − paid − credited − withheld − writtenOff.
  // CHECK receivable_invoices_written_off_chk is SQL only.
  // SQL only (migration 20261015120100): partial unique receivable_invoices_one_statement_per_period ON (tenantId,
  // customerAccountId, periodTo) WHERE kind = 'statement' AND status <> 'void' — one live statement per client per period.
  customerAccountId  String?
  periodFrom         DateTime?
  periodTo           DateTime?
  writtenOffCents    BigInt    @default(0)

  payments ReceivablePayment[]

  @@unique([tenantId, number])
  @@index([tenantId, status, dueDate])
  @@index([originalInvoiceId])
  @@index([tenantId, customerAccountId, status])
  @@map("receivable_invoices")
}

// BOOKS-06: money columns on this model are BIGINT paisa (lib/money.ts returns them as JS numbers).
model ReceivablePayment {
  id             String    @id @default(uuid())
  tenantId       String
  invoiceId      String
  amountCents    BigInt
  receivedAt     DateTime
  // bank | cash | cheque | card | wht | st_withheld (wave B: sales tax the CLIENT withheld, H13,
  // 'receivable.st_withheld:<id>' Dr 1335 / Cr 1110 — never 'stwh', which is OUR withholding as agent, 2041)
  method         String
  reference      String?
  createdById    String?
  createdAt      DateTime  @default(now())
  bankAccountId  String? // the company bank account it was received into
  // A bounced cheque / reversed receipt: the payment stays for the record,
  // its entry is reversed and the invoice owes it again.
  reversedAt     DateTime?
  reversedReason String?
  taxAuthority   String? // st_withheld: fbr | srb | pra | kpra | bra (from the issue entry / the statement's brands)
  writeOffId     String? // a recovery of a written-off amount

  invoice ReceivableInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("receivable_payments")
}

// A payment of tax to an authority (sales tax output to FBR/SRB/PRA/KPRA/BRA,
// or income tax withheld from suppliers — 'wht'), per company and period.
// Its journal entry ('salestax.payment:<id>') is excluded from the return's
// "output for the period" so paying the tax never lowers what was charged.
// A manual entry already posted for a payment can be LINKED instead
// (journalEntryId, linked = true) — never posted twice.
// BOOKS-06: money columns are BIGINT paisa (lib/money.ts returns them as JS numbers).
model SalesTaxPayment {
  id                          String   @id @default(uuid())
  tenantId                    String
  // fbr | pra | srb | kpra | bra | wht | stwh | salary_tax | eobi | sessi (wave B statutory challans, H7:
  // Dr 2042/2043/2044 / Cr money). Several challans per scheme and month (a top-up, finance audit 2026-10-17
  // item 22): one row per CPR number in the period; every payment after the period's first needs a CPR.
  authority                   String
  periodFrom                  DateTime
  periodTo                    DateTime
  outputSetOffCents           BigInt   @default(0)
  inputSetOffCents            BigInt   @default(0)
  paidCents                   BigInt   @default(0)
  paidAt                      DateTime
  bankAccountId               String?
  cprNumber                   String? // the challan / CPR number
  journalEntryId              String?
  linked                      Boolean  @default(false)
  notes                       String?
  createdById                 String?
  createdAt                   DateTime @default(now())
  // Sales tax withheld by customers (1335, H13) set off against this authority's output in this payment.
  customerWithheldSetOffCents BigInt   @default(0)

  @@unique([tenantId, authority, periodFrom, cprNumber])
  @@index([tenantId, authority, periodFrom])
  @@index([tenantId, paidAt])
  @@map("sales_tax_payments")
}

// ════════════════════════════════════════════════════════════════════════════
// Card payouts at payout (H12, wave B): one Keenu payout bank line matched to the card sales of the days it covers.
// Days are keyed per (company, unit, day); unit = 'company' by default, 'brand:<conceptId>' / 'terminal:<terminalId>'
// when a company has several Keenu MIDs. CHECK card_settlements_status_chk is SQL only.
// BOOKS-06: money columns are BIGINT paisa (lib/money.ts returns them as JS numbers).
// ════════════════════════════════════════════════════════════════════════════

model CardSettlement {
  id              String   @id @default(uuid())
  tenantId        String
  unit            String   @default("company") // 'company' | 'brand:<conceptId>' | 'terminal:<terminalId>' (per Keenu MID)
  bankAccountId   String
  statementLineId String
  journalEntryId  String?
  grossCents      BigInt
  feeCents        BigInt
  feeTaxCents     BigInt   @default(0) // informational split of feeCents (all of it is 6080, H12)
  netCents        BigInt
  dayFrom         String // YYYY-MM-DD PKT
  dayTo           String
  status          String // auto | confirmed | manual_adjust (a BOOKS-11 manual split that claimed the days)
  createdById     String?
