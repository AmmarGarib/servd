// Refund / void / comp policy — single record per scope
model RefundPolicy {
  id                       String   @id @default(cuid())
  scope                    String   @default("global")        // 'global' | 'concept'
  scopeId                  String?                              // concept id when scope='concept'

  // Per-role caps (cents). 0 = role can't perform without manager override.
  cashierVoidLimitCents    Int      @default(0)
  cashierCompLimitCents    Int      @default(50000)             // PKR 500
  cashierRefundLimitCents  Int      @default(0)

  managerVoidLimitCents    Int      @default(500000)            // PKR 5,000
  managerCompLimitCents    Int      @default(500000)
  managerRefundLimitCents  Int      @default(500000)

  requireReason            Boolean  @default(true)
  requirePhotoEvidence     Boolean  @default(false)
  notifyOwnerAboveCents    Int?                                 // alert owner above threshold
  approverEmail            String?
  notes                    String?
  updatedAt                DateTime @updatedAt
  updatedById              String?

  @@unique([scope, scopeId])
  @@map("refund_policies")
}

// Reservation policy — single record per scope
model ReservationPolicy {
  id                          String   @id @default(cuid())
  scope                       String   @default("global")
  scopeId                     String?

  depositRequiredAboveParty   Int?                              // require deposit for parties larger than this
  depositCents                Int      @default(0)
  noShowGraceMinutes          Int      @default(15)
  cancellationWindowHours     Int      @default(24)
  maxAdvanceDays              Int      @default(60)
  minAdvanceHours             Int      @default(2)
  maxPartySize                Int      @default(20)
  walkInsAllowed              Boolean  @default(true)
  remindersEnabled            Boolean  @default(true)
  reminderHoursBefore         Int      @default(24)

  // Slot generation — drives the public availability widget. The restaurant
  // controls these from /configuration/reservation-policy. slotIntervalMin
  // sets the granularity (15 / 30 / 60). defaultDurationMin is the booked
  // window per slot (90 = standard dinner sitting).
  slotIntervalMin             Int      @default(30)
  defaultDurationMin          Int      @default(90)

  // Daypart grouping — how the public widget buckets the slot grid into
  // labelled sections (Lunch / Dinner / etc). JSON array of
  //   { label: string, startHour: 0..23, endHour: 1..24 }
  // Default mirrors the original hardcoded grouping so existing rows behave
  // the same after migration.
  dayparts                    Json     @default("[{\"label\":\"Lunch\",\"startHour\":0,\"endHour\":12},{\"label\":\"Afternoon\",\"startHour\":12,\"endHour\":16},{\"label\":\"Dinner\",\"startHour\":16,\"endHour\":22},{\"label\":\"Late night\",\"startHour\":22,\"endHour\":24}]")

  notes                       String?
  updatedAt                   DateTime @updatedAt
  updatedById                 String?

  @@unique([scope, scopeId])
  @@map("reservation_policies")
}

// Receipt customization — logo/footer/legal/format
model ReceiptConfig {
  id                  String   @id @default(cuid())
  scope               String   @default("global")
  scopeId             String?
  paperWidthMm        Int      @default(80)                   // 80 or 58
  showLogo            Boolean  @default(true)
  logoUrl             String?
  headerText          String?                                  // e.g. "Mubarak Biryani Co. — DHA Phase 5"
  footerText          String?                                  // "Thank you, see you again!"
  legalDisclaimer     String?                                  // "Goods sold are not returnable"
  showTaxBreakdown    Boolean  @default(true)
  showFbrInvoice      Boolean  @default(true)
  printerIp           String?                                   // ESC/POS network printer
  printerPort         Int      @default(9100)
  autoPrintOnOrder    Boolean  @default(false)
  autoPrintOnPay      Boolean  @default(true)
  drawerKickEnabled   Boolean  @default(true)
  cashVarianceLimitCents Int   @default(20000)                 // PKR 200 default
  updatedAt           DateTime @updatedAt
  updatedById         String?

  @@unique([scope, scopeId])
  @@map("receipt_configs")
}

// Operations config — service charge, tip pool rules, invoice numbering, withholding tax,
// brand assets, period locks, COA — settings the platform reads but no dedicated full
// model. Stored as a single typed record per scope.
model OperationsConfig {
  id                          String   @id @default(cuid())
  scope                       String   @default("global")
  scopeId                     String?

  // Service charge
  serviceChargePct            Float    @default(0)              // 0–1, e.g. 0.05 = 5%
  serviceChargeAppliesToChannels String[] @default([])           // ['pos', 'storefront'] — if empty, applies to all

  // Tip pool
  tipPoolEnabled              Boolean  @default(false)
  tipPoolDistribution         String   @default("equal")         // 'equal' | 'by_hours' | 'by_role_weight'
  tipPoolRoleWeights          Json?                              // { kitchen: 1.0, cashier: 1.5, ... }

  // Tax invoice numbering
  invoiceSequenceReset        String   @default("yearly")        // 'yearly' | 'monthly' | 'never'
  invoiceCreditNotePrefix     String?                             // 'CN-'

  // Withholding tax
  withholdingTaxEnabled       Boolean  @default(false)
  withholdingTaxPct           Float    @default(0)
  withholdingTaxRecoverable   Boolean  @default(true)

  // Brand assets (extended palette)
  secondaryColors             String[] @default([])              // hex colors
  fontHeading                 String?                             // 'Playfair Display'
  fontBody                    String?                             // 'Inter'
  brandVoiceNotes             String?                             // tone-of-voice guidance for marketing copy
  socialInstagramHandle       String?
  socialTiktokHandle          String?
  socialFacebookUrl           String?

  // Anti-theft enforcement thresholds (added 2026-05-06)
  cashierDiscountPctCap        Float    @default(0.10)             // 10% — above requires manager PIN
  managerDiscountPctCap        Float    @default(0.50)             // 50% — admin override above
  cashierPriceOverrideCap      Int      @default(0)                // PKR cents — 0 = no override allowed for cashiers
  photoRequiredAboveCents      Int      @default(50000)            // waste/receipt photo required above this
  geofenceRadiusMetres         Int      @default(150)              // clock-in must be within N metres of concept lat/lng
  geofenceEnforced             Boolean  @default(false)            // soft-launch flag; flips to true after staff training
  selfieRequiredAtClockIn      Boolean  @default(false)            // selfie photo at clock-in
  pii_export_row_threshold     Int      @default(100)              // bulk customer/recipe export above this auto-flags
  shrinkage_trend_weeks        Int      @default(4)                // window for chronic shrinkage detection

  updatedAt                   DateTime @updatedAt
  updatedById                 String?

  @@unique([scope, scopeId])
  @@map("operations_configs")
}

// ─── Component library ────────────────────────────────────────────────────────
// Master file of every prep / sauce / sub-recipe built FROM raw ingredients and
// used IN menu items. Sits between InventoryItem (raw) and MenuItem (finished).
// One ingredient can yield many components — operators capture hero forms,
// supporting forms, and trim/waste utilizations all hanging off the same
// parent ingredient. Plug-and-play seasonal additions over time.
//
// Examples from the GS Foods component matrix:
//   Dates → hero: "Stuffed Dates"
//         → supporting: "Date Syrup", "Date Ketchup"
//         → trim/waste: "Date Coffee"
//   Lemon → hero: "Lemon Curd / Fluid Gel"
//         → supporting: "Preserved Lemons"
//         → trim/waste: "Candied Lemon Julienne"

enum ComponentType {
  hero
  supporting
  trim_waste
}

model Component {
  id                 String              @id @default(cuid())
  baseIngredientId   String?
  name               String
  type               ComponentType
  description        String?
  preparation        String?

  seasons            String[]            @default([])

  yieldGrams         Float?
  shelfLifeHours     Int?
  laborMinutes       Int?

  isActive           Boolean             @default(true)
  notes              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?

  baseIngredient     InventoryItem?      @relation(fields: [baseIngredientId], references: [id])
  brands             ComponentBrandUse[]

  @@index([baseIngredientId])
  @@index([type])
  @@index([isActive])
  @@map("components")
}

model ComponentBrandUse {
  componentId String
  conceptId   String
  usageNote   String?
  isPrimary   Boolean   @default(false)
  createdAt   DateTime  @default(now())

  component   Component @relation(fields: [componentId], references: [id], onDelete: Cascade)
  concept     Concept   @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@id([componentId, conceptId])
  @@index([conceptId])
  @@map("component_brand_uses")
}

// ─── Capital ledger ───────────────────────────────────────────────────────────
// Tracks every PKR out against the project's total capital ask. Mirrors the
// "Date / Amount / For / Paid Out To" tab most operators run in Excel.

model CapitalLedgerEntry {
  id          String   @id @default(cuid())
  tenantId    String?
  conceptId   String?
  projectId   String?
  date        DateTime
  amountCents Int
  description String
  paidTo      String?
  invoiceUrl  String?
  category    String?                       // 'rent' | 'broker' | 'capex' | 'license' | 'equipment' | 'consulting' | 'other'
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([tenantId, date(sort: Desc)])
  @@index([conceptId, date(sort: Desc)])
  @@index([projectId])
  @@map("capital_ledger_entries")
}

// ─── CapEx project ────────────────────────────────────────────────────────────
// One project per location/concept buildout. Line items grouped into scopes
// (BOH = back of house, FOH = front of house, AG = above ground / finishing).

model CapexProject {
  id                  String   @id @default(cuid())
  tenantId            String?
  conceptId           String?
  locationId          String?                                            // physical location being built/refurbed
  name                String
  projectType         String   @default("kitchen_buildout")              // kitchen_buildout | refurb | expansion | new_brand | equipment_only
  phase               String   @default("planning")                       // planning | quoting | executing | snagging | live
  // Budget envelope — owner-set cap. Lines + fees + tax + contingency = totalAsk;
  // we flag when totalAsk exceeds this.
  budgetEnvelopeCents Int      @default(0)
  contingencyPct      Float    @default(0.10)                            // 10% default
  totalAskCents       Int      @default(0)                               // legacy; recomputed from lines + fees
  consultantFeesCents Int      @default(0)
  taxCents            Int      @default(0)
  // Project schedule
  targetOpeningDate   DateTime?
  actualOpeningDate   DateTime?
  // Project metadata
  ownerId             String?                                            // project manager / owner
  address             String?
  floorAreaSqft       Int?
  // Per-project scope sections — JSON array of { key, label, emoji, hint }.
  // null = use platform default (BOH/FOH/AG/etc). Operators rename/add/reorder.
  scopeConfig         Json?
  status              String   @default("planning")                       // legacy alias for phase
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  deletedAt           DateTime?

  lines               CapexLine[]

  @@index([tenantId])
  @@index([conceptId])
  @@index([locationId])
  @@map("capex_projects")
}

model CapexLine {
  id              String   @id @default(cuid())
  projectId       String
  scope           String                       // 'BOH' | 'FOH' | 'AG' | 'Equipment' | 'MEP' | 'Civil' | 'Tech' | 'Branding' | 'Permits' | 'SoftCosts' | 'Other'
  category        String?                      // sub-grouping for the operator's mental model
  item            String
  quantity        Int      @default(1)
  unitCostCents   Int                          // budgeted/estimated cost — what you planned
  // Vendor + quoting
  vendor          String?                      // selected vendor
  vendorContact   String?
  quotedCents     Int?                         // initial quote total
  negotiatedCents Int?                         // final negotiated total — what you actually committed to
  paidCents       Int      @default(0)         // running total paid
  // Status pipeline
  status          String   @default("not_quoted")  // not_quoted | quoted | ordered | partial_paid | delivered | installed | commissioned | snag | done
  priority        String   @default("must_have")   // must_have | nice_to_have | future
  // Schedule
  leadTimeDays      Int?
  expectedDeliveryDate DateTime?
  actualDeliveryDate   DateTime?
  installedDate     DateTime?
  // Documents + photos as JSON arrays of {label, url}
  documentUrls    Json?
  photoUrls       Json?
  // Operational
  warrantyMonths  Int?
  assignedToId    String?
  notes           String?
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project         CapexProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  quotes          CapexQuote[]
  payments        CapexPayment[]

  @@index([projectId])
  @@index([status])
  @@map("capex_lines")
}

// Multiple quotes per line — vendor comparison shopping. Operator marks one
// as the winner; that one populates CapexLine.vendor + negotiatedCents.
model CapexQuote {
  id            String   @id @default(cuid())
  lineId        String
  vendor        String
  contactName   String?
  contactPhone  String?
  totalCents    Int
  leadTimeDays  Int?
  validUntil    DateTime?
  fileUrl       String?                         // PDF / image of the quote document
  notes         String?
  isWinner      Boolean  @default(false)
  createdAt     DateTime @default(now())

  line          CapexLine @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@index([lineId])
  @@map("capex_quotes")
}

// ─── OpEx tracker — recurring operational expenses ───────────────────────────
// Different shape from CapEx: these are recurring cash-outflows (rent, payroll,
// utilities, software). The model is "category → line → period payments" with
// expected vs actual per period so trend + variance jump out.

model OpexCategory {
  id        String   @id @default(cuid())
  tenantId  String?
  conceptId String?                                // null = company-wide
  name      String                                 // 'Rent' | 'Utilities' | 'Payroll' | 'Software' | etc.
  emoji     String?                                // surfaced in UI
  budgetMonthlyCents Int @default(0)               // monthly cap; variance vs actual flagged
  notes     String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  lines     OpexLine[]

  @@index([tenantId])
  @@index([conceptId])
  @@map("opex_categories")
}

model OpexLine {
  id            String   @id @default(cuid())
  categoryId    String
  conceptId     String?
  projectId     String?                             // optional link to a CapexProject (build-out + run together = full TCO)
  name          String                              // 'Office rent — Lahore', 'KE bill — Karachi kitchen'
  vendor        String?
  vendorContact String?
  amountCents   Int                                 // expected per-period amount
  cadence       String   @default("monthly")        // 'monthly' | 'quarterly' | 'annual' | 'per_use'
  nextDueDate   DateTime?
  paymentMethod String?                             // 'bank_transfer' | 'card' | 'cash' | 'auto_debit'
  bankAccountId String?
  // Source: 'manual' for hand-entered; 'payroll'/'license'/'subscription' link to internal data.
  source        String   @default("manual")
  isActive      Boolean  @default(true)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category      OpexCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  payments      OpexPayment[]

  @@index([categoryId])
  @@index([projectId])
  @@index([nextDueDate])
  @@map("opex_lines")
}

model OpexPayment {
  id            String   @id @default(cuid())
  lineId        String
  periodStart   DateTime
  periodEnd     DateTime
  expectedCents Int                                 // forecast for this period
  actualCents   Int?                                // what hit the bank (null until paid)
  paidAt        DateTime?
  paymentRef    String?
  receiptUrl    String?
  notes         String?
  createdAt     DateTime @default(now())

  line          OpexLine @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@index([lineId, periodStart])
  @@index([paidAt])
  @@map("opex_payments")
}

// Payment schedule per line — deposit / midpoint / balance / extras.
// Cash-flow page sums these by dueDate to show outflow timeline.
model CapexPayment {
  id            String   @id @default(cuid())
  lineId        String
  label         String                          // 'deposit' | 'midpoint' | 'balance' | 'extra'
  amountCents   Int
  dueDate       DateTime?
  paidAt        DateTime?
  paidAmountCents Int?                          // null until paid; supports partial
  paymentRef    String?                         // bank ref, cheque #, transaction ID
  notes         String?
  createdAt     DateTime @default(now())

  line          CapexLine @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@index([lineId])
  @@index([dueDate])
  @@map("capex_payments")
}

// ─── Pro-forma / financial projection ─────────────────────────────────────────
// Persisted version of the operator's Excel "Annual Projection" tab. One
// ProForma = one scenario; channels + fixed costs + monthly ramp curves
// produce the per-month P&L.

model ProForma {
  id                       String   @id @default(cuid())
  tenantId                 String?
  conceptId                String?
  name                     String
  scenario                 String   @default("base")
  totalAskCents            Int      @default(0)
  capexCents               Int      @default(0)
  workingCapitalCents      Int      @default(0)
  brokerFeeCents           Int      @default(0)
  rentAdvanceSecurityCents Int      @default(0)
  monthlyFixedCostsCents   Int      @default(0)
  variableCostPct          Float    @default(0.40)
  tradingDaysPerMonth      Int      @default(26)
  notes                    String?
  createdById              String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  deletedAt                DateTime?

  channels                 ProFormaChannel[]
  fixedCosts               ProFormaFixedCost[]
  months                   ProFormaMonth[]

  @@index([tenantId])
  @@index([conceptId])
  @@map("pro_formas")
}

model ProFormaChannel {
  id              String   @id @default(cuid())
  proFormaId      String
  name            String
  checkAvgCents   Int
  ordersTue       Int      @default(0)
  ordersWed       Int      @default(0)
  ordersThu       Int      @default(0)
  ordersFri       Int      @default(0)
  ordersSat       Int      @default(0)
  ordersSun       Int      @default(0)
  ordersMon       Int      @default(0)
  sortOrder       Int      @default(0)

  proForma        ProForma @relation(fields: [proFormaId], references: [id], onDelete: Cascade)

  @@index([proFormaId])
  @@map("pro_forma_channels")
}

model ProFormaFixedCost {
  id           String   @id @default(cuid())
  proFormaId   String
  category     String
  monthlyCents Int
  notes        String?
  sortOrder    Int      @default(0)

  proForma     ProForma @relation(fields: [proFormaId], references: [id], onDelete: Cascade)

  @@index([proFormaId])
  @@map("pro_forma_fixed_costs")
}

model ProFormaMonth {
  id              String   @id @default(cuid())
  proFormaId      String
  monthIndex      Int
  rampPct         Float
  channelOverrides Json?
  notes           String?

  proForma        ProForma @relation(fields: [proFormaId], references: [id], onDelete: Cascade)

  @@unique([proFormaId, monthIndex])
  @@index([proFormaId])
  @@map("pro_forma_months")
}

// ─── Custom domains ───────────────────────────────────────────────────────────
// Maps a hostname (`order.mubarakbiryani.pk`) to a concept. Storefront-side
// middleware reads the Host header and serves that concept's microsite / order
// flow. SSL is provisioned at the edge (Cloudflare / Caddy / Vercel) — servd
// just tracks status here so the operator can see what's wired up.
//
// Verification flow:
//   1. User adds domain. We generate a 16-char `verificationToken`.
//   2. UI tells them to add a DNS TXT record:
//        _servd-verify.<their-domain> = <verificationToken>
//   3. Plus a CNAME for traffic:
//        <their-domain> → <servd-storefront-host>
//   4. They click "Verify". We DNS-resolve the TXT and flip status: verified.
//   5. Operator (or auto-job) provisions SSL at the edge → flips status: active.

enum DomainStatus {
  pending          // added, awaiting DNS records
  verified         // TXT record found, ready for SSL
  active           // SSL issued + serving traffic
  failed           // verification failed; user fix DNS and retry
  disabled         // operator paused this domain
}

model Domain {
  id                String       @id @default(cuid())
  tenantId          String?
  conceptId         String?      // null = generic tenant landing; set = specific brand microsite / order page
  hostname          String       @unique     // 'order.mubarakbiryani.pk', no scheme
  purpose           String       @default("order")  // 'order' | 'brand_microsite' | 'admin' (rare)
  status            DomainStatus @default(pending)
  verificationToken String       // random 16-char string included in TXT record
  verifiedAt        DateTime?
  sslIssuedAt       DateTime?
  lastCheckedAt     DateTime?
  notes             String?
  createdById       String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?

  @@index([tenantId])
  @@index([conceptId])
  @@index([status])
  @@map("domains")
}

// ─── Tenant ───────────────────────────────────────────────────────────────────
// Lightweight multi-tenancy. Each restaurant company is one Tenant; concepts
// (brands) and users belong to a tenant. We attach tenantId nullably so existing
// single-tenant data keeps working — the seed function promotes existing rows
// into a default "main" tenant on first boot.
//
// (Named Tenant rather than Account because `Account` is already the chart-of-
// accounts model in the accounting module.)
//
// What this gets you today:
//   - A signup flow that creates a fresh tenant + admin + first concept
//   - Templates apply per-tenant so prospects can try with sample data
//   - Top-level list endpoints will filter by tenantId once we wire the JWT
//
// What's NOT here yet:
//   - Row-level isolation across every model (deferred — risky refactor;
//     concepts already filter most queries by conceptId so tenant scoping
//     flows naturally for now)
//   - Per-tenant billing customer ID, plan tier (next iteration)

model Tenant {
  id            String    @id @default(cuid())
  slug          String    @unique
  name          String
  ownerEmail    String?                    // owner contact — set during signup
  industry      String?                    // 'qsr' | 'cafe' | 'fine_dining' | 'cloud_kitchen' | 'biryani' | 'multi_brand'
  countryCode   String    @default("PK")   // ISO 3166-1 alpha-2 — drives currency, tax regime
  currency      String    @default("PKR")
  timezone      String    @default("Asia/Karachi")
  plan          String    @default("trial") // 'trial' | 'starter' | 'growth' | 'chain'
  trialEndsAt   DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  concepts      Concept[]
  users         User[]
  members       TenantMember[]

  @@map("tenants")
}

// ─── TenantMember ─────────────────────────────────────────────────────────────
// Many-to-many between User and Tenant. A user can own / be a member of multiple
// tenants (each billed separately). The User.tenantId column above continues to
// represent the *active* tenant in the current session. Switching active tenant
// = update User.tenantId to another tenant the user is a member of.

model TenantMember {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  role      String   @default("owner")    // 'owner' | 'admin' | 'manager'
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([userId])
  @@index([tenantId])
  @@map("tenant_members")
}

// ─── Payment gateway configuration ────────────────────────────────────────────
// Per-provider toggle + non-secret config. Secrets (merchant keys, hash keys)
// live in env vars — referenced by name here so the UI can show the user
// which env var to populate.

model PaymentGatewayConfig {
  id            String   @id @default(uuid())
  provider      String                          // 'keenu' | 'jazzcash' | 'easypaisa' | 'cash'
  conceptId     String?                         // null = global; otherwise per-concept override
  isEnabled     Boolean  @default(false)
  isLive        Boolean  @default(false)        // false = sandbox / test mode
  merchantId    String?                         // public, safe to store (NOT the secret)
  callbackUrl   String?
  successUrl    String?
  failureUrl    String?
  notes         String?
  updatedAt     DateTime @updatedAt
  updatedById   String?

  @@unique([provider, conceptId])
  @@map("payment_gateway_configs")
}

// ─── Locations ────────────────────────────────────────────────────────────────
// A physical place. A location can host one or many Concepts (multi-concept
// kitchens, ghost kitchens, food courts). A concept can theoretically also run
// at multiple locations (chain expansion), so the relationship is many-to-many.
//
// Why a separate model: Concept = brand (logical, has its own menu, branding,
// loyalty); Location = physical venue (has an address, a cash drawer, a kitchen,
// a printer). Accounting and ops need to filter by both axes independently.

model Location {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String                          // "Gulberg Branch", "DHA Kitchen"
  address     String?
  city        String?
  latitude    Float?
  longitude   Float?
  phone       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  concepts    ConceptLocation[]
  orders      Order[]
  shifts      Shift[]
  financialEntries FinancialEntry[]
  transfersFrom    StockTransfer[]   @relation("TransferFrom")
  transfersTo      StockTransfer[]   @relation("TransferTo")

  @@map("locations")
}

// ─── StockTransfer ───────────────────────────────────────────────────────────
// Inter-location inventory movement. Records the request → approval →
// in-transit → received workflow. Stock-level mutations live separately
// (today inventory is one tenant-wide pool; per-location stock is queued
// for a future migration). Until then, this model is the authoritative
// audit trail of "who sent what to whom on what day."
model StockTransfer {
  id                 String   @id @default(uuid())
  inventoryItemId    String
  fromLocationId     String
  toLocationId       String
  quantity           Float
  unit               String
  // requested → approved → in_transit → received       (happy path)
  //              ↓                       ↓
  //          cancelled               (any time before received)
  status             String   @default("requested")
  reason             String?              // e.g. "low stock at DHA, surplus at Gulberg"
  notes              String?              // free-form

  // Audit trail of WHO did what
  requestedById      String
  approvedById       String?
  shippedById        String?
  receivedById       String?
  cancelledById      String?

  requestedAt        DateTime @default(now())
  approvedAt         DateTime?
  shippedAt          DateTime?
  receivedAt         DateTime?
  cancelledAt        DateTime?
  cancelReason       String?

  // Once per-location stock lands, this is where receivedQuantity might
  // diverge from quantity (driver lost some, breakage, etc.).
  receivedQuantity   Float?

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
  fromLocation  Location      @relation("TransferFrom", fields: [fromLocationId], references: [id])
  toLocation    Location      @relation("TransferTo",   fields: [toLocationId],   references: [id])

  @@index([status, requestedAt])
  @@index([inventoryItemId])
  @@index([fromLocationId, status])
  @@index([toLocationId, status])
  @@map("stock_transfers")
}

// Many-to-many link between Concept (brand) and Location (place).
// A row in this table means "concept X is operated at location Y".
model ConceptLocation {
  conceptId   String
  locationId  String
  isPrimary   Boolean  @default(false)        // primary location for a concept (used when an order doesn't specify one)
  createdAt   DateTime @default(now())

  concept     Concept  @relation(fields: [conceptId], references: [id])
  location    Location @relation(fields: [locationId], references: [id])

  @@id([conceptId, locationId])
  @@index([locationId])
  @@map("concept_locations")
}

// ─── Role-based permissions ──────────────────────────────────────────────────
// Editable permission matrix. The catalogue of permission keys lives in code
// (see lib/permissions.ts); this table tracks which role currently has each
// one enabled. Admins can flip any cell from the Roles & Permissions admin UI.

model RolePermission {
  id         String   @id @default(cuid())
  role       UserRole
  permission String
  enabled    Boolean  @default(true)
  updatedAt  DateTime @updatedAt

  @@unique([role, permission])
  @@index([role])
  @@map("role_permissions")
}

// ─── API access tokens ───────────────────────────────────────────────────────
// Long-lived bearer tokens for partner integrations + the customer mobile app.
// Tokens are hashed with sha256 before storage; the plaintext is shown only
// once (at creation time). Revoke by setting revokedAt — never delete the row,
// so audit lookups stay intact.

model ApiToken {
  id          String    @id @default(cuid())
  name        String                  // human-readable label, e.g. "Mobile app prod"
  tokenHash   String    @unique       // sha256 of the plaintext bearer
  scopes      String[]  @default([])  // free-form permission scopes ("orders:read", "menu:read", "*")
  conceptId   String?                 // null = all concepts
  createdById String?                 // staff user who issued the token
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([tokenHash])
  @@map("api_tokens")
}

// ─── Media Library ────────────────────────────────────────────────────────────

model MediaAsset {
  id           String   @id @default(cuid())
  key          String
  url          String
  filename     String
  contentType  String
  category     String   @default("general") // menu, marketing, shoot, kds, general
  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([category, createdAt])
  @@map("media_assets")
}

// ─── Cross-checks: closed-loop inventory + fraud detection ───────────────────
//
// The platform's anti-fraud spine. Each model captures one checkpoint in the
// "buy → receive → use → sell" loop. Variance between adjacent checkpoints is
// the signal — `ExceptionFlag` records that signal so the owner only sees
// what's broken, not what's working.

// Goods receipt — what physically arrived at the dock. Independent of the
// supplier's bill so we can detect price manipulation or short-shipments
// before the bill is paid (3-way match: PO qty / GRN qty / Bill qty).
model GoodsReceipt {
  id            String   @id @default(cuid())
  poId          String?                              // matched PO if scanned at dock
  supplierId    String
  receivedById  String                               // user who accepted delivery
  receivedAt    DateTime @default(now())
  photoUrl      String?                              // dock-door photo (required if config)
  notes         String?
  status        String   @default("pending")         // pending | accepted | disputed | partial
  varianceFlag  Boolean  @default(false)             // true if any line variance > threshold

  lines         GoodsReceiptLine[]

  @@index([supplierId, receivedAt])
  @@index([status])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id              String  @id @default(cuid())
  receiptId       String
  inventoryItemId String?                            // null when receiving non-inventoried items
  description     String                             // human-readable; mirrors PO line
  poQty           Float?                             // ordered qty (when matched)
  receivedQty     Float                              // what actually arrived
  poUnitCostCents Int?                               // expected unit cost
  unit            String  @default("kg")
  variancePct     Float?                             // (receivedQty - poQty) / poQty
  notes           String?

  receipt         GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
  @@map("goods_receipt_lines")
}

// Prep batch — kitchen records what they made + what they used to make it.
// Yield variance (actualYield / expectedYield) is the leak signal between
// "received into inventory" and "available to sell". A chef walking out with
// product shows up here as low yield % over time.
model PrepBatch {
  id                String   @id @default(cuid())
  recipeId          String?                           // null for ad-hoc preps
  itemName          String                            // e.g. "Confit garlic"
  inputs            Json                              // [{inventoryItemId, qtyDrawn, unit}]
  expectedYieldQty  Float?
  actualYieldQty    Float
  unit              String   @default("g")
  yieldVariancePct  Float?                            // actualYield / expectedYield
  staffId           String                            // chef who logged it
  photoUrl          String?                           // photo of finished prep
  notes             String?
  createdAt         DateTime @default(now())

  @@index([staffId, createdAt])
  @@index([recipeId])
  @@map("prep_batches")
}

// Physical count — periodic spot-counts. Variance vs system stock shows
// shrinkage between checkpoints (received→used or used→sold). Cumulative
// per-item shrinkage trends drive the strongest theft signal.
model PhysicalCount {
  id          String   @id @default(cuid())
  countedById String
  countedAt   DateTime @default(now())
  status      String   @default("pending")            // pending | completed | reviewed
  notes       String?

  lines       PhysicalCountLine[]

  @@index([countedAt])
  @@map("physical_counts")
}

model PhysicalCountLine {
  id              String  @id @default(cuid())
  countId         String
  inventoryItemId String
  systemQty       Float                                // what the DB thinks
  physicalQty     Float                                // what was physically counted
  variancePct     Float?                               // (physical - system) / system
  reason          String?                              // free-text justification

  count           PhysicalCount @relation(fields: [countId], references: [id], onDelete: Cascade)

  @@index([countId])
  @@index([inventoryItemId])
  @@map("physical_count_lines")
}

// ExceptionFlag — universal anomaly signal. Anywhere in the codebase fires
// `flagException(...)` when a control trigger fires; the owner inbox reads
// open flags and shows only what needs attention. Resolution + acknowledgement
// are tracked so audit trail is complete.
enum ExceptionSeverity {
  low
  medium
  high
  critical
}

enum ExceptionStatus {
  open
  acknowledged
  resolved
  dismissed
}

model ExceptionFlag {
  id          String            @id @default(cuid())
  kind        String                                // 'receiving_variance' | 'shrinkage' | 'consecutive_voids' | 'cash_variance' | 'route_variance' | 'pii_export' | 'self_approval' | 'price_drift' | 'yield_low' | 'ghost_employee'
  severity    ExceptionSeverity @default(medium)
  title       String
  description String
  entityType  String?                               // 'GoodsReceipt' | 'Order' | 'Shift' | 'PrepBatch' | etc.
  entityId    String?
  metadata    Json?                                 // arbitrary context (variance %, names, amounts)
  conceptId   String?                               // when scoped to a brand
  actorId     String?                               // user who triggered it (if applicable)
  amountCents Int?                                  // monetary impact, if any

  status            ExceptionStatus @default(open)
  acknowledgedById  String?
  acknowledgedAt    DateTime?
  resolvedById      String?
  resolvedAt        DateTime?
  resolution        String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, severity, createdAt])
  @@index([kind, status])
  @@index([entityType, entityId])
  @@map("exception_flags")
}

// ─── Petty cash ──────────────────────────────────────────────────────────────
// Float box(es) the operator stocks for small spend (water bottles, last-minute
// herbs, courier tips). Without this, PKR leaks through "miscellaneous" with no
// trail. Every spend requires a receipt photo above threshold; reconcile
// monthly against actual count.

model PettyCashBox {
  id            String   @id @default(cuid())
  name          String                                  // "Front-of-house till", "Manager pocket"
  conceptId     String?
  custodianId   String                                  // user responsible for the box
  floatCents    Int      @default(0)                    // current balance (system view)
  topUpLimitCents Int    @default(2000000)              // reject top-up above this without admin
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  movements     PettyCashMovement[]

  @@index([conceptId])
  @@map("petty_cash_boxes")
}

model PettyCashMovement {
  id            String   @id @default(cuid())
  boxId         String
  type          String                                  // 'topup' | 'spend' | 'reconcile' | 'transfer'
  amountCents   Int                                     // signed: + topup, - spend
  category      String?                                 // expense category (drives JE account)
  reason        String                                  // free-text description
  receiptUrl    String?                                 // photo of vendor receipt (required above threshold)
  vendorName    String?
  approvedById  String?                                 // for spend > role cap
  createdById   String
  createdAt     DateTime @default(now())

  box           PettyCashBox @relation(fields: [boxId], references: [id])

  @@index([boxId, createdAt])
  @@map("petty_cash_movements")
}

// ─── Bank deposit drops ──────────────────────────────────────────────────────
// End-of-day cash to bank. Closes the cash loop: shift cash sales should equal
// the deposit drop. Variance flags theft between till and bank teller.

model DepositDrop {
  id              String   @id @default(cuid())
  shiftId         String?                               // when scoped per-shift
  conceptId       String?
  bankAccountId   String?
  amountCents     Int                                   // counted at drop
  expectedCents   Int                                   // cash sales total
  varianceCents   Int                                   // amount - expected
  bagSerial       String?                               // tamper-evident bag serial
  receiptUrl      String?                               // photo of teller deposit slip
  droppedById     String                                // who delivered to bank
  witnessedById   String?                               // dual-signoff (optional)
  droppedAt       DateTime @default(now())
  notes           String?

  @@index([conceptId, droppedAt])
  @@index([shiftId])
  @@map("deposit_drops")
}

// ─── Staff meals ─────────────────────────────────────────────────────────────
// Free / staff-rate meals consumed by employees. Without logging, "I'll take a
// burger off the line" runs untracked and inventory shrinks without a paper
// trail. Approver PIN required + caps; above cap auto-flags.

model StaffMeal {
  id                 String   @id @default(cuid())
  staffId            String                              // who ate
  approvedById       String                              // manager who approved (PIN-verified)
  shiftId            String?
  conceptId          String?
  description        String                              // "Stax Classic + fries"
  estimatedCostCents Int      @default(0)               // recipe-cost approximation
  reason             String   @default("shift_meal")    // 'shift_meal' | 'training' | 'tasting' | 'comp'
  consumedAt         DateTime @default(now())

  @@index([staffId, consumedAt])
  @@index([conceptId, consumedAt])
  @@map("staff_meals")
}
