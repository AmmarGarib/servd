}

model CardSettlementDay {
  id           String @id @default(uuid())
  tenantId     String
  settlementId String
  unit         String @default("company")
  day          String // YYYY-MM-DD PKT
  grossCents   BigInt

  settlement CardSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  @@unique([tenantId, unit, day])
  @@index([settlementId])
  @@map("card_settlement_days")
}

// ════════════════════════════════════════════════════════════════════════════
// On-account clients (owner, 2026-10-13): named corporate clients with a credit limit; the client gets a QR card the
// cashier scans; NO manager approval per bill; finance invoices monthly (ReceivableInvoice kind 'statement').
// Per company. Limits are company-level money → BIGINT; a charge is per ticket → INT4 (like Payment).
// CHECKs customer_accounts_chk / customer_account_charges_chk are SQL only (migration 20261014090000).
// ════════════════════════════════════════════════════════════════════════════

model CustomerAccount {
