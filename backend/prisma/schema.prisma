model CustomerAccountCard {
  id            String    @id @default(uuid())
  tenantId      String
  accountId     String
  label         String // "Reception", "Mr Khan"
  tokenHash     String // sha256 hex of the normalised code; the code is never stored or logged
  tokenHint     String // last 4 chars
  issuedById    String
  issuedAt      DateTime  @default(now())
  revokedAt     DateTime?
  revokedById   String?
  revokedReason String? // rotated | lost | <text>
  lastUsedAt    DateTime?

  account CustomerAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([tenantId, tokenHash])
  @@index([tenantId, accountId])
  @@map("customer_account_cards")
}

// One row per on-account bill. Per-ticket money stays INT4 like Payment.
model CustomerAccountCharge {
  id                 String   @id @default(uuid())
  tenantId           String
  accountId          String
  cardId             String?
  orderId            String
  paymentId          String
  conceptId          String
  shiftId            String?
  amountCents        Int
  taxCents           Int      @default(0)
  refundedCents      Int      @default(0)
  reference          String? // client PO / who signed
  chargedById        String
  chargedAt          DateTime @default(now())
  statementInvoiceId String? // ReceivableInvoice kind 'statement' (claimed only once the sale is BOOKED)
  // City Ledger (2026-10-24): paid on this bill directly (Σ live CityLedgerAllocation) — a bill not yet on a
  // statement. Still owed on the bill = amount − refunded − settled; a statement bills only that remainder.
  settledCents       Int      @default(0)

  account     CustomerAccount        @relation(fields: [accountId], references: [id])
  allocations CityLedgerAllocation[]

  @@unique([tenantId, orderId])
  @@unique([tenantId, paymentId])
  @@index([tenantId, accountId, statementInvoiceId])
  @@index([statementInvoiceId])
  @@map("customer_account_charges")
}

// Bad-debt write-offs (H15 'direct'; owner: the CEO approves every one; a CEO-raised request applies at once).
// One open request per invoice: partial unique receivable_write_offs_one_open (SQL only); CHECK
// receivable_write_offs_chk is SQL only. BOOKS-06: money columns are BIGINT paisa.
model ReceivableWriteOff {
  id             String    @id @default(uuid())
  tenantId       String
  invoiceId      String
  amountCents    BigInt
  reason         String
  status         String    @default("requested") // requested | approved | rejected | cancelled
  requestedById  String
  requestedAt    DateTime  @default(now())
  decidedById    String?
  decidedAt      DateTime?
  decisionNote   String?
  journalEntryId String?
  recoveredCents BigInt    @default(0)

  attachments ReceivableWriteOffAttachment[]

  @@index([tenantId, status])
  @@index([invoiceId])
  @@map("receivable_write_offs")
}

model ReceivableWriteOffAttachment {
  id           String   @id @default(uuid())
  tenantId     String
  writeOffId   String
  fileName     String
  mime         String // image/jpeg|png|webp | application/pdf (lib/evidenceFile.ts)
  sizeBytes    Int
  data         Bytes
  uploadedById String
  createdAt    DateTime @default(now())

  writeOff ReceivableWriteOff @relation(fields: [writeOffId], references: [id], onDelete: Cascade)

  @@index([writeOffId])
  @@map("receivable_write_off_attachments")
}

// ════════════════════════════════════════════════════════════════════════════
// Food safety — base layer (2026-09-23)
//
// Temperature checks against limits, cleaning schedules, and corrective action
// whenever a reading is out of range. Nothing of the kind existed before.
// ════════════════════════════════════════════════════════════════════════════

model FoodSafetyUnit {
  id         String   @id @default(uuid())
  tenantId   String
  locationId String?
  name       String // "Walk-in chiller", "Bain-marie"
  kind       String // fridge | freezer | hot_hold | cooking | delivery | other
  minC       Float? // null = no lower limit
  maxC       Float? // null = no upper limit
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  logs TemperatureLog[]

  @@index([tenantId, isActive])
  @@map("food_safety_units")
}

model TemperatureLog {
  id               String   @id @default(uuid())
  tenantId         String
  unitId           String
  readingC         Float
  withinRange      Boolean
  // Required whenever withinRange is false — an out-of-range reading with no
  // action recorded is the thing an inspector asks about first.
  correctiveAction String?
  note             String?
  takenById        String?
  takenAt          DateTime @default(now())

  unit FoodSafetyUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([tenantId, takenAt])
  @@index([unitId, takenAt])
  @@map("temperature_logs")
}

model CleaningTask {
  id         String   @id @default(uuid())
  tenantId   String
  locationId String?
  name       String
  area       String?
  frequency  String // daily | weekly | monthly
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  logs CleaningLog[]

  @@index([tenantId, isActive])
  @@map("cleaning_tasks")
}

model CleaningLog {
  id       String   @id @default(uuid())
  tenantId String
  taskId   String
  doneById String?
  doneAt   DateTime @default(now())
  note     String?

  task CleaningTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, doneAt])
  @@map("cleaning_logs")
}

// ════════════════════════════════════════════════════════════════════════════
// HR module — base layer (2026-09-24)
//
// Built from the HR team's 30-section module spec. The design splits the two
// things that change at different speeds:
//
//   FORMATS change often and belong to HR. Every section is a form whose field
//   list lives in HrFormDefinition as data — versioned, editable in admin,
//   importable as JSON — so the HR team's formats go in without a deploy.
//
//   LOGIC changes rarely and belongs to code: leave balances, overtime, payroll
//   with EOBI, loans, final settlement, approvals. It never reads a field by its
//   label. It reads a handful of fixed SLOTS on HrRecord (employeeId, startDate,
//   endDate, quantity, amountCents, effectiveDate), and a format BINDS its
//   fields to those slots. Rename "Leave from" to "First day off" and the leave
//   balance still works, because the field is still bound to startDate.
// ════════════════════════════════════════════════════════════════════════════

// The central HR database. One row per person employed, login or not.
model HrEmployee {
  id                String    @id @default(uuid())
  tenantId          String
  employeeCode      String // "GSF-0001" — unique per company
  // Optional link to a servd login. Most kitchen staff never have one; when
  // they do, it lets self-service and the time clock find their record.
  userId            String?
  fullName          String
  fatherHusbandName String?
  cnic              String?
  cnicExpiry        DateTime?
  dateOfBirth       DateTime?
  gender            String?
  phone             String?
  personalEmail     String?
  departmentId      String? // existing company Department table
  designationId     String? // HrOrgUnit(kind=designation)
  gradeId           String? // HrOrgUnit(kind=grade)
  locationId        String? // branch / restaurant — existing Location
  managerId         String? // reporting manager, another HrEmployee
  employmentType    String    @default("probation") // permanent | probation | contract | temporary | intern
  status            String    @default("active") // active | on_leave | resigned | terminated | separated
  joiningDate       DateTime?
  probationEnd      DateTime?
  confirmationDate  DateTime?
  contractEnd       DateTime?
  lastWorkingDay    DateTime?
  noticePeriodDays  Int?
  basicSalaryCents  Int       @default(0)
  grossSalaryCents  Int       @default(0)
  monthlyTaxCents   Int       @default(0) // until slab-based tax exists, HR sets it
  paymentMethod     String? // bank | cash | cheque
  bankName          String?
  iban              String?
  eobiNo            String?
  sessiNo           String?
  ntn               String?
  photoUrl          String?
  // Kiosk PIN for staff without a login (punches on the shared tablet).
  kioskPinHash      String?
  // Every other field from the Employee Master format (family, dependents,
  // addresses, emergency contact, …) lives here, keyed as the format defines.
  data              Json      @default("{}")
  createdById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  documents          HrDocument[]
  records            HrRecord[]
  payslips           HrPayslip[]
  // Tip pools this person is in without a servd login (kiosk / time-clock staff)
  tipPoolMemberships TipPoolMember[]
  // Till tickets this person waited (Order.waiterEmployeeId; till flow 2026-10-20)
  waitedOrders       Order[]          @relation("OrderWaiter")
  // Where this person works (owner, 2026-10-15): one or more of the company's Locations; the time clock checks a
  // punch against the nearest of them.
  workLocations      HrWorkLocation[]

  @@unique([tenantId, employeeCode])
  @@unique([tenantId, userId])
  @@index([tenantId, status])
  @@index([managerId])
  @@index([userId])
  @@map("hr_employees")
}

// Org setup lists that had no table: business units, sub-departments,
// designations, grades, cost centres. Departments and branches reuse the
// existing Department and Location tables.
model HrOrgUnit {
  id        String   @id @default(uuid())
  tenantId  String
  kind      String // business_unit | sub_department | designation | grade | cost_center
  name      String
  code      String?
  parentId  String?
  isActive  Boolean  @default(true)
  data      Json     @default("{}")
  createdAt DateTime @default(now())

  @@unique([tenantId, kind, name])
  @@index([tenantId, kind])
  @@map("hr_org_units")
}

model HrDocument {
  id           String    @id @default(uuid())
  tenantId     String
  employeeId   String
  docType      String // cnic_front | cnic_back | frc | photo | education | … (format-defined)
  title        String?
  fileUrl      String?
  issueDate    DateTime?
  expiryDate   DateTime? // drives document-expiry alerts
  verifiedById String?
  verifiedAt   DateTime?
  notes        String?
  createdAt    DateTime  @default(now())

  employee HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, expiryDate])
  @@index([employeeId])
  @@map("hr_documents")
}

// A section's format. Versioned: a new save is a new row, and every record
// remembers the version it was captured under, so changing a format never
// rewrites what an old record meant.
model HrFormDefinition {
  id          String   @id @default(uuid())
  tenantId    String
  section     String // e.g. "leave", "overtime", "offer"
  version     Int
  title       String
  fields      Json // HrField[] — see modules/hr/forms.ts
  workflow    Json     @default("[]") // approval steps: [{ key, label, role }]
  stages      Json     @default("[]") // pipeline stages, where the section has them
  isActive    Boolean  @default(true)
  note        String?
  updatedById String?
  createdAt   DateTime @default(now())

  @@unique([tenantId, section, version])
  @@index([tenantId, section, isActive])
  @@map("hr_form_definitions")
}

// One entry in any section — a leave application, an OT request, a candidate,
// a promotion. The format's fields are in `data`; the slots are what logic reads.
model HrRecord {
  id              String    @id @default(uuid())
  tenantId        String
  section         String
  formVersion     Int
  employeeId      String?
  // ── slots (a format binds fields to these) ──
  startDate       DateTime?
  endDate         DateTime?
  effectiveDate   DateTime?
  quantity        Float? // days, hours, installments — whatever the section counts
  amountCents     Int?
  refId           String? // a related record (the interview's candidate, the leave's leave type)
  category        String? // a classification logic reads: attendance status, paid/unpaid, adjustment type, outcome
  // ── lifecycle ──
  status          String    @default("draft") // draft | submitted | approved | rejected | cancelled
  stage           String? // pipeline position, for sections that have stages
  currentStep     Int       @default(0)
  approvals       Json      @default("[]") // [{ step, role, decision, byUserId, byName, at, note }]
  data            Json      @default("{}")
  // Effects applied to the employee on final approval (promotion, transfer…),
  // stamped so they are applied exactly once.
  appliedAt       DateTime?
  createdById     String?
  viaHeadOfficeId String? // D1/A3: the head office it was submitted through (stamped at submit; plain id, no FK)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  employee HrEmployee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([tenantId, section, status])
  @@index([employeeId, section])
  @@index([tenantId, section, startDate])
  @@index([tenantId, section, category])
  @@map("hr_records")
}

model HrPayrollRun {
  id                  String    @id @default(uuid())
  tenantId            String
  period              String // YYYY-MM
  // draft → finance_review (HR sent it) → finance_checked (finance passed it)
  // → approved (CEO / co-owner / management) → locked (owner, 2026-10-30).
  status              String    @default("draft") // draft | finance_review | finance_checked | approved | locked
  settings            Json // the rates in force when it was calculated
  totals              Json      @default("{}")
  createdById         String?
  // Everyone who recalculated it or edited a payslip on it. None of them may
  // approve it (the CEO excepted) — nor may the creator.
  preparedByIds       String[]  @default([])
  // Finance review (owner, 2026-10-30: "HR sends to finance, then CEO").
  sentToFinanceById   String?
  sentToFinanceAt     DateTime?
  financeCheckedById  String?
  financeCheckedAt    DateTime?
  financeNote         String? // finance's note when passing it on
  // The last return to HR (kept after HR sends it again, so the note stays visible).
  financeReturnNote   String?
  financeReturnedById String?
  financeReturnedAt   DateTime?
  approvedById        String?
  approvedAt          DateTime?
  lockedAt            DateTime?
  // Marked paid: the wages-payable clearance is posted then.
  paidAt              DateTime?
  viaHeadOfficeId     String? // D1/A3: the head office it was submitted through (stamped at submit; plain id, no FK)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  payslips HrPayslip[]

  @@unique([tenantId, period])
  @@map("hr_payroll_runs")
}

model HrPayslip {
  id                String   @id @default(uuid())
  runId             String
  tenantId          String
  employeeId        String
  // The month's inputs, prefilled from records and editable before approval.
  inputs            Json // { absentDays, lateCount, unpaidLeaveDays, otHours, … }
  lines             Json // [{ kind: earning|deduction|employer, code, label, amountCents }]
  grossCents        Int
  earningsCents     Int
  deductionsCents   Int
  eobiEmployeeCents Int
  eobiEmployerCents Int
  netCents          Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  run      HrPayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employee HrEmployee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([runId, employeeId])
  @@map("hr_payslips")
}

// HR letters — HTML with {{placeholders}}, filled from the employee and the
// record the letter is about. The HR team's letter formats go in here.
model HrLetterTemplate {
  id           String   @id @default(uuid())
  tenantId     String
  key          String // offer_letter | confirmation_letter | … | custom_<hex> (HR's own letter)
  title        String
  body         String // '' while a Word file is the letter
  // HR's own Word file (owner, 2026-10-22): when set it IS the letter — its
  // {{placeholders}} are filled for the chosen employee; print copy derived.
  wordFile     Bytes?
  wordFileName String?
  custom       Boolean  @default(false) // a letter HR added (not a built-in one)
  version      Int      @default(1)
  updatedById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, key])
  @@map("hr_letter_templates")
}

// ─── Waitlist (owner, 2026-10-07) ────────────────────────────────────────────
// "Tell me when servd opens a new brand." A general servd list, not one
// company's: tenantId is deliberately absent — the person signed up to servd,
// and the brand they'll hear about can be any company's. Each row points at
// the ONE customer master record (matched on the verified phone), carries the
// consent they gave, and where they came from. `list` leaves room for more
// lists later without a new table.
model WaitlistSignup {
  id             String    @id @default(uuid())
  list           String    @default("servd_new_brand")
  customerId     String
  source         String? // ?src= tag on the link: instagram, flyer, …
  area           String?
  interest       String? // "what would you like to see"
  consentText    String // the exact wording they ticked
  consentAt      DateTime
  verifiedAt     DateTime // WhatsApp code confirmed — no unverified rows
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([list, customerId])
  @@index([list, createdAt])
  @@map("waitlist_signups")
}

// Anonymous visits to the waitlist page, for conversion by source. No name,
// phone, email or IP is stored — only where the click came from.
model WaitlistVisit {
  id        String   @id @default(uuid())
  list      String   @default("servd_new_brand")
  source    String?
  device    String? // mobile | tablet | desktop
  country   String? // from the CDN country header, if present
  createdAt DateTime @default(now())

  @@index([list, createdAt])
  @@map("waitlist_visits")
}

// ─── POS connector (2026-10-10, owner decision) ──────────────────────────────
// servd talks to an external fiscal POS (FBR / SRB filing — the ONLY filer) and
// to the payment processor's card machine through vendor-neutral drivers
// (backend/src/connectors). Spec: docs/pos-connector-api.md.

enum ConnectorKind {
  fiscal // external fiscal POS that files FBR / SRB
  terminal // payment processor's card machine
  raast // Raast QR bank alerts: bank-SMS matching now, a bank / aggregator API later ('enabled' = SMS matching ON)
}

// ─── Raast QR (2026-10-12) ───────────────────────────────────────────────────
// A Raast tender records a RaastReceipt: the sale completes at the till like
// card; the receipt is 'provisional' until a bank-statement line matches it
// (the statement is the truth that closes the books). Bank SMS alerts from the
// counter phone (BankSmsDevice) only confirm or settle — never guess.

enum RaastReceiptStatus {
  awaiting // an intent: the customer is paying, waiting for the bank SMS (SMS matching ON)
  provisional // paid at the till (reference typed or SMS-confirmed); not yet on a bank statement
  matched // matched to a bank-statement line
  cancelled // intent cancelled or expired before payment
  unreceived // finance wrote it off: never arrived in the bank
  needs_attention // an SMS or a settle could not complete it cleanly — a person decides
  voided // the CEO voided a provisional receipt whose sale was never booked (RV-MONEY-1); no ledger entry; bankRef stays claimed
}

enum RaastConfirmedVia {
  cashier // the cashier typed the bank reference after checking the counter device
  sms // a bank SMS forwarded by the counter phone
  bank_api // a future bank / aggregator callback
}

enum BankSmsAlertStatus {
  received
  processing
  unparsed
  off // parsed while SMS matching is OFF — kept so IT can check templates; never matched
  debit
  duplicate
  matched // settled an awaiting intent
  confirmed // confirmed a receipt the cashier had already recorded
  unmatched
  ambiguous
  needs_attention
  attached // a cashier attached it to a bill by hand
  dismissed // a manager marked it 'not a sale'
}

enum FiscalDocKind {
  sale
  refund
}

enum FiscalDocStatus {
  held // connector off / not live / brand+outlet not registered — visible backlog, never auto-sent
  waiting // refund waiting for its sale document to be filed
  pending // due at nextAttemptAt
  submitting // leased by one sender (leaseUntil)
  filed // fiscal number back
  rejected // permanent vendor validation error — needs a fix + manual retry
  failed // retries exhausted — manual retry only
  skipped // AUTOMATIC ONLY: prefiled_direct | zero_value | zero_value_unsupported | no_sale_document — never an operator choice
  manual_required // e.g. refund of a sale filed directly with SRB/FBR before cutover
  manual_filed // operator recorded an out-of-band fiscal number
}

enum TerminalChargeKind {
  charge
  refund
}

enum TerminalChargeStatus {
  pending // row created, driver not yet accepted (or start was transient)
  sent // driver accepted; waiting for the card
  approved // vendor approved; Payment not yet recorded
  recorded // Payment (or refund Payment) written — success, final
  declined // final, no money
  cancel_requested // cancel sent, outcome not yet known
  cancelled // final, no money
  expired // vendor confirmed nothing charged after timeout; final
  unknown // outcome not known — blocks the order
  unverified // cashier said "not charged"; order released; reconciler still verifies 24h
  void_pending // approved but servd refused the payment — auto-reversal in progress
  voided // money given back; final
  needs_attention // reversal failed, or unknown > 24h — manager alert; human action
  manual_resolved // cashier recorded it from the machine slip; reconciler verifies
}

/// One per company per kind (per-company singleton rule). Secrets stored only as secretBox ciphertext.
model PosConnector {
  id                String        @id @default(cuid())
  tenantId          String
  kind              ConnectorKind
  driver            String        @default("none") // 'none' | 'test' | 'http' | later '<vendor>'
  enabled           Boolean       @default(false) // fiscal: live (set ONLY by go-live); terminal: shown at the till
  liveSince         DateTime? // fiscal: first go-live
  baseUrl           String?
  apiKeyEnc         String?
  apiKeyHint        String?
  webhookSecretEnc  String?
  webhookSecretHint String?
  webhookToken      String        @unique // random 32-byte hex; selects the company for inbound webhooks; rotatable
  settings          Json          @default("{}")
  lastTestAt        DateTime?
  lastTestOk        Boolean?
  lastTestDetail    String?
  lastOkAt          DateTime?
  lastError         String?
  lastErrorAt       DateTime?
  updatedById       String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  tenant     Tenant           @relation("TenantPosConnectors", fields: [tenantId], references: [id])
  charges    TerminalCharge[]
  smsDevices BankSmsDevice[] // kind 'raast' only

  @@unique([tenantId, kind])
  @@index([tenantId])
  @@map("pos_connectors")
}

/// The fiscal outbox: one row per sale (created ONLY at the full & final bill, i.e. completeOrder), one per refund. id doubles as the vendor idempotency key.
model FiscalDocument {
  id              String          @id @default(cuid())
  tenantId        String
  kind            FiscalDocKind
  orderId         String
  conceptId       String
  locationId      String?
  idempotencyKey  String // 'sale:<orderId>' | 'refund:<refundPaymentId>' | 'void:<orderId>'
  saleDocumentId  String?
  refundPaymentId String?
  status          FiscalDocStatus @default(pending)
  statusReason    String?
  driver          String?
  payload         Json
  payloadHash     String
  amountCents     Int
  attempts        Int             @default(0)
  nextAttemptAt   DateTime        @default(now())
  leaseUntil      DateTime?
  leaseOwner      String?
  lastErrorCode   String?
  lastError       String?
  fiscalNumber    String?
  authority       String? // 'fbr' | 'srb' | 'pra' | 'kpra' | 'bra'
  qrPayload       String?
  verifyUrl       String?
  extraNumbers    Json?
  providerRef     String?
  fiscalAt        DateTime?
  filedAt         DateTime?
  isTest          Boolean         @default(false) // filed by the 'test' driver — never a real fiscal invoice
  alertedAt       DateTime?
  resolvedById    String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  tenant      Tenant          @relation("TenantFiscalDocuments", fields: [tenantId], references: [id])
  order       Order           @relation(fields: [orderId], references: [id])
  attemptsLog FiscalAttempt[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, nextAttemptAt])
  @@index([status, nextAttemptAt])
  @@index([status, leaseUntil])
  @@index([orderId])
  @@index([saleDocumentId])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, fiscalNumber])
  @@map("fiscal_documents")
}

/// Append-only attempt log.
model FiscalAttempt {
  id         String   @id @default(cuid())
  tenantId   String
  documentId String
  attemptNo  Int
  op         String // 'submit' | 'lookup'
  outcome    String // 'filed' | 'processing' | 'rejected' | 'transient' | 'unknown' | 'not_found'
  httpStatus Int?
  errorCode  String?
  message    String?
  durationMs Int
  via        String // 'sync_till' | 'worker' | 'sweeper' | 'manual_retry' | 'webhook'
  createdAt  DateTime @default(now())

  document FiscalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([documentId])
  @@map("fiscal_attempts")
}

/// One per push to the card machine (charge or refund).
model TerminalCharge {
  id               String               @id @default(cuid())
  tenantId         String
  kind             TerminalChargeKind   @default(charge)
  connectorId      String
  terminalId       String
  orderId          String
  shiftId          String?
  targetPaymentId  String?
  paymentId        String?              @unique
  originalChargeId String?
  amountCents      Int
  tipCents         Int                  @default(0)
  quoteDueCents    Int
  idempotencyKey   String
  status           TerminalChargeStatus @default(pending)
  providerRef      String?
  approvalRef      String?
  authCode         String?
  cardBrand        String?
  cardLast4        String? // masked only; never a PAN
  message          String?
  refusalCode      String?
  manualReason     String?
  vendorMeta       Json?
  reverseAttempts  Int                  @default(0)
  nextActionAt     DateTime?
  expiresAt        DateTime
  lastPolledAt     DateTime?
  pollLeaseUntil   DateTime?
  resolvedAt       DateTime?
  alertedAt        DateTime?
  createdById      String
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  tenant    Tenant       @relation("TenantTerminalCharges", fields: [tenantId], references: [id])
  connector PosConnector @relation(fields: [connectorId], references: [id])
  order     Order        @relation(fields: [orderId], references: [id])

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, updatedAt])
  @@index([status, nextActionAt])
  @@index([orderId])
  @@index([shiftId, status])
  @@index([connectorId, providerRef])
  @@map("terminal_charges")
}

// ─── Pre-bills (2026-10-10, owner decision) ───────────────────────────────────
// A pre-bill is the bill printed for an open order before payment. It is NEVER
// a fiscal document and never goes to the POS: only the full & final bill
// (completeOrder) files. Every pre-bill is a permanent record listed in
// Finance -> Voided pre bills (never deleted or hidden).

enum PreBillStatus {
  open // latest pre-bill of an order that is not final yet
  superseded // a later pre-bill was printed for the same order
  converted // the order reached its full & final bill
  cancelled // the order was cancelled / voided / rejected before the final bill
}

model PreBill {
  id                 String        @id @default(cuid())
  tenantId           String
  conceptId          String
  locationId         String?
  orderId            String
  shiftId            String?
  number             Int // per company, gap-free (PreBillCounter)
  tableLabel         String?
  printedById        String
  printedAt          DateTime      @default(now())
  tender             String // quote basis of the headline total: 'cash' | 'card'
  lines              Json
  subtotalCents      Int
  discountCents      Int
  serviceChargeCents Int
  taxCents           Int
  totalCents         Int
  cardTotalCents     Int?
  status             PreBillStatus @default(open)
  statusAt           DateTime?
  finalTotalCents    Int?
  finalAt            DateTime?
  cancelledById      String? // the MANAGER who approved the cancel/void of the order
  cancelReason       String?
  createdAt          DateTime      @default(now())

  tenant Tenant @relation("TenantPreBills", fields: [tenantId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id])

  @@unique([tenantId, number])
  @@index([tenantId, printedAt(sort: Desc)])
  @@index([tenantId, status])
  @@index([orderId])
  @@map("pre_bills")
}

/// Per-company pre-bill number sequence (one row per company, locked FOR UPDATE when issuing).
model PreBillCounter {
  tenantId String @id
  next     Int    @default(1)

  @@map("pre_bill_counters")
}

/// One row per Raast tender (an intent while the customer pays, or a direct
/// cashier-recorded payment). Company = the order's brand's company.
/// 'provisional' until a bank-statement line matches it ('matched').
model RaastReceipt {
  id                String             @id @default(cuid())
  tenantId          String
  orderId           String
  conceptId         String
  shiftId           String?
  targetPaymentId   String? // a pending check-split portion this receipt settles
  paymentId         String?            @unique // null while awaiting / cancelled / needs_attention
  bankAccountId     String
  ledgerCode        String // snapshot of BankAccount.accountCode when recorded — the ledger debits this
  // Per-ticket money (the bill share + tip the customer transfers): INT4 like Payment.amountCents.
  amountCents       Int
  tipCents          Int                @default(0)
  dueCents          Int // the bill due when created
  bankRef           String? // normalised (connectors/raast/reference.ts); required from 'provisional' on
  bankRefRaw        String?
  status            RaastReceiptStatus @default(awaiting)
  confirmedVia      RaastConfirmedVia?
  confirmedAt       DateTime?
  confirmedById     String?
  cashierVerified   Boolean            @default(false) // the cashier ticked "I saw it arrive on the counter device"
  smsAlertId        String?            @unique
  smsConfirmedAt    DateTime?
  // An SMS settling this intent holds a short lease so the alert's own
  // finishing write and a racing cashier confirm never overwrite each other.
  settlingUntil     DateTime?
  statementLineId   String?            @unique
  matchedAt         DateTime?
  matchedById       String? // null = matched automatically
  expiresAt         DateTime? // awaiting only
  cancelReason      String?
  attentionReason   String?
  flaggedAt         DateTime?
  writeOffEntryId   String?
  idempotencyKey    String
  createdById       String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  // CEO void of a receipt whose sale was never booked (RV-MONEY-1, wave B; owner: CEO ONLY): finance may request,
  // only the CEO voids. No ledger entry; bankRef stays claimed. After a void, refund-due, the Z-report and hand-back
  // exclude it.
  voidRequestedAt   DateTime?
  voidRequestedById String?
  voidRequestReason String?
  voidedAt          DateTime?
  voidedById        String?
  voidReason        String?

  tenant        Tenant             @relation("TenantRaastReceipts", fields: [tenantId], references: [id])
  order         Order              @relation(fields: [orderId], references: [id])
  payment       Payment?           @relation(fields: [paymentId], references: [id])
  bankAccount   BankAccount        @relation(fields: [bankAccountId], references: [id])
  smsAlert      BankSmsAlert?      @relation(fields: [smsAlertId], references: [id], onDelete: SetNull)
  statementLine BankStatementLine? @relation(fields: [statementLineId], references: [id], onDelete: Restrict)

  // The same transfer can't pay two bills — per company. (One awaiting
  // intent per order is a partial unique index in SQL, migration 20261013090100.)
  @@unique([tenantId, bankRef])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, bankAccountId, status, amountCents])
  @@index([orderId])
  @@index([shiftId, status])
  @@map("raast_receipts")
}

/// A counter phone that forwards bank SMS alerts (one company). The bearer
/// token is stored as a SHA-256 lookup hash + secretBox ciphertext.
model BankSmsDevice {
  id             String    @id @default(cuid())
  tenantId       String
  connectorId    String // the company's raast PosConnector
  locationId     String? // the company's own location (optional)
  label          String
  // A credential, globally unique like PosConnector.webhookToken (not per company).
  tokenHash      String    @unique
  tokenEnc       String
  tokenHint      String
  // The forwarder may post the token in the URL path (forwarders without
  // custom headers). Off by default: a path token lands in request logs.
  allowPathToken Boolean   @default(false)
  active         Boolean   @default(true)
  lastSeenAt     DateTime?
  lastSmsAt      DateTime?
  ignoredCount   Int       @default(0)
  lastIgnoredAt  DateTime?
  rotatedAt      DateTime?
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant    Tenant         @relation("TenantBankSmsDevices", fields: [tenantId], references: [id])
  connector PosConnector   @relation(fields: [connectorId], references: [id])
  alerts    BankSmsAlert[]

  @@index([tenantId])
  @@map("bank_sms_devices")
}

/// One bank SMS from a counter phone (only listed bank senders are stored;
/// OTPs and other SMS are never stored).
model BankSmsAlert {
  id            String             @id @default(cuid())
  tenantId      String
  deviceId      String
  locationId    String?
  sender        String // normalised
  bodyHash      String
  body          String? // null after retention
  receivedAt    DateTime
  templateId    String?
  kind          String? // 'credit' | 'debit'
  // A bank credit can be any size (like BankStatementLine.amountCents): BIGINT.
  amountCents   BigInt?
  bankRef       String?
  occurredAt    DateTime?
  payer         String?
  accountLast4  String?
  bankAccountId String?
  status        BankSmsAlertStatus @default(received)
  candidateIds  String[]           @default([])
  attempts      Int                @default(0)
  processedAt   DateTime?
  resolvedById  String?
  resolvedAt    DateTime?
  resolution    String?
  // A reference a manager dismissed as 'not a sale' (or a debit's reference)
  // is claimed here so the same transfer can never also be booked as a sale.
  claimedRef    String?
  alertedAt     DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  tenant  Tenant        @relation("TenantBankSmsAlerts", fields: [tenantId], references: [id])
  device  BankSmsDevice @relation(fields: [deviceId], references: [id])
  receipt RaastReceipt?

  @@unique([tenantId, bodyHash])
  @@unique([tenantId, claimedRef])
  @@index([tenantId, status, receivedAt])
  @@index([tenantId, bankRef])
  @@index([status, createdAt])
  @@map("bank_sms_alerts")
}

// ─── Cash vouchers (owner, 2026-10-13) ───────────────────────────────────────
// GS Foods' internal cash payment voucher. The HOD prepares and signs it, the
// director (CEO) signs it, it is printed, the cashier (the cash box's
// custodian) signs the paper and pays the cash, and a photo of the signed
// paper is uploaded. Only that upload puts it in cash: it then becomes ONE
// petty-cash spend on its box (PettyCashMovement). Generating, signing or
// printing a voucher never touches cash.
//
// CASH REQUESTS (wave B, owner 2026-10-13 — replaces the voucher flow; the
// table cash_vouchers is kept and IS the cash request): anyone who needs cash
// RAISES a request → HOD signs → director (CEO) approves → the box custodian
// (Jamil sb) pays and marks it paid (NO photo needed) as an ADVANCE (Dr 1355 /
// Cr 1011) → the holder uploads receipt(s) (CashVoucherSettlement) which book
// the expense. Receipts are due by dueBy; the daily worker converts the
// unsettled rest to an HR staff loan or the director's current account (H3).

enum CashVoucherStatus {
  draft // raised; waiting for the HOD
  hod_signed // waiting for the director
  approved // the custodian (Jamil sb) pays
  disbursed // paid as an ADVANCE (Dr 1355 / Cr 1011); receipts due by dueBy (legacy: signed photo uploaded)
  rejected // the director refused it (with a note)
  cancelled // withdrawn before payment
  settled // receipts + change returned cover the amount
  converted // the unsettled rest moved to the director's current account (1356) or an HR staff loan (1350)
  submitted // (2026-10-15 flow) raised; waiting for FINANCE approval
  finance_approved // finance approved; waiting for the CEO's final approval (legacy hod_signed rows also wait for the CEO)
  returned // finance or the CEO sent it back for correction (with a note); the raiser edits and resubmits
  posted // paid, supporting documents verified by finance, expense booked out of 1357
}

/// Who raised a cash_vouchers row (2026-10-15, owner): 'request' = any staff login asks for cash for themselves (the
/// voucher is created automatically); 'expense' = finance raises a voucher for an outside payee (vendor). Both follow
/// ONE flow: finance approves → CEO final approval → cashier pays (Dr 1357 / Cr 1011) → supporting documents →
/// finance verifies → the expense is booked (Dr 6xxx / Cr 1357).
enum CashVoucherKind {
  request
  expense
}

model CashVoucher {
  id                  String            @id @default(cuid())
  tenantId            String
  seq                 Int // per company, from 1
  number              String // "CV-00001"
  voucherDate         DateTime
  payeeName           String // who receives the cash
  payeeUserId         String?
  purpose             String
  category            String? // expense category (the petty-cash spend's category)
  conceptId           String? // brand / cost centre (the company's own)
  department          String?
  // Paid out of a petty-cash box (INT4 like PettyCashMovement), so INT4.
  amountCents         Int
  // The cash box it is paid from — its custodian is the cashier. Nullable since wave B: the custodian or a keeper
  // picks it at pay.
  boxId               String?
  status              CashVoucherStatus @default(draft)
  preparedById        String
  hodSignedById       String?
  hodSignedAt         DateTime?
  directorSignedById  String?
  directorSignedAt    DateTime?
  rejectedById        String?
  rejectedAt          DateTime?
  rejectNote          String?
  cancelledById       String?
  cancelledAt         DateTime?
  cancelNote          String?
  disbursedById       String? // who uploaded the signed photo
  disbursedAt         DateTime?
  cashierName         String? // the box custodian's name when it was paid
  pettyCashMovementId String?           @unique // the spend it became
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  // ── Cash requests (wave B, 2026-10-14) ──
  // payeeUserId (above) = the HOLDER (who must bring receipts). New requests: default the raiser. Legacy rows are
  // NOT backfilled (the old preparedById was the HOD): a disbursed row with no holder is 'needs review' — keepers
  // only, never flagged or converted until finance names the holder.
  // Counters are INT4 like amountCents; CHECK cash_vouchers_counters_chk (settled + returned + converted ≤ amount)
  // is SQL only (migration 20261014090000).
  dueBy            DateTime? // receipts due = disbursedAt + OperationsConfig.cashAdvanceSettleDays
  settledCents     Int       @default(0) // receipts booked (Σ settlements)
  returnedCents    Int       @default(0) // change handed back to a box
  convertedCents   Int       @default(0) // moved to a staff loan or the director's account
  settledAt        DateTime?
  overdueFlaggedAt DateTime?
  convertedTo      String? // 'staff_loan' | 'director_account'
  convertedAt      DateTime?
  convertedById    String? // a user id, or 'system' (the daily worker, H3 default)
  conversionNote   String?
  hrLoanRecordId   String?

  // ── Petty-cash expense vouchers (2026-10-15, owner) ──
  // amountCents stays the amount PAID (the total). grossCents = the amount before discount; amountCents = gross −
  // discount (CHECK cash_vouchers_discount_chk, SQL only). A request carries discount 0 and no gross.
  kind                      CashVoucherKind @default(request)
  grossCents                Int?
  discountCents             Int             @default(0)
  submittedById             String?
  submittedAt               DateTime?
  financeApprovedById       String?
  financeApprovedAt         DateTime?
  // true = paid under the 2026-10-15 documents flow (pay held on 1357, expense booked when finance verifies the
  // documents — unless bookedAtPay, below);
  // false = a legacy request paid under H3 (expensed at pay; its old settlement rules still apply).
  expenseOnVerify           Boolean         @default(false)
  returnedById              String?
  returnedAt                DateTime?
  returnNote                String?
  returnCount               Int             @default(0)
  docsVerifiedById          String?
  docsVerifiedAt            DateTime?
  postedAt                  DateTime?
  postedById                String?
  postedJournalEntryId      String?         @unique // the Dr 6xxx / Cr 1357 entry (reference cashvoucher.post:<id>) — posts once
  // Digital receipt (owner, 2026-10-15: "no physical signatures"): the holder confirms "Cash received" (a request), or
  // the payer's pay records it for an outside payee (kind expense). Required before finance verifies a request.
  cashReceivedById          String?
  cashReceivedAt            DateTime?
  // Where the cash came from (owner, 2026-10-16: "pay from petty cash / cash on hand and bank accounts"):
  // 'box' (default, every row before: a petty-cash box, Dr 1357 / Cr 1011 via its movement) | 'cash_on_hand'
  // (Dr 1357 / Cr 1010) | 'bank' (Dr 1357 / Cr the named bank's code). The last two post ONE entry
  // 'cashvoucher.pay:<id>' (payJournalEntryId), no box movement; change / an overspend at verification go back to
  // / come from the SAME account (payAccountCode). CHECK cash_vouchers_pay_source_chk is SQL only.
  paySource                 String          @default("box")
  payAccountCode            String?
  payBankAccountId          String?
  payJournalEntryId         String?         @unique
  // ONE entry at pay (owner, 2026-10-16: "It should pass only one entry when booked by finance, either docs are
  // attached or not"): true = finance's pay booked the expense — Dr the voucher's account / Cr 1011 (the box's spend,
  // one expense line) | 1010 | the bank ('cashvoucher.pay:<id>'). Nothing is held on 1357; supporting documents and
  // finance's check (POST /:id/verify-docs → posted) book NOTHING; change / an overspend is a manual journal.
  // expenseOnVerify stays true on these rows (the documents flow and its CLOSED state). false = every row paid
  // before this (a 1357 hold still clears at verification; legacy H3 unchanged).
  bookedAtPay               Boolean         @default(false)
  // Equipment on a finance payee voucher (owner, 2026-10-19; kind 'expense' only): the fixed-asset class (a
  // FixedAssetClass of the voucher's company) instead of an expense account (`category` null). Finance's pay books
  // it through the CapEx Quick-buy engine (financePlanning/capexPosting.ts recordEquipmentPurchaseTx): a capital line
  // on the outlet's standing project, its payment Dr 1340 / Cr the source, and the capitalisation request the CEO
  // approves (Dr class cost / Cr 1340 → register → depreciation). assetLocationId = the outlet (required when the
  // voucher has no brand: shared equipment). capexLineId / capitaliseEventId are stamped at pay. Plain ids, no
  // relations (like pettyCashMovementId).
  assetClassId              String?
  assetLocationId           String?
  capexLineId               String?         @unique
  capitaliseEventId         String?
  // "To pay from" on a finance payee voucher (owner, 2026-10-19): chosen at raise — 'cash' | 'bank' (+
  // plannedBankAccountId) | 'credit' (+ supplierId, a supplier of the voucher's company). Cash / bank prefill finance's
  // pay; credit = no cash leaves: finance's pay books a SUPPLIER BILL (procurement createBill's engine, bill number =
  // the voucher number) — or, for equipment, the CapEx line on that supplier with its capitalisation request
  // (Dr class cost / Cr 2012 on the CEO's approval) — and paySource becomes 'credit'. supplierBillId = the bill.
  // CHECK cash_vouchers_planned_pay_chk (SQL only, migration 20261019110000).
  plannedPaySource          String?
  plannedBankAccountId      String?
  supplierId                String?
  supplierBillId            String?         @unique
  // Internal payment classification chosen when the voucher is raised (owner, 2026-10-20): finance / the CEO only;
  // prefills the pay step, where it is stamped on the payment entry (accounting/paymentsRegister.ts). A label only.
  // CHECK cash_vouchers_planned_classification_chk (SQL only, migration 20261020130000).
  plannedClassification     String?
  plannedTaxStatus          String?
  plannedNonDeductionReason String?

  tenant      Tenant                  @relation("TenantCashVouchers", fields: [tenantId], references: [id])
  // onDelete Restrict kept from the original required relation (a box with requests is never hard-deleted).
  box         PettyCashBox?           @relation(fields: [boxId], references: [id], onDelete: Restrict)
  attachments CashVoucherAttachment[]
  settlements CashVoucherSettlement[]

  @@unique([tenantId, seq])
  @@unique([tenantId, hrLoanRecordId])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, status, dueBy])
  @@index([tenantId, kind, status])
  @@map("cash_vouchers")
}

/// THE store for petty-cash paper (wave B): the photo of a signed paper voucher (legacy), or a receipt attached to a
/// cash request's settlement, a direct box spend (movementId) or a box (boxId; company = the box's). Stored in the
/// database (file storage is not configured on every server); the admin compresses it first. Bytes are NEVER
/// selected in lists. CHECK cash_voucher_attachments_owner_chk (voucherId, boxId, movementId or depositDropId set) is SQL only.
// THE private record-file store (owner decision 2026-10-16: "One private store … so any record can carry files —
// only staff of that company can open them, View + Download. One store across servd, no new copies"). Bytes live
// in the DB, RLS by tenantId. Besides the cash-voucher / petty-cash / deposit-drop owners below, ANY record can own
// files through (ownerType, ownerId), kind 'record_file' — lib/recordFiles.ts is the one writer / reader and holds a
// provider per ownerType (its module's own access rule and company). Never a URL field for a supporting document.
model CashVoucherAttachment {
  id            String   @id @default(cuid())
  tenantId      String
  voucherId     String? // WAS required (before wave B)
  kind          String   @default("signed_voucher") // 'signed_voucher' (legacy paper photo) | 'receipt' | 'supporting' (expense voucher document)
  mime          String // image/jpeg | image/png | image/webp (receipts may also be application/pdf, lib/evidenceFile.ts); 'supporting' also takes Excel / Word / CSV / text
  fileName      String? // the uploaded file's name (supporting documents), shown and used on download
  sizeBytes     Int
  data          Bytes
  uploadedById  String
  createdAt     DateTime @default(now())
  settlementId  String?
  movementId    String?
  boxId         String? // a direct box-spend receipt (company = the box's)
  depositDropId String? // kind 'deposit_slip': the bank deposit slip of a deposit drop (company = the drop's)
  ownerType     String? // kind 'record_file': the provider key in lib/recordFiles.ts (opex_payment, supplier_bill, …)
  ownerId       String? // kind 'record_file': the owning record's id (no FK — the provider resolves it; company = the record's)

  tenant      Tenant                 @relation("TenantCashVoucherAttachments", fields: [tenantId], references: [id])
  voucher     CashVoucher?           @relation(fields: [voucherId], references: [id], onDelete: Restrict) // Restrict kept from the original required relation
  settlement  CashVoucherSettlement? @relation(fields: [settlementId], references: [id])
  movement    PettyCashMovement?     @relation(fields: [movementId], references: [id])
  depositDrop DepositDrop?           @relation(fields: [depositDropId], references: [id], onDelete: Restrict)

  @@index([voucherId])
  @@index([tenantId])
  @@index([settlementId])
  @@index([movementId])
  @@index([boxId])
  @@index([depositDropId])
  @@index([tenantId, ownerType, ownerId])
  @@map("cash_voucher_attachments")
}

// One batch of receipts the holder of a cash request brought back (wave B). Each books its lines' expense / stock /
// capex against 1355 (the advance). INT4: ≤ the request amount.
model CashVoucherSettlement {
  id            String   @id @default(cuid())
  tenantId      String
  voucherId     String
  seq           Int // 1.. per request
  totalCents    Int // INT4, ≤ the request amount
  note          String?
  submittedById String
  createdAt     DateTime @default(now())

  tenant      Tenant                  @relation("TenantCashVoucherSettlements", fields: [tenantId], references: [id])
  voucher     CashVoucher             @relation(fields: [voucherId], references: [id])
  lines       PettyCashSpendLine[]
  attachments CashVoucherAttachment[]

  @@unique([tenantId, voucherId, seq])
  @@index([tenantId, createdAt])
  @@map("cash_voucher_settlements")
}

// What a box spend or a request's receipts bought (wave B). Exactly one owner (movementId or settlementId): CHECK
// petty_cash_spend_lines_owner_chk, plus petty_cash_spend_lines_amount_chk / petty_cash_spend_lines_kind_chk /
// petty_cash_spend_lines_stock_chk / petty_cash_spend_lines_capex_chk — all SQL only (migration 20261014090000).
// INT4 per line (≤ the box spend / request).
model PettyCashSpendLine {
  id              String   @id @default(cuid())
  tenantId        String
  movementId      String? // a direct box spend
  settlementId    String? // a cash request's receipts
  kind            String // 'expense' | 'stock' | 'capex'
  categoryKey     String? // PAYOUT_CATEGORIES key (expense)
  // debit: 6xxx (expense; 5010-5030 only on a history-backfill pick of a pre-FIFO spend), 1210/1220/1230 by class
  // (stock), 1340 (capex)
  accountCode     String
  amountCents     Int
  conceptId       String?
  description     String
  inventoryItemId String? // stock
  quantity        Float? // stock
  unit            String? // stock: must convert to the item's purchase unit (422 UNIT_MISMATCH)
  locationId      String? // outlet tag — must be a Location of the line's company (422 LOCATION_NOT_IN_COMPANY)
  receiptLineId   String? // stock: the GoodsReceiptLine of the settled receipt (decision P6)
  capexLineId     String? // capex: the CapEx line (same company)
  capexPaymentId  String? // capex: the CapexPayment this line created (one-time guard, per company)
  createdAt       DateTime @default(now())

  tenant     Tenant                 @relation("TenantPettyCashSpendLines", fields: [tenantId], references: [id])
  movement   PettyCashMovement?     @relation(fields: [movementId], references: [id])
  settlement CashVoucherSettlement? @relation(fields: [settlementId], references: [id])

  @@unique([tenantId, capexPaymentId])
  @@index([tenantId, createdAt])
  @@index([movementId])
  @@index([settlementId])
  @@map("petty_cash_spend_lines")
}

// ═════════════════════════════════════════════════════════════════════════════
// Head office (D1) and HOD approvals with hand-over (D3) — migration 20261015120000_head_office.
// Spec: .handoff/fixes/D1D3-spec.md as amended (D1D3-amendments.json). Additive and OFF until the CEO creates a head
// office: no row here exists on live until then. Head-office ↔ company money moves through the EXISTING inter-company
// engine (IntercompanyTransfer source 'ho_recharge', pair accounts 1450–1499 / 2150–2199) — there are no head-office
// due-to / due-from columns. CHECK constraints and partial unique indexes named on each model are SQL only (the
// migration's SQL-only section; tests/setup.ts applies them after db push) and are never re-declared here.
// BOOKS-06: every money column below is BIGINT paisa (lib/money.ts returns them as JS numbers).
// ═════════════════════════════════════════════════════════════════════════════

// What a Tenant row is (owner decision D1, 2026-10-11).
enum TenantKind {
  company // a trading company: brands, orders, the till
  head_office // shared-services unit with its own HR, payroll and books; serves companies via HeadOfficeLink and
  // recharges them monthly. Never has brands.
}

// One row per (head office, company) LIVE at a time. CEO-only. Ending a link stamps endedAt; re-linking later creates
// a new row. SQL only: partial unique head_office_links_one_live ON (tenantId, companyTenantId) WHERE endedAt IS NULL
// (like the tip-pool member indexes — do not re-declare); CHECKs head_office_links_parties_chk (tenantId <>
// companyTenantId) and head_office_links_period_chk (lastChargedPeriod 'YYYY-MM' or NULL). RLS: either side reads.
model HeadOfficeLink {
  id                String    @id @default(uuid())
  tenantId          String // the head office (kind head_office); owner of the row
  companyTenantId   String // the served company (kind company)
  chargesAccountId  String? // company chart: "Head office charges — <HO>" (expense; may be shared by a company's links)
  startedAt         DateTime  @default(now())
  endedAt           DateTime? // reach and delegation cover stop at once; balances and history stay
  lastChargedPeriod String? // 'YYYY-MM', set when ended
  createdById       String
  endedById         String?
  endReason         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  headOffice Tenant            @relation("HoLinkHeadOffice", fields: [tenantId], references: [id], onDelete: Restrict)
  company    Tenant            @relation("HoLinkCompany", fields: [companyTenantId], references: [id], onDelete: Restrict)
  charges    Account?          @relation("HoLinkCharges", fields: [chargesAccountId], references: [id], onDelete: Restrict)
  runLines   RechargeRunLine[]

  @@index([tenantId, endedAt])
  @@index([companyTenantId, endedAt])
  @@map("head_office_links")
}

// One per head office: its recharge account, cost pool, CA confirmation, switch and setup-wizard marker.
// SQL only: CHECKs head_office_books_enable_chk (NOT rechargeEnabled OR (accountsConfirmedAt AND rechargeFromPeriod))
// and head_office_books_period_chk.
model HeadOfficeBooks {
  tenantId              String    @id // the head office
  rechargeAccountId     String? // HO chart; default 4220 Head Office Recharge Income (HO-Q3, 2026-10-26; was 6990); the CA may re-map
  costPool              Json      @default("{\"include\":[{\"from\":6030,\"to\":6036}],\"includeCodes\":[],\"excludeCodes\":[]}") // salaries only (owner, 2026-10-30)
  accountsConfirmedAt   DateTime? // NULL = "Confirm with your CA". Cleared by ANY change to accounts, pool or links
  accountsConfirmedById String?
  accountsConfirmedNote String? // the CEO's note
  taxAnswer             String? // the CA's tax answer (spec §4.10), recorded before recharge can be switched on
  rechargeEnabled       Boolean   @default(false)
  rechargeFromPeriod    String? // 'YYYY-MM' = the CA's cutover month
  requireLockedPayroll  Boolean   @default(true)
  setupAppliedAt        DateTime? // the setup wizard ran (a second apply → 409 SETUP_ALREADY_DONE)
  setupAppliedById      String?
  setupSummary          Json?
  updatedById           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tenant          Tenant   @relation("HoBooks", fields: [tenantId], references: [id], onDelete: Restrict)
  rechargeAccount Account? @relation("HoRechargeAccount", fields: [rechargeAccountId], references: [id], onDelete: Restrict)

  @@map("head_office_books")
}

// The CEO's % table, versioned by effective month (version for month M = latest effectiveFrom <= M). Each version is
// written whole; "total <= 100%" is checked in code. SQL only: CHECK recharge_splits_period_chk.
model RechargeSplit {
  id            String   @id @default(uuid())
  tenantId      String // head office
  effectiveFrom String // 'YYYY-MM'
  note          String?
  createdById   String
  createdAt     DateTime @default(now())

  tenant Tenant              @relation("HoRechargeSplits", fields: [tenantId], references: [id], onDelete: Restrict)
  lines  RechargeSplitLine[]
  runs   RechargeRun[]

  @@unique([tenantId, effectiveFrom])
  @@map("recharge_splits")
}

// SQL only: CHECK recharge_split_lines_bps_chk (shareBps BETWEEN 1 AND 10000).
model RechargeSplitLine {
  id              String @id @default(uuid())
  splitId         String
  tenantId        String // head office (denormalised for scoping)
  companyTenantId String
  shareBps        Int // 1..10000; sum per split <= 10000 (code)

  split      RechargeSplit @relation(fields: [splitId], references: [id], onDelete: Cascade)
  company    Tenant        @relation("SplitLineCompany", fields: [companyTenantId], references: [id], onDelete: Restrict)
  headOffice Tenant        @relation("SplitLineHeadOffice", fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([splitId, companyTenantId])
  @@index([companyTenantId])
  @@index([tenantId])
  @@map("recharge_split_lines")
}

// The head-office module's own pending record for a month's recharge (or its true-up). SQL only: CHECKs
// recharge_runs_period_chk / recharge_runs_kind_chk / recharge_runs_status_chk and the partial unique
// recharge_runs_one_open ON (tenantId, period) WHERE status IN ('draft','submitted').
model RechargeRun {
  id                   String    @id @default(uuid())
  tenantId             String // head office
  period               String // 'YYYY-MM'
  kind                 String    @default("monthly") // monthly | true_up
  status               String    @default("draft") // draft | submitted | posted | rejected | withdrawn | reversed
  stale                Boolean   @default(false) // the pool moved after preparation
  splitId              String
  costPool             Json // pool definition used (snapshot)
  basis                Json // [{ accountId, code, name, netCents }]
  poolCents            BigInt // HO net cost for the month at preparation
  priorCents           BigInt // sum of baseCents of earlier POSTED, non-reversed runs for (tenant, period)
  baseCents            BigInt // pool - prior: what this run splits
  rechargedCents       BigInt // sum of lines
  retainedCents        BigInt // base - sum of lines (stays with the HO)
  driftAtApprovalCents BigInt? // (pool - prior) recomputed at approval minus baseCents
  warnings             String[]  @default([])
  preparedById         String? // null = the worker
  preparedByIds        String[]  @default([]) // everyone who prepared or edited it (never its approver)
  preparedAt           DateTime  @default(now())
  submittedById        String? // null = the worker
  submittedAt          DateTime?
  decidedById          String?
  decidedAt            DateTime?
  decisionNote         String?
  decidedVia           String? // role | delegation
  delegationId         String?
  postedAt             DateTime?
  reversedById         String?
  reversedAt           DateTime?
  reversalReason       String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tenant Tenant            @relation("HoRechargeRuns", fields: [tenantId], references: [id], onDelete: Restrict)
  split  RechargeSplit     @relation(fields: [splitId], references: [id], onDelete: Restrict)
  lines  RechargeRunLine[]

  @@index([tenantId, period, status])
  @@index([status, submittedAt])
  @@map("recharge_runs")
}

// One company's share of a run; posted as ONE IntercompanyTransfer (source 'ho_recharge') in both books.
// SQL only: CHECK recharge_run_lines_bps_chk (shareBps BETWEEN 0 AND 10000). RLS: either side reads.
model RechargeRunLine {
  id              String    @id @default(uuid())
  runId           String
  tenantId        String // head office
  companyTenantId String
  linkId          String
  shareBps        Int
  amountCents     BigInt // signed: negative = credit to the company (true-up / negative month)
  transferId      String?   @unique // the IntercompanyTransfer that booked it (globally unique uuid by construction)
  entryDate       DateTime?
  postedLate      Boolean   @default(false)
  memoNote        String?

  run        RechargeRun           @relation(fields: [runId], references: [id], onDelete: Restrict)
  company    Tenant                @relation("RunLineCompany", fields: [companyTenantId], references: [id], onDelete: Restrict)
  link       HeadOfficeLink        @relation(fields: [linkId], references: [id], onDelete: Restrict)
  transfer   IntercompanyTransfer? @relation("RunLineTransfer", fields: [transferId], references: [id], onDelete: Restrict)
  headOffice Tenant                @relation("RunLineHeadOffice", fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([runId, companyTenantId])
  @@index([companyTenantId])
  @@index([tenantId])
  @@map("recharge_run_lines")
}

// WHO may decide a section — never items, never decisions. Rows are never edited or deleted: change = revoke + new
// grant. Checked live on every use (nothing cached). SQL only: CHECKs approval_delegations_section_chk (operations |
// procurement | finance | marketing | hr | dev — never ceo) and approval_delegations_window_chk (endsAt > startsAt).
model ApprovalDelegation {
  id              String    @id @default(uuid())
  tenantId        String // the head office the delegate belongs to
  companyTenantId String? // null = the HO itself + every company LIVE-linked to it at the moment of use
  section         String
  approvalTypes   String[]  @default([]) // narrows to these delegable types of the section; [] = all
  delegateUserId  String // plain id (users are soft-deleted; checked live)
  grantedById     String
  note            String?
  startsAt        DateTime  @default(now())
  endsAt          DateTime? // exclusive
  revokedAt       DateTime?
  revokedById     String?
  revokeReason    String?
  createdAt       DateTime  @default(now())

  headOffice Tenant  @relation("DelegationHeadOffice", fields: [tenantId], references: [id], onDelete: Restrict)
  company    Tenant? @relation("DelegationCompany", fields: [companyTenantId], references: [id], onDelete: Restrict)

  @@index([delegateUserId, revokedAt])
  @@index([tenantId, section, revokedAt])
  @@index([companyTenantId])
  @@map("approval_delegations")
}

// Accounting's own pending state for manual journals (finance prepares; the CEO or a Finance delegate approves).
// SQL only: CHECKs journal_requests_kind_chk, journal_requests_status_chk, journal_requests_reverse_chk.
model JournalRequest {
  id              String    @id @default(uuid())
  tenantId        String // the books it posts to
  kind            String    @default("post") // post | reverse | amend (reverse / amend of an existing manual entry = CEO only; 2026-10-23)
  status          String    @default("draft") // draft | submitted | returned | posted | withdrawn
  description     String
  reference       String?
  entryDate       DateTime?
  lines           Json      @default("[]") // post: [{ accountId, type, amountCents, memo?, conceptId? }] (re-validated on approval)
  totalCents      BigInt    @default(0)
  reverseEntryId  String? // reverse / amend: the manual entry to cancel or edit (one open change per entry, checked under its lock)
  reason          String? // reverse: required
  preparedById    String
  preparedByIds   String[]  @default([])
  preparedAt      DateTime  @default(now())
  submittedById   String?
  submittedAt     DateTime?
  viaHeadOfficeId String? // stamped at submit (A3): the head office it came through, else NULL
  decidedById     String?
  decidedAt       DateTime?
  decisionNote    String?
  decidedVia      String?
  delegationId    String?
  postedEntryId   String?   @unique // journal-entry uuid — globally unique by construction
  // reverse / amend raised from the Journals tab (2026-10-23): { fingerprint (accounting/manualJournal.ts
  // entryFingerprint of the entry as it was when raised), classification? (the corrected payment's label) }.
  changeMeta      Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant Tenant @relation("TenantJournalRequests", fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
  @@index([preparedById])
  @@map("journal_requests")
}

// Connectors' own pending state for IT changes to a company's POS connector (Dev section).
// SQL only: CHECK pos_connector_changes_status_chk.
model PosConnectorChange {
  id               String        @id @default(uuid())
  tenantId         String
  kind             ConnectorKind
  status           String        @default("submitted") // submitted | applied | rejected | withdrawn
  patch            Json // the PUT /connectors/:kind body minus secrets
  apiKeyEnc        String? // sealed with lib/secretBox; never returned
  webhookSecretEnc String?
  preparedById     String
  preparedByIds    String[]      @default([])
  preparedAt       DateTime      @default(now())
  viaHeadOfficeId  String? // stamped at submit (A3)
  decidedById      String?
  decidedAt        DateTime?
  decisionNote     String?
  decidedVia       String?
  delegationId     String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  tenant Tenant @relation("TenantPosConnectorChanges", fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
  @@map("pos_connector_changes")
}

/// An employee's work location (owner, 2026-10-15: "multiple employment locations"). A Location of the employee's OWN
/// company (422 LOCATION_NOT_IN_COMPANY otherwise). The time clock measures a punch against the nearest of these
/// (radius: this row's, else the Location's, else the company's OperationsConfig). No rows = the company's locations.
model HrWorkLocation {
  id                   String    @id @default(uuid())
  tenantId             String
  employeeId           String
  // EITHER a company Location (locationId) OR a custom map pin of this employee only (label + latitude + longitude;
  // owner, 2026-10-27: "make work locations a system in which i can add multiple pin locations"). CHECK
  // hr_work_locations_kind_chk. For a Location, radiusMetres is the per-employee radius; for a pin it is the pin's
  // radius as entered (null = the company's).
  locationId           String?
  label                String?
  latitude             Float?
  longitude            Float?
  radiusMetres         Int?
  isPrimary            Boolean   @default(false)
  // A custom pin's fence the CEO APPROVED (approval type work_pin, mirroring Location.fence*): the time clock measures
  // from these only; a new / moved pin waits and the old approved one stays in force meanwhile. fencePinRejected =
  // the pin the CEO turned down ({lat, lng, radius, at, byId, note}).
  fenceLatitude        Float?
  fenceLongitude       Float?
  fenceRadiusMetres    Int?
  fencePinApprovedAt   DateTime?
  fencePinApprovedById String?
  fencePinRejected     Json?
  createdById          String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @default(now()) @updatedAt

  tenant   Tenant     @relation("TenantHrWorkLocations", fields: [tenantId], references: [id])
  employee HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  location Location?  @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([employeeId, locationId])
  @@index([tenantId])
  @@index([locationId])
  @@map("hr_work_locations")
}

// ── Trash bin (owner, 2026-10-15) ─────────────────────────────────────────────
// modules/trash/README.md is the contract. One row per thing in the Trash:
//   - a master deleted with deletedAt (strategy 'soft'): the row's deletedAt is
//     the truth, this row is the index + WHO deleted it;
//   - a master hard-deleted after a snapshot (strategy 'snapshot'): `snapshot`
//     holds the row and its children; restore re-creates them with the same ids;
//   - a status master (dismissed exception, archived position, ended
//     contribution, inactive OpEx line): meta.previous holds what restore writes back;
//   - a money record that a route still erases (F1–F5: tax-payment void, card
//     payout undo, CapEx instalment delete, period reopen, payment unapply):
//     snapshot, never erasable, never restorable;
//   - a voided / cancelled transaction the CEO ARCHIVED (hidden from the default
//     list). Transactions are otherwise read from their own status — no row here.
// Kind, module, roles and erasable rules come from the registry
// (modules/trash/registry.ts) by entityType — never stored per row.
// Written ONLY by lib/trash.ts moveToTrash / the trash service, in the same
// transaction as the delete. One OPEN row per (entityType, entityId): partial
// unique index trash_entries_open_key WHERE restoredAt IS NULL AND purgedAt IS
// NULL — SQL only. tenantId is the row's company; null only for deliberate
// company-less rows (servd:* site pages, legacy company-less logins) — CEO only.
// Moves with its company on POST /tenants/merge (tenants/routes.ts repoint list).
model TrashEntry {
  id           String    @id @default(uuid())
  tenantId     String?
  entityType   String // registry key: 'menu_item', 'promo_code', 'sales_tax_payment', …
  entityId     String
  conceptId    String? // brand, when the row has one (filter + brand-in-trash parent check)
  title        String // shown in the list; kept after purge (tombstone)
  subtitle     String?
  parentType   String?
  parentId     String?
  reason       String?
  deletedById  String? // null = deleted before the Trash existed (backfill)
  deletedAt    DateTime  @default(now())
  snapshot     Json? // strategy 'snapshot': { v, model, row, children }; null after purge
  meta         Json      @default("{}") // restore hints: previous status / isActive, unlinked table ids, brand links
  restoredAt   DateTime?
  restoredById String?
  purgedAt     DateTime? // CEO "Delete forever" (row erased / snapshot dropped); this row stays as the record
  purgedById   String?
  purgeReason  String?
  archivedAt   DateTime? // CEO hid it from the default list (transactions, never-erasable masters)
  archivedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([tenantId, deletedAt(sort: Desc)])
  @@index([tenantId, entityType, deletedAt(sort: Desc)])
  @@index([entityType, entityId])
  @@map("trash_entries")
}

// One "Recover as copy" of a voided / cancelled transaction (or money snapshot).
// The original keeps its own status; this is only the log so the Trash can say
// "copied 2x — last by X" and link the new draft. newEntityId is null for a
// prefill copy (the user submits the module's own form; nothing is created here).
model TrashCopy {
  id            String   @id @default(uuid())
  tenantId      String?
  entityType    String
  entityId      String
  mode          String // 'created' | 'prefill'
  newEntityType String?
  newEntityId   String?
  copiedById    String
  copiedAt      DateTime @default(now())

  @@index([tenantId, entityType, entityId])
  @@map("trash_copies")
}

// ─── Night audit (owner, 2026-10-16) — SALES module only ──────────────────────
// Lock each sales day, then close it when its sales money settles. Contract:
// backend/src/modules/nightAudit/README.md. Migration 20261016120000_night_audit.

enum NightAuditStatus {
  open // not run, or reopened by the CEO — sales postings into the day allowed
  audited // night run done ("awaiting settlement") — day LOCKED for sales postings
  closed // sales settlement matched (or CEO override) — day LOCKED for sales postings
}

/// One row per company per Karachi business date — the SALES day (night audit,
/// owner 2026-10-16: sales module only). No row = open.
/// CHECKs night_audit_days_* (SQL only, migration 20261016120000_night_audit).
model NightAuditDay {
  id                       String           @id @default(uuid())
  tenantId                 String
  businessDate             String // 'YYYY-MM-DD' PKT (same convention as CardSettlementDay.day)
  status                   NightAuditStatus @default(open)
  auditedAt                DateTime?
  auditedById              String?
  /// Night-step blocks the CEO pushed through: [{key,title,count,cents}]; null = none.
  nightOverrides           Json?
  nightOverrideReason      String?
  closedAt                 DateTime?
  closedById               String? // null = closed automatically
  closedVia                String? // 'auto' | 'manual' | 'override'
  settlementOverrides      Json?
  settlementOverrideReason String?
  /// Daily audit report snapshot; `closing` added when the day closes.
  report                   Json?
  /// Latest check result shown on the calendar: {phase, at, blocks:[{key,title,count,cents}], warnings:[…]}.
  lastCheck                Json?
  lastCheckedAt            DateTime?
  reopenCount              Int              @default(0)
  /// Append-only: [{at, byId, action, from, to, reason?, keys?}]
  history                  Json             @default("[]")
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  tenant Tenant @relation("TenantNightAuditDays", fields: [tenantId], references: [id])

  @@unique([tenantId, businessDate])
  @@index([tenantId, status, businessDate])
  @@map("night_audit_days")
}

// ─── Shift corrections (owner, 2026-10-21) ───────────────────────────────────
//
// "A shift closed by staff/cashier, Finance should have access to reopen the
// shift and cancel any KOT, with CEO's approval." Finance lists every fix on a
// CLOSED drawer with a reason; the CEO approves or rejects the set once;
// nothing touches the books, stock, fiscal documents or orders until it is
// approved (modules/shiftCorrections/). tenantId = the SHIFT's company. One
// open (submitted) set per shift (partial unique shift_corrections_one_open).
model ShiftCorrection {
  id            String                @id @default(uuid())
  tenantId      String
  shiftId       String
  /// The shift's Karachi business day 'YYYY-MM-DD' (lib/businessDay.ts).
  businessDay   String
  status        ShiftCorrectionStatus @default(submitted)
  reason        String
  requestedById String
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?
  appliedAt     DateTime?
  error         String?
  /// What the apply did (steps, entries, the new drawer variance).
  result        Json?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  shift Shift                 @relation(fields: [shiftId], references: [id])
  items ShiftCorrectionItem[]

  @@index([tenantId, status])
  @@index([shiftId])
  @@map("shift_corrections")
}

model ShiftCorrectionItem {
  id            String              @id @default(uuid())
  tenantId      String
  correctionId  String
  kind          ShiftCorrectionKind
  orderId       String
  reason        String
  /// The money was really handed back to the customer: the receipts stay and are owed back (refund due).
  moneyReturned Boolean             @default(false)
  /// The food was made: every line is wasted (cancelled_after_fire); otherwise every line goes back to its lots.
  foodMade      Boolean             @default(false)
  /// void_reissue only: the right tender (lib/tenders.ts TILL_TENDERS).
  newTender     String?
  /// void_reissue only: the card slip / approval reference (card) or the bank reference (Raast) of the right tender.
  tenderRef     String?
  result        Json?
  createdAt     DateTime            @default(now())

  correction ShiftCorrection @relation(fields: [correctionId], references: [id], onDelete: Cascade)

  @@unique([correctionId, orderId])
  @@index([tenantId])
  @@index([orderId])
  @@map("shift_correction_items")
}

/// City Ledger settlement (owner, 2026-10-24): money a City Ledger (on-account) client paid against chosen
/// till bills that are not on a statement yet — at the till (cash into the drawer) or by finance (cash on hand,
/// bank). ONE journal entry 'cityledger.settlement:<id>' Dr the money account / Cr 1110. receivables/cityLedger.ts.
model CityLedgerSettlement {
  id                     String    @id @default(uuid())
  tenantId               String
  accountId              String
  number                 String // CLS-00001 per company (advisory lock)
  amountCents            BigInt
  method                 String // cash | bank_transfer | bank_deposit | cheque
  reference              String?
  bankAccountId          String?
  receivedAt             DateTime
  channel                String // till | back_office
  shiftId                String? // the drawer (till only)
  cashMovementId         String?   @unique // the drawer pay-in (till cash)
  /// Till cash reversed while its drawer was still open: the drawer pay-out that handed it back.
  reversalCashMovementId String?   @unique
  moneyAccountCode       String // the account the entry debited
  /// 'in' = received from the client; 'out' = paid back on bills that owe back (back office only).
  direction              String    @default("in")
  idempotencyKey         String?
  note                   String?
  createdById            String
  createdAt              DateTime  @default(now())
  reversedAt             DateTime?
  reversedById           String?
  reversedReason         String?

  account     CustomerAccount        @relation(fields: [accountId], references: [id])
  allocations CityLedgerAllocation[]

  @@unique([tenantId, number])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, accountId, receivedAt])
  @@index([shiftId])
  @@map("city_ledger_settlements")
}

/// How a City Ledger settlement is split across the client's bills — chosen explicitly by the person settling.
model CityLedgerAllocation {
  id           String @id @default(uuid())
  tenantId     String
  settlementId String
  chargeId     String
  amountCents  Int

  settlement CityLedgerSettlement  @relation(fields: [settlementId], references: [id])
  charge     CustomerAccountCharge @relation(fields: [chargeId], references: [id])

  @@unique([settlementId, chargeId])
  @@index([chargeId])
  @@index([tenantId])
  @@map("city_ledger_allocations")
}

// ─── Weekly database backup (owner S13, 2026-10-26: "make it a weekly file i
// can download and save to my pc.. ceo only..") ────────────────────────────
// One row per backup FILE (modules/backups). Deliberately NO tenantId: a
// backup is the WHOLE database (every company) and only the CEO reads it —
// platform data, like the settings table. The file itself is encrypted
// (AES-256-GCM) and only the CEO's backup passphrase opens it.
model DatabaseBackup {
  id          String    @id @default(uuid())
  status      String    @default("running") // running | done | failed
  trigger     String // weekly | manual
  fileName    String?
  sizeBytes   Float?
  keyId       String? // which passphrase key made it (backup key fingerprint)
  error       String?
  createdById String?
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?

  @@index([startedAt])
  @@map("database_backups")
}
