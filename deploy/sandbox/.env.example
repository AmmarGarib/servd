# ════════════════════════════════════════════════════════════════════════════
# servd PRACTICE COPY — C:\servd-sandbox\.env
#
# Copy this file to .env in the practice folder (C:\servd-sandbox) and fill
# every value. Step-by-step: SETUP.md, step 3.
#
# EVERY value here is NEW and belongs to the practice copy only. Never copy a
# value from the live box's deploy\.env or deploy\.env.production — the only
# live things written here are two HOSTNAMES in SERVD_PROD_HOSTS, so the
# practice API can refuse to start if it is ever pointed at them.
#
# Never commit this file once filled in.
# ════════════════════════════════════════════════════════════════════════════

# ─── Database: the Neon practice BRANCH ─────────────────────────────────────
# Neon → servd project → Branches → "practice" → Connect (connection pooling
# OFF) → copy. Its host (ep-…) is different from the live one. NEVER the live
# database's connection string.
DATABASE_URL=

# ─── Sign-in keys: NEW random values (SETUP.md step 3 shows how) ───────────
# At least 32 characters each, different from each other and from live. Then
# a live sign-in never works here and a practice sign-in never works on live.
JWT_SECRET=
JWT_REFRESH_SECRET=

# ─── Key for stored integration secrets: a NEW random 32-byte base64 key ────
# Must NOT be the live key: the POS connector, WhatsApp gateway and SMTP keys
# copied over with the data then stay unreadable here.
SERVD_SECRET_KEY=

# ─── Card-gateway callback check: a NEW random value ────────────────────────
# The API won't start in production without it. Random, so no gateway
# callback is ever accepted here. (No gateway keys are set: the practice copy
# never calls a gateway.)
KEENU_WEBHOOK_SECRET=

# ─── Live hostnames the practice copy must never use ────────────────────────
# Comma-separated HOSTNAMES only (no passwords): the live database host — both
# forms, with and without "-pooler" — and the live Redis (Upstash) host. Copy
# them from DATABASE_URL and REDIS_URL in the live deploy\.env.production (the
# part after "@" and before ":" or "/"). The practice API refuses to start if
# DATABASE_URL or REDIS_URL points at one of them.
# Example: ep-xxxx-123456.ap-southeast-1.aws.neon.tech,ep-xxxx-123456-pooler.ap-southeast-1.aws.neon.tech,xxxx-12345.upstash.io
SERVD_PROD_HOSTS=

# ─── Redis: the practice copy's own (a container in this stack) ─────────────
# Leave as it is. Never the live Upstash Redis.
REDIS_URL=redis://sandbox-redis:6379

# ─── Cloudflare tunnel "servd-practice" (NOT the live tunnel) ───────────────
# Zero Trust → Networks → Tunnels → servd-practice. The token is the long
# string in the install command; the ID is the tunnel's UUID on that page.
# The stack checks that the token belongs to this ID before it connects, so
# the live tunnel's token is refused.
CF_TUNNEL_TOKEN=
CF_TUNNEL_ID=

# ─── Optional: hold the practice copy on a specific build ───────────────────
# Defaults: api-sandbox / admin-sandbox (the latest practice builds). To pin,
# use a practice tag such as api-sandbox-<sha>. Never a live tag (api, admin,
# api-<sha>, admin-<sha>).
# SANDBOX_API_TAG=api-sandbox
# SANDBOX_ADMIN_TAG=admin-sandbox

# ─── Deliberately NOT here — never add them ────────────────────────────────
# WHATSAPP_*, SMTP_*, TWILIO_*, R2_* / S3 keys, SENTRY_*, KEENU_API_KEY /
# KEENU_MERCHANT_ID, JAZZCASH_*, EASYPAISA_*, FACEBOOK_*, POSTMARK_*, any
# FBR_* / SRB_*, OTP_DEV_ECHO, ALLOW_UNSIGNED_WEBHOOKS.
# The practice copy has no messaging, storage, error-reporting, gateway or tax
# credentials on purpose. docker-compose.yml passes only the variables above
# to the API, so anything else written here never reaches it anyway.
