# ════════════════════════════════════════════════════════════════════════════
# deploy/.env.production  —  Backend API runtime environment
#
# Copy this file to deploy/.env.production and fill in all values.
# This file is passed directly into the `api` container at runtime.
#
# DATABASE_URL and REDIS_URL are overridden by docker-compose.yml
# (they point to the local containers). You only need to change them
# if you want to use an external database or Redis.
# ════════════════════════════════════════════════════════════════════════════

# ─── Database ────────────────────────────────────────────────────────────────
# Overridden by docker-compose.yml to use the local postgres container.
# Replace with a Neon/Supabase URL here if you prefer a hosted DB,
# and also remove the DATABASE_URL override in docker-compose.yml.
DATABASE_URL=postgresql://servd:CHANGEME@postgres:5432/servd

# ─── Redis ───────────────────────────────────────────────────────────────────
# Overridden by docker-compose.yml — leave as-is for local Redis.
REDIS_URL=redis://redis:6379

# ─── Auth (JWT) ──────────────────────────────────────────────────────────────
# Generate strong secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=CHANGE_ME_min_32_chars_random_string_here
JWT_REFRESH_SECRET=CHANGE_ME_refresh_min_32_chars_random_string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
PIN_TOKEN_EXPIRY=12h

# ─── Payment Gateways ────────────────────────────────────────────────────────
KEENU_API_KEY=
KEENU_MERCHANT_ID=
KEENU_WEBHOOK_SECRET=
KEENU_BASE_URL=https://api.keenu.com.pk/v1
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
EASYPAISA_STORE_ID=
EASYPAISA_ACCOUNT_NUM=
EASYPAISA_HASH_KEY=

# ─── File Storage (Cloudflare R2 / S3-compatible) ────────────────────────────
# Create a free R2 bucket at dash.cloudflare.com → R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=servd-media
R2_PUBLIC_URL=https://media.servd.pk

# ─── Messaging (SMS/WhatsApp receipts) ───────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=

# ─── WhatsApp gateway (staff 2FA, customer OTPs, password reset links) ───────
# lib/whatsapp.ts reads these two and nothing else. Unset, every OTP send
# throws: staff 2FA enrolment refuses (fails safe), customer signup OTPs 503,
# and password-reset links can only go by email.
WHATSAPP_API_URL=
WHATSAPP_API_KEY=

# ─── Email (transactional — magic links, receipts) ────────────────────────────
# Resend.com is recommended (free 3k/month). Sign up at resend.com → API Keys.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
# NOTE: the code reads SMTP_FROM, not EMAIL_FROM. Setting the wrong name
# leaves the default the old fallback sender in the From header — a domain GS Foods
# does not own, so Resend/SES reject the send as an unverified sender.
SMTP_FROM=contact@gsfoods.pk

# ─── App URLs ────────────────────────────────────────────────────────────────
# Your Cloudflare Tunnel public HTTPS URLs. Used for CORS, redirect URLs, etc.
API_URL=https://api.servd.pk
WEB_URL=https://admin.servd.pk
STOREFRONT_URL=https://servd.pk

# ─── Tax ─────────────────────────────────────────────────────────────────────
# Pakistan FBR GST rate (percentage, e.g. 17 = 17%)
DEFAULT_TAX_RATE=17

# ─── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
ENABLE_WORKERS=true
