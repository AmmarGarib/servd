# ════════════════════════════════════════════════════════════════════════════
# deploy/.env  —  Docker Compose build-time + compose-level variables
#
# Copy this file to deploy/.env and fill in all values.
# Docker Compose reads this file automatically for ${VAR} substitution
# (used in docker-compose.yml for build args, DB password, CF token, etc.)
#
# Do NOT put runtime backend secrets here — those go in .env.production.
# ════════════════════════════════════════════════════════════════════════════

# ─── Local Database Password ─────────────────────────────────────────────────
# Password for the PostgreSQL container. Pick anything strong.
# If you switch to an external DB (Neon/Supabase), this is still required
# but will just be unused.
DB_PASSWORD=change_me_strong_db_password

# ─── Public-facing URLs (baked into Next.js bundles at BUILD time) ────────────
# These must be your real Cloudflare Tunnel public HTTPS URLs.
# Changing them requires a full rebuild: docker compose up -d --build admin storefront
PUBLIC_API_URL=https://api.servd.garibsons.app
PUBLIC_WS_URL=https://api.servd.garibsons.app

# ─── Cloudflare Tunnel Token ──────────────────────────────────────────────────
# Get from: Cloudflare dashboard → Zero Trust → Networks → Tunnels
# → your tunnel → Configure → copy the token from the "cloudflared" command
CF_TUNNEL_TOKEN=

# ─── Sentry (optional — leave blank to disable error tracking) ───────────────
SENTRY_DSN_ADMIN=
SENTRY_DSN_STOREFRONT=
