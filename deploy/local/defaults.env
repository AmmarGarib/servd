# Bundled-database defaults for the local dev stack (docker-compose.local.yml).
#
# These point the API at the Postgres + Redis containers that the local stack
# spins up. They are SAFE defaults — nothing here touches production.
#
# To run against the SAME database production uses (Neon + Upstash), DO NOT
# edit this file. Instead create a git-ignored `.env.local` in the repo root
# and set DATABASE_URL / REDIS_URL there — it is layered on top of this file
# and overrides it. See LOCAL-DEV.md.

DATABASE_URL=postgresql://servd:servd_dev@db:5432/servd
REDIS_URL=redis://redis:6379

# Local-only JWT secrets. If you point at the live DB and want existing
# production tokens to validate, override these in .env.local with the real
# values; otherwise just log in fresh locally.
JWT_SECRET=local-dev-jwt-secret-change-me-min-32-chars
JWT_REFRESH_SECRET=local-dev-refresh-secret-change-me-min-32-chars
